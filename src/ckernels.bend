# ==== F5: the filter predicate's mask tree and the kept count (Kernel.pred_count per leaf, U32.add at the nodes) ====

def CK.pc.ww.l(+n: U32, +dd: Nat, +d: Nat, +na: U32, +da: Nat, +nb: U32, +db: Nat, +nc: U32, +dc: Nat, r: K.PC<U32, U32>) -> CPC<CH.CW, CH.CW>:
  match r:
    case K.PC{m, +k, xa, xva, xb, xvb}:
      CPC{CH.WL{n, dd, m}, k, CH.WL{n, d, xa}, CH.WL{na, da, xva}, CH.WL{nb, db, xb}, CH.WL{nc, dc, xvb}}

def CK.pc.ww.j(+r1: U32, +l1: U32, +r2: U32, +l2: U32, +r3: U32, +l3: U32, +r4: U32, +l4: U32, x: CPC<CH.CW, CH.CW>, y: CPC<CH.CW, CH.CW>) -> CPC<CH.CW, CH.CW>:
  match x y:
    case CPC{m1, +k1, a1, va1, b1, vb1} CPC{m2, +k2, a2, va2, b2, vb2}:
      CPC{CH.WN{r1, l1, m1, m2}, U32.add(k1, k2), CH.WN{r1, l1, a1, a2}, CH.WN{r2, l2, va1, va2}, CH.WN{r3, l3, b1, b2}, CH.WN{r4, l4, vb1, vb2}}

# F5: m = (va & vb) != 0 ? f(p, a, b) : 0 per row and the kept count (the modulo-2^32 sum of the mask
# words: per leaf the kernel's count, U32.add at the nodes); the four trees BORROWED
def CK.pc.ww(~P: Data, ~f: P -> U32 -> U32 -> U32, +p: P, a: CH.CW, va: CH.CW, b: CH.CW, vb: CH.CW) -> CPC<CH.CW, CH.CW>:
  match a va b vb:
    case CH.WL{+n, +d, xa} CH.WL{+na, +da, xva} CH.WL{+nb, +db, xb} CH.WL{+nc, +dc, xvb}:
      +dd = CK.dmax(d, db)
      CK.pc.ww.l(n, dd, d, na, da, nb, db, nc, dc, K.Kernel.pred_count(~U32, ~U32, ~P, ~f, n, dd, p, xa, xva, xb, xvb))
    case CH.WN{+r1, +l1, a1, a2} CH.WN{+r2, +l2, va1, va2} CH.WN{+r3, +l3, b1, b2} CH.WN{+r4, +l4, vb1, vb2}:
      x y = CK.pc.ww(~P, ~f, p, a1, va1, b1, vb1) CK.pc.ww(~P, ~f, p, a2, va2, b2, vb2)
      CK.pc.ww.j(r1, l1, r2, l2, r3, l3, r4, l4, x, y)
    case a va b vb:
      CPC{CH.CW.empty(), 0, a, va, b, vb}

