    case CH.FL{+n, +d, xa} CH.WL{+na, +da, xva} CH.FL{+nb, +db, xb} CH.WL{+nc, +dc, xvb}:
      +dd = CK.dmax(d, db)
      CK.pc.ff.l(n, dd, d, na, da, nb, db, nc, dc, K.Kernel.pred_count(~F32, ~F32, ~P, ~f, n, dd, p, xa, xva, xb, xvb))
    case CH.FN{+r1, +l1, a1, a2} CH.WN{+r2, +l2, va1, va2} CH.FN{+r3, +l3, b1, b2} CH.WN{+r4, +l4, vb1, vb2}:
      x y = CK.pc.ff(~P, ~f, p, a1, va1, b1, vb1) CK.pc.ff(~P, ~f, p, a2, va2, b2, vb2)
      CK.pc.ff.j(r1, l1, r2, l2, r3, l3, r4, l4, x, y)
    case a va b vb:
      CPC{CH.CW.empty(), 0, a, va, b, vb}

# ==== F6: per-leaf compaction by a mask tree, into each leaf's own capacity (ragged outputs keep d) ====

def CK.ck.w.k(+n: U32, +d: Nat, out: Array<U32>, r: Array<U32> & U32) -> CC1<CH.CW>:
  (m, +k) = r
  CC1{CH.WL{k, d, out}, CH.WL{n, d, m}, k}

def CK.ck.w.l(+n: U32, +d: Nat, r: Array<U32> & Array<U32>) -> CC1<CH.CW>:
  (out, m) = r
  CK.ck.w.k(n, d, out, K.Kernel.popcount(n, m))

def CK.ck.w.j(+rows: U32, +lrows: U32, x: CC1<CH.CW>, y: CC1<CH.CW>) -> CC1<CH.CW>:
  match x y:
    case CC1{o1, m1, +k1} CC1{o2, m2, +k2}:
      CC1{CH.WN{U32.add(k1, k2), k1, o1, o2}, CH.WN{rows, lrows, m1, m2}, U32.add(k1, k2)}

# the rows of t whose mask word is set, in order, leaf by leaf (Kernel.compact_keep into a leaf of the
# mask leaf's capacity 2^d, the kept count by Kernel.popcount of the leaf mask); t is consumed, the mask
# tree comes back; a mismatch answers an empty output
def CK.ck.w(m: CH.CW, t: CH.CW) -> CC1<CH.CW>:
  match m t:
    case CH.WL{+n, +d, mm} CH.WL{na, da, a}:
      CK.ck.w.l(n, d, K.Kernel.compact_keep(~U32, n, d, a, mm, 0))
    case CH.WN{+rows, +lrows, m1, m2} CH.WN{ra, la, a1, a2}:
      x y = CK.ck.w(m1, a1) CK.ck.w(m2, a2)
      CK.ck.w.j(rows, lrows, x, y)
    case m t:
      CC1{CH.CW.empty(), m, 0}

def CK.ck.f.k(+n: U32, +d: Nat, out: Array<F32>, r: Array<U32> & U32) -> CC1<CH.CF>:
  (m, +k) = r
  CC1{CH.FL{k, d, out}, CH.WL{n, d, m}, k}

def CK.ck.f.l(+n: U32, +d: Nat, r: Array<F32> & Array<U32>) -> CC1<CH.CF>:
  (out, m) = r
  CK.ck.f.k(n, d, out, K.Kernel.popcount(n, m))

def CK.ck.f.j(+rows: U32, +lrows: U32, x: CC1<CH.CF>, y: CC1<CH.CF>) -> CC1<CH.CF>:
  match x y:
    case CC1{o1, m1, +k1} CC1{o2, m2, +k2}:
      CC1{CH.FN{U32.add(k1, k2), k1, o1, o2}, CH.WN{rows, lrows, m1, m2}, U32.add(k1, k2)}

# the rows of t whose mask word is set, in order, leaf by leaf (Kernel.compact_keep into a leaf of the
# mask leaf's capacity 2^d, the kept count by Kernel.popcount of the leaf mask); t is consumed, the mask
# tree comes back; a mismatch answers an empty output
def CK.ck.f(m: CH.CW, t: CH.CF) -> CC1<CH.CF>:
  match m t:
    case CH.WL{+n, +d, mm} CH.FL{na, da, a}:
      CK.ck.f.l(n, d, K.Kernel.compact_keep(~F32, n, d, a, mm, 0.0))
    case CH.WN{+rows, +lrows, m1, m2} CH.FN{ra, la, a1, a2}:
      x y = CK.ck.f(m1, a1) CK.ck.f(m2, a2)
      CK.ck.f.j(rows, lrows, x, y)
    case m t:
      CC1{CH.CF.empty(), m, 0}

def CK.ck.s.k(+n: U32, +d: Nat, out: Array<String>, r: Array<U32> & U32) -> CC1<CH.CS>:
  (m, +k) = r
  CC1{CH.SL{k, d, out}, CH.WL{n, d, m}, k}

def CK.ck.s.l(+n: U32, +d: Nat, r: Array<String> & Array<U32>) -> CC1<CH.CS>:
  (out, m) = r
  CK.ck.s.k(n, d, out, K.Kernel.popcount(n, m))

def CK.ck.s.j(+rows: U32, +lrows: U32, x: CC1<CH.CS>, y: CC1<CH.CS>) -> CC1<CH.CS>:
  match x y:
    case CC1{o1, m1, +k1} CC1{o2, m2, +k2}:
      CC1{CH.SN{U32.add(k1, k2), k1, o1, o2}, CH.WN{rows, lrows, m1, m2}, U32.add(k1, k2)}

# the rows of t whose mask word is set, in order, leaf by leaf (Kernel.compact_keep into a leaf of the
# mask leaf's capacity 2^d, the kept count by Kernel.popcount of the leaf mask); t is consumed, the mask
# tree comes back; a mismatch answers an empty output
def CK.ck.s(m: CH.CW, t: CH.CS) -> CC1<CH.CS>:
  match m t:
    case CH.WL{+n, +d, mm} CH.SL{na, da, a}:
      CK.ck.s.l(n, d, K.Kernel.compact_keep(~String, n, d, a, mm, ""))
    case CH.WN{+rows, +lrows, m1, m2} CH.SN{ra, la, a1, a2}:
      x y = CK.ck.s(m1, a1) CK.ck.s(m2, a2)
      CK.ck.s.j(rows, lrows, x, y)
    case m t:
      CC1{CH.CS.empty(), m, 0}

def CK.c3.www.l(+n: U32, +d: Nat, +n1: U32, +d1: Nat, +n2: U32, +d2: Nat, +n3: U32, +d3: Nat, r: K.C3<U32, U32, U32>) -> CC3<CH.CW, CH.CW, CH.CW>:
  match r:
    case K.C3{o1, o2, o3, m, a1, a2, a3, +k}:
      CC3{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.WL{k, d, o3}, CH.WL{n, d, m}, CH.WL{n1, d1, a1}, CH.WL{n2, d2, a2}, CH.WL{n3, d3, a3}, k}

def CK.c3.www.j(+r0: U32, +l0: U32, +r1: U32, +l1: U32, +r2: U32, +l2: U32, +r3: U32, +l3: U32, x: CC3<CH.CW, CH.CW, CH.CW>, y: CC3<CH.CW, CH.CW, CH.CW>) -> CC3<CH.CW, CH.CW, CH.CW>:
  match x y:
    case CC3{o1, o2, o3, m, a1, a2, a3, +k} CC3{p1, p2, p3, q, b1, b2, b3, +j}:
      CC3{CH.WN{U32.add(k, j), k, o1, p1}, CH.WN{U32.add(k, j), k, o2, p2}, CH.WN{U32.add(k, j), k, o3, p3}, CH.WN{r0, l0, m, q}, CH.WN{r1, l1, a1, b1}, CH.WN{r2, l2, a2, b2}, CH.WN{r3, l3, a3, b3}, U32.add(k, j)}

# F6: three aligned buffers compacted by ONE mask with ONE cursor per leaf (Kernel.compact3 into the mask
# leaf's capacity 2^d); the mask and the inputs BORROWED; the kept count is the cursor (U32.add at nodes)
def CK.c3.www(m: CH.CW, a1: CH.CW, a2: CH.CW, a3: CH.CW) -> CC3<CH.CW, CH.CW, CH.CW>:
  match m a1 a2 a3:
    case CH.WL{+n, +d, mm} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      CK.c3.www.l(n, d, n1, d1, n2, d2, n3, d3, K.Kernel.compact3(~U32, ~U32, ~U32, n, d, mm, x1, x2, x3, 0, 0, 0))
    case CH.WN{+r0, +l0, m1, m2} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      x y = CK.c3.www(m1, p1, p2, p3) CK.c3.www(m2, q1, q2, q3)
      CK.c3.www.j(r0, l0, r1, l1, r2, l2, r3, l3, x, y)
    case m a1 a2 a3:
      CC3{CH.CW.empty(), CH.CW.empty(), CH.CW.empty(), m, a1, a2, a3, 0}

def CK.c3.wwf.l(+n: U32, +d: Nat, +n1: U32, +d1: Nat, +n2: U32, +d2: Nat, +n3: U32, +d3: Nat, r: K.C3<U32, U32, F32>) -> CC3<CH.CW, CH.CW, CH.CF>:
  match r:
    case K.C3{o1, o2, o3, m, a1, a2, a3, +k}:
      CC3{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.FL{k, d, o3}, CH.WL{n, d, m}, CH.WL{n1, d1, a1}, CH.WL{n2, d2, a2}, CH.FL{n3, d3, a3}, k}

def CK.c3.wwf.j(+r0: U32, +l0: U32, +r1: U32, +l1: U32, +r2: U32, +l2: U32, +r3: U32, +l3: U32, x: CC3<CH.CW, CH.CW, CH.CF>, y: CC3<CH.CW, CH.CW, CH.CF>) -> CC3<CH.CW, CH.CW, CH.CF>:
  match x y:
    case CC3{o1, o2, o3, m, a1, a2, a3, +k} CC3{p1, p2, p3, q, b1, b2, b3, +j}:
      CC3{CH.WN{U32.add(k, j), k, o1, p1}, CH.WN{U32.add(k, j), k, o2, p2}, CH.FN{U32.add(k, j), k, o3, p3}, CH.WN{r0, l0, m, q}, CH.WN{r1, l1, a1, b1}, CH.WN{r2, l2, a2, b2}, CH.FN{r3, l3, a3, b3}, U32.add(k, j)}

# F6: three aligned buffers compacted by ONE mask with ONE cursor per leaf (Kernel.compact3 into the mask
# leaf's capacity 2^d); the mask and the inputs BORROWED; the kept count is the cursor (U32.add at nodes)
def CK.c3.wwf(m: CH.CW, a1: CH.CW, a2: CH.CW, a3: CH.CF) -> CC3<CH.CW, CH.CW, CH.CF>:
  match m a1 a2 a3:
    case CH.WL{+n, +d, mm} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.FL{+n3, +d3, x3}:
      CK.c3.wwf.l(n, d, n1, d1, n2, d2, n3, d3, K.Kernel.compact3(~U32, ~U32, ~F32, n, d, mm, x1, x2, x3, 0, 0, 0.0))
    case CH.WN{+r0, +l0, m1, m2} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.FN{+r3, +l3, p3, q3}:
      x y = CK.c3.wwf(m1, p1, p2, p3) CK.c3.wwf(m2, q1, q2, q3)
      CK.c3.wwf.j(r0, l0, r1, l1, r2, l2, r3, l3, x, y)
    case m a1 a2 a3:
      CC3{CH.CW.empty(), CH.CW.empty(), CH.CF.empty(), m, a1, a2, a3, 0}

def CK.c3.wff.l(+n: U32, +d: Nat, +n1: U32, +d1: Nat, +n2: U32, +d2: Nat, +n3: U32, +d3: Nat, r: K.C3<U32, F32, F32>) -> CC3<CH.CW, CH.CF, CH.CF>:
  match r:
    case K.C3{o1, o2, o3, m, a1, a2, a3, +k}:
      CC3{CH.WL{k, d, o1}, CH.FL{k, d, o2}, CH.FL{k, d, o3}, CH.WL{n, d, m}, CH.WL{n1, d1, a1}, CH.FL{n2, d2, a2}, CH.FL{n3, d3, a3}, k}

def CK.c3.wff.j(+r0: U32, +l0: U32, +r1: U32, +l1: U32, +r2: U32, +l2: U32, +r3: U32, +l3: U32, x: CC3<CH.CW, CH.CF, CH.CF>, y: CC3<CH.CW, CH.CF, CH.CF>) -> CC3<CH.CW, CH.CF, CH.CF>:
  match x y:
    case CC3{o1, o2, o3, m, a1, a2, a3, +k} CC3{p1, p2, p3, q, b1, b2, b3, +j}:
      CC3{CH.WN{U32.add(k, j), k, o1, p1}, CH.FN{U32.add(k, j), k, o2, p2}, CH.FN{U32.add(k, j), k, o3, p3}, CH.WN{r0, l0, m, q}, CH.WN{r1, l1, a1, b1}, CH.FN{r2, l2, a2, b2}, CH.FN{r3, l3, a3, b3}, U32.add(k, j)}

# F6: three aligned buffers compacted by ONE mask with ONE cursor per leaf (Kernel.compact3 into the mask
# leaf's capacity 2^d); the mask and the inputs BORROWED; the kept count is the cursor (U32.add at nodes)
def CK.c3.wff(m: CH.CW, a1: CH.CW, a2: CH.CF, a3: CH.CF) -> CC3<CH.CW, CH.CF, CH.CF>:
  match m a1 a2 a3:
    case CH.WL{+n, +d, mm} CH.WL{+n1, +d1, x1} CH.FL{+n2, +d2, x2} CH.FL{+n3, +d3, x3}:
      CK.c3.wff.l(n, d, n1, d1, n2, d2, n3, d3, K.Kernel.compact3(~U32, ~F32, ~F32, n, d, mm, x1, x2, x3, 0, 0.0, 0.0))
    case CH.WN{+r0, +l0, m1, m2} CH.WN{+r1, +l1, p1, q1} CH.FN{+r2, +l2, p2, q2} CH.FN{+r3, +l3, p3, q3}:
      x y = CK.c3.wff(m1, p1, p2, p3) CK.c3.wff(m2, q1, q2, q3)
      CK.c3.wff.j(r0, l0, r1, l1, r2, l2, r3, l3, x, y)
    case m a1 a2 a3:
      CC3{CH.CW.empty(), CH.CF.empty(), CH.CF.empty(), m, a1, a2, a3, 0}

def CK.c3.fff.l(+n: U32, +d: Nat, +n1: U32, +d1: Nat, +n2: U32, +d2: Nat, +n3: U32, +d3: Nat, r: K.C3<F32, F32, F32>) -> CC3<CH.CF, CH.CF, CH.CF>:
  match r:
    case K.C3{o1, o2, o3, m, a1, a2, a3, +k}:
      CC3{CH.FL{k, d, o1}, CH.FL{k, d, o2}, CH.FL{k, d, o3}, CH.WL{n, d, m}, CH.FL{n1, d1, a1}, CH.FL{n2, d2, a2}, CH.FL{n3, d3, a3}, k}

def CK.c3.fff.j(+r0: U32, +l0: U32, +r1: U32, +l1: U32, +r2: U32, +l2: U32, +r3: U32, +l3: U32, x: CC3<CH.CF, CH.CF, CH.CF>, y: CC3<CH.CF, CH.CF, CH.CF>) -> CC3<CH.CF, CH.CF, CH.CF>:
  match x y:
    case CC3{o1, o2, o3, m, a1, a2, a3, +k} CC3{p1, p2, p3, q, b1, b2, b3, +j}:
      CC3{CH.FN{U32.add(k, j), k, o1, p1}, CH.FN{U32.add(k, j), k, o2, p2}, CH.FN{U32.add(k, j), k, o3, p3}, CH.WN{r0, l0, m, q}, CH.FN{r1, l1, a1, b1}, CH.FN{r2, l2, a2, b2}, CH.FN{r3, l3, a3, b3}, U32.add(k, j)}

# F6: three aligned buffers compacted by ONE mask with ONE cursor per leaf (Kernel.compact3 into the mask
# leaf's capacity 2^d); the mask and the inputs BORROWED; the kept count is the cursor (U32.add at nodes)
def CK.c3.fff(m: CH.CW, a1: CH.CF, a2: CH.CF, a3: CH.CF) -> CC3<CH.CF, CH.CF, CH.CF>:
  match m a1 a2 a3:
    case CH.WL{+n, +d, mm} CH.FL{+n1, +d1, x1} CH.FL{+n2, +d2, x2} CH.FL{+n3, +d3, x3}:
      CK.c3.fff.l(n, d, n1, d1, n2, d2, n3, d3, K.Kernel.compact3(~F32, ~F32, ~F32, n, d, mm, x1, x2, x3, 0.0, 0.0, 0.0))
    case CH.WN{+r0, +l0, m1, m2} CH.FN{+r1, +l1, p1, q1} CH.FN{+r2, +l2, p2, q2} CH.FN{+r3, +l3, p3, q3}:
      x y = CK.c3.fff(m1, p1, p2, p3) CK.c3.fff(m2, q1, q2, q3)
      CK.c3.fff.j(r0, l0, r1, l1, r2, l2, r3, l3, x, y)
    case m a1 a2 a3:
      CC3{CH.CF.empty(), CH.CF.empty(), CH.CF.empty(), m, a1, a2, a3, 0}

def CK.c4.wwww.l(+n: U32, +d: Nat, +n1: U32, +d1: Nat, +n2: U32, +d2: Nat, +n3: U32, +d3: Nat, +n4: U32, +d4: Nat, r: K.C4<U32, U32, U32, U32>) -> CC4<CH.CW, CH.CW, CH.CW, CH.CW>:
  match r:
    case K.C4{o1, o2, o3, o4, m, a1, a2, a3, a4, +k}:
      CC4{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.WL{k, d, o3}, CH.WL{k, d, o4}, CH.WL{n, d, m}, CH.WL{n1, d1, a1}, CH.WL{n2, d2, a2}, CH.WL{n3, d3, a3}, CH.WL{n4, d4, a4}, k}

def CK.c4.wwww.j(+r0: U32, +l0: U32, +r1: U32, +l1: U32, +r2: U32, +l2: U32, +r3: U32, +l3: U32, +r4: U32, +l4: U32, x: CC4<CH.CW, CH.CW, CH.CW, CH.CW>, y: CC4<CH.CW, CH.CW, CH.CW, CH.CW>) -> CC4<CH.CW, CH.CW, CH.CW, CH.CW>:
  match x y:
    case CC4{o1, o2, o3, o4, m, a1, a2, a3, a4, +k} CC4{p1, p2, p3, p4, q, b1, b2, b3, b4, +j}:
      CC4{CH.WN{U32.add(k, j), k, o1, p1}, CH.WN{U32.add(k, j), k, o2, p2}, CH.WN{U32.add(k, j), k, o3, p3}, CH.WN{U32.add(k, j), k, o4, p4}, CH.WN{r0, l0, m, q}, CH.WN{r1, l1, a1, b1}, CH.WN{r2, l2, a2, b2}, CH.WN{r3, l3, a3, b3}, CH.WN{r4, l4, a4, b4}, U32.add(k, j)}

# F6 with four buffers (Kernel.compact4 per leaf; more buffers: chain CK.c4 / CK.c3 / CK.ck with the same mask)
def CK.c4.wwww(m: CH.CW, a1: CH.CW, a2: CH.CW, a3: CH.CW, a4: CH.CW) -> CC4<CH.CW, CH.CW, CH.CW, CH.CW>:
  match m a1 a2 a3 a4:
    case CH.WL{+n, +d, mm} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3} CH.WL{+n4, +d4, x4}:
      CK.c4.wwww.l(n, d, n1, d1, n2, d2, n3, d3, n4, d4, K.Kernel.compact4(~U32, ~U32, ~U32, ~U32, n, d, mm, x1, x2, x3, x4, 0, 0, 0, 0))
    case CH.WN{+r0, +l0, m1, m2} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3} CH.WN{+r4, +l4, p4, q4}:
      x y = CK.c4.wwww(m1, p1, p2, p3, p4) CK.c4.wwww(m2, q1, q2, q3, q4)
      CK.c4.wwww.j(r0, l0, r1, l1, r2, l2, r3, l3, r4, l4, x, y)
    case m a1 a2 a3 a4:
      CC4{CH.CW.empty(), CH.CW.empty(), CH.CW.empty(), CH.CW.empty(), m, a1, a2, a3, a4, 0}

def CK.c4.wwwf.l(+n: U32, +d: Nat, +n1: U32, +d1: Nat, +n2: U32, +d2: Nat, +n3: U32, +d3: Nat, +n4: U32, +d4: Nat, r: K.C4<U32, U32, U32, F32>) -> CC4<CH.CW, CH.CW, CH.CW, CH.CF>:
  match r:
    case K.C4{o1, o2, o3, o4, m, a1, a2, a3, a4, +k}:
      CC4{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.WL{k, d, o3}, CH.FL{k, d, o4}, CH.WL{n, d, m}, CH.WL{n1, d1, a1}, CH.WL{n2, d2, a2}, CH.WL{n3, d3, a3}, CH.FL{n4, d4, a4}, k}

def CK.c4.wwwf.j(+r0: U32, +l0: U32, +r1: U32, +l1: U32, +r2: U32, +l2: U32, +r3: U32, +l3: U32, +r4: U32, +l4: U32, x: CC4<CH.CW, CH.CW, CH.CW, CH.CF>, y: CC4<CH.CW, CH.CW, CH.CW, CH.CF>) -> CC4<CH.CW, CH.CW, CH.CW, CH.CF>:
  match x y:
    case CC4{o1, o2, o3, o4, m, a1, a2, a3, a4, +k} CC4{p1, p2, p3, p4, q, b1, b2, b3, b4, +j}:
      CC4{CH.WN{U32.add(k, j), k, o1, p1}, CH.WN{U32.add(k, j), k, o2, p2}, CH.WN{U32.add(k, j), k, o3, p3}, CH.FN{U32.add(k, j), k, o4, p4}, CH.WN{r0, l0, m, q}, CH.WN{r1, l1, a1, b1}, CH.WN{r2, l2, a2, b2}, CH.WN{r3, l3, a3, b3}, CH.FN{r4, l4, a4, b4}, U32.add(k, j)}

# F6 with four buffers (Kernel.compact4 per leaf; more buffers: chain CK.c4 / CK.c3 / CK.ck with the same mask)
def CK.c4.wwwf(m: CH.CW, a1: CH.CW, a2: CH.CW, a3: CH.CW, a4: CH.CF) -> CC4<CH.CW, CH.CW, CH.CW, CH.CF>:
  match m a1 a2 a3 a4:
    case CH.WL{+n, +d, mm} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3} CH.FL{+n4, +d4, x4}:
      CK.c4.wwwf.l(n, d, n1, d1, n2, d2, n3, d3, n4, d4, K.Kernel.compact4(~U32, ~U32, ~U32, ~F32, n, d, mm, x1, x2, x3, x4, 0, 0, 0, 0.0))
    case CH.WN{+r0, +l0, m1, m2} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3} CH.FN{+r4, +l4, p4, q4}:
      x y = CK.c4.wwwf(m1, p1, p2, p3, p4) CK.c4.wwwf(m2, q1, q2, q3, q4)
      CK.c4.wwwf.j(r0, l0, r1, l1, r2, l2, r3, l3, r4, l4, x, y)
    case m a1 a2 a3 a4:
      CC4{CH.CW.empty(), CH.CW.empty(), CH.CW.empty(), CH.CF.empty(), m, a1, a2, a3, a4, 0}

def CK.c4.wwff.l(+n: U32, +d: Nat, +n1: U32, +d1: Nat, +n2: U32, +d2: Nat, +n3: U32, +d3: Nat, +n4: U32, +d4: Nat, r: K.C4<U32, U32, F32, F32>) -> CC4<CH.CW, CH.CW, CH.CF, CH.CF>:
  match r:
    case K.C4{o1, o2, o3, o4, m, a1, a2, a3, a4, +k}:
      CC4{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.FL{k, d, o3}, CH.FL{k, d, o4}, CH.WL{n, d, m}, CH.WL{n1, d1, a1}, CH.WL{n2, d2, a2}, CH.FL{n3, d3, a3}, CH.FL{n4, d4, a4}, k}

def CK.c4.wwff.j(+r0: U32, +l0: U32, +r1: U32, +l1: U32, +r2: U32, +l2: U32, +r3: U32, +l3: U32, +r4: U32, +l4: U32, x: CC4<CH.CW, CH.CW, CH.CF, CH.CF>, y: CC4<CH.CW, CH.CW, CH.CF, CH.CF>) -> CC4<CH.CW, CH.CW, CH.CF, CH.CF>:
  match x y:
    case CC4{o1, o2, o3, o4, m, a1, a2, a3, a4, +k} CC4{p1, p2, p3, p4, q, b1, b2, b3, b4, +j}:
      CC4{CH.WN{U32.add(k, j), k, o1, p1}, CH.WN{U32.add(k, j), k, o2, p2}, CH.FN{U32.add(k, j), k, o3, p3}, CH.FN{U32.add(k, j), k, o4, p4}, CH.WN{r0, l0, m, q}, CH.WN{r1, l1, a1, b1}, CH.WN{r2, l2, a2, b2}, CH.FN{r3, l3, a3, b3}, CH.FN{r4, l4, a4, b4}, U32.add(k, j)}

# F6 with four buffers (Kernel.compact4 per leaf; more buffers: chain CK.c4 / CK.c3 / CK.ck with the same mask)
def CK.c4.wwff(m: CH.CW, a1: CH.CW, a2: CH.CW, a3: CH.CF, a4: CH.CF) -> CC4<CH.CW, CH.CW, CH.CF, CH.CF>:
  match m a1 a2 a3 a4:
    case CH.WL{+n, +d, mm} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.FL{+n3, +d3, x3} CH.FL{+n4, +d4, x4}:
      CK.c4.wwff.l(n, d, n1, d1, n2, d2, n3, d3, n4, d4, K.Kernel.compact4(~U32, ~U32, ~F32, ~F32, n, d, mm, x1, x2, x3, x4, 0, 0, 0.0, 0.0))
    case CH.WN{+r0, +l0, m1, m2} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.FN{+r3, +l3, p3, q3} CH.FN{+r4, +l4, p4, q4}:
      x y = CK.c4.wwff(m1, p1, p2, p3, p4) CK.c4.wwff(m2, q1, q2, q3, q4)
      CK.c4.wwff.j(r0, l0, r1, l1, r2, l2, r3, l3, r4, l4, x, y)
    case m a1 a2 a3 a4:
      CC4{CH.CW.empty(), CH.CW.empty(), CH.CF.empty(), CH.CF.empty(), m, a1, a2, a3, a4, 0}

def CK.c4.wfff.l(+n: U32, +d: Nat, +n1: U32, +d1: Nat, +n2: U32, +d2: Nat, +n3: U32, +d3: Nat, +n4: U32, +d4: Nat, r: K.C4<U32, F32, F32, F32>) -> CC4<CH.CW, CH.CF, CH.CF, CH.CF>:
  match r:
    case K.C4{o1, o2, o3, o4, m, a1, a2, a3, a4, +k}:
      CC4{CH.WL{k, d, o1}, CH.FL{k, d, o2}, CH.FL{k, d, o3}, CH.FL{k, d, o4}, CH.WL{n, d, m}, CH.WL{n1, d1, a1}, CH.FL{n2, d2, a2}, CH.FL{n3, d3, a3}, CH.FL{n4, d4, a4}, k}

def CK.c4.wfff.j(+r0: U32, +l0: U32, +r1: U32, +l1: U32, +r2: U32, +l2: U32, +r3: U32, +l3: U32, +r4: U32, +l4: U32, x: CC4<CH.CW, CH.CF, CH.CF, CH.CF>, y: CC4<CH.CW, CH.CF, CH.CF, CH.CF>) -> CC4<CH.CW, CH.CF, CH.CF, CH.CF>:
  match x y:
    case CC4{o1, o2, o3, o4, m, a1, a2, a3, a4, +k} CC4{p1, p2, p3, p4, q, b1, b2, b3, b4, +j}:
      CC4{CH.WN{U32.add(k, j), k, o1, p1}, CH.FN{U32.add(k, j), k, o2, p2}, CH.FN{U32.add(k, j), k, o3, p3}, CH.FN{U32.add(k, j), k, o4, p4}, CH.WN{r0, l0, m, q}, CH.WN{r1, l1, a1, b1}, CH.FN{r2, l2, a2, b2}, CH.FN{r3, l3, a3, b3}, CH.FN{r4, l4, a4, b4}, U32.add(k, j)}

# F6 with four buffers (Kernel.compact4 per leaf; more buffers: chain CK.c4 / CK.c3 / CK.ck with the same mask)
def CK.c4.wfff(m: CH.CW, a1: CH.CW, a2: CH.CF, a3: CH.CF, a4: CH.CF) -> CC4<CH.CW, CH.CF, CH.CF, CH.CF>:
  match m a1 a2 a3 a4:
    case CH.WL{+n, +d, mm} CH.WL{+n1, +d1, x1} CH.FL{+n2, +d2, x2} CH.FL{+n3, +d3, x3} CH.FL{+n4, +d4, x4}:
      CK.c4.wfff.l(n, d, n1, d1, n2, d2, n3, d3, n4, d4, K.Kernel.compact4(~U32, ~F32, ~F32, ~F32, n, d, mm, x1, x2, x3, x4, 0, 0.0, 0.0, 0.0))
    case CH.WN{+r0, +l0, m1, m2} CH.WN{+r1, +l1, p1, q1} CH.FN{+r2, +l2, p2, q2} CH.FN{+r3, +l3, p3, q3} CH.FN{+r4, +l4, p4, q4}:
      x y = CK.c4.wfff(m1, p1, p2, p3, p4) CK.c4.wfff(m2, q1, q2, q3, q4)
      CK.c4.wfff.j(r0, l0, r1, l1, r2, l2, r3, l3, r4, l4, x, y)
    case m a1 a2 a3 a4:
      CC4{CH.CW.empty(), CH.CF.empty(), CH.CF.empty(), CH.CF.empty(), m, a1, a2, a3, a4, 0}

def CK.c4.ffff.l(+n: U32, +d: Nat, +n1: U32, +d1: Nat, +n2: U32, +d2: Nat, +n3: U32, +d3: Nat, +n4: U32, +d4: Nat, r: K.C4<F32, F32, F32, F32>) -> CC4<CH.CF, CH.CF, CH.CF, CH.CF>:
  match r:
    case K.C4{o1, o2, o3, o4, m, a1, a2, a3, a4, +k}:
      CC4{CH.FL{k, d, o1}, CH.FL{k, d, o2}, CH.FL{k, d, o3}, CH.FL{k, d, o4}, CH.WL{n, d, m}, CH.FL{n1, d1, a1}, CH.FL{n2, d2, a2}, CH.FL{n3, d3, a3}, CH.FL{n4, d4, a4}, k}

def CK.c4.ffff.j(+r0: U32, +l0: U32, +r1: U32, +l1: U32, +r2: U32, +l2: U32, +r3: U32, +l3: U32, +r4: U32, +l4: U32, x: CC4<CH.CF, CH.CF, CH.CF, CH.CF>, y: CC4<CH.CF, CH.CF, CH.CF, CH.CF>) -> CC4<CH.CF, CH.CF, CH.CF, CH.CF>:
  match x y:
    case CC4{o1, o2, o3, o4, m, a1, a2, a3, a4, +k} CC4{p1, p2, p3, p4, q, b1, b2, b3, b4, +j}:
      CC4{CH.FN{U32.add(k, j), k, o1, p1}, CH.FN{U32.add(k, j), k, o2, p2}, CH.FN{U32.add(k, j), k, o3, p3}, CH.FN{U32.add(k, j), k, o4, p4}, CH.WN{r0, l0, m, q}, CH.FN{r1, l1, a1, b1}, CH.FN{r2, l2, a2, b2}, CH.FN{r3, l3, a3, b3}, CH.FN{r4, l4, a4, b4}, U32.add(k, j)}

# F6 with four buffers (Kernel.compact4 per leaf; more buffers: chain CK.c4 / CK.c3 / CK.ck with the same mask)
def CK.c4.ffff(m: CH.CW, a1: CH.CF, a2: CH.CF, a3: CH.CF, a4: CH.CF) -> CC4<CH.CF, CH.CF, CH.CF, CH.CF>:
  match m a1 a2 a3 a4:
    case CH.WL{+n, +d, mm} CH.FL{+n1, +d1, x1} CH.FL{+n2, +d2, x2} CH.FL{+n3, +d3, x3} CH.FL{+n4, +d4, x4}:
      CK.c4.ffff.l(n, d, n1, d1, n2, d2, n3, d3, n4, d4, K.Kernel.compact4(~F32, ~F32, ~F32, ~F32, n, d, mm, x1, x2, x3, x4, 0.0, 0.0, 0.0, 0.0))
    case CH.WN{+r0, +l0, m1, m2} CH.FN{+r1, +l1, p1, q1} CH.FN{+r2, +l2, p2, q2} CH.FN{+r3, +l3, p3, q3} CH.FN{+r4, +l4, p4, q4}:
      x y = CK.c4.ffff(m1, p1, p2, p3, p4) CK.c4.ffff(m2, q1, q2, q3, q4)
      CK.c4.ffff.j(r0, l0, r1, l1, r2, l2, r3, l3, r4, l4, x, y)
    case m a1 a2 a3 a4:
      CC4{CH.CF.empty(), CH.CF.empty(), CH.CF.empty(), CH.CF.empty(), m, a1, a2, a3, a4, 0}

# ==== U32 tree reductions (D4): per-leaf Kernel.fold from z, combined at the nodes; the tree comes back ====

def CK.fold.w.l(+n: U32, +d: Nat, r: Array<U32> & U32) -> CH.CW & U32:
  (a, x) = r
  (CH.WL{n, d, a}, x)

def CK.fold.w.j(~c: U32 -> U32 -> U32, +rows: U32, +lrows: U32, x: CH.CW & U32, y: CH.CW & U32) -> CH.CW & U32:
  (l, +a) = x
  (r, +b) = y
  (CH.WN{rows, lrows, l, r}, c(a, b))

# f folded over each leaf's rows from z (Kernel.fold), the leaves' results combined by c at the nodes (one
# fork per node). With c = f associative and z its identity this is the row-order fold (LAWS section 22:
# ck_sum for U32.add, ck_min / ck_max for U32.min / U32.max); the tree is BORROWED
def CK.fold.w(~f: U32 -> U32 -> U32, ~c: U32 -> U32 -> U32, t: CH.CW, +z: U32) -> CH.CW & U32:
  match t:
    case CH.WL{+n, +d, a}:
      CK.fold.w.l(n, d, K.Kernel.fold(~U32, ~U32, ~f, n, a, z))
    case CH.WN{+rows, +lrows, l, r}:
      x y = CK.fold.w(~f, ~c, l, z) CK.fold.w(~f, ~c, r, z)
      CK.fold.w.j(~c, rows, lrows, x, y)

# the modulo-2^32 sum of the rows (U32 sum; I32 sum as words, two's complement); the tree comes back
def CK.sum.w(t: CH.CW) -> CH.CW & U32:
  CK.fold.w(~(acc => x => U32.add(acc, x)), ~(a => b => U32.add(a, b)), t, 0)

# the number of set words of a 0/1 mask tree (the kept count of a filter, the valid count of a column):
# the sum (LAWS section 22 ck_sum covers both)
def CK.popcount.w(t: CH.CW) -> CH.CW & U32:
  CK.sum.w(t)

# U32 min / max of the rows (identity 2^32 - 1 / 0: an empty tree answers it, the caller's null rule
# applies first, as Eval.nz does for the flat fold1); the tree comes back
def CK.min.w(t: CH.CW) -> CH.CW & U32:
  CK.fold.w(~(acc => x => U32.min(acc, x)), ~(a => b => U32.min(a, b)), t, 4294967295)

def CK.max.w(t: CH.CW) -> CH.CW & U32:
  CK.fold.w(~(acc => x => U32.max(acc, x)), ~(a => b => U32.max(a, b)), t, 0)

# ==== sequential reductions in ascending row order (D4): the leaves listed, then ONE tail loop over them ====

# the leaves of t in row order, on a stack (the leftmost on top); O(leaves), the arrays are moved
def CK.leaves.w(t: CH.CW, s: CH.CWS) -> CH.CWS:
  match t:
    case CH.WL{+n, d, a}:
      CH.CWCons{n, CH.WL{n, d, a}, s}
    case CH.WN{rows, lrows, l, r}:
      CK.leaves.w(l, CK.leaves.w(r, s))

def CK.walk.w.l(~A: Data, r: Array<U32> & A) -> A:
  (a, acc) = r
  acc

def CK.walk.w.leaf(~A: Data, ~f: A -> U32 -> A, c: CH.CW, acc: A) -> A:
  match c:
    case CH.WL{+n, d, a}:
      CK.walk.w.l(~A, K.Kernel.fold(~U32, ~A, ~f, n, a, acc))
    case CH.WN{rows, lrows, l, r}:
      acc

def CK.walk.w.go(~A: Data, ~f: A -> U32 -> A, s: CH.CWS, acc: A) -> A:
  match s:
    case CH.CWNil{}:
      acc
    case CH.CWCons{n, c, nx}:
      CK.walk.w.go(~A, ~f, nx, CK.walk.w.leaf(~A, ~f, c, acc))

# acc = f(acc, row) over every row in ascending order (each leaf by Kernel.fold, the leaves left to right);
# the tree is consumed. No fork: the order of the steps is the row order (F32 rounding as written).
# The leaves are listed first and folded by ONE tail loop, so the accumulator stays in registers across
# leaves: a fold inside the recursive tree walk itself (f(r, f(l, acc))) received the accumulator as a
# term word and kept the F32 compensation in an integer register (an fmov round trip on the loop-carried
# chain per row: the 2.5x of DESIGN 16.4's open issue, IMPLEMENTING.md T5.2)
def CK.walk.w(~A: Data, ~f: A -> U32 -> A, t: CH.CW, acc: A) -> A:
  CK.walk.w.go(~A, ~f, CK.leaves.w(t, CH.CWNil{}), acc)

# the leaves of t in row order, on a stack (the leftmost on top); O(leaves), the arrays are moved
def CK.leaves.f(t: CH.CF, s: CH.CFS) -> CH.CFS:
  match t:
    case CH.FL{+n, d, a}:
      CH.CFCons{n, CH.FL{n, d, a}, s}
    case CH.FN{rows, lrows, l, r}:
      CK.leaves.f(l, CK.leaves.f(r, s))

def CK.walk.f.l(~A: Data, r: Array<F32> & A) -> A:
  (a, acc) = r
  acc

def CK.walk.f.leaf(~A: Data, ~f: A -> F32 -> A, c: CH.CF, acc: A) -> A:
  match c:
    case CH.FL{+n, d, a}:
      CK.walk.f.l(~A, K.Kernel.fold(~F32, ~A, ~f, n, a, acc))
    case CH.FN{rows, lrows, l, r}:
      acc

def CK.walk.f.go(~A: Data, ~f: A -> F32 -> A, s: CH.CFS, acc: A) -> A:
  match s:
    case CH.CFNil{}:
      acc
    case CH.CFCons{n, c, nx}:
      CK.walk.f.go(~A, ~f, nx, CK.walk.f.leaf(~A, ~f, c, acc))

# acc = f(acc, row) over every row in ascending order (each leaf by Kernel.fold, the leaves left to right);
# the tree is consumed. No fork: the order of the steps is the row order (F32 rounding as written).
# The leaves are listed first and folded by ONE tail loop, so the accumulator stays in registers across
# leaves: a fold inside the recursive tree walk itself (f(r, f(l, acc))) received the accumulator as a
# term word and kept the F32 compensation in an integer register (an fmov round trip on the loop-carried
# chain per row: the 2.5x of DESIGN 16.4's open issue, IMPLEMENTING.md T5.2)
def CK.walk.f(~A: Data, ~f: A -> F32 -> A, t: CH.CF, acc: A) -> A:
  CK.walk.f.go(~A, ~f, CK.leaves.f(t, CH.CFNil{}), acc)

# ---- the F32 reductions over chunks (D4, DESIGN.md 15.5.3 unchanged): ONE Neumaier pass in row order ----

# the 15.5.3 sum of cv(row) over every row in ascending order: the in-order walk threading K.NS
# (the leaves are listed BEFORE the K.NS seed is built: the literal seed then sits in the same compiled
# continuation as the loop, so the compensation stays an F32 register; a seed passed in as a parameter
# arrives as a term word and costs the integer round trip again, IMPLEMENTING.md T5.2)
def CK.fsum.w.k(~cv: U32 -> F32, s: CH.CWS) -> F32:
  K.Kernel.nm.fin(CK.walk.w.go(~K.NS, ~(acc => x => K.Kernel.nm.step(acc, cv(x))), s, K.NS{0.0, 0.0}))

def CK.fsum.w(~cv: U32 -> F32, t: CH.CW) -> F32:
  CK.fsum.w.k(~cv, CK.leaves.w(t, CH.CWNil{}))

def CK.fsum.f.k(s: CH.CFS) -> F32:
  K.Kernel.nm.fin(CK.walk.f.go(~K.NS, ~(acc => x => K.Kernel.nm.step(acc, x)), s, K.NS{0.0, 0.0}))

def CK.fsum.f(t: CH.CF) -> F32:
  CK.fsum.f.k(CK.leaves.f(t, CH.CFNil{}))

# the same sum from a flattened copy (one Kernel.copy_into per leaf, then the flat Kernel.fsum: today's
# loop over one buffer); a one-leaf tree is moved, not copied (CW.depth / CF.depth answer its own depth)
def CK.fsumflat.w.b(~cv: U32 -> F32, +rows: U32, r: CH.CW & Nat) -> F32:
  (t, +dd) = r
  K.Kernel.fsum(~U32, ~cv, rows, CH.CW.to_flat(dd, t))

def CK.fsumflat.w.a(~cv: U32 -> F32, r: CH.CW & U32) -> F32:
  (t, +rows) = r
  CK.fsumflat.w.b(~cv, rows, CH.CW.depth(t))

def CK.fsumflat.w(~cv: U32 -> F32, t: CH.CW) -> F32:
  CK.fsumflat.w.a(~cv, CH.CW.rows(t))

def CK.fsumflat.f.b(+rows: U32, r: CH.CF & Nat) -> F32:
  (t, +dd) = r
  K.Kernel.fsum(~F32, ~(x => x), rows, CH.CF.to_flat(dd, t))

def CK.fsumflat.f.a(r: CH.CF & U32) -> F32:
  (t, +rows) = r
  CK.fsumflat.f.b(rows, CH.CF.depth(t))

def CK.fsumflat.f(t: CH.CF) -> F32:
  CK.fsumflat.f.a(CH.CF.rows(t))

# the first row (the slot 0 of the leftmost leaf; an empty tree answers its slot 0); the tree comes back
def CK.first.f.n(+rows: U32, +lrows: U32, r: CH.CF, x: CH.CF & F32) -> CH.CF & F32:
  (l, +v) = x
  (CH.FN{rows, lrows, l, r}, v)

def CK.first.f.l(+n: U32, +d: Nat, r: Array<F32> & F32) -> CH.CF & F32:
  (a, +v) = r
  (CH.FL{n, d, a}, v)

def CK.first.f(t: CH.CF) -> CH.CF & F32:
  match t:
    case CH.FL{+n, +d, a}:
      CK.first.f.l(n, d, Array.get(F32, a, 0))
    case CH.FN{+rows, +lrows, l, r}:
      CK.first.f.n(rows, lrows, r, CK.first.f(l))

def CK.first.w.n(+rows: U32, +lrows: U32, r: CH.CW, x: CH.CW & U32) -> CH.CW & U32:
  (l, +v) = x
  (CH.WN{rows, lrows, l, r}, v)

def CK.first.w.l(+n: U32, +d: Nat, r: Array<U32> & U32) -> CH.CW & U32:
  (a, +v) = r
  (CH.WL{n, d, a}, v)

def CK.first.w(t: CH.CW) -> CH.CW & U32:
  match t:
    case CH.WL{+n, +d, a}:
      CK.first.w.l(n, d, Array.get(U32, a, 0))
    case CH.WN{+rows, +lrows, l, r}:
      CK.first.w.n(rows, lrows, r, CK.first.w(l))

# F32 min / max (15.5.2: NaN skipped, -0.0 / 0.0 tie) seeded with the first row, in row order: Eval.fold1's
# steps exactly (sequential: the tree combine of Kernel.fmin / fmax is not proven associative, D4)
def CK.fmin.f.k(r: CH.CF & F32) -> F32:
  (t, +x0) = r
  CK.walk.f(~F32, ~(a => b => K.Kernel.fmin(a, b)), t, x0)

def CK.fmin.f(t: CH.CF) -> F32:
  CK.fmin.f.k(CK.first.f(t))

def CK.fmax.f.k(r: CH.CF & F32) -> F32:
  (t, +x0) = r
  CK.walk.f(~F32, ~(a => b => K.Kernel.fmax(a, b)), t, x0)

def CK.fmax.f(t: CH.CF) -> F32:
  CK.fmax.f.k(CK.first.f(t))

# I32 min / max over words (signed order: the sign bit flipped, as D.I32.cmp), seeded with the first row,
# in row order (Eval.fold1 with Eval.i32_min / i32_max; sequential: no combine law for the signed order)
def CK.i32_lt(+a: U32, +b: U32) -> Bool:
  U32.is_lt(U32.xor(a, 2147483648), U32.xor(b, 2147483648))

def CK.i32_min(+a: U32, +b: U32) -> U32:
  Bool.pick(U32, CK.i32_lt(a, b), a, b)

def CK.i32_max(+a: U32, +b: U32) -> U32:
  Bool.pick(U32, CK.i32_lt(a, b), b, a)

def CK.imin.w.k(r: CH.CW & U32) -> U32:
  (t, +x0) = r
  CK.walk.w(~U32, ~(a => b => CK.i32_min(a, b)), t, x0)

def CK.imin.w(t: CH.CW) -> U32:
  CK.imin.w.k(CK.first.w(t))

def CK.imax.w.k(r: CH.CW & U32) -> U32:
  (t, +x0) = r
  CK.walk.w(~U32, ~(a => b => CK.i32_max(a, b)), t, x0)

def CK.imax.w(t: CH.CW) -> U32:
  CK.imax.w.k(CK.first.w(t))

# ==== an AllValid side: 1-slot ones leaves of a skeleton (the flat kernels read slot 0 for every row) ====

# NOT a well-formed tree (n rows in one slot): only ever READ by a kernel (zipv / pred_count validity
# operands), never written, never flattened. O(leaves) small allocations instead of a ones column.
def CK.ones1(s: CH.Skel) -> CH.CW:
  match s:
    case CH.KLeaf{n}:
      CH.WL{n, 0n, Array.new(U32, 0n, 1)}
    case CH.KNode{rows, lrows, l, r}:
      CH.WN{rows, lrows, CK.ones1(l), CK.ones1(r)}

# ==== gathers: outputs built fresh from a flat permutation (sort / join / head outputs) ====

def CK.gatherf.w.c(+n: U32, +g: Nat, r: Array<U32> & Array<U32>) -> CH.CW & Array<U32>:
  (o, perm) = r
  (CH.CW.of(n, K.Kernel.depth_for(U32.max(n, 1)), g, o), perm)

def CK.gatherf.w.b(+n: U32, +g: Nat, perm: Array<U32>, r: CH.CW & Nat) -> CH.CW & Array<U32>:
  (t, +dd) = r
  CK.gatherf.w.c(n, g, K.Kernel.gather(~U32, n, K.Kernel.depth_for(U32.max(n, 1)), CH.CW.to_flat(dd, t), perm, 0))

# out row j = src row perm[j] for j < n, chunked at grain 2^g: the source flattened (a one-leaf tree is
# moved), today's Kernel.gather into a flat buffer, then the builder (a range copy per leaf; at most 2^g
# rows: the buffer itself is the one leaf); src is consumed, perm comes back
def CK.gatherf.w(src: CH.CW, perm: Array<U32>, +n: U32, +g: Nat) -> CH.CW & Array<U32>:
  CK.gatherf.w.b(n, g, perm, CH.CW.depth(src))

def CK.gatherf.f.c(+n: U32, +g: Nat, r: Array<F32> & Array<U32>) -> CH.CF & Array<U32>:
  (o, perm) = r
  (CH.CF.of(n, K.Kernel.depth_for(U32.max(n, 1)), g, o), perm)

def CK.gatherf.f.b(+n: U32, +g: Nat, perm: Array<U32>, r: CH.CF & Nat) -> CH.CF & Array<U32>:
  (t, +dd) = r
  CK.gatherf.f.c(n, g, K.Kernel.gather(~F32, n, K.Kernel.depth_for(U32.max(n, 1)), CH.CF.to_flat(dd, t), perm, 0.0))

# out row j = src row perm[j] for j < n, chunked at grain 2^g: the source flattened (a one-leaf tree is
# moved), today's Kernel.gather into a flat buffer, then the builder (a range copy per leaf; at most 2^g
# rows: the buffer itself is the one leaf); src is consumed, perm comes back
def CK.gatherf.f(src: CH.CF, perm: Array<U32>, +n: U32, +g: Nat) -> CH.CF & Array<U32>:
  CK.gatherf.f.b(n, g, perm, CH.CF.depth(src))

def CK.gatherf.s.c(+n: U32, +g: Nat, r: Array<String> & Array<U32>) -> CH.CS & Array<U32>:
  (o, perm) = r
  (CH.CS.of(n, K.Kernel.depth_for(U32.max(n, 1)), g, o), perm)

def CK.gatherf.s.b(+n: U32, +g: Nat, perm: Array<U32>, r: CH.CS & Nat) -> CH.CS & Array<U32>:
  (t, +dd) = r
  CK.gatherf.s.c(n, g, K.Kernel.gather(~String, n, K.Kernel.depth_for(U32.max(n, 1)), CH.CS.to_flat(dd, t), perm, ""))

# out row j = src row perm[j] for j < n, chunked at grain 2^g: the source flattened (a one-leaf tree is
# moved), today's Kernel.gather into a flat buffer, then the builder (a range copy per leaf; at most 2^g
# rows: the buffer itself is the one leaf); src is consumed, perm comes back
def CK.gatherf.s(src: CH.CS, perm: Array<U32>, +n: U32, +g: Nat) -> CH.CS & Array<U32>:
  CK.gatherf.s.b(n, g, perm, CH.CS.depth(src))

# the fused leaf gather: out[k] = src[perm[off + k]] for k < n into a fresh array of 2^d slots; src and perm
# are handed back (one flat buffer and one permutation feed every leaf of the build)

type RGW is Type:
  RGW{out: Array<U32>, src: Array<U32>, perm: Array<U32>}

def CK.rg.w.go(f: Nat, +k: U32, +off: U32, so: Array<U32> & Array<U32>, r: Array<U32> & U32) -> RGW:
  match f:
    case 0n:
      (src, out) = so
      (perm, i) = r
      RGW{out, src, perm}
    case 1n+p:
      (src, out) = so
      (perm, i) = r
      +j = U32.inc(k)
      CK.rg.w.go(p, j, off, K.Kernel.gather.put(~U32, out, k, Array.get(U32, src, i)), Array.get(U32, perm, U32.add(off, j)))

def CK.rg.w(+n: U32, +d: Nat, +off: U32, src: Array<U32>, perm: Array<U32>) -> RGW:
  CK.rg.w.go(U32.to_nat(n), 0, off, (src, Array.new(U32, d, 0)), Array.get(U32, perm, U32.add(off, 0)))

# the build loop (CW.of's binary counter and read-ahead): r is the gather of the current leaf (rows off ..
# off + 2^g when `more`, else off .. n); the next leaf's gather is made in the recursive call's arguments
def CK.gather.w.go(f: Nat, more: Bool, +i: U32, +off: U32, +n: U32, +g: Nat, s: CH.CWS, r: RGW) -> CH.CWS & Array<U32>:
  match f more r:
    case _ False{} RGW{out, src, perm}:
      (CH.CWS.push(i, U32.sub(n, off), CH.WL{U32.sub(n, off), g, out}, s), perm)
    case 0n True{} RGW{out, src, perm}:
      (CH.CWS.push(i, U32.shln(1, g), CH.WL{U32.shln(1, g), g, out}, s), perm)
    case 1n+p True{} RGW{out, src, perm}:
      +o2 = U32.add(off, U32.shln(1, g))
      +more2 = U32.is_lt(U32.shln(1, g), U32.sub(n, o2))
      CK.gather.w.go(p, more2, U32.inc(i), o2, n, g, CH.CWS.push(i, U32.shln(1, g), CH.WL{U32.shln(1, g), g, out}, s), CK.rg.w(Bool.pick(U32, more2, U32.shln(1, g), U32.sub(n, o2)), g, o2, src, perm))

def CK.gather.w.fin(r: CH.CWS & Array<U32>) -> CH.CW & Array<U32>:
  (s, perm) = r
  (CH.CWS.collapse(s), perm)

def CK.gather.w.small(+n: U32, r: RGW) -> CH.CW & Array<U32>:
  match r:
    case RGW{out, src, perm}:
      (CH.WL{n, K.Kernel.depth_for(U32.max(n, 1)), out}, perm)

def CK.gather.w.k(small: Bool, +n: U32, +g: Nat, src: Array<U32>, perm: Array<U32>) -> CH.CW & Array<U32>:
  match small:
    case True{}:
      CK.gather.w.small(n, CK.rg.w(n, K.Kernel.depth_for(U32.max(n, 1)), 0, src, perm))
    case False{}:
      +more = U32.is_lt(U32.shln(1, g), n)
      CK.gather.w.fin(CK.gather.w.go(U32.to_nat(U32.shrn(n, g)), more, 0, 0, n, g, CH.CWNil{}, CK.rg.w(Bool.pick(U32, more, U32.shln(1, g), n), g, 0, src, perm)))

def CK.gather.w.b(+n: U32, +g: Nat, perm: Array<U32>, r: CH.CW & Nat) -> CH.CW & Array<U32>:
  (t, +dd) = r
  CK.gather.w.k(U32.is_le(n, U32.shln(1, g)), n, g, CH.CW.to_flat(dd, t), perm)

# out row j = src row perm[j] for j < n, chunked at grain 2^g, the gather fused into the build: the source
# flattened once (a one-leaf tree is moved), each output leaf gathered straight from it (no flat output,
# no range copy); src is consumed, perm comes back
def CK.gather.w(src: CH.CW, perm: Array<U32>, +n: U32, +g: Nat) -> CH.CW & Array<U32>:
  CK.gather.w.b(n, g, perm, CH.CW.depth(src))

type RGF is Type:
  RGF{out: Array<F32>, src: Array<F32>, perm: Array<U32>}

def CK.rg.f.go(f: Nat, +k: U32, +off: U32, so: Array<F32> & Array<F32>, r: Array<U32> & U32) -> RGF:
  match f:
    case 0n:
      (src, out) = so
      (perm, i) = r
      RGF{out, src, perm}
    case 1n+p:
      (src, out) = so
      (perm, i) = r
      +j = U32.inc(k)
      CK.rg.f.go(p, j, off, K.Kernel.gather.put(~F32, out, k, Array.get(F32, src, i)), Array.get(U32, perm, U32.add(off, j)))

def CK.rg.f(+n: U32, +d: Nat, +off: U32, src: Array<F32>, perm: Array<U32>) -> RGF:
  CK.rg.f.go(U32.to_nat(n), 0, off, (src, Array.new(F32, d, 0.0)), Array.get(U32, perm, U32.add(off, 0)))

# the build loop (CW.of's binary counter and read-ahead): r is the gather of the current leaf (rows off ..
# off + 2^g when `more`, else off .. n); the next leaf's gather is made in the recursive call's arguments
def CK.gather.f.go(f: Nat, more: Bool, +i: U32, +off: U32, +n: U32, +g: Nat, s: CH.CFS, r: RGF) -> CH.CFS & Array<U32>:
  match f more r:
    case _ False{} RGF{out, src, perm}:
      (CH.CFS.push(i, U32.sub(n, off), CH.FL{U32.sub(n, off), g, out}, s), perm)
    case 0n True{} RGF{out, src, perm}:
      (CH.CFS.push(i, U32.shln(1, g), CH.FL{U32.shln(1, g), g, out}, s), perm)
    case 1n+p True{} RGF{out, src, perm}:
      +o2 = U32.add(off, U32.shln(1, g))
      +more2 = U32.is_lt(U32.shln(1, g), U32.sub(n, o2))
      CK.gather.f.go(p, more2, U32.inc(i), o2, n, g, CH.CFS.push(i, U32.shln(1, g), CH.FL{U32.shln(1, g), g, out}, s), CK.rg.f(Bool.pick(U32, more2, U32.shln(1, g), U32.sub(n, o2)), g, o2, src, perm))

def CK.gather.f.fin(r: CH.CFS & Array<U32>) -> CH.CF & Array<U32>:
  (s, perm) = r
  (CH.CFS.collapse(s), perm)

def CK.gather.f.small(+n: U32, r: RGF) -> CH.CF & Array<U32>:
  match r:
    case RGF{out, src, perm}:
      (CH.FL{n, K.Kernel.depth_for(U32.max(n, 1)), out}, perm)

def CK.gather.f.k(small: Bool, +n: U32, +g: Nat, src: Array<F32>, perm: Array<U32>) -> CH.CF & Array<U32>:
  match small:
    case True{}:
      CK.gather.f.small(n, CK.rg.f(n, K.Kernel.depth_for(U32.max(n, 1)), 0, src, perm))
    case False{}:
      +more = U32.is_lt(U32.shln(1, g), n)
      CK.gather.f.fin(CK.gather.f.go(U32.to_nat(U32.shrn(n, g)), more, 0, 0, n, g, CH.CFNil{}, CK.rg.f(Bool.pick(U32, more, U32.shln(1, g), n), g, 0, src, perm)))

def CK.gather.f.b(+n: U32, +g: Nat, perm: Array<U32>, r: CH.CF & Nat) -> CH.CF & Array<U32>:
  (t, +dd) = r
  CK.gather.f.k(U32.is_le(n, U32.shln(1, g)), n, g, CH.CF.to_flat(dd, t), perm)

# out row j = src row perm[j] for j < n, chunked at grain 2^g, the gather fused into the build: the source
# flattened once (a one-leaf tree is moved), each output leaf gathered straight from it (no flat output,
# no range copy); src is consumed, perm comes back
def CK.gather.f(src: CH.CF, perm: Array<U32>, +n: U32, +g: Nat) -> CH.CF & Array<U32>:
  CK.gather.f.b(n, g, perm, CH.CF.depth(src))

type RGS is Type:
  RGS{out: Array<String>, src: Array<String>, perm: Array<U32>}

def CK.rg.s.go(f: Nat, +k: U32, +off: U32, so: Array<String> & Array<String>, r: Array<U32> & U32) -> RGS:
  match f:
    case 0n:
      (src, out) = so
      (perm, i) = r
      RGS{out, src, perm}
    case 1n+p:
      (src, out) = so
      (perm, i) = r
      +j = U32.inc(k)
      CK.rg.s.go(p, j, off, K.Kernel.gather.put(~String, out, k, Array.get(String, src, i)), Array.get(U32, perm, U32.add(off, j)))

def CK.rg.s(+n: U32, +d: Nat, +off: U32, src: Array<String>, perm: Array<U32>) -> RGS:
  CK.rg.s.go(U32.to_nat(n), 0, off, (src, Array.new(String, d, "")), Array.get(U32, perm, U32.add(off, 0)))

# the build loop (CW.of's binary counter and read-ahead): r is the gather of the current leaf (rows off ..
# off + 2^g when `more`, else off .. n); the next leaf's gather is made in the recursive call's arguments
def CK.gather.s.go(f: Nat, more: Bool, +i: U32, +off: U32, +n: U32, +g: Nat, s: CH.CSS, r: RGS) -> CH.CSS & Array<U32>:
  match f more r:
    case _ False{} RGS{out, src, perm}:
      (CH.CSS.push(i, U32.sub(n, off), CH.SL{U32.sub(n, off), g, out}, s), perm)
    case 0n True{} RGS{out, src, perm}:
      (CH.CSS.push(i, U32.shln(1, g), CH.SL{U32.shln(1, g), g, out}, s), perm)
    case 1n+p True{} RGS{out, src, perm}:
      +o2 = U32.add(off, U32.shln(1, g))
      +more2 = U32.is_lt(U32.shln(1, g), U32.sub(n, o2))
      CK.gather.s.go(p, more2, U32.inc(i), o2, n, g, CH.CSS.push(i, U32.shln(1, g), CH.SL{U32.shln(1, g), g, out}, s), CK.rg.s(Bool.pick(U32, more2, U32.shln(1, g), U32.sub(n, o2)), g, o2, src, perm))

def CK.gather.s.fin(r: CH.CSS & Array<U32>) -> CH.CS & Array<U32>:
  (s, perm) = r
  (CH.CSS.collapse(s), perm)

def CK.gather.s.small(+n: U32, r: RGS) -> CH.CS & Array<U32>:
  match r:
    case RGS{out, src, perm}:
      (CH.SL{n, K.Kernel.depth_for(U32.max(n, 1)), out}, perm)

def CK.gather.s.k(small: Bool, +n: U32, +g: Nat, src: Array<String>, perm: Array<U32>) -> CH.CS & Array<U32>:
  match small:
    case True{}:
      CK.gather.s.small(n, CK.rg.s(n, K.Kernel.depth_for(U32.max(n, 1)), 0, src, perm))
    case False{}:
      +more = U32.is_lt(U32.shln(1, g), n)
      CK.gather.s.fin(CK.gather.s.go(U32.to_nat(U32.shrn(n, g)), more, 0, 0, n, g, CH.CSNil{}, CK.rg.s(Bool.pick(U32, more, U32.shln(1, g), n), g, 0, src, perm)))

def CK.gather.s.b(+n: U32, +g: Nat, perm: Array<U32>, r: CH.CS & Nat) -> CH.CS & Array<U32>:
  (t, +dd) = r
  CK.gather.s.k(U32.is_le(n, U32.shln(1, g)), n, g, CH.CS.to_flat(dd, t), perm)

# out row j = src row perm[j] for j < n, chunked at grain 2^g, the gather fused into the build: the source
# flattened once (a one-leaf tree is moved), each output leaf gathered straight from it (no flat output,
# no range copy); src is consumed, perm comes back
def CK.gather.s(src: CH.CS, perm: Array<U32>, +n: U32, +g: Nat) -> CH.CS & Array<U32>:
  CK.gather.s.b(n, g, perm, CH.CS.depth(src))
