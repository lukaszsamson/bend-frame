      CPC{CH.WN{r1, l1, m1, m2}, U32.add(k1, k2), CH.WN{r1, l1, a1, a2}, CH.WN{r2, l2, va1, va2}, CH.FN{r3, l3, b1, b2}, CH.WN{r4, l4, vb1, vb2}}

