def CK.zipb.www.l(+n: U32, +dd: Nat, +d: Nat, +n2: U32, +d2: Nat, r: K.ZB<U32, U32, U32>) -> CZB<CH.CW, CH.CW, CH.CW>:
  match r:
    case K.ZB{o, xa, xb}:
      CZB{CH.WL{n, dd, o}, CH.WL{n, d, xa}, CH.WL{n2, d2, xb}}

def CK.zipb.www.j(+rows: U32, +lrows: U32, +rows2: U32, +lrows2: U32, x: CZB<CH.CW, CH.CW, CH.CW>, y: CZB<CH.CW, CH.CW, CH.CW>) -> CZB<CH.CW, CH.CW, CH.CW>:
  match x y:
    case CZB{o1, a1, b1} CZB{o2, a2, b2}:
      CZB{CH.WN{rows, lrows, o1, o2}, CH.WN{rows, lrows, a1, a2}, CH.WN{rows2, lrows2, b1, b2}}

# F1/F3: out = f(a, b) per row, both trees BORROWED (each handed back with its own counts); a mismatch
# answers an empty output and the operands
def CK.zipb.www(~f: U32 -> U32 -> U32, a: CH.CW, b: CH.CW, +z: U32) -> CZB<CH.CW, CH.CW, CH.CW>:
  match a b:
    case CH.WL{+n, +d, xa} CH.WL{+n2, +d2, xb}:
      +dd = CK.dmax(d, d2)
      CK.zipb.www.l(n, dd, d, n2, d2, K.Kernel.zipb(~U32, ~U32, ~U32, ~f, n, dd, xa, xb, z))
    case CH.WN{+rows, +lrows, l1, r1} CH.WN{+rows2, +lrows2, l2, r2}:
      x y = CK.zipb.www(~f, l1, l2, z) CK.zipb.www(~f, r1, r2, z)
      CK.zipb.www.j(rows, lrows, rows2, lrows2, x, y)
    case a b:
      CZB{CH.CW.empty(), a, b}

