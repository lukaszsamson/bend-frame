  match r:
    case K.PC{m, +k, xa, xva, xb, xvb}:
      CPC{CH.WL{n, dd, m}, k, CH.WL{n, d, xa}, CH.WL{na, da, xva}, CH.FL{nb, db, xb}, CH.WL{nc, dc, xvb}}

def CK.pc.wf.j(+r1: U32, +l1: U32, +r2: U32, +l2: U32, +r3: U32, +l3: U32, +r4: U32, +l4: U32, x: CPC<CH.CW, CH.CF>, y: CPC<CH.CW, CH.CF>) -> CPC<CH.CW, CH.CF>:
  match x y:
