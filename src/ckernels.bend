# src/ckernels.bend -- the chunked kernel wrappers of the v0.2 engine (plans/M_02.txt W5 / D1, D3, D4;
# DESIGN.md 16.1, 16.3, 16.4). GENERATED by bench/w5/gen_ckernels.py: edit the generator, not this file.
# No executor wiring here (T5.3 writes the chunked runner, src/cexec.bend).
#
# Every wrapper is a recursion over the WN / FN / SN nodes of src/chunks.bend's trees with ONE balanced
# parallel let per node (`x y = k(left) k(right)`: both halves have the rows of their subtree) and the
# EXISTING flat kernel of src/kernels.bend at each leaf (AGENT_BRIEF_M2 rule 3: no Array is split by its
# ANode, no Array.fork, the leaf runs today's flat loop). A column of at most 2^G rows is one leaf
# (src/chunks.bend), so it runs exactly today's flat kernel with no fork. Wrappers over several trees walk
# them in LOCKSTEP: the trees of one frame share the partition (WFCFrame, checked once at the executor
# boundary by CFrame.check); a shape mismatch, which WFCFrame excludes, answers an empty output and hands
# the inputs back unchanged.
#
#   CK.map.XY / CK.mapp.XY       consuming maps (Kernel.map / Kernel.map_p at the leaf)
#   CK.mappb.XY                  F1: the borrowing map with a scalar (Kernel.map_pb): (out, input)
#   CK.zip.XYZ                   consuming zip (Kernel.zip)
#   CK.zipb.XYZ                  F1/F3: the borrowing zip (Kernel.zipb): CZB{o, a, b}
#   CK.zipv.XYZ                  F2: the null-propagating zip with validity (Kernel.zipv): CZV{o, vo, a, va, b, vb}
#   CK.pc.XY                     F5: predicate mask + kept count (Kernel.pred_count), counts added at the nodes
#   CK.ck.X                      per-leaf compaction of one buffer by a mask tree (Kernel.compact_keep, the
#                                kept count by Kernel.popcount of the leaf mask)
#   CK.c3.XYZ / CK.c4.XYZV       F6: per-leaf compaction of 3 / 4 aligned buffers by one mask, one cursor
#                                (Kernel.compact3 / compact4); the kept count is the cursor
#   CK.fold.w (CK.sum / popcount / min / max)   U32 tree reductions: per-leaf Kernel.fold, combined at the
#                                nodes (U32.add / U32.min / U32.max: LAWS section 22 proves the combines)
#   CK.walk.X                    sequential in-order folds (the D4 rows-in-order reductions: F32 sums,
#                                F32 / I32 min / max): the leaves listed in order, ONE tail loop folds them
#   CK.fsum.X / CK.fsumflat.X    the F32 Neumaier sum in row order: in-order walk / flatten-then-fold
#   CK.gather.X / CK.gatherf.X   outputs built fresh from a flat permutation (sort / join / head outputs)
#   CK.ones1                     an AllValid side as a tree of 1-slot ones leaves (the flat kernels' AllValid
#                                convention per leaf: reads wrap to slot 0; never written)
#
# Compaction (DESIGN.md 16.1): each leaf compacts into a leaf of the SAME capacity 2^d (d = the mask
# leaf's depth): the branchless write lands at the cursor k <= i < n <= 2^d, so no kept + 1 slot is needed
# (LAWS section 21 croom_of_cap; section 22 uses it at every leaf). Ragged outputs keep d; the caller runs
# CFrame.rebalance after a row-dropping operator (decided by row counts only, so every tree of the frame
# takes the same shape).
#
# Idioms (DESIGN.md section 9, IMPLEMENTING.md W0 / T5.1): helpers above callers; a pair or record a
# kernel answers is opened in a helper's parameters (R3); the two lanes of a parallel let are joined by a
# non-recursive helper; a template ~f is passed through unchanged; no per-row allocation (the leaf loops
# are the flat kernels' spin loops; per leaf a wrapper allocates its leaf constructors and the kernel's
# answer record, per node one node constructor per tree and the join record).
import Base
import ./kernels.bend as K
import ./chunks.bend as CH

# the output depth of a leaf over two operands: the larger of the two (an operand may be a 1-slot literal
# or AllValid leaf of depth 0, as the flat kernels' convention allows; a real operand's n <= 2^d then
# bounds the output's rows)
def CK.dmax(+a: Nat, +b: Nat) -> Nat:
  Bool.pick(Nat, Nat.is_le(a, b), b, a)

# ==== answer records (the trees a borrowing wrapper hands back, beside its outputs) ====

# a borrowing zip: the output and both operands
type CZB<-A: Type, -B: Type, -C: Type> is Type:
  CZB{o: C, a: A, b: B}

# a validity zip: value and validity outputs, both operands with their validity trees
type CZV<-A: Type, -B: Type, -C: Type> is Type:
  CZV{o: C, vo: CH.CW, a: A, va: CH.CW, b: B, vb: CH.CW}

# a predicate: the 0/1 keep mask tree, the kept count, the borrowed operands
type CPC<-A: Type, -B: Type> is Type:
  CPC{m: CH.CW, k: U32, a: A, va: CH.CW, b: B, vb: CH.CW}

# a one-buffer compaction: the output, the mask handed back, the kept count
type CC1<-A: Type> is Type:
  CC1{o: A, m: CH.CW, k: U32}

# a 3- / 4-buffer compaction: the outputs, the mask and the inputs handed back, the kept count
type CC3<-A: Type, -B: Type, -C: Type> is Type:
  CC3{o1: A, o2: B, o3: C, m: CH.CW, a1: A, a2: B, a3: C, k: U32}

type CC4<-A: Type, -B: Type, -C: Type, -D: Type> is Type:
  CC4{o1: A, o2: B, o3: C, o4: D, m: CH.CW, a1: A, a2: B, a3: C, a4: D, k: U32}

# ==== maps: consuming (Kernel.map, Kernel.map_p) and borrowing with a scalar (Kernel.map_pb, F1) ====

# out = f(a) per row, consuming the tree; the shape and counts are copied
def CK.map.ww(~f: U32 -> U32, t: CH.CW, +z: U32) -> CH.CW:
  match t:
    case CH.WL{+n, +d, a}:
      CH.WL{n, d, K.Kernel.map(~U32, ~U32, ~f, n, d, a, z)}
    case CH.WN{rows, lrows, l, r}:
      x y = CK.map.ww(~f, l, z) CK.map.ww(~f, r, z)
      CH.WN{rows, lrows, x, y}

# out = f(a) per row, consuming the tree; the shape and counts are copied
def CK.map.wf(~f: U32 -> F32, t: CH.CW, +z: F32) -> CH.CF:
  match t:
    case CH.WL{+n, +d, a}:
      CH.FL{n, d, K.Kernel.map(~U32, ~F32, ~f, n, d, a, z)}
    case CH.WN{rows, lrows, l, r}:
      x y = CK.map.wf(~f, l, z) CK.map.wf(~f, r, z)
      CH.FN{rows, lrows, x, y}

# out = f(a) per row, consuming the tree; the shape and counts are copied
def CK.map.fw(~f: F32 -> U32, t: CH.CF, +z: U32) -> CH.CW:
  match t:
    case CH.FL{+n, +d, a}:
      CH.WL{n, d, K.Kernel.map(~F32, ~U32, ~f, n, d, a, z)}
    case CH.FN{rows, lrows, l, r}:
      x y = CK.map.fw(~f, l, z) CK.map.fw(~f, r, z)
      CH.WN{rows, lrows, x, y}

# out = f(a) per row, consuming the tree; the shape and counts are copied
def CK.map.ff(~f: F32 -> F32, t: CH.CF, +z: F32) -> CH.CF:
  match t:
    case CH.FL{+n, +d, a}:
      CH.FL{n, d, K.Kernel.map(~F32, ~F32, ~f, n, d, a, z)}
    case CH.FN{rows, lrows, l, r}:
      x y = CK.map.ff(~f, l, z) CK.map.ff(~f, r, z)
      CH.FN{rows, lrows, x, y}

# out = f(p, a) per row (a Data parameter every leaf sees), consuming the tree
def CK.mapp.ww(~P: Data, ~f: P -> U32 -> U32, t: CH.CW, +p: P, +z: U32) -> CH.CW:
  match t:
    case CH.WL{+n, +d, a}:
      CH.WL{n, d, K.Kernel.map_p(~U32, ~P, ~U32, ~f, n, d, a, p, z)}
    case CH.WN{rows, lrows, l, r}:
      x y = CK.mapp.ww(~P, ~f, l, p, z) CK.mapp.ww(~P, ~f, r, p, z)
      CH.WN{rows, lrows, x, y}

# out = f(p, a) per row (a Data parameter every leaf sees), consuming the tree
def CK.mapp.wf(~P: Data, ~f: P -> U32 -> F32, t: CH.CW, +p: P, +z: F32) -> CH.CF:
  match t:
    case CH.WL{+n, +d, a}:
      CH.FL{n, d, K.Kernel.map_p(~U32, ~P, ~F32, ~f, n, d, a, p, z)}
    case CH.WN{rows, lrows, l, r}:
      x y = CK.mapp.wf(~P, ~f, l, p, z) CK.mapp.wf(~P, ~f, r, p, z)
      CH.FN{rows, lrows, x, y}

# out = f(p, a) per row (a Data parameter every leaf sees), consuming the tree
def CK.mapp.fw(~P: Data, ~f: P -> F32 -> U32, t: CH.CF, +p: P, +z: U32) -> CH.CW:
  match t:
    case CH.FL{+n, +d, a}:
      CH.WL{n, d, K.Kernel.map_p(~F32, ~P, ~U32, ~f, n, d, a, p, z)}
    case CH.FN{rows, lrows, l, r}:
      x y = CK.mapp.fw(~P, ~f, l, p, z) CK.mapp.fw(~P, ~f, r, p, z)
      CH.WN{rows, lrows, x, y}

# out = f(p, a) per row (a Data parameter every leaf sees), consuming the tree
def CK.mapp.ff(~P: Data, ~f: P -> F32 -> F32, t: CH.CF, +p: P, +z: F32) -> CH.CF:
  match t:
    case CH.FL{+n, +d, a}:
      CH.FL{n, d, K.Kernel.map_p(~F32, ~P, ~F32, ~f, n, d, a, p, z)}
    case CH.FN{rows, lrows, l, r}:
      x y = CK.mapp.ff(~P, ~f, l, p, z) CK.mapp.ff(~P, ~f, r, p, z)
      CH.FN{rows, lrows, x, y}

def CK.mappb.ww.l(+n: U32, +d: Nat, r: Array<U32> & Array<U32>) -> CH.CW & CH.CW:
  (o, a) = r
  (CH.WL{n, d, o}, CH.WL{n, d, a})

def CK.mappb.ww.j(+rows: U32, +lrows: U32, x: CH.CW & CH.CW, y: CH.CW & CH.CW) -> CH.CW & CH.CW:
  (o1, a1) = x
  (o2, a2) = y
  (CH.WN{rows, lrows, o1, o2}, CH.WN{rows, lrows, a1, a2})

# F1: out = f(p, a) per row, the tree BORROWED: answers (out, t) with t unchanged
def CK.mappb.ww(~P: Data, ~f: P -> U32 -> U32, t: CH.CW, +p: P, +z: U32) -> CH.CW & CH.CW:
  match t:
    case CH.WL{+n, +d, a}:
      CK.mappb.ww.l(n, d, K.Kernel.map_pb(~U32, ~P, ~U32, ~f, n, d, a, p, z))
    case CH.WN{+rows, +lrows, l, r}:
      x y = CK.mappb.ww(~P, ~f, l, p, z) CK.mappb.ww(~P, ~f, r, p, z)
      CK.mappb.ww.j(rows, lrows, x, y)

def CK.mappb.wf.l(+n: U32, +d: Nat, r: Array<F32> & Array<U32>) -> CH.CF & CH.CW:
  (o, a) = r
  (CH.FL{n, d, o}, CH.WL{n, d, a})

def CK.mappb.wf.j(+rows: U32, +lrows: U32, x: CH.CF & CH.CW, y: CH.CF & CH.CW) -> CH.CF & CH.CW:
  (o1, a1) = x
  (o2, a2) = y
  (CH.FN{rows, lrows, o1, o2}, CH.WN{rows, lrows, a1, a2})

# F1: out = f(p, a) per row, the tree BORROWED: answers (out, t) with t unchanged
def CK.mappb.wf(~P: Data, ~f: P -> U32 -> F32, t: CH.CW, +p: P, +z: F32) -> CH.CF & CH.CW:
  match t:
    case CH.WL{+n, +d, a}:
      CK.mappb.wf.l(n, d, K.Kernel.map_pb(~U32, ~P, ~F32, ~f, n, d, a, p, z))
    case CH.WN{+rows, +lrows, l, r}:
      x y = CK.mappb.wf(~P, ~f, l, p, z) CK.mappb.wf(~P, ~f, r, p, z)
      CK.mappb.wf.j(rows, lrows, x, y)

def CK.mappb.fw.l(+n: U32, +d: Nat, r: Array<U32> & Array<F32>) -> CH.CW & CH.CF:
  (o, a) = r
  (CH.WL{n, d, o}, CH.FL{n, d, a})

def CK.mappb.fw.j(+rows: U32, +lrows: U32, x: CH.CW & CH.CF, y: CH.CW & CH.CF) -> CH.CW & CH.CF:
  (o1, a1) = x
  (o2, a2) = y
  (CH.WN{rows, lrows, o1, o2}, CH.FN{rows, lrows, a1, a2})

# F1: out = f(p, a) per row, the tree BORROWED: answers (out, t) with t unchanged
def CK.mappb.fw(~P: Data, ~f: P -> F32 -> U32, t: CH.CF, +p: P, +z: U32) -> CH.CW & CH.CF:
  match t:
    case CH.FL{+n, +d, a}:
      CK.mappb.fw.l(n, d, K.Kernel.map_pb(~F32, ~P, ~U32, ~f, n, d, a, p, z))
    case CH.FN{+rows, +lrows, l, r}:
      x y = CK.mappb.fw(~P, ~f, l, p, z) CK.mappb.fw(~P, ~f, r, p, z)
      CK.mappb.fw.j(rows, lrows, x, y)

def CK.mappb.ff.l(+n: U32, +d: Nat, r: Array<F32> & Array<F32>) -> CH.CF & CH.CF:
  (o, a) = r
  (CH.FL{n, d, o}, CH.FL{n, d, a})

def CK.mappb.ff.j(+rows: U32, +lrows: U32, x: CH.CF & CH.CF, y: CH.CF & CH.CF) -> CH.CF & CH.CF:
  (o1, a1) = x
  (o2, a2) = y
  (CH.FN{rows, lrows, o1, o2}, CH.FN{rows, lrows, a1, a2})

# F1: out = f(p, a) per row, the tree BORROWED: answers (out, t) with t unchanged
def CK.mappb.ff(~P: Data, ~f: P -> F32 -> F32, t: CH.CF, +p: P, +z: F32) -> CH.CF & CH.CF:
  match t:
    case CH.FL{+n, +d, a}:
      CK.mappb.ff.l(n, d, K.Kernel.map_pb(~F32, ~P, ~F32, ~f, n, d, a, p, z))
    case CH.FN{+rows, +lrows, l, r}:
      x y = CK.mappb.ff(~P, ~f, l, p, z) CK.mappb.ff(~P, ~f, r, p, z)
      CK.mappb.ff.j(rows, lrows, x, y)

# ==== zips over two aligned trees: consuming (Kernel.zip), borrowing (Kernel.zipb, F1/F3), with validity (Kernel.zipv, F2) ====

# out = f(a, b) per row, both trees consumed (lockstep; a's counts, the larger leaf depth); a mismatch
# answers empty
def CK.zip.www(~f: U32 -> U32 -> U32, a: CH.CW, b: CH.CW, +z: U32) -> CH.CW:
  match a b:
    case CH.WL{+n, +d, xa} CH.WL{n2, +d2, xb}:
      +dd = CK.dmax(d, d2)
      CH.WL{n, dd, K.Kernel.zip(~U32, ~U32, ~U32, ~f, n, dd, xa, xb, z)}
    case CH.WN{rows, lrows, l1, r1} CH.WN{rows2, lrows2, l2, r2}:
      x y = CK.zip.www(~f, l1, l2, z) CK.zip.www(~f, r1, r2, z)
      CH.WN{rows, lrows, x, y}
    case a b:
      CH.CW.empty()

# out = f(a, b) per row, both trees consumed (lockstep; a's counts, the larger leaf depth); a mismatch
# answers empty
def CK.zip.wwf(~f: U32 -> U32 -> F32, a: CH.CW, b: CH.CW, +z: F32) -> CH.CF:
  match a b:
    case CH.WL{+n, +d, xa} CH.WL{n2, +d2, xb}:
      +dd = CK.dmax(d, d2)
      CH.FL{n, dd, K.Kernel.zip(~U32, ~U32, ~F32, ~f, n, dd, xa, xb, z)}
    case CH.WN{rows, lrows, l1, r1} CH.WN{rows2, lrows2, l2, r2}:
      x y = CK.zip.wwf(~f, l1, l2, z) CK.zip.wwf(~f, r1, r2, z)
      CH.FN{rows, lrows, x, y}
    case a b:
      CH.CF.empty()

# out = f(a, b) per row, both trees consumed (lockstep; a's counts, the larger leaf depth); a mismatch
# answers empty
def CK.zip.wfw(~f: U32 -> F32 -> U32, a: CH.CW, b: CH.CF, +z: U32) -> CH.CW:
  match a b:
    case CH.WL{+n, +d, xa} CH.FL{n2, +d2, xb}:
      +dd = CK.dmax(d, d2)
      CH.WL{n, dd, K.Kernel.zip(~U32, ~F32, ~U32, ~f, n, dd, xa, xb, z)}
    case CH.WN{rows, lrows, l1, r1} CH.FN{rows2, lrows2, l2, r2}:
      x y = CK.zip.wfw(~f, l1, l2, z) CK.zip.wfw(~f, r1, r2, z)
      CH.WN{rows, lrows, x, y}
    case a b:
