# the node: the operand record r (Fail refuted), then the dtype rule
def strpred_ana(+op: X.StrPredOp, +p: String, +e2: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  r: E.Res(A.Ana), +er: {A.Expr.analyse(e2, s) == r : E.Res(A.Ana)}, ha: {A.Ana.strpred(op, r) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, ih: IH(e2, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.IStr{op, p} <> acc)):
  match r:
    case Fail{e}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.IStr{op, p} <> acc)), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{A.Ana{+t2, +rs2, +k2, +tot2, +loc2}}:
      strpred_ana_k(op, p, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, t2, rs2, k2, tot2, loc2, X.Expr.type.strpred.ok(op, t2), {==}, er, ha, ih)

# ---- Col: ICol clones the column the schema names (get_cloned_typed) ------------------------------------

def col_fin(+n: String, +h: U32, +acc: List<&2, V.Instr>, -f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, ev: Laws.StkTy(h, sh, stk), +t2: D.DType, w: Laws.GetW(f, n, h, t2)) -> Laws.RunW(h, t2, V.KFull{}, True{}, f, sh, stk, acc, V.ICol{n} <> acc):
  (f2, c, eg, ef, ty) = w
  %Equal.sym(C.Frame & E.ResT(C.Column), C.Frame.get_cloned(f, n), (f2, Done{c}), eg) : &st: V.EvSt -> {V.Eval.run(acc, h, V.Eval.push_col(stk, _)) == V.Eval.run(acc, h, st) : V.EvSt} & Laws.RunTy(h, t2, V.KFull{}, True{}, f, sh, st)
  (V.EvSt{f2, Done{V.Slot{V.KFull{}, c} <> stk}}, {==}, ef, {==}, ty, ev)

def col_ana(+n: String, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  m: Maybe<&2, D.DType>, +em: {S.Schema.find(s, n) == m : Maybe<&2, D.DType>}, ha: {A.Ana.col(n, m) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)})
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.ICol{n} <> acc):
  match m:
    case None{}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.ICol{n} <> acc), L.fail_done(A.Ana, E.ColumnNotFound{n}, A.Ana{t, rs, k, tot, loc}, ha))
    case Some{+t2}:
      +ea = L.done_inj(A.Ana, A.Ana{t2, n <> Nil{}, A.KRow{}, True{}, True{}}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(t2, n <> Nil{}, A.KRow{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.ICol{n} <> acc)
      %ana_tot_inj(t2, n <> Nil{}, A.KRow{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, V.KFull{}, _, f, sh, stk, acc, V.ICol{n} <> acc)
      %ana_t_inj(t2, n <> Nil{}, A.KRow{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, _, V.KFull{}, True{}, f, sh, stk, acc, V.ICol{n} <> acc)
      col_fin(n, h, acc, f, stk, sh, ev, t2, Laws.get_cloned_typed(f, n, h, t2, hf, (%Equal.sym(List<&2, S.Field>, Laws.fschema(f), s, hs) : {S.Schema.find(_, n) == Some{t2} : Maybe<&2, D.DType>}; em)))

# ---- Lit: IConst pushes a one-row literal slot (unit_typed) ----------------------------------------------

def lit_ana(+v: D.Scalar, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  ha: {A.Ana.lit(v) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}) -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile.lit(v) <> acc):
  match v:
    case D.SNull{}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile.lit(D.SNull{}) <> acc), L.fail_done(A.Ana, E.TypeMismatch{"lit", "a typed literal", "null"}, A.Ana{t, rs, k, tot, loc}, ha))
    case D.SBool{b}:
      +ea = L.done_inj(A.Ana, A.Ana{D.TBool{}, Nil{}, A.KScalar{}, True{}, True{}}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(D.TBool{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.Eval.compile.lit(D.SBool{b}) <> acc)
      %ana_tot_inj(D.TBool{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, V.KLit{}, _, f, sh, stk, acc, V.Eval.compile.lit(D.SBool{b}) <> acc)
      %ana_t_inj(D.TBool{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, _, V.KLit{}, True{}, f, sh, stk, acc, V.Eval.compile.lit(D.SBool{b}) <> acc)
      (V.EvSt{f, Done{V.Slot{V.KLit{}, V.Eval.unit(D.SBool{b}, D.TBool{})} <> stk}}, {==}, {==}, {==}, Laws.unit_typed(D.SBool{b}, D.TBool{}), ev)
    case D.SU32{x}:
      +ea = L.done_inj(A.Ana, A.Ana{D.TU32{}, Nil{}, A.KScalar{}, True{}, True{}}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(D.TU32{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.Eval.compile.lit(D.SU32{x}) <> acc)
      %ana_tot_inj(D.TU32{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, V.KLit{}, _, f, sh, stk, acc, V.Eval.compile.lit(D.SU32{x}) <> acc)
      %ana_t_inj(D.TU32{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, _, V.KLit{}, True{}, f, sh, stk, acc, V.Eval.compile.lit(D.SU32{x}) <> acc)
      (V.EvSt{f, Done{V.Slot{V.KLit{}, V.Eval.unit(D.SU32{x}, D.TU32{})} <> stk}}, {==}, {==}, {==}, Laws.unit_typed(D.SU32{x}, D.TU32{}), ev)
    case D.SI32{x}:
      +ea = L.done_inj(A.Ana, A.Ana{D.TI32{}, Nil{}, A.KScalar{}, True{}, True{}}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(D.TI32{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.Eval.compile.lit(D.SI32{x}) <> acc)
      %ana_tot_inj(D.TI32{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, V.KLit{}, _, f, sh, stk, acc, V.Eval.compile.lit(D.SI32{x}) <> acc)
      %ana_t_inj(D.TI32{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, _, V.KLit{}, True{}, f, sh, stk, acc, V.Eval.compile.lit(D.SI32{x}) <> acc)
      (V.EvSt{f, Done{V.Slot{V.KLit{}, V.Eval.unit(D.SI32{x}, D.TI32{})} <> stk}}, {==}, {==}, {==}, Laws.unit_typed(D.SI32{x}, D.TI32{}), ev)
    case D.SF32{x}:
      +ea = L.done_inj(A.Ana, A.Ana{D.TF32{}, Nil{}, A.KScalar{}, True{}, True{}}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(D.TF32{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.Eval.compile.lit(D.SF32{x}) <> acc)
      %ana_tot_inj(D.TF32{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, V.KLit{}, _, f, sh, stk, acc, V.Eval.compile.lit(D.SF32{x}) <> acc)
      %ana_t_inj(D.TF32{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, _, V.KLit{}, True{}, f, sh, stk, acc, V.Eval.compile.lit(D.SF32{x}) <> acc)
      (V.EvSt{f, Done{V.Slot{V.KLit{}, V.Eval.unit(D.SF32{x}, D.TF32{})} <> stk}}, {==}, {==}, {==}, Laws.unit_typed(D.SF32{x}, D.TF32{}), ev)
    case D.SStr{x}:
      +ea = L.done_inj(A.Ana, A.Ana{D.TStr{}, Nil{}, A.KScalar{}, True{}, True{}}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(D.TStr{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.Eval.compile.lit(D.SStr{x}) <> acc)
      %ana_tot_inj(D.TStr{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, V.KLit{}, _, f, sh, stk, acc, V.Eval.compile.lit(D.SStr{x}) <> acc)
      %ana_t_inj(D.TStr{}, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, _, V.KLit{}, True{}, f, sh, stk, acc, V.Eval.compile.lit(D.SStr{x}) <> acc)
      (V.EvSt{f, Done{V.Slot{V.KLit{}, V.Eval.unit(D.SStr{x}, D.TStr{})} <> stk}}, {==}, {==}, {==}, Laws.unit_typed(D.SStr{x}, D.TStr{}), ev)

# ---- Cast / TryCast: the typed null literal is an IConst; otherwise the operand then ICast / ITry -----

# the step for a strict cast: Eval.cast may fail exactly when the pair is fallible (eval_cast_typed)
def cast_stepc(+to: D.DType, +t2: D.DType, +k2: V.SKind, +h: U32, +tot2: Bool, hok: {X.Cast.ok(t2, to) == True{} : Bool}, c: C.Column, hc: Laws.ColTy(t2, Laws.klen(k2, h), c)) -> SResW(to, k2, Laws.klen(k2, h), Bool.and(tot2, X.Cast.total(t2, to)), V.Eval.do1(h, V.ICast{to}, k2, c)):
  (+ed, el) = hc
  wrap_w(k2, to, Laws.klen(k2, h), Bool.and(tot2, X.Cast.total(t2, to)), X.Cast.total(Laws.cdtype(c), to), V.Eval.cast(to, c), resw_len(X.Cast.total(Laws.cdtype(c), to), to, Laws.klen(k2, h), Laws.clen(c), V.Eval.cast(to, c), el, Laws.eval_cast_typed(to, c, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Cast.ok(_, to) == True{} : Bool}; hok))), x => (%ed : {Bool.and(tot2, X.Cast.total(_, to)) == False{} : Bool}; (%Equal.sym(Bool, X.Cast.total(Laws.cdtype(c), to), False{}, x) : {Bool.and(tot2, _) == False{} : Bool}; PV.and_false_r(tot2))))

# the step for try_cast: never fails on a castable pair
def trycast_stepc(+to: D.DType, +t2: D.DType, +k2: V.SKind, +h: U32, +tot2: Bool, hok: {X.Cast.ok(t2, to) == True{} : Bool}, c: C.Column, hc: Laws.ColTy(t2, Laws.klen(k2, h), c)) -> SResW(to, k2, Laws.klen(k2, h), tot2, V.Eval.do1(h, V.ITry{to}, k2, c)):
  (ed, el) = hc
  wrap_w(k2, to, Laws.klen(k2, h), tot2, True{}, V.Eval.try_cast(to, c), resw_len(True{}, to, Laws.klen(k2, h), Laws.clen(c), V.Eval.try_cast(to, c), el, Laws.eval_try_cast_typed(to, c, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Cast.ok(_, to) == True{} : Bool}; hok))), x => tot_true(tot2, x))

# a fallible operand makes the strict cast fallible
def cast_htot(+tot2: Bool, +t2: D.DType, +to: D.DType, x: {tot2 == False{} : Bool}) -> {Bool.and(tot2, X.Cast.total(t2, to)) == False{} : Bool}:
  %Equal.sym(Bool, tot2, False{}, x) : {Bool.and(_, X.Cast.total(t2, to)) == False{} : Bool}
  {==}

# the castability test answered ok: the record is (to, k2, Bool.and(tot2, X.Cast.total(t2, to))); run the operand and step
def cast_ana_k(+to: D.DType, +e2: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  +t2: D.DType, +rs2: List<&2, String>, +k2: A.AKind, +tot2: Bool, +loc2: Bool, ok: Bool, +eok: {X.Cast.ok(t2, to) == ok : Bool},
  +er: {A.Expr.analyse(e2, s) == Done{A.Ana{t2, rs2, k2, tot2, loc2}} : E.Res(A.Ana)}, ha: {A.Ana.mk(X.Expr.chk(ok, E.TypeMismatch{"cast", "castable to " ++ D.DType.show(to), D.DType.show(t2)}, Done{to}), rs2, k2, Bool.and(tot2, X.Cast.total(t2, to)), loc2) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, ih: IH(e2, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.ICast{to} <> acc)):
  match ok:
    case False{}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.ICast{to} <> acc)), L.fail_done(A.Ana, E.TypeMismatch{"cast", "castable to " ++ D.DType.show(to), D.DType.show(t2)}, A.Ana{t, rs, k, tot, loc}, ha))
    case True{}:
      +ea = L.done_inj(A.Ana, A.Ana{to, rs2, k2, Bool.and(tot2, X.Cast.total(t2, to)), loc2}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(to, rs2, k2, Bool.and(tot2, X.Cast.total(t2, to)), loc2, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.Eval.compile(e2, V.ICast{to} <> acc))
      %ana_tot_inj(to, rs2, k2, Bool.and(tot2, X.Cast.total(t2, to)), loc2, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(k2), _, f, sh, stk, acc, V.Eval.compile(e2, V.ICast{to} <> acc))
      %ana_t_inj(to, rs2, k2, Bool.and(tot2, X.Cast.total(t2, to)), loc2, t, rs, k, tot, loc, ea) : Laws.RunW(h, _, Laws.skind(k2), Bool.and(tot2, X.Cast.total(t2, to)), f, sh, stk, acc, V.Eval.compile(e2, V.ICast{to} <> acc))
      un_run(h, V.ICast{to}, t2, Laws.skind(k2), tot2, to, Laws.skind(k2), Bool.and(tot2, X.Cast.total(t2, to)), f, sh, stk, acc, V.Eval.compile(e2, V.ICast{to} <> acc), ih(V.ICast{to} <> acc, f, stk, sh, hs, hf, ev, t2, rs2, k2, tot2, loc2, er), f3 => stk3 => {==}, c4 => hc4 => cast_stepc(to, t2, Laws.skind(k2), h, tot2, eok, c4, hc4), x => cast_htot(tot2, t2, to, x))

# not the null literal: the operand record r (Fail refuted), then the castability test
def cast_ana_r(+to: D.DType, +e2: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  r: E.Res(A.Ana), +er: {A.Expr.analyse(e2, s) == r : E.Res(A.Ana)}, ha: {A.Ana.cast(False{}, False{}, to, r) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, ih: IH(e2, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.ICast{to} <> acc)):
  match r:
    case Fail{e}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.ICast{to} <> acc)), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{A.Ana{+t2, +rs2, +k2, +tot2, +loc2}}:
      cast_ana_k(to, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, t2, rs2, k2, tot2, loc2, X.Cast.ok(t2, to), {==}, er, ha, ih)

# the node: the typed null literal Cast{Lit{SNull}, to} is a one-row IConst of dtype `to`
def cast_ana(+to: D.DType, +e2: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  nl: Bool, r: E.Res(A.Ana), +er: {A.Expr.analyse(e2, s) == r : E.Res(A.Ana)}, ha: {A.Ana.cast(False{}, nl, to, r) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, ih: IH(e2, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile.cast(nl, to, acc, V.Eval.compile(e2, V.ICast{to} <> acc))):
  match nl:
    case True{}:
      +ea = L.done_inj(A.Ana, A.Ana{to, Nil{}, A.KScalar{}, True{}, True{}}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(to, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.IConst{D.SNull{}, to} <> acc)
      %ana_tot_inj(to, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, V.KLit{}, _, f, sh, stk, acc, V.IConst{D.SNull{}, to} <> acc)
      %ana_t_inj(to, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, _, V.KLit{}, True{}, f, sh, stk, acc, V.IConst{D.SNull{}, to} <> acc)
      (V.EvSt{f, Done{V.Slot{V.KLit{}, V.Eval.unit(D.SNull{}, to)} <> stk}}, {==}, {==}, {==}, Laws.unit_typed(D.SNull{}, to), ev)
    case False{}:
      cast_ana_r(to, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, r, er, ha, ih)

# the castability test answered ok: the record is (to, k2, tot2); run the operand and step
def trycast_ana_k(+to: D.DType, +e2: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  +t2: D.DType, +rs2: List<&2, String>, +k2: A.AKind, +tot2: Bool, +loc2: Bool, ok: Bool, +eok: {X.Cast.ok(t2, to) == ok : Bool},
  +er: {A.Expr.analyse(e2, s) == Done{A.Ana{t2, rs2, k2, tot2, loc2}} : E.Res(A.Ana)}, ha: {A.Ana.mk(X.Expr.chk(ok, E.TypeMismatch{"try_cast", "castable to " ++ D.DType.show(to), D.DType.show(t2)}, Done{to}), rs2, k2, tot2, loc2) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, ih: IH(e2, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.ITry{to} <> acc)):
  match ok:
    case False{}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.ITry{to} <> acc)), L.fail_done(A.Ana, E.TypeMismatch{"try_cast", "castable to " ++ D.DType.show(to), D.DType.show(t2)}, A.Ana{t, rs, k, tot, loc}, ha))
    case True{}:
      +ea = L.done_inj(A.Ana, A.Ana{to, rs2, k2, tot2, loc2}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(to, rs2, k2, tot2, loc2, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.Eval.compile(e2, V.ITry{to} <> acc))
      %ana_tot_inj(to, rs2, k2, tot2, loc2, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(k2), _, f, sh, stk, acc, V.Eval.compile(e2, V.ITry{to} <> acc))
      %ana_t_inj(to, rs2, k2, tot2, loc2, t, rs, k, tot, loc, ea) : Laws.RunW(h, _, Laws.skind(k2), tot2, f, sh, stk, acc, V.Eval.compile(e2, V.ITry{to} <> acc))
      un_run(h, V.ITry{to}, t2, Laws.skind(k2), tot2, to, Laws.skind(k2), tot2, f, sh, stk, acc, V.Eval.compile(e2, V.ITry{to} <> acc), ih(V.ITry{to} <> acc, f, stk, sh, hs, hf, ev, t2, rs2, k2, tot2, loc2, er), f3 => stk3 => {==}, c4 => hc4 => trycast_stepc(to, t2, Laws.skind(k2), h, tot2, eok, c4, hc4), x => x)

# not the null literal: the operand record r (Fail refuted), then the castability test
def trycast_ana_r(+to: D.DType, +e2: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  r: E.Res(A.Ana), +er: {A.Expr.analyse(e2, s) == r : E.Res(A.Ana)}, ha: {A.Ana.cast(True{}, False{}, to, r) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, ih: IH(e2, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.ITry{to} <> acc)):
  match r:
    case Fail{e}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.ITry{to} <> acc)), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{A.Ana{+t2, +rs2, +k2, +tot2, +loc2}}:
      trycast_ana_k(to, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, t2, rs2, k2, tot2, loc2, X.Cast.ok(t2, to), {==}, er, ha, ih)

# the node: the typed null literal Cast{Lit{SNull}, to} is a one-row IConst of dtype `to`
def trycast_ana(+to: D.DType, +e2: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  nl: Bool, r: E.Res(A.Ana), +er: {A.Expr.analyse(e2, s) == r : E.Res(A.Ana)}, ha: {A.Ana.cast(True{}, nl, to, r) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, ih: IH(e2, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile.cast(nl, to, acc, V.Eval.compile(e2, V.ITry{to} <> acc))):
  match nl:
    case True{}:
      +ea = L.done_inj(A.Ana, A.Ana{to, Nil{}, A.KScalar{}, True{}, True{}}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(to, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.IConst{D.SNull{}, to} <> acc)
      %ana_tot_inj(to, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, V.KLit{}, _, f, sh, stk, acc, V.IConst{D.SNull{}, to} <> acc)
      %ana_t_inj(to, Nil{}, A.KScalar{}, True{}, True{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, _, V.KLit{}, True{}, f, sh, stk, acc, V.IConst{D.SNull{}, to} <> acc)
      (V.EvSt{f, Done{V.Slot{V.KLit{}, V.Eval.unit(D.SNull{}, to)} <> stk}}, {==}, {==}, {==}, Laws.unit_typed(D.SNull{}, to), ev)
    case False{}:
      trycast_ana_r(to, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, r, er, ha, ih)

# ---- Agg: IAgg reduces the operand to one row (eval_agg_typed); Len over a literal broadcasts first ----

# the step on a full column: fit_agg leaves it alone (fit_len(KFull) too)
def agg_stepc_full(op: X.AggOp, +t2: D.DType, +h: U32, +t: D.DType, +tot: Bool, hok: {X.Expr.type.agg.ok(op, t2) == Done{t} : E.Res(D.DType)}, c: C.Column, hc: Laws.ColTy(t2, Laws.klen(V.KFull{}, h), c)) -> SResW(t, V.KAgg{}, Laws.klen(V.KAgg{}, h), tot, V.Eval.do1(h, V.IAgg{op}, V.KFull{}, c)):
  match op:
    case X.Sum{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Sum{}, c), Laws.eval_agg_typed(X.Sum{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Sum{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Mean{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Mean{}, c), Laws.eval_agg_typed(X.Mean{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Mean{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Min{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Min{}, c), Laws.eval_agg_typed(X.Min{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Min{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Max{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Max{}, c), Laws.eval_agg_typed(X.Max{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Max{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Count{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Count{}, c), Laws.eval_agg_typed(X.Count{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Count{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Len{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Len{}, c), Laws.eval_agg_typed(X.Len{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Len{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.First{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.First{}, c), Laws.eval_agg_typed(X.First{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.First{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Last{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Last{}, c), Laws.eval_agg_typed(X.Last{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Last{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.NUnique{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.NUnique{}, c), Laws.eval_agg_typed(X.NUnique{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.NUnique{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Std{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Std{}, c), Laws.eval_agg_typed(X.Std{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Std{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Var{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Var{}, c), Laws.eval_agg_typed(X.Var{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Var{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Median{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Median{}, c), Laws.eval_agg_typed(X.Median{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Median{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))

# Len over a one-row literal: the literal is broadcast to the height first (bcast_typed), then counted
def agg_len_lit(+t2: D.DType, +h: U32, +t: D.DType, +tot: Bool, hok: {X.Expr.type.agg.ok(X.Len{}, t2) == Done{t} : E.Res(D.DType)}, -c: C.Column, ed: {Laws.cdtype(c) == t2 : D.DType}, w: Laws.ColW(Laws.cdtype(c), h, V.Eval.bcast(c, h))) -> SResW(t, V.KAgg{}, 1, tot, V.Eval.wrap(V.KAgg{}, V.Eval.agg(X.Len{}, V.Eval.bcast(c, h)))):
  (c2, eb, ed2, el2) = w
  %Equal.sym(C.Column, V.Eval.bcast(c, h), c2, eb) : SResW(t, V.KAgg{}, 1, tot, V.Eval.wrap(V.KAgg{}, V.Eval.agg(X.Len{}, _)))
  wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Len{}, c2), Laws.eval_agg_typed(X.Len{}, c2, t, (%Equal.sym(D.DType, Laws.cdtype(c2), Laws.cdtype(c), ed2) : {X.Expr.type.agg.ok(X.Len{}, _) == Done{t} : E.Res(D.DType)}; (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Len{}, _) == Done{t} : E.Res(D.DType)}; hok))), x => tot_true(tot, x))

# the step on a literal slot
def agg_stepc_lit(op: X.AggOp, +t2: D.DType, +h: U32, +t: D.DType, +tot: Bool, hok: {X.Expr.type.agg.ok(op, t2) == Done{t} : E.Res(D.DType)}, c: C.Column, hc: Laws.ColTy(t2, Laws.klen(V.KLit{}, h), c)) -> SResW(t, V.KAgg{}, Laws.klen(V.KAgg{}, h), tot, V.Eval.do1(h, V.IAgg{op}, V.KLit{}, c)):
  match op:
    case X.Sum{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Sum{}, c), Laws.eval_agg_typed(X.Sum{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Sum{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Mean{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Mean{}, c), Laws.eval_agg_typed(X.Mean{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Mean{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Min{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Min{}, c), Laws.eval_agg_typed(X.Min{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Min{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Max{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Max{}, c), Laws.eval_agg_typed(X.Max{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Max{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Count{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Count{}, c), Laws.eval_agg_typed(X.Count{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Count{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Len{}:
      (ed, el) = hc
      agg_len_lit(t2, h, t, tot, hok, c, ed, Laws.bcast_typed(c, h))
    case X.First{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.First{}, c), Laws.eval_agg_typed(X.First{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.First{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Last{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Last{}, c), Laws.eval_agg_typed(X.Last{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Last{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.NUnique{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.NUnique{}, c), Laws.eval_agg_typed(X.NUnique{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.NUnique{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Std{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Std{}, c), Laws.eval_agg_typed(X.Std{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Std{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Var{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Var{}, c), Laws.eval_agg_typed(X.Var{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Var{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))
    case X.Median{}:
      (ed, el) = hc
      wrap_w(V.KAgg{}, t, 1, tot, True{}, V.Eval.agg(X.Median{}, c), Laws.eval_agg_typed(X.Median{}, c, t, (%Equal.sym(D.DType, Laws.cdtype(c), t2, ed) : {X.Expr.type.agg.ok(X.Median{}, _) == Done{t} : E.Res(D.DType)}; hok)), x => tot_true(tot, x))

# the reducer's rule answered Done{t3} over a KRow / KScalar operand (k2): the record is (t3, KRed, tot2);
# the step lemma for the operand's slot kind comes from the caller (mk), parametric in t3
def agg_ana_t(+op: X.AggOp, +e2: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  +t2: D.DType, +rs2: List<&2, String>, +k2: A.AKind, +tot2: Bool, +loc2: Bool, rt: E.Res(D.DType), +ert: {X.Expr.type.agg.ok(op, t2) == rt : E.Res(D.DType)},
  +er: {A.Expr.analyse(e2, s) == Done{A.Ana{t2, rs2, k2, tot2, loc2}} : E.Res(A.Ana)}, ha: {A.Ana.mk(rt, rs2, A.KRed{}, tot2, False{}) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, ih: IH(e2, s, h),
  mk: @t3: D.DType -> @hok: {X.Expr.type.agg.ok(op, t2) == Done{t3} : E.Res(D.DType)} -> @c4: C.Column -> @hc4: Laws.ColTy(t2, Laws.klen(Laws.skind(k2), h), c4) -> SResW(t3, V.KAgg{}, Laws.klen(V.KAgg{}, h), tot2, V.Eval.do1(h, V.IAgg{op}, Laws.skind(k2), c4)))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.IAgg{op} <> acc)):
  match rt:
    case Fail{e}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.IAgg{op} <> acc)), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{+t3}:
      +ea = L.done_inj(A.Ana, A.Ana{t3, rs2, A.KRed{}, tot2, False{}}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(t3, rs2, A.KRed{}, tot2, False{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.Eval.compile(e2, V.IAgg{op} <> acc))
      %ana_tot_inj(t3, rs2, A.KRed{}, tot2, False{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, t, V.KAgg{}, _, f, sh, stk, acc, V.Eval.compile(e2, V.IAgg{op} <> acc))
      %ana_t_inj(t3, rs2, A.KRed{}, tot2, False{}, t, rs, k, tot, loc, ea) : Laws.RunW(h, _, V.KAgg{}, tot2, f, sh, stk, acc, V.Eval.compile(e2, V.IAgg{op} <> acc))
      un_run(h, V.IAgg{op}, t2, Laws.skind(k2), tot2, t3, V.KAgg{}, tot2, f, sh, stk, acc, V.Eval.compile(e2, V.IAgg{op} <> acc), ih(V.IAgg{op} <> acc, f, stk, sh, hs, hf, ev, t2, rs2, k2, tot2, loc2, er), f3 => stk3 => {==}, mk(t3, ert), x => x)

# the operand's kind: a KRed operand is the nested-aggregation error; KRow / KScalar reduce
def agg_ana_k(+op: X.AggOp, +e2: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  +t2: D.DType, +rs2: List<&2, String>, +k2: A.AKind, +tot2: Bool, +loc2: Bool, +er: {A.Expr.analyse(e2, s) == Done{A.Ana{t2, rs2, k2, tot2, loc2}} : E.Res(A.Ana)}, ha: {A.Ana.agg.k(k2, op, e2, t2, rs2, tot2) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, ih: IH(e2, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.IAgg{op} <> acc)):
  match k2:
    case A.KRed{}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.IAgg{op} <> acc)), PV.fail_done_r(A.Ana, A.Ana.agg.k(A.KRed{}, op, e2, t2, rs2, tot2), A.Ana{t, rs, k, tot, loc}, {==}, ha))
    case A.KRow{}:
      agg_ana_t(op, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, t2, rs2, A.KRow{}, tot2, loc2, X.Expr.type.agg.ok(op, t2), {==}, er, ha, ih, t3 => hok => c4 => hc4 => agg_stepc_full(op, t2, h, t3, tot2, hok, c4, hc4))
    case A.KScalar{}:
      agg_ana_t(op, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, t2, rs2, A.KScalar{}, tot2, loc2, X.Expr.type.agg.ok(op, t2), {==}, er, ha, ih, t3 => hok => c4 => hc4 => agg_stepc_lit(op, t2, h, t3, tot2, hok, c4, hc4))

def agg_ana(+op: X.AggOp, +e2: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  r: E.Res(A.Ana), +er: {A.Expr.analyse(e2, s) == r : E.Res(A.Ana)}, ha: {A.Ana.agg(op, e2, r) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, ih: IH(e2, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.IAgg{op} <> acc)):
  match r:
    case Fail{e}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e2, V.IAgg{op} <> acc)), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{A.Ana{+t2, +rs2, +k2, +tot2, +loc2}}:
      agg_ana_k(op, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, t2, rs2, k2, tot2, loc2, er, ha, ih)

# ---- two- and three-operand instructions (Eval.app2 / do2, Eval.app3 / do3) ------------------------------
#
# do2.a / do3.a read the operand lengths (len_k pins them to klen of the slot kinds), test the shapes
# (bad2_false / bad3_false: the test is False for typed slots) and fit the 1-row sides to the full
# length (fit_w); the result column has the length klen of the combined kind (len2 / len3).

# the length Eval.fit gives: a full column keeps its own, a 1-row side takes n
def fitlen(k: V.SKind, +m: U32, +n: U32) -> U32:
  match k:
    case V.KFull{}:
      m
    case _:
      n

def fit_lit(+n: U32, +t: D.DType, -c: C.Column, ed: {Laws.cdtype(c) == t : D.DType}, w: Laws.ColW(Laws.cdtype(c), n, V.Eval.bcast(c, n))) -> Laws.ColW(t, n, V.Eval.bcast(c, n)):
  (c2, eb, ed2, el2) = w
  (c2, eb, Equal.trans(D.DType, Laws.cdtype(c2), Laws.cdtype(c), t, ed2, ed), el2)

def fit_w(k: V.SKind, c: C.Column, +n: U32, +t: D.DType, +m: U32, hc: Laws.ColTy(t, m, c)) -> Laws.ColW(t, fitlen(k, m, n), V.Eval.fit(k, c, n)):
  match k:
    case V.KFull{}:
      (c, {==}, hc)
    case V.KLit{}:
      (ed, el) = hc
      fit_lit(n, t, c, ed, Laws.bcast_typed(c, n))
    case V.KAgg{}:
      (ed, el) = hc
      fit_lit(n, t, c, ed, Laws.bcast_typed(c, n))

# M4: fitd (do2's fit): a 1-row side next to a Dictionary operand broadcasts as a one-entry
# Dictionary (PV.bcast_dict_w), else as fit; the same dtype and length either way
def fitd_lit(+n: U32, +t: D.DType, -c: C.Column, ed: {Laws.cdtype(c) == t : D.DType}, w: Laws.ColW(Laws.cdtype(c), n, V.Eval.bcast_dict(c, n))) -> Laws.ColW(t, n, V.Eval.bcast_dict(c, n)):
  (c2, eb, ed2, el2) = w
  (c2, eb, Equal.trans(D.DType, Laws.cdtype(c2), Laws.cdtype(c), t, ed2, ed), el2)

def fitd_b(od: Bool, c: C.Column, +n: U32, +t: D.DType, ed: {Laws.cdtype(c) == t : D.DType}) -> Laws.ColW(t, n, V.Eval.fitd(V.KLit{}, c, n, od)):
  match od:
    case True{}:
      fitd_lit(n, t, c, ed, PV.bcast_dict_w(c, n))
    case False{}:
      fit_lit(n, t, c, ed, Laws.bcast_typed(c, n))

def fitd_a(od: Bool, c: C.Column, +n: U32, +t: D.DType, ed: {Laws.cdtype(c) == t : D.DType}) -> Laws.ColW(t, n, V.Eval.fitd(V.KAgg{}, c, n, od)):
  match od:
    case True{}:
      fitd_lit(n, t, c, ed, PV.bcast_dict_w(c, n))
    case False{}:
      fit_lit(n, t, c, ed, Laws.bcast_typed(c, n))

def fitd_f(od: Bool, c: C.Column, +n: U32, +t: D.DType, +m: U32, hc: Laws.ColTy(t, m, c)) -> Laws.ColW(t, m, V.Eval.fitd(V.KFull{}, c, n, od)):
  match od:
    case True{}:
      (c, {==}, hc)
    case False{}:
      (c, {==}, hc)

def fitd_w(k: V.SKind, od: Bool, c: C.Column, +n: U32, +t: D.DType, +m: U32, hc: Laws.ColTy(t, m, c)) -> Laws.ColW(t, fitlen(k, m, n), V.Eval.fitd(k, c, n, od)):
  match k:
    case V.KFull{}:
      fitd_f(od, c, n, t, m, hc)
    case V.KLit{}:
      (ed, el) = hc
      fitd_b(od, c, n, t, ed)
    case V.KAgg{}:
      (ed, el) = hc
      fitd_a(od, c, n, t, ed)

# a ColW restated as the ColTy of the witness (for the entry points)
def colw_ty(+t: D.DType, +n: U32, -c0: C.Column, -c: C.Column, ed: {Laws.cdtype(c) == t : D.DType}, w: Laws.ColW(Laws.cdtype(c), n, c0)) -> Laws.ColTy(t, n, c0):
  (c2, e, ed2, el2) = w
  %Equal.sym(C.Column, c0, c2, e) : Laws.ColTy(t, n, _)
  (Equal.trans(D.DType, Laws.cdtype(c2), Laws.cdtype(c), t, ed2, ed), el2)

# the two-operand shape test is False on typed slots (full sides have the height h)
def bad2_false(+h: U32, ka: V.SKind, kb: V.SKind) -> {Bool.and(Bool.and(V.SKind.is_full(ka), V.SKind.is_full(kb)), U32.is_ne(Laws.klen(ka, h), Laws.klen(kb, h))) == False{} : Bool}:
  match ka kb:
    case V.KFull{} V.KFull{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {_ == False{} : Bool}
      {==}
    case V.KFull{} V.KLit{}:
      {==}
    case V.KFull{} V.KAgg{}:
      {==}
    case V.KLit{} V.KFull{}:
      {==}
    case V.KLit{} V.KLit{}:
      {==}
    case V.KLit{} V.KAgg{}:
      {==}
    case V.KAgg{} V.KFull{}:
      {==}
    case V.KAgg{} V.KLit{}:
      {==}
    case V.KAgg{} V.KAgg{}:
      {==}

# the result length of a two-operand step is klen of the combined kind
def len2(+h: U32, ka: V.SKind, kb: V.SKind) -> {fitlen(ka, Laws.klen(ka, h), Bool.pick(U32, V.SKind.is_full(ka), Laws.klen(ka, h), Bool.pick(U32, V.SKind.is_full(kb), Laws.klen(kb, h), 1))) == Laws.klen(V.SKind.comb(ka, kb), h) : U32}:
  match ka kb:
    case V.KFull{} V.KFull{}:
      {==}
    case V.KFull{} V.KLit{}:
      {==}
    case V.KFull{} V.KAgg{}:
      {==}
    case V.KLit{} V.KFull{}:
      {==}
    case V.KLit{} V.KLit{}:
      {==}
    case V.KLit{} V.KAgg{}:
      {==}
    case V.KAgg{} V.KFull{}:
      {==}
    case V.KAgg{} V.KLit{}:
      {==}
    case V.KAgg{} V.KAgg{}:
      {==}

def bad3_false(+h: U32, kc: V.SKind, ka: V.SKind, kb: V.SKind) -> {Bool.or(Bool.and(V.SKind.is_full(kc), U32.is_ne(Laws.klen(kc, h), Bool.pick(U32, V.SKind.is_full(kc), Laws.klen(kc, h), Bool.pick(U32, V.SKind.is_full(ka), Laws.klen(ka, h), Bool.pick(U32, V.SKind.is_full(kb), Laws.klen(kb, h), 1))))), Bool.or(Bool.and(V.SKind.is_full(ka), U32.is_ne(Laws.klen(ka, h), Bool.pick(U32, V.SKind.is_full(kc), Laws.klen(kc, h), Bool.pick(U32, V.SKind.is_full(ka), Laws.klen(ka, h), Bool.pick(U32, V.SKind.is_full(kb), Laws.klen(kb, h), 1))))), Bool.and(V.SKind.is_full(kb), U32.is_ne(Laws.klen(kb, h), Bool.pick(U32, V.SKind.is_full(kc), Laws.klen(kc, h), Bool.pick(U32, V.SKind.is_full(ka), Laws.klen(ka, h), Bool.pick(U32, V.SKind.is_full(kb), Laws.klen(kb, h), 1))))))) == False{} : Bool}:
  match kc ka kb:
    case V.KFull{} V.KFull{} V.KFull{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(_, Bool.or(_, _)) == False{} : Bool}
      {==}
    case V.KFull{} V.KFull{} V.KLit{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(_, Bool.or(_, False{})) == False{} : Bool}
      {==}
    case V.KFull{} V.KFull{} V.KAgg{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(_, Bool.or(_, False{})) == False{} : Bool}
      {==}
    case V.KFull{} V.KLit{} V.KFull{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(_, Bool.or(False{}, _)) == False{} : Bool}
      {==}
    case V.KFull{} V.KLit{} V.KLit{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(_, Bool.or(False{}, False{})) == False{} : Bool}
      {==}
    case V.KFull{} V.KLit{} V.KAgg{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(_, Bool.or(False{}, False{})) == False{} : Bool}
      {==}
    case V.KFull{} V.KAgg{} V.KFull{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(_, Bool.or(False{}, _)) == False{} : Bool}
      {==}
    case V.KFull{} V.KAgg{} V.KLit{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(_, Bool.or(False{}, False{})) == False{} : Bool}
      {==}
    case V.KFull{} V.KAgg{} V.KAgg{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(_, Bool.or(False{}, False{})) == False{} : Bool}
      {==}
    case V.KLit{} V.KFull{} V.KFull{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(False{}, Bool.or(_, _)) == False{} : Bool}
      {==}
    case V.KLit{} V.KFull{} V.KLit{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(False{}, Bool.or(_, False{})) == False{} : Bool}
      {==}
    case V.KLit{} V.KFull{} V.KAgg{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(False{}, Bool.or(_, False{})) == False{} : Bool}
      {==}
    case V.KLit{} V.KLit{} V.KFull{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(False{}, Bool.or(False{}, _)) == False{} : Bool}
      {==}
    case V.KLit{} V.KLit{} V.KLit{}:
      {==}
    case V.KLit{} V.KLit{} V.KAgg{}:
      {==}
    case V.KLit{} V.KAgg{} V.KFull{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(False{}, Bool.or(False{}, _)) == False{} : Bool}
      {==}
    case V.KLit{} V.KAgg{} V.KLit{}:
      {==}
    case V.KLit{} V.KAgg{} V.KAgg{}:
      {==}
    case V.KAgg{} V.KFull{} V.KFull{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(False{}, Bool.or(_, _)) == False{} : Bool}
      {==}
    case V.KAgg{} V.KFull{} V.KLit{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(False{}, Bool.or(_, False{})) == False{} : Bool}
      {==}
    case V.KAgg{} V.KFull{} V.KAgg{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(False{}, Bool.or(_, False{})) == False{} : Bool}
      {==}
    case V.KAgg{} V.KLit{} V.KFull{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(False{}, Bool.or(False{}, _)) == False{} : Bool}
      {==}
    case V.KAgg{} V.KLit{} V.KLit{}:
      {==}
    case V.KAgg{} V.KLit{} V.KAgg{}:
      {==}
    case V.KAgg{} V.KAgg{} V.KFull{}:
      %Equal.sym(Bool, U32.is_ne(h, h), False{}, PV.u32_ne_refl(h)) : {Bool.or(False{}, Bool.or(False{}, _)) == False{} : Bool}
      {==}
    case V.KAgg{} V.KAgg{} V.KLit{}:
      {==}
    case V.KAgg{} V.KAgg{} V.KAgg{}:
      {==}

def len3(+h: U32, kc: V.SKind, ka: V.SKind, kb: V.SKind) -> {fitlen(ka, Laws.klen(ka, h), Bool.pick(U32, V.SKind.is_full(kc), Laws.klen(kc, h), Bool.pick(U32, V.SKind.is_full(ka), Laws.klen(ka, h), Bool.pick(U32, V.SKind.is_full(kb), Laws.klen(kb, h), 1)))) == Laws.klen(V.SKind.comb(kc, V.SKind.comb(ka, kb)), h) : U32}:
  match kc ka kb:
    case V.KFull{} V.KFull{} V.KFull{}:
      {==}
    case V.KFull{} V.KFull{} V.KLit{}:
      {==}
    case V.KFull{} V.KFull{} V.KAgg{}:
      {==}
    case V.KFull{} V.KLit{} V.KFull{}:
      {==}
    case V.KFull{} V.KLit{} V.KLit{}:
      {==}
    case V.KFull{} V.KLit{} V.KAgg{}:
      {==}
    case V.KFull{} V.KAgg{} V.KFull{}:
      {==}
    case V.KFull{} V.KAgg{} V.KLit{}:
      {==}
    case V.KFull{} V.KAgg{} V.KAgg{}:
      {==}
    case V.KLit{} V.KFull{} V.KFull{}:
      {==}
    case V.KLit{} V.KFull{} V.KLit{}:
      {==}
    case V.KLit{} V.KFull{} V.KAgg{}:
      {==}
    case V.KLit{} V.KLit{} V.KFull{}:
      {==}
    case V.KLit{} V.KLit{} V.KLit{}:
      {==}
    case V.KLit{} V.KLit{} V.KAgg{}:
      {==}
    case V.KLit{} V.KAgg{} V.KFull{}:
      {==}
    case V.KLit{} V.KAgg{} V.KLit{}:
      {==}
    case V.KLit{} V.KAgg{} V.KAgg{}:
      {==}
    case V.KAgg{} V.KFull{} V.KFull{}:
      {==}
    case V.KAgg{} V.KFull{} V.KLit{}:
      {==}
    case V.KAgg{} V.KFull{} V.KAgg{}:
      {==}
    case V.KAgg{} V.KLit{} V.KFull{}:
      {==}
    case V.KAgg{} V.KLit{} V.KLit{}:
      {==}
    case V.KAgg{} V.KLit{} V.KAgg{}:
      {==}
    case V.KAgg{} V.KAgg{} V.KFull{}:
      {==}
    case V.KAgg{} V.KAgg{} V.KLit{}:
      {==}
    case V.KAgg{} V.KAgg{} V.KAgg{}:
      {==}

# a wrapped total operation result pushed (the shared tail of the two- and three-operand steps)
def do_fin(+h: U32, +K: V.SKind, +t3: D.DType, +tot: Bool, -f: C.Frame, f3: C.Frame, +sh: List<&2, Laws.Sh>, rest: List<&1, V.Slot>, ef: {f3 == f : C.Frame}, ev: Laws.StkTy(h, sh, rest), -r0: E.ResT(C.Column), w: Laws.ResW(True{}, t3, Laws.klen(K, h), r0)) -> PushW(h, t3, K, tot, f, f3, sh, rest, V.Eval.wrap(K, r0)):
  push_r(h, t3, K, tot, f, f3, sh, rest, ef, ev, V.Eval.wrap(K, r0), wrap_w(K, t3, Laws.klen(K, h), tot, True{}, r0, w, x => tot_true(tot, x)))

# do2.b with the shape test False: the fitted operands (ColW witnesses) go to the operation (opc)
def do2_fit2(+h: U32, +i: V.Instr, +K: V.SKind, +la: U32, +lb: U32, +ta: D.DType, +tb: D.DType, +t3: D.DType, +tot: Bool, -f: C.Frame, f3: C.Frame, +sh: List<&2, Laws.Sh>, rest: List<&1, V.Slot>, ef: {f3 == f : C.Frame}, ev: Laws.StkTy(h, sh, rest),
  -A: C.Column, -B: C.Column, +na: U32, +nb: U32, wa: Laws.ColW(ta, na, A), wb: Laws.ColW(tb, nb, B), ena: {na == Laws.klen(K, h) : U32},
  opc: @na2: U32 -> @nb2: U32 -> @a4: C.Column -> @b4: C.Column -> @ha4: Laws.ColTy(ta, na2, a4) -> @hb4: Laws.ColTy(tb, nb2, b4) -> Laws.ResW(True{}, t3, na2, V.Eval.op2(i, a4, b4))) -> PushW(h, t3, K, tot, f, f3, sh, rest, V.Eval.do2.b(False{}, i, K, la, lb, A, B)):
  (a3, ea, tya) = wa
  (b3, eb, tyb) = wb
  %Equal.sym(C.Column, A, a3, ea) : PushW(h, t3, K, tot, f, f3, sh, rest, V.Eval.wrap(K, V.Eval.op2(i, _, B)))
  %Equal.sym(C.Column, B, b3, eb) : PushW(h, t3, K, tot, f, f3, sh, rest, V.Eval.wrap(K, V.Eval.op2(i, a3, _)))
  do_fin(h, K, t3, tot, f, f3, sh, rest, ef, ev, V.Eval.op2(i, a3, b3), resw_len(True{}, t3, Laws.klen(K, h), na, V.Eval.op2(i, a3, b3), ena, opc(na, nb, a3, b3, tya, tyb)))

def do2_fit(+h: U32, +i: V.Instr, +K: V.SKind, bad: Bool, ebad: {bad == False{} : Bool}, +la: U32, +lb: U32, +ta: D.DType, +tb: D.DType, +t3: D.DType, +tot: Bool, -f: C.Frame, f3: C.Frame, +sh: List<&2, Laws.Sh>, rest: List<&1, V.Slot>, ef: {f3 == f : C.Frame}, ev: Laws.StkTy(h, sh, rest),
  -A: C.Column, -B: C.Column, +na: U32, +nb: U32, wa: Laws.ColW(ta, na, A), wb: Laws.ColW(tb, nb, B), ena: {na == Laws.klen(K, h) : U32},
  opc: @na2: U32 -> @nb2: U32 -> @a4: C.Column -> @b4: C.Column -> @ha4: Laws.ColTy(ta, na2, a4) -> @hb4: Laws.ColTy(tb, nb2, b4) -> Laws.ResW(True{}, t3, na2, V.Eval.op2(i, a4, b4))) -> PushW(h, t3, K, tot, f, f3, sh, rest, V.Eval.do2.b(bad, i, K, la, lb, A, B)):
  match bad:
    case True{}:
      Empty.absurd(PushW(h, t3, K, tot, f, f3, sh, rest, V.Eval.do2.b(True{}, i, K, la, lb, A, B)), L.true_false(ebad))
    case False{}:
      do2_fit2(h, i, K, la, lb, ta, tb, t3, tot, f, f3, sh, rest, ef, ev, A, B, na, nb, wa, wb, ena, opc)

# the operands' storages read (M4: is_dict, the column back unchanged): do2.e computes to do2.b
# over the symbolic shape test, each side fitted with fitd
def step2_d(+h: U32, +i: V.Instr, +ta: D.DType, +ka: V.SKind, +tb: D.DType, +kb: V.SKind, +t3: D.DType, +tot: Bool, -f: C.Frame, f3: C.Frame, +sh: List<&2, Laws.Sh>, rest: List<&1, V.Slot>, ef: {f3 == f : C.Frame}, ev: Laws.StkTy(h, sh, rest),
  -a2: C.Column, -b2: C.Column, hca: Laws.ColTy(ta, Laws.klen(ka, h), a2), hcb: Laws.ColTy(tb, Laws.klen(kb, h), b2),
  wa: &a3: C.Column -> &da: Bool -> {C.Column.is_dict(a2) == (a3, da) : C.Column & Bool} & {a3 == a2 : C.Column},
  wb: &b3: C.Column -> &db: Bool -> {C.Column.is_dict(b2) == (b3, db) : C.Column & Bool} & {b3 == b2 : C.Column},
  opc: @na2: U32 -> @nb2: U32 -> @a4: C.Column -> @b4: C.Column -> @ha4: Laws.ColTy(ta, na2, a4) -> @hb4: Laws.ColTy(tb, nb2, b4) -> Laws.ResW(True{}, t3, na2, V.Eval.op2(i, a4, b4))) -> PushW(h, t3, V.SKind.comb(ka, kb), tot, f, f3, sh, rest, V.Eval.do2.e(i, ka, kb, Laws.klen(ka, h), Laws.klen(kb, h), C.Column.is_dict(a2), C.Column.is_dict(b2))):
  (a3, +da, ea, ea2) = wa
  (b3, +db, eb, eb2) = wb
  %Equal.sym(C.Column & Bool, C.Column.is_dict(a2), (a3, da), ea) : PushW(h, t3, V.SKind.comb(ka, kb), tot, f, f3, sh, rest, V.Eval.do2.e(i, ka, kb, Laws.klen(ka, h), Laws.klen(kb, h), _, C.Column.is_dict(b2)))
