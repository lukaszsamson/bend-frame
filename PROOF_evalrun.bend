  step2_d(h, i, ta, ka, tb, kb, t3, tot, f, f3, sh, rest, ef, ev, a2, b2, hca, hcb, PV.isdict_w(a2), PV.isdict_w(b2), opc)

def step2_b(+h: U32, +i: V.Instr, +ta: D.DType, +ka: V.SKind, +tb: D.DType, +kb: V.SKind, +t3: D.DType, +tot: Bool, -f: C.Frame, -f2: C.Frame, +sh: List<&2, Laws.Sh>, f3: C.Frame, stk2: List<&1, V.Slot>, +ef2: {f2 == f : C.Frame},
  ty: {f3 == f2 : C.Frame} & Laws.StkTy(h, Laws.Sh{tb, kb} <> Laws.Sh{ta, ka} <> sh, stk2), hex2: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, i, f3, stk3) == V.EvSt{f3, V.Eval.app2(i, stk3)} : V.EvSt}, opc: @na2: U32 -> @nb2: U32 -> @a4: C.Column -> @b4: C.Column -> @ha4: Laws.ColTy(ta, na2, a4) -> @hb4: Laws.ColTy(tb, nb2, b4) -> Laws.ResW(True{}, t3, na2, V.Eval.op2(i, a4, b4)))
  -> StepW(h, i, t3, V.SKind.comb(ka, kb), tot, f, sh, V.EvSt{f3, Done{stk2}}):
  match stk2:
    case Nil{}:
      (ef3, ev) = ty
      Empty.absurd(StepW(h, i, t3, V.SKind.comb(ka, kb), tot, f, sh, V.EvSt{f3, Done{Nil{}}}), ev)
    case V.Slot{kb2, b} <> Nil{}:
      (ef3, hk, hc, ev) = ty
      Empty.absurd(StepW(h, i, t3, V.SKind.comb(ka, kb), tot, f, sh, V.EvSt{f3, Done{V.Slot{kb2, b} <> Nil{}}}), ev)
    case V.Slot{+kb2, b} <> V.Slot{+ka2, a} <> rest:
      (ef3, hkb, hcb, hka, hca, ev) = ty
      %Equal.sym(V.EvSt, V.Eval.exec(h, i, f3, V.Slot{kb2, b} <> V.Slot{ka2, a} <> rest), V.EvSt{f3, V.Eval.app2(i, V.Slot{kb2, b} <> V.Slot{ka2, a} <> rest)}, hex2(f3, V.Slot{kb2, b} <> V.Slot{ka2, a} <> rest)) : &st2: V.EvSt -> {_ == st2 : V.EvSt} & Laws.RunTy(h, t3, V.SKind.comb(ka, kb), tot, f, sh, st2)
      %Equal.sym(V.SKind, ka2, ka, hka) : PushW(h, t3, V.SKind.comb(ka, kb), tot, f, f3, sh, rest, V.Eval.do2(i, _, a, kb2, b))
      %Equal.sym(V.SKind, kb2, kb, hkb) : PushW(h, t3, V.SKind.comb(ka, kb), tot, f, f3, sh, rest, V.Eval.do2(i, ka, a, _, b))
