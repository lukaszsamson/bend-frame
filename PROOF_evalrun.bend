  %Equal.sym(C.Column & U32, C.Column.len(c), (c2, Laws.klen(kc, h)), elc) : PushW(h, t3, V.SKind.comb(kc, V.SKind.comb(ka, kb)), tot, f, f3, sh, rest, V.Eval.do3.a(kc, ka, kb, _, C.Column.len(a), C.Column.len(b)))
