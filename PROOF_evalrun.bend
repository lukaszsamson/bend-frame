def step3_b(+h: U32, +tc: D.DType, +kc: V.SKind, +ta: D.DType, +ka: V.SKind, +tb: D.DType, +kb: V.SKind, +t3: D.DType, +tot: Bool, -f: C.Frame, -f2: C.Frame, +sh: List<&2, Laws.Sh>, f3: C.Frame, stk2: List<&1, V.Slot>, +ef2: {f2 == f : C.Frame},
  ty: {f3 == f2 : C.Frame} & Laws.StkTy(h, Laws.Sh{tb, kb} <> Laws.Sh{ta, ka} <> Laws.Sh{tc, kc} <> sh, stk2), hex3: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, V.IWhen{}, f3, stk3) == V.EvSt{f3, V.Eval.app3(stk3)} : V.EvSt}, hok: {X.Expr.type.when.ok(tc, ta, tb) == Done{t3} : E.Res(D.DType)})
  -> StepW(h, V.IWhen{}, t3, V.SKind.comb(kc, V.SKind.comb(ka, kb)), tot, f, sh, V.EvSt{f3, Done{stk2}}):
  match stk2:
    case Nil{}:
      (ef3, ev) = ty
      Empty.absurd(StepW(h, V.IWhen{}, t3, V.SKind.comb(kc, V.SKind.comb(ka, kb)), tot, f, sh, V.EvSt{f3, Done{Nil{}}}), ev)
    case V.Slot{kb2, b} <> Nil{}:
      (ef3, hk, hc, ev) = ty
      Empty.absurd(StepW(h, V.IWhen{}, t3, V.SKind.comb(kc, V.SKind.comb(ka, kb)), tot, f, sh, V.EvSt{f3, Done{V.Slot{kb2, b} <> Nil{}}}), ev)
    case V.Slot{kb2, b} <> V.Slot{ka2, a} <> Nil{}:
      (ef3, hk, hc, hk2, hc2, ev) = ty
      Empty.absurd(StepW(h, V.IWhen{}, t3, V.SKind.comb(kc, V.SKind.comb(ka, kb)), tot, f, sh, V.EvSt{f3, Done{V.Slot{kb2, b} <> V.Slot{ka2, a} <> Nil{}}}), ev)
    case V.Slot{+kb2, b} <> V.Slot{+ka2, a} <> V.Slot{+kc2, c} <> rest:
      (ef3, hkb, hcb, hka, hca, hkc, hcc, ev) = ty
      %Equal.sym(V.EvSt, V.Eval.exec(h, V.IWhen{}, f3, V.Slot{kb2, b} <> V.Slot{ka2, a} <> V.Slot{kc2, c} <> rest), V.EvSt{f3, V.Eval.app3(V.Slot{kb2, b} <> V.Slot{ka2, a} <> V.Slot{kc2, c} <> rest)}, hex3(f3, V.Slot{kb2, b} <> V.Slot{ka2, a} <> V.Slot{kc2, c} <> rest)) : &st2: V.EvSt -> {_ == st2 : V.EvSt} & Laws.RunTy(h, t3, V.SKind.comb(kc, V.SKind.comb(ka, kb)), tot, f, sh, st2)
      %Equal.sym(V.SKind, kc2, kc, hkc) : PushW(h, t3, V.SKind.comb(kc, V.SKind.comb(ka, kb)), tot, f, f3, sh, rest, V.Eval.do3(_, c, ka2, a, kb2, b))
      %Equal.sym(V.SKind, ka2, ka, hka) : PushW(h, t3, V.SKind.comb(kc, V.SKind.comb(ka, kb)), tot, f, f3, sh, rest, V.Eval.do3(kc, c, _, a, kb2, b))
      %Equal.sym(V.SKind, kb2, kb, hkb) : PushW(h, t3, V.SKind.comb(kc, V.SKind.comb(ka, kb)), tot, f, f3, sh, rest, V.Eval.do3(kc, c, ka, a, _, b))
      step3_c(h, tc, kc, ta, ka, tb, kb, t3, tot, f, f3, sh, rest, Equal.trans(C.Frame, f3, f2, f, ef3, ef2), ev, c, a, b, len_k(c, Laws.klen(kc, h), tc, hcc), len_k(a, Laws.klen(ka, h), ta, hca), len_k(b, Laws.klen(kb, h), tb, hcb), hok)

def step3_a(+h: U32, +tc: D.DType, +kc: V.SKind, +ta: D.DType, +ka: V.SKind, +tb: D.DType, +kb: V.SKind, +totb: Bool, +t3: D.DType, +tot: Bool, -f: C.Frame, -f2: C.Frame, +sh: List<&2, Laws.Sh>, f3: C.Frame, r: E.ResT(List<&1, V.Slot>), +ef2: {f2 == f : C.Frame},
  ty: Laws.ResSt(h, tb, kb, totb, f2, Laws.Sh{ta, ka} <> Laws.Sh{tc, kc} <> sh, f3, r), htot: @_x: {totb == False{} : Bool} -> {tot == False{} : Bool}, hex3: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, V.IWhen{}, f3, stk3) == V.EvSt{f3, V.Eval.app3(stk3)} : V.EvSt}, hok: {X.Expr.type.when.ok(tc, ta, tb) == Done{t3} : E.Res(D.DType)})
  -> StepW(h, V.IWhen{}, t3, V.SKind.comb(kc, V.SKind.comb(ka, kb)), tot, f, sh, V.EvSt{f3, r}):
  match r:
    case Fail{e}:
      (V.EvSt{f3, Fail{e}}, {==}, htot(ty))
    case Done{stk2}:
      step3_b(h, tc, kc, ta, ka, tb, kb, t3, tot, f, f2, sh, f3, stk2, ef2, ty, hex3, hok)

# IWhen on a typed state whose top three slots are (b, a, c)
def step3(+h: U32, +tc: D.DType, +kc: V.SKind, +ta: D.DType, +ka: V.SKind, +tb: D.DType, +kb: V.SKind, +totb: Bool, +t3: D.DType, +tot: Bool, -f: C.Frame, -f2: C.Frame, +sh: List<&2, Laws.Sh>, st: V.EvSt, +ef2: {f2 == f : C.Frame},
  ty: Laws.RunTy(h, tb, kb, totb, f2, Laws.Sh{ta, ka} <> Laws.Sh{tc, kc} <> sh, st), htot: @_x: {totb == False{} : Bool} -> {tot == False{} : Bool}, hex3: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, V.IWhen{}, f3, stk3) == V.EvSt{f3, V.Eval.app3(stk3)} : V.EvSt}, hok: {X.Expr.type.when.ok(tc, ta, tb) == Done{t3} : E.Res(D.DType)})
  -> StepW(h, V.IWhen{}, t3, V.SKind.comb(kc, V.SKind.comb(ka, kb)), tot, f, sh, st):
  match st:
    case V.EvSt{f3, r}:
      step3_a(h, tc, kc, ta, ka, tb, kb, totb, t3, tot, f, f2, sh, f3, r, ef2, ty, htot, hex3, hok)

# ---- Bin / FillNull: the left operand's code, then the right operand's from the state it left, then the step --

def bin_run_c(+h: U32, +i: V.Instr, +ta: D.DType, +ka: A.AKind, +tota: Bool, +tb: D.DType, +kb: A.AKind, +totb: Bool, +t3: D.DType, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, -code1: List<&2, V.Instr>, -f2: C.Frame, -stk1: List<&1, V.Slot>, +ef2: {f2 == f : C.Frame},
  eq1: {V.Eval.run(code, h, V.EvSt{f, Done{stk}}) == V.Eval.run(code1, h, V.EvSt{f2, Done{stk1}}) : V.EvSt},
  wb: Laws.RunW(h, tb, Laws.skind(kb), totb, f2, Laws.Sh{ta, Laws.skind(ka)} <> sh, stk1, i <> acc, code1), hex2: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, i, f3, stk3) == V.EvSt{f3, V.Eval.app2(i, stk3)} : V.EvSt}, opc: @na2: U32 -> @nb2: U32 -> @a4: C.Column -> @b4: C.Column -> @ha4: Laws.ColTy(ta, na2, a4) -> @hb4: Laws.ColTy(tb, nb2, b4) -> Laws.ResW(True{}, t3, na2, V.Eval.op2(i, a4, b4)))
  -> Laws.RunW(h, t3, V.SKind.comb(Laws.skind(ka), Laws.skind(kb)), Bool.and(tota, totb), f, sh, stk, acc, code):
  (st2, eq2, ty2) = wb
  run_step2(h, i, t3, V.SKind.comb(Laws.skind(ka), Laws.skind(kb)), Bool.and(tota, totb), f, sh, stk, acc, code, code1, V.EvSt{f2, Done{stk1}}, st2, eq1, eq2, step2(h, i, ta, Laws.skind(ka), tb, Laws.skind(kb), totb, t3, Bool.and(tota, totb), f, f2, sh, st2, ef2, ty2, x => (%Equal.sym(Bool, totb, False{}, x) : {Bool.and(tota, _) == False{} : Bool}; PV.and_false_r(tota)), hex2, opc))

def bin_run_b(+h: U32, +i: V.Instr, +b: X.Expr, +s: List<&2, S.Field>, +ta: D.DType, +ka: A.AKind, +tota: Bool, +tb: D.DType, +rsb: List<&2, String>, +kb: A.AKind, +totb: Bool, +locb: Bool, +t3: D.DType, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool},
  +erb: {A.Expr.analyse(b, s) == Done{A.Ana{tb, rsb, kb, totb, locb}} : E.Res(A.Ana)}, f2: C.Frame, r1: E.ResT(List<&1, V.Slot>),
  eq1: {V.Eval.run(code, h, V.EvSt{f, Done{stk}}) == V.Eval.run(V.Eval.compile(b, i <> acc), h, V.EvSt{f2, r1}) : V.EvSt}, ty1: Laws.ResSt(h, ta, Laws.skind(ka), tota, f, sh, f2, r1), ihb: IH(b, s, h), hex2: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, i, f3, stk3) == V.EvSt{f3, V.Eval.app2(i, stk3)} : V.EvSt}, opc: @na2: U32 -> @nb2: U32 -> @a4: C.Column -> @b4: C.Column -> @ha4: Laws.ColTy(ta, na2, a4) -> @hb4: Laws.ColTy(tb, nb2, b4) -> Laws.ResW(True{}, t3, na2, V.Eval.op2(i, a4, b4)))
  -> Laws.RunW(h, t3, V.SKind.comb(Laws.skind(ka), Laws.skind(kb)), Bool.and(tota, totb), f, sh, stk, acc, code):
  match r1:
    case Fail{e}:
      run_failed(h, t3, V.SKind.comb(Laws.skind(ka), Laws.skind(kb)), Bool.and(tota, totb), f, sh, stk, acc, code, V.Eval.compile(b, i <> acc), f2, e, eq1, (%Equal.sym(Bool, tota, False{}, ty1) : {Bool.and(_, totb) == False{} : Bool}; {==}))
    case Done{stk1}:
      (+ef2, ev1) = ty1
      bin_run_c(h, i, ta, ka, tota, tb, kb, totb, t3, f, sh, stk, acc, code, V.Eval.compile(b, i <> acc), f2, stk1, ef2, eq1, ihb(i <> acc, f2, stk1, Laws.Sh{ta, Laws.skind(ka)} <> sh, hs_along(f, f2, s, ef2, hs), hf_along(f, f2, h, ef2, hf), ev1, tb, rsb, kb, totb, locb, erb), hex2, opc)

def bin_run_a(+h: U32, +i: V.Instr, +b: X.Expr, +s: List<&2, S.Field>, +ta: D.DType, +ka: A.AKind, +tota: Bool, +tb: D.DType, +rsb: List<&2, String>, +kb: A.AKind, +totb: Bool, +locb: Bool, +t3: D.DType, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool},
  +erb: {A.Expr.analyse(b, s) == Done{A.Ana{tb, rsb, kb, totb, locb}} : E.Res(A.Ana)}, st1: V.EvSt,
  eq1: {V.Eval.run(code, h, V.EvSt{f, Done{stk}}) == V.Eval.run(V.Eval.compile(b, i <> acc), h, st1) : V.EvSt}, ty1: Laws.RunTy(h, ta, Laws.skind(ka), tota, f, sh, st1), ihb: IH(b, s, h), hex2: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, i, f3, stk3) == V.EvSt{f3, V.Eval.app2(i, stk3)} : V.EvSt}, opc: @na2: U32 -> @nb2: U32 -> @a4: C.Column -> @b4: C.Column -> @ha4: Laws.ColTy(ta, na2, a4) -> @hb4: Laws.ColTy(tb, nb2, b4) -> Laws.ResW(True{}, t3, na2, V.Eval.op2(i, a4, b4)))
  -> Laws.RunW(h, t3, V.SKind.comb(Laws.skind(ka), Laws.skind(kb)), Bool.and(tota, totb), f, sh, stk, acc, code):
  match st1:
    case V.EvSt{f2, r1}:
      bin_run_b(h, i, b, s, ta, ka, tota, tb, rsb, kb, totb, locb, t3, f, sh, stk, acc, code, hs, hf, erb, f2, r1, eq1, ty1, ihb, hex2, opc)

def bin_run(+h: U32, +i: V.Instr, +b: X.Expr, +s: List<&2, S.Field>, +ta: D.DType, +ka: A.AKind, +tota: Bool, +tb: D.DType, +rsb: List<&2, String>, +kb: A.AKind, +totb: Bool, +locb: Bool, +t3: D.DType, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool},
  +erb: {A.Expr.analyse(b, s) == Done{A.Ana{tb, rsb, kb, totb, locb}} : E.Res(A.Ana)}, wa: Laws.RunW(h, ta, Laws.skind(ka), tota, f, sh, stk, V.Eval.compile(b, i <> acc), code), ihb: IH(b, s, h), hex2: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, i, f3, stk3) == V.EvSt{f3, V.Eval.app2(i, stk3)} : V.EvSt}, opc: @na2: U32 -> @nb2: U32 -> @a4: C.Column -> @b4: C.Column -> @ha4: Laws.ColTy(ta, na2, a4) -> @hb4: Laws.ColTy(tb, nb2, b4) -> Laws.ResW(True{}, t3, na2, V.Eval.op2(i, a4, b4)))
  -> Laws.RunW(h, t3, V.SKind.comb(Laws.skind(ka), Laws.skind(kb)), Bool.and(tota, totb), f, sh, stk, acc, code):
  (st1, eq1, ty1) = wa
  bin_run_a(h, i, b, s, ta, ka, tota, tb, rsb, kb, totb, locb, t3, f, sh, stk, acc, code, hs, hf, erb, st1, eq1, ty1, ihb, hex2, opc)

# ---- bin ----

# the operation on two typed columns, as the step hypothesis opc
def bin_opc(+op: X.BinOp, +ta: D.DType, +tb: D.DType, +t3: D.DType, +na: U32, -nb: U32, hok: {X.Expr.type.bin.ok(op, ta, tb) == Done{t3} : E.Res(D.DType)}, a: C.Column, b: C.Column, ha: Laws.ColTy(ta, na, a), hb: Laws.ColTy(tb, nb, b)) -> Laws.ResW(True{}, t3, na, V.Eval.op2(V.IBin{op}, a, b)):
  (eda, ela) = ha
  (edb, elb) = hb
  resw_len(True{}, t3, na, Laws.clen(a), V.Eval.bin(op, a, b), ela, Laws.eval_bin_typed(op, a, b, t3, (%Equal.sym(D.DType, Laws.cdtype(a), ta, eda) : {X.Expr.type.bin.ok(op, _, Laws.cdtype(b)) == Done{t3} : E.Res(D.DType)}; (%Equal.sym(D.DType, Laws.cdtype(b), tb, edb) : {X.Expr.type.bin.ok(op, ta, _) == Done{t3} : E.Res(D.DType)}; hok))))

# the dtype rule answered Done{t3}: the record is (t3, join(ka, kb), and(tota, totb))
def bin_ana_k(+op: X.BinOp, +a: X.Expr, +b: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  +ta: D.DType, +rsa: List<&2, String>, +ka: A.AKind, +tota: Bool, +loca: Bool, +tb: D.DType, +rsb: List<&2, String>, +kb: A.AKind, +totb: Bool, +locb: Bool, rt: E.Res(D.DType), +ert: {X.Expr.type.bin.ok(op, ta, tb) == rt : E.Res(D.DType)},
  +era: {A.Expr.analyse(a, s) == Done{A.Ana{ta, rsa, ka, tota, loca}} : E.Res(A.Ana)}, +erb: {A.Expr.analyse(b, s) == Done{A.Ana{tb, rsb, kb, totb, locb}} : E.Res(A.Ana)},
  ha: {A.Ana.mk(rt, List.append(&2, String, rsa, rsb), A.AKind.join(ka, kb), Bool.and(tota, totb), Bool.and(loca, locb)) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, iha: IH(a, s, h), ihb: IH(b, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IBin{op} <> acc))):
  match rt:
    case Fail{e}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IBin{op} <> acc))), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{+t3}:
      +ea = L.done_inj(A.Ana, A.Ana{t3, List.append(&2, String, rsa, rsb), A.AKind.join(ka, kb), Bool.and(tota, totb), Bool.and(loca, locb)}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(t3, List.append(&2, String, rsa, rsb), A.AKind.join(ka, kb), Bool.and(tota, totb), Bool.and(loca, locb), t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IBin{op} <> acc)))
      %ana_tot_inj(t3, List.append(&2, String, rsa, rsb), A.AKind.join(ka, kb), Bool.and(tota, totb), Bool.and(loca, locb), t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(A.AKind.join(ka, kb)), _, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IBin{op} <> acc)))
      %ana_t_inj(t3, List.append(&2, String, rsa, rsb), A.AKind.join(ka, kb), Bool.and(tota, totb), Bool.and(loca, locb), t, rs, k, tot, loc, ea) : Laws.RunW(h, _, Laws.skind(A.AKind.join(ka, kb)), Bool.and(tota, totb), f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IBin{op} <> acc)))
      %Equal.sym(V.SKind, Laws.skind(A.AKind.join(ka, kb)), V.SKind.comb(Laws.skind(ka), Laws.skind(kb)), skind_join(ka, kb)) : Laws.RunW(h, t3, _, Bool.and(tota, totb), f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IBin{op} <> acc)))
      bin_run(h, V.IBin{op}, b, s, ta, ka, tota, tb, rsb, kb, totb, locb, t3, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IBin{op} <> acc)), hs, hf, erb, iha(V.Eval.compile(b, V.IBin{op} <> acc), f, stk, sh, hs, hf, ev, ta, rsa, ka, tota, loca, era), ihb, f3 => stk3 => {==}, na2 => nb2 => a4 => b4 => ha4 => hb4 => bin_opc(op, ta, tb, t3, na2, nb2, ert, a4, b4, ha4, hb4))

# the node: both operand records (the Fail rows refuted, left first), then the dtype rule
def bin_ana(+op: X.BinOp, +a: X.Expr, +b: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  ra: E.Res(A.Ana), +era: {A.Expr.analyse(a, s) == ra : E.Res(A.Ana)}, rb: E.Res(A.Ana), +erb: {A.Expr.analyse(b, s) == rb : E.Res(A.Ana)}, ha: {A.Ana.bin(op, ra, rb) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, iha: IH(a, s, h), ihb: IH(b, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IBin{op} <> acc))):
  match ra rb:
    case Fail{e} _:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IBin{op} <> acc))), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{x} Fail{e}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IBin{op} <> acc))), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{A.Ana{+ta, +rsa, +ka, +tota, +loca}} Done{A.Ana{+tb, +rsb, +kb, +totb, +locb}}:
      bin_ana_k(op, a, b, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, ta, rsa, ka, tota, loca, tb, rsb, kb, totb, locb, X.Expr.type.bin.ok(op, ta, tb), {==}, era, erb, ha, iha, ihb)

# ---- fill ----

# the operation on two typed columns, as the step hypothesis opc
def fill_opc(+ta: D.DType, +tb: D.DType, +t3: D.DType, +na: U32, -nb: U32, hok: {X.Expr.type.fill(Done{ta}, Done{tb}) == Done{t3} : E.Res(D.DType)}, a: C.Column, b: C.Column, ha: Laws.ColTy(ta, na, a), hb: Laws.ColTy(tb, nb, b)) -> Laws.ResW(True{}, t3, na, V.Eval.op2(V.IFill{}, a, b)):
  (eda, ela) = ha
  (edb, elb) = hb
  resw_len(True{}, t3, na, Laws.clen(a), V.Eval.fill(a, b), ela, Laws.eval_fill_typed(a, b, t3, (%Equal.sym(D.DType, Laws.cdtype(a), ta, eda) : {X.Expr.type.fill(Done{_}, Done{Laws.cdtype(b)}) == Done{t3} : E.Res(D.DType)}; (%Equal.sym(D.DType, Laws.cdtype(b), tb, edb) : {X.Expr.type.fill(Done{ta}, Done{_}) == Done{t3} : E.Res(D.DType)}; hok))))

# the dtype rule answered Done{t3}: the record is (t3, join(ka, kb), and(tota, totb))
def fill_ana_k(+a: X.Expr, +b: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  +ta: D.DType, +rsa: List<&2, String>, +ka: A.AKind, +tota: Bool, +loca: Bool, +tb: D.DType, +rsb: List<&2, String>, +kb: A.AKind, +totb: Bool, +locb: Bool, rt: E.Res(D.DType), +ert: {X.Expr.type.fill(Done{ta}, Done{tb}) == rt : E.Res(D.DType)},
  +era: {A.Expr.analyse(a, s) == Done{A.Ana{ta, rsa, ka, tota, loca}} : E.Res(A.Ana)}, +erb: {A.Expr.analyse(b, s) == Done{A.Ana{tb, rsb, kb, totb, locb}} : E.Res(A.Ana)},
  ha: {A.Ana.mk(rt, List.append(&2, String, rsa, rsb), A.AKind.join(ka, kb), Bool.and(tota, totb), Bool.and(loca, locb)) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, iha: IH(a, s, h), ihb: IH(b, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IFill{} <> acc))):
  match rt:
    case Fail{e}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IFill{} <> acc))), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{+t3}:
      +ea = L.done_inj(A.Ana, A.Ana{t3, List.append(&2, String, rsa, rsb), A.AKind.join(ka, kb), Bool.and(tota, totb), Bool.and(loca, locb)}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(t3, List.append(&2, String, rsa, rsb), A.AKind.join(ka, kb), Bool.and(tota, totb), Bool.and(loca, locb), t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IFill{} <> acc)))
      %ana_tot_inj(t3, List.append(&2, String, rsa, rsb), A.AKind.join(ka, kb), Bool.and(tota, totb), Bool.and(loca, locb), t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(A.AKind.join(ka, kb)), _, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IFill{} <> acc)))
      %ana_t_inj(t3, List.append(&2, String, rsa, rsb), A.AKind.join(ka, kb), Bool.and(tota, totb), Bool.and(loca, locb), t, rs, k, tot, loc, ea) : Laws.RunW(h, _, Laws.skind(A.AKind.join(ka, kb)), Bool.and(tota, totb), f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IFill{} <> acc)))
      %Equal.sym(V.SKind, Laws.skind(A.AKind.join(ka, kb)), V.SKind.comb(Laws.skind(ka), Laws.skind(kb)), skind_join(ka, kb)) : Laws.RunW(h, t3, _, Bool.and(tota, totb), f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IFill{} <> acc)))
      bin_run(h, V.IFill{}, b, s, ta, ka, tota, tb, rsb, kb, totb, locb, t3, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IFill{} <> acc)), hs, hf, erb, iha(V.Eval.compile(b, V.IFill{} <> acc), f, stk, sh, hs, hf, ev, ta, rsa, ka, tota, loca, era), ihb, f3 => stk3 => {==}, na2 => nb2 => a4 => b4 => ha4 => hb4 => fill_opc(ta, tb, t3, na2, nb2, ert, a4, b4, ha4, hb4))

# the node: both operand records (the Fail rows refuted, left first), then the dtype rule
def fill_ana(+a: X.Expr, +b: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  ra: E.Res(A.Ana), +era: {A.Expr.analyse(a, s) == ra : E.Res(A.Ana)}, rb: E.Res(A.Ana), +erb: {A.Expr.analyse(b, s) == rb : E.Res(A.Ana)}, ha: {A.Ana.fill(ra, rb) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, iha: IH(a, s, h), ihb: IH(b, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IFill{} <> acc))):
  match ra rb:
    case Fail{e} _:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IFill{} <> acc))), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{x} Fail{e}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(a, V.Eval.compile(b, V.IFill{} <> acc))), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{A.Ana{+ta, +rsa, +ka, +tota, +loca}} Done{A.Ana{+tb, +rsb, +kb, +totb, +locb}}:
      fill_ana_k(a, b, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, ta, rsa, ka, tota, loca, tb, rsb, kb, totb, locb, X.Expr.type.fill(Done{ta}, Done{tb}), {==}, era, erb, ha, iha, ihb)

# ---- When: c's code, then a's, then b's, then IWhen --------------------------------------------------------

# after b: the step
def when_run_f(+h: U32, +a: X.Expr, +b: X.Expr, +s: List<&2, S.Field>, +tc: D.DType, +rsc: List<&2, String>, +kc: A.AKind, +xc: Bool, +lc: Bool, +ta: D.DType, +rsa: List<&2, String>, +ka: A.AKind, +xa: Bool, +la: Bool, +tb: D.DType, +rsb: List<&2, String>, +kb: A.AKind, +xb: Bool, +lb: Bool, +t3: D.DType, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, +era: {A.Expr.analyse(a, s) == Done{A.Ana{ta, rsa, ka, xa, la}} : E.Res(A.Ana)}, +erb: {A.Expr.analyse(b, s) == Done{A.Ana{tb, rsb, kb, xb, lb}} : E.Res(A.Ana)}, hok: {X.Expr.type.when.ok(tc, ta, tb) == Done{t3} : E.Res(D.DType)}, -f3: C.Frame, -stk2: List<&1, V.Slot>, +ef3: {f3 == f : C.Frame},
  eq12: {V.Eval.run(code, h, V.EvSt{f, Done{stk}}) == V.Eval.run(V.Eval.compile(b, V.IWhen{} <> acc), h, V.EvSt{f3, Done{stk2}}) : V.EvSt},
  wb: Laws.RunW(h, tb, Laws.skind(kb), xb, f3, Laws.Sh{ta, Laws.skind(ka)} <> Laws.Sh{tc, Laws.skind(kc)} <> sh, stk2, V.IWhen{} <> acc, V.Eval.compile(b, V.IWhen{} <> acc)))
  -> Laws.RunW(h, t3, V.SKind.comb(Laws.skind(kc), V.SKind.comb(Laws.skind(ka), Laws.skind(kb))), Bool.and(xc, Bool.and(xa, xb)), f, sh, stk, acc, code):
  (st3, eq3, ty3) = wb
  run_step2(h, V.IWhen{}, t3, V.SKind.comb(Laws.skind(kc), V.SKind.comb(Laws.skind(ka), Laws.skind(kb))), Bool.and(xc, Bool.and(xa, xb)), f, sh, stk, acc, code, V.Eval.compile(b, V.IWhen{} <> acc), V.EvSt{f3, Done{stk2}}, st3, eq12, eq3, step3(h, tc, Laws.skind(kc), ta, Laws.skind(ka), tb, Laws.skind(kb), xb, t3, Bool.and(xc, Bool.and(xa, xb)), f, f3, sh, st3, ef3, ty3, x => (%Equal.sym(Bool, xb, False{}, x) : {Bool.and(xc, Bool.and(xa, _)) == False{} : Bool}; (%Equal.sym(Bool, Bool.and(xa, False{}), False{}, PV.and_false_r(xa)) : {Bool.and(xc, _) == False{} : Bool}; PV.and_false_r(xc))), f4 => stk4 => {==}, hok))

# after a: its state (Fail keeps failing; Done runs b from it)
def when_run_e(+h: U32, +a: X.Expr, +b: X.Expr, +s: List<&2, S.Field>, +tc: D.DType, +rsc: List<&2, String>, +kc: A.AKind, +xc: Bool, +lc: Bool, +ta: D.DType, +rsa: List<&2, String>, +ka: A.AKind, +xa: Bool, +la: Bool, +tb: D.DType, +rsb: List<&2, String>, +kb: A.AKind, +xb: Bool, +lb: Bool, +t3: D.DType, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, +era: {A.Expr.analyse(a, s) == Done{A.Ana{ta, rsa, ka, xa, la}} : E.Res(A.Ana)}, +erb: {A.Expr.analyse(b, s) == Done{A.Ana{tb, rsb, kb, xb, lb}} : E.Res(A.Ana)}, hok: {X.Expr.type.when.ok(tc, ta, tb) == Done{t3} : E.Res(D.DType)}, -f2: C.Frame, +ef2: {f2 == f : C.Frame}, f3: C.Frame, r2: E.ResT(List<&1, V.Slot>),
  eq12: {V.Eval.run(code, h, V.EvSt{f, Done{stk}}) == V.Eval.run(V.Eval.compile(b, V.IWhen{} <> acc), h, V.EvSt{f3, r2}) : V.EvSt},
  ty2: Laws.ResSt(h, ta, Laws.skind(ka), xa, f2, Laws.Sh{tc, Laws.skind(kc)} <> sh, f3, r2), ihb: IH(b, s, h))
  -> Laws.RunW(h, t3, V.SKind.comb(Laws.skind(kc), V.SKind.comb(Laws.skind(ka), Laws.skind(kb))), Bool.and(xc, Bool.and(xa, xb)), f, sh, stk, acc, code):
  match r2:
    case Fail{e}:
      run_failed(h, t3, V.SKind.comb(Laws.skind(kc), V.SKind.comb(Laws.skind(ka), Laws.skind(kb))), Bool.and(xc, Bool.and(xa, xb)), f, sh, stk, acc, code, V.Eval.compile(b, V.IWhen{} <> acc), f3, e, eq12, (%Equal.sym(Bool, xa, False{}, ty2) : {Bool.and(xc, Bool.and(_, xb)) == False{} : Bool}; PV.and_false_r(xc)))
    case Done{stk2}:
      (ef32, ev2) = ty2
      +ef3 = Equal.trans(C.Frame, f3, f2, f, ef32, ef2)
      when_run_f(h, a, b, s, tc, rsc, kc, xc, lc, ta, rsa, ka, xa, la, tb, rsb, kb, xb, lb, t3, f, sh, stk, acc, code, hs, hf, era, erb, hok, f3, stk2, ef3, eq12, ihb(V.IWhen{} <> acc, f3, stk2, Laws.Sh{ta, Laws.skind(ka)} <> Laws.Sh{tc, Laws.skind(kc)} <> sh, hs_along(f, f3, s, ef3, hs), hf_along(f, f3, h, ef3, hf), ev2, tb, rsb, kb, xb, lb, erb))

def when_run_dd(+h: U32, +a: X.Expr, +b: X.Expr, +s: List<&2, S.Field>, +tc: D.DType, +rsc: List<&2, String>, +kc: A.AKind, +xc: Bool, +lc: Bool, +ta: D.DType, +rsa: List<&2, String>, +ka: A.AKind, +xa: Bool, +la: Bool, +tb: D.DType, +rsb: List<&2, String>, +kb: A.AKind, +xb: Bool, +lb: Bool, +t3: D.DType, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, +era: {A.Expr.analyse(a, s) == Done{A.Ana{ta, rsa, ka, xa, la}} : E.Res(A.Ana)}, +erb: {A.Expr.analyse(b, s) == Done{A.Ana{tb, rsb, kb, xb, lb}} : E.Res(A.Ana)}, hok: {X.Expr.type.when.ok(tc, ta, tb) == Done{t3} : E.Res(D.DType)}, -f2: C.Frame, +ef2: {f2 == f : C.Frame}, st2: V.EvSt,
  eq12: {V.Eval.run(code, h, V.EvSt{f, Done{stk}}) == V.Eval.run(V.Eval.compile(b, V.IWhen{} <> acc), h, st2) : V.EvSt},
  ty2: Laws.RunTy(h, ta, Laws.skind(ka), xa, f2, Laws.Sh{tc, Laws.skind(kc)} <> sh, st2), ihb: IH(b, s, h))
  -> Laws.RunW(h, t3, V.SKind.comb(Laws.skind(kc), V.SKind.comb(Laws.skind(ka), Laws.skind(kb))), Bool.and(xc, Bool.and(xa, xb)), f, sh, stk, acc, code):
  match st2:
    case V.EvSt{f3, r2}:
      when_run_e(h, a, b, s, tc, rsc, kc, xc, lc, ta, rsa, ka, xa, la, tb, rsb, kb, xb, lb, t3, f, sh, stk, acc, code, hs, hf, era, erb, hok, f2, ef2, f3, r2, eq12, ty2, ihb)

def when_run_d(+h: U32, +a: X.Expr, +b: X.Expr, +s: List<&2, S.Field>, +tc: D.DType, +rsc: List<&2, String>, +kc: A.AKind, +xc: Bool, +lc: Bool, +ta: D.DType, +rsa: List<&2, String>, +ka: A.AKind, +xa: Bool, +la: Bool, +tb: D.DType, +rsb: List<&2, String>, +kb: A.AKind, +xb: Bool, +lb: Bool, +t3: D.DType, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, +era: {A.Expr.analyse(a, s) == Done{A.Ana{ta, rsa, ka, xa, la}} : E.Res(A.Ana)}, +erb: {A.Expr.analyse(b, s) == Done{A.Ana{tb, rsb, kb, xb, lb}} : E.Res(A.Ana)}, hok: {X.Expr.type.when.ok(tc, ta, tb) == Done{t3} : E.Res(D.DType)}, -f2: C.Frame, -stk1: List<&1, V.Slot>, +ef2: {f2 == f : C.Frame},
  eq1: {V.Eval.run(code, h, V.EvSt{f, Done{stk}}) == V.Eval.run(V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc)), h, V.EvSt{f2, Done{stk1}}) : V.EvSt},
  wa: Laws.RunW(h, ta, Laws.skind(ka), xa, f2, Laws.Sh{tc, Laws.skind(kc)} <> sh, stk1, V.Eval.compile(b, V.IWhen{} <> acc), V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc))), ihb: IH(b, s, h))
  -> Laws.RunW(h, t3, V.SKind.comb(Laws.skind(kc), V.SKind.comb(Laws.skind(ka), Laws.skind(kb))), Bool.and(xc, Bool.and(xa, xb)), f, sh, stk, acc, code):
  (st2, eq2, ty2) = wa
  when_run_dd(h, a, b, s, tc, rsc, kc, xc, lc, ta, rsa, ka, xa, la, tb, rsb, kb, xb, lb, t3, f, sh, stk, acc, code, hs, hf, era, erb, hok, f2, ef2, st2, Equal.trans(V.EvSt, V.Eval.run(code, h, V.EvSt{f, Done{stk}}), V.Eval.run(V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc)), h, V.EvSt{f2, Done{stk1}}), V.Eval.run(V.Eval.compile(b, V.IWhen{} <> acc), h, st2), eq1, eq2), ty2, ihb)

# after c: its state (Fail keeps failing; Done runs a from it)
def when_run_b(+h: U32, +a: X.Expr, +b: X.Expr, +s: List<&2, S.Field>, +tc: D.DType, +rsc: List<&2, String>, +kc: A.AKind, +xc: Bool, +lc: Bool, +ta: D.DType, +rsa: List<&2, String>, +ka: A.AKind, +xa: Bool, +la: Bool, +tb: D.DType, +rsb: List<&2, String>, +kb: A.AKind, +xb: Bool, +lb: Bool, +t3: D.DType, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, +era: {A.Expr.analyse(a, s) == Done{A.Ana{ta, rsa, ka, xa, la}} : E.Res(A.Ana)}, +erb: {A.Expr.analyse(b, s) == Done{A.Ana{tb, rsb, kb, xb, lb}} : E.Res(A.Ana)}, hok: {X.Expr.type.when.ok(tc, ta, tb) == Done{t3} : E.Res(D.DType)}, f2: C.Frame, r1: E.ResT(List<&1, V.Slot>),
  eq1: {V.Eval.run(code, h, V.EvSt{f, Done{stk}}) == V.Eval.run(V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc)), h, V.EvSt{f2, r1}) : V.EvSt},
  ty1: Laws.ResSt(h, tc, Laws.skind(kc), xc, f, sh, f2, r1), iha: IH(a, s, h), ihb: IH(b, s, h))
  -> Laws.RunW(h, t3, V.SKind.comb(Laws.skind(kc), V.SKind.comb(Laws.skind(ka), Laws.skind(kb))), Bool.and(xc, Bool.and(xa, xb)), f, sh, stk, acc, code):
  match r1:
    case Fail{e}:
      run_failed(h, t3, V.SKind.comb(Laws.skind(kc), V.SKind.comb(Laws.skind(ka), Laws.skind(kb))), Bool.and(xc, Bool.and(xa, xb)), f, sh, stk, acc, code, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc)), f2, e, eq1, (%Equal.sym(Bool, xc, False{}, ty1) : {Bool.and(_, Bool.and(xa, xb)) == False{} : Bool}; {==}))
    case Done{stk1}:
      (+ef2, ev1) = ty1
      when_run_d(h, a, b, s, tc, rsc, kc, xc, lc, ta, rsa, ka, xa, la, tb, rsb, kb, xb, lb, t3, f, sh, stk, acc, code, hs, hf, era, erb, hok, f2, stk1, ef2, eq1, iha(V.Eval.compile(b, V.IWhen{} <> acc), f2, stk1, Laws.Sh{tc, Laws.skind(kc)} <> sh, hs_along(f, f2, s, ef2, hs), hf_along(f, f2, h, ef2, hf), ev1, ta, rsa, ka, xa, la, era), ihb)

def when_run_a(+h: U32, +a: X.Expr, +b: X.Expr, +s: List<&2, S.Field>, +tc: D.DType, +rsc: List<&2, String>, +kc: A.AKind, +xc: Bool, +lc: Bool, +ta: D.DType, +rsa: List<&2, String>, +ka: A.AKind, +xa: Bool, +la: Bool, +tb: D.DType, +rsb: List<&2, String>, +kb: A.AKind, +xb: Bool, +lb: Bool, +t3: D.DType, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, +era: {A.Expr.analyse(a, s) == Done{A.Ana{ta, rsa, ka, xa, la}} : E.Res(A.Ana)}, +erb: {A.Expr.analyse(b, s) == Done{A.Ana{tb, rsb, kb, xb, lb}} : E.Res(A.Ana)}, hok: {X.Expr.type.when.ok(tc, ta, tb) == Done{t3} : E.Res(D.DType)}, st1: V.EvSt,
  eq1: {V.Eval.run(code, h, V.EvSt{f, Done{stk}}) == V.Eval.run(V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc)), h, st1) : V.EvSt},
  ty1: Laws.RunTy(h, tc, Laws.skind(kc), xc, f, sh, st1), iha: IH(a, s, h), ihb: IH(b, s, h))
  -> Laws.RunW(h, t3, V.SKind.comb(Laws.skind(kc), V.SKind.comb(Laws.skind(ka), Laws.skind(kb))), Bool.and(xc, Bool.and(xa, xb)), f, sh, stk, acc, code):
  match st1:
    case V.EvSt{f2, r1}:
      when_run_b(h, a, b, s, tc, rsc, kc, xc, lc, ta, rsa, ka, xa, la, tb, rsb, kb, xb, lb, t3, f, sh, stk, acc, code, hs, hf, era, erb, hok, f2, r1, eq1, ty1, iha, ihb)

def when_run(+h: U32, +a: X.Expr, +b: X.Expr, +s: List<&2, S.Field>, +tc: D.DType, +rsc: List<&2, String>, +kc: A.AKind, +xc: Bool, +lc: Bool, +ta: D.DType, +rsa: List<&2, String>, +ka: A.AKind, +xa: Bool, +la: Bool, +tb: D.DType, +rsb: List<&2, String>, +kb: A.AKind, +xb: Bool, +lb: Bool, +t3: D.DType, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, +era: {A.Expr.analyse(a, s) == Done{A.Ana{ta, rsa, ka, xa, la}} : E.Res(A.Ana)}, +erb: {A.Expr.analyse(b, s) == Done{A.Ana{tb, rsb, kb, xb, lb}} : E.Res(A.Ana)}, hok: {X.Expr.type.when.ok(tc, ta, tb) == Done{t3} : E.Res(D.DType)}, wc: Laws.RunW(h, tc, Laws.skind(kc), xc, f, sh, stk, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc)), code), iha: IH(a, s, h), ihb: IH(b, s, h))
  -> Laws.RunW(h, t3, V.SKind.comb(Laws.skind(kc), V.SKind.comb(Laws.skind(ka), Laws.skind(kb))), Bool.and(xc, Bool.and(xa, xb)), f, sh, stk, acc, code):
  (st1, eq1, ty1) = wc
  when_run_a(h, a, b, s, tc, rsc, kc, xc, lc, ta, rsa, ka, xa, la, tb, rsb, kb, xb, lb, t3, f, sh, stk, acc, code, hs, hf, era, erb, hok, st1, eq1, ty1, iha, ihb)

# the dtype rule answered Done{t3}: the record is (t3, join(kc, join(ka, kb)), and(xc, and(xa, xb)))
def when_ana_k(+c: X.Expr, +a: X.Expr, +b: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  +tc: D.DType, +rsc: List<&2, String>, +kc: A.AKind, +xc: Bool, +lc: Bool, +ta: D.DType, +rsa: List<&2, String>, +ka: A.AKind, +xa: Bool, +la: Bool, +tb: D.DType, +rsb: List<&2, String>, +kb: A.AKind, +xb: Bool, +lb: Bool, rt: E.Res(D.DType), +ert: {X.Expr.type.when.ok(tc, ta, tb) == rt : E.Res(D.DType)},
  +erc: {A.Expr.analyse(c, s) == Done{A.Ana{tc, rsc, kc, xc, lc}} : E.Res(A.Ana)}, +era: {A.Expr.analyse(a, s) == Done{A.Ana{ta, rsa, ka, xa, la}} : E.Res(A.Ana)}, +erb: {A.Expr.analyse(b, s) == Done{A.Ana{tb, rsb, kb, xb, lb}} : E.Res(A.Ana)},
  ha: {A.Ana.mk(rt, List.append(&2, String, rsc, List.append(&2, String, rsa, rsb)), A.AKind.join(kc, A.AKind.join(ka, kb)), Bool.and(xc, Bool.and(xa, xb)), Bool.and(lc, Bool.and(la, lb))) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)},
  ihc: IH(c, s, h), iha: IH(a, s, h), ihb: IH(b, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(c, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc)))):
  match rt:
    case Fail{e}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(c, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc)))), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{+t3}:
      +ea = L.done_inj(A.Ana, A.Ana{t3, List.append(&2, String, rsc, List.append(&2, String, rsa, rsb)), A.AKind.join(kc, A.AKind.join(ka, kb)), Bool.and(xc, Bool.and(xa, xb)), Bool.and(lc, Bool.and(la, lb))}, A.Ana{t, rs, k, tot, loc}, ha)
      %ana_k_inj(t3, List.append(&2, String, rsc, List.append(&2, String, rsa, rsb)), A.AKind.join(kc, A.AKind.join(ka, kb)), Bool.and(xc, Bool.and(xa, xb)), Bool.and(lc, Bool.and(la, lb)), t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(_), tot, f, sh, stk, acc, V.Eval.compile(c, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc))))
      %ana_tot_inj(t3, List.append(&2, String, rsc, List.append(&2, String, rsa, rsb)), A.AKind.join(kc, A.AKind.join(ka, kb)), Bool.and(xc, Bool.and(xa, xb)), Bool.and(lc, Bool.and(la, lb)), t, rs, k, tot, loc, ea) : Laws.RunW(h, t, Laws.skind(A.AKind.join(kc, A.AKind.join(ka, kb))), _, f, sh, stk, acc, V.Eval.compile(c, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc))))
      %ana_t_inj(t3, List.append(&2, String, rsc, List.append(&2, String, rsa, rsb)), A.AKind.join(kc, A.AKind.join(ka, kb)), Bool.and(xc, Bool.and(xa, xb)), Bool.and(lc, Bool.and(la, lb)), t, rs, k, tot, loc, ea) : Laws.RunW(h, _, Laws.skind(A.AKind.join(kc, A.AKind.join(ka, kb))), Bool.and(xc, Bool.and(xa, xb)), f, sh, stk, acc, V.Eval.compile(c, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc))))
      %Equal.sym(V.SKind, Laws.skind(A.AKind.join(kc, A.AKind.join(ka, kb))), V.SKind.comb(Laws.skind(kc), Laws.skind(A.AKind.join(ka, kb))), skind_join(kc, A.AKind.join(ka, kb))) : Laws.RunW(h, t3, _, Bool.and(xc, Bool.and(xa, xb)), f, sh, stk, acc, V.Eval.compile(c, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc))))
      %Equal.sym(V.SKind, Laws.skind(A.AKind.join(ka, kb)), V.SKind.comb(Laws.skind(ka), Laws.skind(kb)), skind_join(ka, kb)) : Laws.RunW(h, t3, V.SKind.comb(Laws.skind(kc), _), Bool.and(xc, Bool.and(xa, xb)), f, sh, stk, acc, V.Eval.compile(c, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc))))
      when_run(h, a, b, s, tc, rsc, kc, xc, lc, ta, rsa, ka, xa, la, tb, rsb, kb, xb, lb, t3, f, sh, stk, acc, V.Eval.compile(c, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc))), hs, hf, era, erb, ert, ihc(V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc)), f, stk, sh, hs, hf, ev, tc, rsc, kc, xc, lc, erc), iha, ihb)

# the node: the three operand records (the Fail rows refuted, left to right), then the dtype rule
def when_ana(+c: X.Expr, +a: X.Expr, +b: X.Expr, +s: List<&2, S.Field>, +h: U32, +acc: List<&2, V.Instr>, f: C.Frame, stk: List<&1, V.Slot>, +sh: List<&2, Laws.Sh>, +hs: {Laws.fschema(f) == s : List<&2, S.Field>}, +hf: {Laws.frame_ok(h, f) == True{} : Bool}, ev: Laws.StkTy(h, sh, stk), +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool,
  rc: E.Res(A.Ana), +erc: {A.Expr.analyse(c, s) == rc : E.Res(A.Ana)}, ra: E.Res(A.Ana), +era: {A.Expr.analyse(a, s) == ra : E.Res(A.Ana)}, rb: E.Res(A.Ana), +erb: {A.Expr.analyse(b, s) == rb : E.Res(A.Ana)},
  ha: {A.Ana.when(rc, ra, rb) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, ihc: IH(c, s, h), iha: IH(a, s, h), ihb: IH(b, s, h))
  -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(c, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc)))):
  match rc ra rb:
    case Fail{e} _ _:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(c, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc)))), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{x} Fail{e} _:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(c, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc)))), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{x} Done{y} Fail{e}:
      Empty.absurd(Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(c, V.Eval.compile(a, V.Eval.compile(b, V.IWhen{} <> acc)))), L.fail_done(A.Ana, e, A.Ana{t, rs, k, tot, loc}, ha))
    case Done{A.Ana{+tc, +rsc, +kc, +xc, +lc}} Done{A.Ana{+ta, +rsa, +ka, +xa, +la}} Done{A.Ana{+tb, +rsb, +kb, +xb, +lb}}:
      when_ana_k(c, a, b, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, tc, rsc, kc, xc, lc, ta, rsa, ka, xa, la, tb, rsb, kb, xb, lb, X.Expr.type.when.ok(tc, ta, tb), {==}, erc, era, erb, ha, ihc, iha, ihb)

# ---- the law: induction over the expression, the IH as a lambda over the operand -------------------------

def Laws.run_typed(e, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, ha):
  match e:
    case X.Col{+n}:
      col_ana(n, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, S.Schema.find(s, n), {==}, ha)
    case X.Lit{+v}:
      lit_ana(v, h, acc, f, stk, sh, ev, t, rs, k, tot, loc, ha)
    case X.Alias{e2, n}:
      Laws.run_typed(e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, ha)
    case X.Cast{+e2, +to}:
      cast_ana(to, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, X.Expr.is_null_lit(e2), A.Expr.analyse(e2, s), {==}, ha, acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(e2, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2))
    case X.TryCast{+e2, +to}:
      trycast_ana(to, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, X.Expr.is_null_lit(e2), A.Expr.analyse(e2, s), {==}, ha, acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(e2, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2))
    case X.Un{+op, +e2}:
      un_ana(op, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, A.Expr.analyse(e2, s), {==}, ha, acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(e2, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2))
    case X.Bin{+op, +a, +b}:
      bin_ana(op, a, b, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, A.Expr.analyse(a, s), {==}, A.Expr.analyse(b, s), {==}, ha, acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(a, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2), acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(b, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2))
    case X.FillNull{+a, +b}:
      fill_ana(a, b, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, A.Expr.analyse(a, s), {==}, A.Expr.analyse(b, s), {==}, ha, acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(a, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2), acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(b, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2))
    case X.Agg{+op, +e2}:
      agg_ana(op, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, A.Expr.analyse(e2, s), {==}, ha, acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(e2, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2))
    case X.When{+c, +a, +b}:
      when_ana(c, a, b, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, A.Expr.analyse(c, s), {==}, A.Expr.analyse(a, s), {==}, A.Expr.analyse(b, s), {==}, ha, acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(c, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2), acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(a, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2), acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(b, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2))
    case X.IsIn{+e2, +vs}:
      isin_ana(vs, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, A.Expr.analyse(e2, s), {==}, ha, acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(e2, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2))
    case X.Clip{+e2, +lo, +hi}:
      clip_ana(lo, hi, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, A.Expr.analyse(e2, s), {==}, ha, acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(e2, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2))
    case X.StrPred{+op, +e2, +p}:
      strpred_ana(op, p, e2, s, h, acc, f, stk, sh, hs, hf, ev, t, rs, k, tot, loc, A.Expr.analyse(e2, s), {==}, ha, acc2 => f2 => stk2 => sh2 => hs2 => hf2 => ev2 => t2 => rs2 => k2 => tot2 => loc2 => ha2 => Laws.run_typed(e2, s, h, acc2, f2, stk2, sh2, hs2, hf2, ev2, t2, rs2, k2, tot2, loc2, ha2))

# ---- the entry points: Eval.full (every 1-row result broadcast) and Eval.expr (a reduction stays 1 row) --------

# the height of the entry point's answer: Eval.full gives the frame's height, Eval.expr elen of the kind
def mlen(full: Bool, k: A.AKind, +h: U32) -> U32:
  match full:
    case True{}:
      h
    case False{}:
      Laws.elen(k, h)

# the slot's column fitted by Eval.unslot has the kind's height
def mode_k(full: Bool, k: A.AKind, +h: U32, +hh: U32, +t: D.DType, +eh: {h == hh : U32}, c: C.Column, hc: Laws.ColTy(t, Laws.klen(Laws.skind(k), h), c)) -> Laws.ColTy(t, mlen(full, k, hh), V.Eval.fit(V.Eval.unslot.k(full, Laws.skind(k)), c, hh)):
  match full k:
    case True{} A.KRow{}:
      (ed, el) = hc
      (ed, Equal.trans(U32, Laws.clen(c), h, hh, el, eh))
    case True{} A.KScalar{}:
      (+ed, el) = hc
      colw_ty(t, hh, V.Eval.bcast(c, hh), c, ed, Laws.bcast_typed(c, hh))
    case True{} A.KRed{}:
      (+ed, el) = hc
      colw_ty(t, hh, V.Eval.bcast(c, hh), c, ed, Laws.bcast_typed(c, hh))
    case False{} A.KRow{}:
      (ed, el) = hc
      (ed, Equal.trans(U32, Laws.clen(c), h, hh, el, eh))
    case False{} A.KScalar{}:
      (+ed, el) = hc
      colw_ty(t, hh, V.Eval.bcast(c, hh), c, ed, Laws.bcast_typed(c, hh))
    case False{} A.KRed{}:
      hc

# Frame.height with the height as a Data value beside the frame
def height_dup(f: C.Frame) -> &f2: C.Frame -> &n: U32 -> {n == Laws.fheight(f) : U32} & {C.Frame.height(f) == (f2, n) : C.Frame & U32} & {f2 == f : C.Frame}:
  match f:
    case C.Frame{+h, cols}:
      (C.Frame{h, cols}, h, {==}, {==}, {==})

# the final state's single slot: Eval.unslot fits it to the height
def mode_fin_d(+full: Bool, +h: U32, +t: D.DType, +k: A.AKind, +tot: Bool, -f2: C.Frame, -f5: C.Frame, f6: C.Frame, +hn: U32, +e52: {f5 == f2 : C.Frame}, +eh: {h == Laws.fheight(f2) : U32}, +en: {hn == Laws.fheight(f5) : U32}, ef6: {f6 == f5 : C.Frame}, +k2: V.SKind, c: C.Column, rest: List<&1, V.Slot>,
  hk: {k2 == Laws.skind(k) : V.SKind}, hc: Laws.ColTy(t, Laws.klen(Laws.skind(k), h), c), ev: Laws.StkTy(h, Nil{}, rest))
  -> Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.b(full, V.Eval.fin.one(V.Slot{k2, c} <> rest), (f6, hn))):
  match rest:
    case x <> xs:
      Empty.absurd(Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.b(full, V.Eval.fin.one(V.Slot{k2, c} <> x <> xs), (f6, hn))), ev)
    case Nil{}:
      %e52 : Laws.EvalTyR(t, tot, mlen(full, k, Laws.fheight(_)), _, f6, Done{V.Eval.fit(V.Eval.unslot.k(full, k2), c, hn)})
      %en : Laws.EvalTyR(t, tot, mlen(full, k, _), f5, f6, Done{V.Eval.fit(V.Eval.unslot.k(full, k2), c, hn)})
      %Equal.sym(V.SKind, k2, Laws.skind(k), hk) : Laws.EvalTyR(t, tot, mlen(full, k, hn), f5, f6, Done{V.Eval.fit(V.Eval.unslot.k(full, _), c, hn)})
      (ef6, mode_k(full, k, h, hn, t, Equal.trans(U32, h, Laws.fheight(f2), hn, eh, Equal.trans(U32, Laws.fheight(f2), Laws.fheight(f5), hn, (%e52 : {Laws.fheight(_) == Laws.fheight(f5) : U32}; {==}), Equal.sym(U32, hn, Laws.fheight(f5), en))), c, hc))

def mode_fin_c(+full: Bool, +h: U32, +t: D.DType, +k: A.AKind, +tot: Bool, -f2: C.Frame, -f5: C.Frame, f6: C.Frame, +hn: U32, +e52: {f5 == f2 : C.Frame}, +eh: {h == Laws.fheight(f2) : U32}, +en: {hn == Laws.fheight(f5) : U32}, ef6: {f6 == f5 : C.Frame}, stk: List<&1, V.Slot>, ev: Laws.StkTy(h, Laws.Sh{t, Laws.skind(k)} <> Nil{}, stk))
  -> Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.b(full, V.Eval.fin.one(stk), (f6, hn))):
  match stk:
    case Nil{}:
      Empty.absurd(Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.b(full, V.Eval.fin.one(Nil{}), (f6, hn))), ev)
    case V.Slot{+k2, c} <> rest:
      (hk, hc, ev2) = ev
      mode_fin_d(full, h, t, k, tot, f2, f5, f6, hn, e52, eh, en, ef6, k2, c, rest, hk, hc, ev2)

# the final state's result: a failure the analysis allowed, or the slot
def mode_fin_bb(+full: Bool, +h: U32, +t: D.DType, +k: A.AKind, +tot: Bool, -f2: C.Frame, -f4: C.Frame, -f5: C.Frame, f6: C.Frame, +hn: U32, +e42: {f4 == f2 : C.Frame}, +eh: {h == Laws.fheight(f2) : U32}, +en: {hn == Laws.fheight(f5) : U32}, ef6: {f6 == f5 : C.Frame}, r: E.ResT(List<&1, V.Slot>), ty: Laws.ResSt(h, t, Laws.skind(k), tot, f4, Nil{}, f5, r))
  -> Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.b(full, V.Eval.fin.r(r), (f6, hn))):
  match r:
    case Fail{e}:
      ty
    case Done{stk}:
      (ef5, ev) = ty
      mode_fin_c(full, h, t, k, tot, f2, f5, f6, hn, Equal.trans(C.Frame, f5, f4, f2, ef5, e42), eh, en, ef6, stk, ev)

def mode_fin_b(+full: Bool, +h: U32, +t: D.DType, +k: A.AKind, +tot: Bool, -f2: C.Frame, -f4: C.Frame, -f5: C.Frame, +e42: {f4 == f2 : C.Frame}, +eh: {h == Laws.fheight(f2) : U32}, r: E.ResT(List<&1, V.Slot>), ty: Laws.ResSt(h, t, Laws.skind(k), tot, f4, Nil{}, f5, r),
  w: &f6: C.Frame -> &n: U32 -> {n == Laws.fheight(f5) : U32} & {C.Frame.height(f5) == (f6, n) : C.Frame & U32} & {f6 == f5 : C.Frame})
  -> Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.b(full, V.Eval.fin.r(r), C.Frame.height(f5))):
  (f6, +hn, +en, eh5, ef6) = w
  %Equal.sym(C.Frame & U32, C.Frame.height(f5), (f6, hn), eh5) : Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.b(full, V.Eval.fin.r(r), _))
  mode_fin_bb(full, h, t, k, tot, f2, f4, f5, f6, hn, e42, eh, en, ef6, r, ty)

def mode_fin(+full: Bool, +h: U32, +t: D.DType, +k: A.AKind, +tot: Bool, -f2: C.Frame, -f4: C.Frame, +e42: {f4 == f2 : C.Frame}, +eh: {h == Laws.fheight(f2) : U32}, st: V.EvSt, ty: Laws.RunTy(h, t, Laws.skind(k), tot, f4, Nil{}, st))
  -> Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.a(full, V.Eval.fin(st))):
  match st:
    case V.EvSt{f5, r}:
      mode_fin_b(full, h, t, k, tot, f2, f4, f5, e42, eh, r, ty, height_dup(f5))

# the run of the code from the empty stack (run_typed at acc = Nil, sh = Nil)
def full_e(+full: Bool, -f2: C.Frame, +e: X.Expr, +t: D.DType, +k: A.AKind, +tot: Bool, -f4: C.Frame, +h: U32, +e42: {f4 == f2 : C.Frame}, +eh: {h == Laws.fheight(f2) : U32}, w: Laws.RunW(h, t, Laws.skind(k), tot, f4, Nil{}, Nil{}, Nil{}, V.Eval.compile(e, Nil{})))
  -> Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.a(full, V.Eval.fin(V.Eval.run(V.Eval.compile(e, Nil{}), h, V.EvSt{f4, Done{Nil{}}})))):
  (st, eq, ty) = w
  %Equal.sym(V.EvSt, V.Eval.run(V.Eval.compile(e, Nil{}), h, V.EvSt{f4, Done{Nil{}}}), st, eq) : Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.a(full, V.Eval.fin(_)))
  mode_fin(full, h, t, k, tot, f2, f4, e42, eh, st, ty)

# ---- Frame.schema with the schema as a Data value (the law needs the schema term live) -------------------

def dt_col(-c2: C.Column, -col: C.Column, +dt: D.DType, e2: {c2 == col : C.Column}, edt: {dt == Laws.cdtype(c2) : D.DType}) -> {dt == Laws.cdtype(col) : D.DType}:
  %e2 : {dt == Laws.cdtype(_) : D.DType}
  edt

def CSchD(-cols: List<&1, C.Named>) -> Type:
  &cols2: List<&1, C.Named> -> &s: List<&2, S.Field> -> {s == Laws.cschema(cols) : List<&2, S.Field>} & {S.Cols.schema(cols) == (cols2, s) : List<&1, C.Named> & List<&2, S.Field>} & {cols2 == cols : List<&1, C.Named>}

def CSchG(+n: String, -col: C.Column, -rest: List<&1, C.Named>, -cr: C.Column & D.DType, -r: List<&1, C.Named> & List<&2, S.Field>) -> Type:
  &cols2: List<&1, C.Named> -> &s2: List<&2, S.Field> -> {s2 == Laws.cschema(C.Named{n, col} <> rest) : List<&2, S.Field>} & {S.Cols.schema.k(n, cr, r) == (cols2, s2) : List<&1, C.Named> & List<&2, S.Field>} & {cols2 == C.Named{n, col} <> rest : List<&1, C.Named>}

def cschema_dup_cons2(+n: String, -col: C.Column, -rest: List<&1, C.Named>, -c2: C.Column, e1: {C.Column.dtype(col) == (c2, Laws.cdtype(col)) : C.Column & D.DType}, +e2: {c2 == col : C.Column}, cols3: List<&1, C.Named>, +s: List<&2, S.Field>, es: {s == Laws.cschema(rest) : List<&2, S.Field>}, eq: {S.Cols.schema(rest) == (cols3, s) : List<&1, C.Named> & List<&2, S.Field>}, ecols: {cols3 == rest : List<&1, C.Named>},
  wd: &c3: C.Column -> &k: U32 -> &dt: D.DType -> {c3 == c2 : C.Column} & {dt == Laws.cdtype(c2) : D.DType} & {k == Laws.clen(c2) : U32}) -> CSchD(C.Named{n, col} <> rest):
  (c3, +k, +dt, +ec3, +edt, ek) = wd
  %Equal.sym(C.Column & D.DType, C.Column.dtype(col), (c2, Laws.cdtype(col)), e1) : CSchG(n, col, rest, _, S.Cols.schema(rest))
  %Equal.sym(List<&1, C.Named> & List<&2, S.Field>, S.Cols.schema(rest), (cols3, s), eq) : CSchG(n, col, rest, (c2, Laws.cdtype(col)), _)
  %ec3 : CSchG(n, col, rest, (_, Laws.cdtype(col)), (cols3, s))
  %dt_col(c2, col, dt, e2, edt) : CSchG(n, col, rest, (c3, _), (cols3, s))
  (C.Named{n, c3} <> cols3, S.Field{n, dt} <> s, (%dt_col(c2, col, dt, e2, edt) : {S.Field{n, dt} <> s == S.Field{n, _} <> Laws.cschema(rest) : List<&2, S.Field>}; (%es : {S.Field{n, dt} <> s == S.Field{n, dt} <> _ : List<&2, S.Field>}; {==})), {==}, (%Equal.trans(C.Column, c3, c2, col, ec3, e2) : {C.Named{n, c3} <> cols3 == C.Named{n, _} <> rest : List<&1, C.Named>}; (%ecols : {C.Named{n, c3} <> cols3 == C.Named{n, c3} <> _ : List<&1, C.Named>}; {==})))

def cschema_dup_cons(+n: String, -col: C.Column, -rest: List<&1, C.Named>, wd: Laws.DtypeW(col), w: CSchD(rest)) -> CSchD(C.Named{n, col} <> rest):
  (c2, e1, e2) = wd
  (cols3, +s, es, eq, ecols) = w
  cschema_dup_cons2(n, col, rest, c2, e1, e2, cols3, s, es, eq, ecols, PV.col_dup2(c2))

def cschema_dup(cols: List<&1, C.Named>) -> CSchD(cols):
  match cols:
    case Nil{}:
      (Nil{}, Nil{}, {==}, {==}, {==})
    case C.Named{+n, col} <> rest:
      cschema_dup_cons(n, col, rest, Laws.dtype_w(col), cschema_dup(rest))

def SchD(-f: C.Frame) -> Type:
  &f2: C.Frame -> &s: List<&2, S.Field> -> {f2 == f : C.Frame} & {s == Laws.fschema(f) : List<&2, S.Field>} & {S.Frame.schema(f) == (f2, s) : C.Frame & List<&2, S.Field>}

def schema_dup_k(+h: U32, -cols: List<&1, C.Named>, w: CSchD(cols)) -> SchD(C.Frame{h, cols}):
  (cols2, +s, es, eq, ecols) = w
  %Equal.sym(List<&1, C.Named> & List<&2, S.Field>, S.Cols.schema(cols), (cols2, s), eq) : &f2: C.Frame -> &s2: List<&2, S.Field> -> {f2 == C.Frame{h, cols} : C.Frame} & {s2 == Laws.cschema(cols) : List<&2, S.Field>} & {S.Frame.schema.k(h, _) == (f2, s2) : C.Frame & List<&2, S.Field>}
  (C.Frame{h, cols2}, s, (%ecols : {C.Frame{h, cols2} == C.Frame{h, _} : C.Frame}; {==}), es, {==})

def schema_dup(f: C.Frame) -> SchD(f):
  match f:
    case C.Frame{+h, cols}:
      schema_dup_k(h, cols, cschema_dup(cols))

# the analysis hypothesis over the schema as a Data value
def ana_along_s(-f2: C.Frame, +s: List<&2, S.Field>, +e: X.Expr, +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool, es: {s == Laws.fschema(f2) : List<&2, S.Field>}, ha: {A.Expr.analyse(e, Laws.fschema(f2)) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}) -> {A.Expr.analyse(e, s) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}:
  %Equal.sym(List<&2, S.Field>, s, Laws.fschema(f2), es) : {A.Expr.analyse(e, _) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}
  ha

# Frame.height taken (height_dup): the run from the frame copy with the height as a number
def full_c(+full: Bool, -f2: C.Frame, +e: X.Expr, +s: List<&2, S.Field>, +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool, hok: {Laws.frame_ok(Laws.fheight(f2), f2) == True{} : Bool}, ha: {A.Expr.analyse(e, s) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, es: {s == Laws.fschema(f2) : List<&2, S.Field>}, -f3: C.Frame, +e32: {f3 == f2 : C.Frame},
  w: &f4: C.Frame -> &n: U32 -> {n == Laws.fheight(f3) : U32} & {C.Frame.height(f3) == (f4, n) : C.Frame & U32} & {f4 == f3 : C.Frame})
  -> Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.a(full, V.Eval.slot.h(e, C.Frame.height(f3)))):
  (f4, +hn, en, eh3, ef4) = w
  %Equal.sym(C.Frame & U32, C.Frame.height(f3), (f4, hn), eh3) : Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.a(full, V.Eval.slot.h(e, _)))
  +e42 = Equal.trans(C.Frame, f4, f3, f2, ef4, e32)
  +eh = Equal.trans(U32, hn, Laws.fheight(f3), Laws.fheight(f2), en, (%Equal.sym(C.Frame, f3, f2, e32) : {Laws.fheight(_) == Laws.fheight(f2) : U32}; {==}))
  full_e(full, f2, e, t, k, tot, f4, hn, e42, eh, Laws.run_typed(e, s, hn, Nil{}, f4, Nil{}, Nil{}, (%Equal.sym(C.Frame, f4, f2, e42) : {Laws.fschema(_) == s : List<&2, S.Field>}; Equal.sym(List<&2, S.Field>, s, Laws.fschema(f2), es)), (%Equal.sym(C.Frame, f4, f2, e42) : {Laws.frame_ok(hn, _) == True{} : Bool}; (%Equal.sym(U32, hn, Laws.fheight(f2), eh) : {Laws.frame_ok(_, f2) == True{} : Bool}; hok)), Unit{}, t, rs, k, tot, loc, ha))

# Frame.schema taken (schema_dup): the analysis' Done record is the type check's answer
def full_b(+full: Bool, -f2: C.Frame, +e: X.Expr, +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool, hok: {Laws.frame_ok(Laws.fheight(f2), f2) == True{} : Bool}, ha: {A.Expr.analyse(e, Laws.fschema(f2)) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, w: SchD(f2))
  -> Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.a(full, V.Eval.slot(f2, e))):
  (f3, +s, +e32, +es, eq) = w
  +ha2 = ana_along_s(f2, s, e, t, rs, k, tot, loc, es, ha)
  %Equal.sym(C.Frame & List<&2, S.Field>, S.Frame.schema(f2), (f3, s), eq) : Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.a(full, V.Eval.slot.s(e, _)))
  %Equal.sym(E.Res(A.Ana), A.Expr.analyse(e, s), Done{A.Ana{t, rs, k, tot, loc}}, ha2) : Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f2)), f2, V.Eval.mode.a(full, V.Eval.slot.t(e, f3, A.Ana.type.k(_))))
  full_c(full, f2, e, s, t, rs, k, tot, loc, hok, ha2, es, f3, e32, height_dup(f3))

# the WF bridge taken (wf_frame_ok_w): the frame copy carries the shape facts
def full_a(+full: Bool, -f: C.Frame, +e: X.Expr, +t: D.DType, +rs: List<&2, String>, +k: A.AKind, +tot: Bool, +loc: Bool, ha: {A.Expr.analyse(e, Laws.fschema(f)) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}, w: PV.WfOkW(f))
  -> Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(f)), f, V.Eval.mode.a(full, V.Eval.slot(f, e))):
  (f2, +ef, hok) = w
  %ef : Laws.EvalTy(t, tot, mlen(full, k, Laws.fheight(_)), _, V.Eval.mode.a(full, V.Eval.slot(_, e)))
  full_b(full, f2, e, t, rs, k, tot, loc, hok, (%Equal.sym(C.Frame, f2, f, ef) : {A.Expr.analyse(e, Laws.fschema(_)) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)}; ha), schema_dup(f2))

def Laws.eval_full_typed(f, e, wf, t, rs, k, tot, loc, ha):
  full_a(True{}, f, e, t, rs, k, tot, loc, ha, PV.wf_frame_ok_w(f, wf))

def Laws.eval_expr_typed(f, e, wf, t, rs, k, tot, loc, ha):
  full_a(False{}, f, e, t, rs, k, tot, loc, ha, PV.wf_frame_ok_w(f, wf))

