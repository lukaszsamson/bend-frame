def step2_a(+h: U32, +i: V.Instr, +ta: D.DType, +ka: V.SKind, +tb: D.DType, +kb: V.SKind, +totb: Bool, +t3: D.DType, +tot: Bool, -f: C.Frame, -f2: C.Frame, +sh: List<&2, Laws.Sh>, f3: C.Frame, r: E.ResT(List<&1, V.Slot>), +ef2: {f2 == f : C.Frame},
  ty: Laws.ResSt(h, tb, kb, totb, f2, Laws.Sh{ta, ka} <> sh, f3, r), htot: @_x: {totb == False{} : Bool} -> {tot == False{} : Bool}, hex2: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, i, f3, stk3) == V.EvSt{f3, V.Eval.app2(i, stk3)} : V.EvSt}, opc: @na2: U32 -> @nb2: U32 -> @a4: C.Column -> @b4: C.Column -> @ha4: Laws.ColTy(ta, na2, a4) -> @hb4: Laws.ColTy(tb, nb2, b4) -> Laws.ResW(True{}, t3, na2, V.Eval.op2(i, a4, b4)))
  -> StepW(h, i, t3, V.SKind.comb(ka, kb), tot, f, sh, V.EvSt{f3, r}):
  match r:
    case Fail{e}:
      (V.EvSt{f3, Fail{e}}, {==}, htot(ty))
    case Done{stk2}:
      step2_b(h, i, ta, ka, tb, kb, t3, tot, f, f2, sh, f3, stk2, ef2, ty, hex2, opc)

# one two-operand instruction (IBin / IFill) on a typed state whose top two slots are the operands
def step2(+h: U32, +i: V.Instr, +ta: D.DType, +ka: V.SKind, +tb: D.DType, +kb: V.SKind, +totb: Bool, +t3: D.DType, +tot: Bool, -f: C.Frame, -f2: C.Frame, +sh: List<&2, Laws.Sh>, st: V.EvSt, +ef2: {f2 == f : C.Frame},
  ty: Laws.RunTy(h, tb, kb, totb, f2, Laws.Sh{ta, ka} <> sh, st), htot: @_x: {totb == False{} : Bool} -> {tot == False{} : Bool}, hex2: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, i, f3, stk3) == V.EvSt{f3, V.Eval.app2(i, stk3)} : V.EvSt}, opc: @na2: U32 -> @nb2: U32 -> @a4: C.Column -> @b4: C.Column -> @ha4: Laws.ColTy(ta, na2, a4) -> @hb4: Laws.ColTy(tb, nb2, b4) -> Laws.ResW(True{}, t3, na2, V.Eval.op2(i, a4, b4)))
  -> StepW(h, i, t3, V.SKind.comb(ka, kb), tot, f, sh, st):
  match st:
    case V.EvSt{f3, r}:
      step2_a(h, i, ta, ka, tb, kb, totb, t3, tot, f, f2, sh, f3, r, ef2, ty, htot, hex2, opc)

# ---- the three-operand step (IWhen) --------------------------------------------------------------------

def do3_fit2(+h: U32, +K: V.SKind, +n: U32, +tc: D.DType, +ta: D.DType, +tb: D.DType, +t3: D.DType, +tot: Bool, -f: C.Frame, f3: C.Frame, +sh: List<&2, Laws.Sh>, rest: List<&1, V.Slot>, ef: {f3 == f : C.Frame}, ev: Laws.StkTy(h, sh, rest),
  -Cc: C.Column, -A: C.Column, -B: C.Column, -nc: U32, +na: U32, -nb: U32, wc: Laws.ColW(tc, nc, Cc), wa: Laws.ColW(ta, na, A), wb: Laws.ColW(tb, nb, B), ena: {na == Laws.klen(K, h) : U32},
  hok: {X.Expr.type.when.ok(tc, ta, tb) == Done{t3} : E.Res(D.DType)}) -> PushW(h, t3, K, tot, f, f3, sh, rest, V.Eval.do3.b(False{}, K, n, Cc, A, B)):
  (c3, ec, edc, elc) = wc
  (a3, ea, eda, ela) = wa
  (b3, eb, edb, elb) = wb
  %Equal.sym(C.Column, Cc, c3, ec) : PushW(h, t3, K, tot, f, f3, sh, rest, V.Eval.wrap(K, V.Eval.when(_, A, B)))
  %Equal.sym(C.Column, A, a3, ea) : PushW(h, t3, K, tot, f, f3, sh, rest, V.Eval.wrap(K, V.Eval.when(c3, _, B)))
  %Equal.sym(C.Column, B, b3, eb) : PushW(h, t3, K, tot, f, f3, sh, rest, V.Eval.wrap(K, V.Eval.when(c3, a3, _)))
