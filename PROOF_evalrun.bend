def do3_fit(+h: U32, +K: V.SKind, +n: U32, bad: Bool, ebad: {bad == False{} : Bool}, +tc: D.DType, +ta: D.DType, +tb: D.DType, +t3: D.DType, +tot: Bool, -f: C.Frame, f3: C.Frame, +sh: List<&2, Laws.Sh>, rest: List<&1, V.Slot>, ef: {f3 == f : C.Frame}, ev: Laws.StkTy(h, sh, rest),
  -Cc: C.Column, -A: C.Column, -B: C.Column, -nc: U32, +na: U32, -nb: U32, wc: Laws.ColW(tc, nc, Cc), wa: Laws.ColW(ta, na, A), wb: Laws.ColW(tb, nb, B), ena: {na == Laws.klen(K, h) : U32},
  hok: {X.Expr.type.when.ok(tc, ta, tb) == Done{t3} : E.Res(D.DType)}) -> PushW(h, t3, K, tot, f, f3, sh, rest, V.Eval.do3.b(bad, K, n, Cc, A, B)):
  match bad:
    case True{}:
      Empty.absurd(PushW(h, t3, K, tot, f, f3, sh, rest, V.Eval.do3.b(True{}, K, n, Cc, A, B)), L.true_false(ebad))
    case False{}:
      do3_fit2(h, K, n, tc, ta, tb, t3, tot, f, f3, sh, rest, ef, ev, Cc, A, B, nc, na, nb, wc, wa, wb, ena, hok)

def step3_c(+h: U32, +tc: D.DType, +kc: V.SKind, +ta: D.DType, +ka: V.SKind, +tb: D.DType, +kb: V.SKind, +t3: D.DType, +tot: Bool, -f: C.Frame, f3: C.Frame, +sh: List<&2, Laws.Sh>, rest: List<&1, V.Slot>, ef: {f3 == f : C.Frame}, ev: Laws.StkTy(h, sh, rest),
