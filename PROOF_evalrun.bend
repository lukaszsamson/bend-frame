# PROOF_evalrun.bend -- proofs of LAWS.bend section 13, the stack machine and the entry points
# (run_typed, eval_full_typed, eval_expr_typed; M5 part 2, plan M_01 P2 stage 3). Generated by
# scripts/proofgen/gen_evalrun.py (the kind / op / scalar case lists are loops).
#
# Shape: run_typed is an induction over the expression (the IH is handed to the node lemmas as a
# forall over the code suffix, the frame, the stack and its shape, `IH`); each node lemma first
# takes the analysis apart (the operand records as parameters with their equations, refuting the
# Fail rows), rewrites the law's (t, k, tot) to the record's fields through Ana injectivity, then
# runs the operand code(s) through the IH and composes one machine step (`step1` / `step2` /
# `step3`: Eval.exec on a typed state; the slot kinds are read off the stack invariant StkTy and
# the operation's typing law from PROOF_evalops supplies the result slot). A machine state is
# affine: every lemma that matches one hands the next state back as a live witness beside the
# equation `step(h, i, st) == st2` (StepW), and the two-operand steps give the operand columns to
# `fit`/`bcast` through `fit_w` (ColW witnesses). The three-operand `bad` shape test and the
# result lengths are closed terms over the three kinds once those are constructors (bad3_false,
# len3), so the when / bin steps need no case split of their own.
import Base
import ./src/dtype.bend as D
import ./src/err.bend as E
import ./src/kernels.bend as K
import ./src/column.bend as C
import ./src/schema.bend as S
import ./src/expr.bend as X
import ./src/analysis.bend as A
import ./src/eval.bend as V
import ./LAWS.bend as Laws
import ./PROOF_lib.bend as L
import ./PROOF_eval.bend as PV
import ./PROOF_evalops.bend as PO

# ---- toolkit ------------------------------------------------------------------------------------

# a run from a failed state stays failed
def run_fail(code: List<&2, V.Instr>, +h: U32, -f: C.Frame, -e: E.Err) -> {V.Eval.run(code, h, V.EvSt{f, Fail{e}}) == V.EvSt{f, Fail{e}} : V.EvSt}:
  match code:
    case Nil{}:
      {==}
    case i <> t:
      run_fail(t, h, f, e)

# Column.len with the length pinned to n (the column back, still typed)
def len_k(c: C.Column, +n: U32, +t: D.DType, hc: Laws.ColTy(t, n, c)) -> &c2: C.Column -> {C.Column.len(c) == (c2, n) : C.Column & U32} & Laws.ColTy(t, n, c2):
  match c:
    case C.CBool{+len, d, v, x}:
      (ed, +el) = hc
      (C.CBool{len, d, v, x}, (%el : {(C.CBool{len, d, v, x}, len) == (C.CBool{len, d, v, x}, _) : C.Column & U32}; {==}), (ed, el))
    case C.CU32{+len, d, v, x}:
      (ed, +el) = hc
      (C.CU32{len, d, v, x}, (%el : {(C.CU32{len, d, v, x}, len) == (C.CU32{len, d, v, x}, _) : C.Column & U32}; {==}), (ed, el))
    case C.CI32{+len, d, v, x}:
      (ed, +el) = hc
      (C.CI32{len, d, v, x}, (%el : {(C.CI32{len, d, v, x}, len) == (C.CI32{len, d, v, x}, _) : C.Column & U32}; {==}), (ed, el))
    case C.CF32{+len, d, v, x}:
      (ed, +el) = hc
      (C.CF32{len, d, v, x}, (%el : {(C.CF32{len, d, v, x}, len) == (C.CF32{len, d, v, x}, _) : C.Column & U32}; {==}), (ed, el))
    case C.CStr{+len, d, v, x}:
      (ed, +el) = hc
      (C.CStr{len, d, v, x}, (%el : {(C.CStr{len, d, v, x}, len) == (C.CStr{len, d, v, x}, _) : C.Column & U32}; {==}), (ed, el))

# a ResW restated at an equal length (the production length is a term over the consumed column)
def resw_len(-tot: Bool, +t: D.DType, +n: U32, -n2: U32, -r0: E.ResT(C.Column), e: {n2 == n : U32}, w: Laws.ResW(tot, t, n2, r0)) -> Laws.ResW(tot, t, n, r0):
  %e : Laws.ResW(tot, t, _, r0)
  w

# a slot result: kind k, dtype t, n rows; or a failure the analysis allowed
def SlotTy(+t: D.DType, +k: V.SKind, +n: U32, s: V.Slot) -> Type:
  match s:
    case V.Slot{+k2, c}:
      {k2 == k : V.SKind} & Laws.ColTy(t, n, c)

def SResTy(+t: D.DType, +k: V.SKind, +n: U32, +tot: Bool, r: E.ResT(V.Slot)) -> Type:
  match r:
    case Fail{e}:
      {tot == False{} : Bool}
    case Done{s}:
      SlotTy(t, k, n, s)

def SResW(+t: D.DType, +k: V.SKind, +n: U32, +tot: Bool, -r0: E.ResT(V.Slot)) -> Type:
  &r: E.ResT(V.Slot) -> {r0 == r : E.ResT(V.Slot)} & SResTy(t, k, n, tot, r)

# Eval.wrap of a typed column result is a typed slot result
def wrap_k(+k: V.SKind, +t: D.DType, +n: U32, +tot: Bool, -tot2: Bool, r: E.ResT(C.Column), ty: Laws.ResTy(tot2, t, n, r), htot: @_x: {tot2 == False{} : Bool} -> {tot == False{} : Bool}) -> SResW(t, k, n, tot, V.Eval.wrap(k, r)):
  match r:
    case Fail{e}:
      (Fail{e}, {==}, htot(ty))
    case Done{c}:
      (Done{V.Slot{k, c}}, {==}, ({==}, ty))

def wrap_w(+k: V.SKind, +t: D.DType, +n: U32, +tot: Bool, -tot2: Bool, -r0: E.ResT(C.Column), w: Laws.ResW(tot2, t, n, r0), htot: @_x: {tot2 == False{} : Bool} -> {tot == False{} : Bool}) -> SResW(t, k, n, tot, V.Eval.wrap(k, r0)):
  (r, e, ty) = w
  %Equal.sym(E.ResT(C.Column), r0, r, e) : SResW(t, k, n, tot, V.Eval.wrap(k, _))
  wrap_k(k, t, n, tot, tot2, r, ty, htot)

# a total operation never fails
def tot_true(+tot: Bool, x: {True{} == False{} : Bool}) -> {tot == False{} : Bool}:
  PV.true_false_any({tot == False{} : Bool}, x)

# pushing a typed slot result onto a typed stack: the new state as a witness
def PushW(+h: U32, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, -f2: C.Frame, +sh: List<&2, Laws.Sh>, -rest: List<&1, V.Slot>, -r: E.ResT(V.Slot)) -> Type:
  &st2: V.EvSt -> {V.EvSt{f2, V.Eval.push(rest, r)} == st2 : V.EvSt} & Laws.RunTy(h, t, k, tot, f, sh, st2)

def push_s(+h: U32, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, f2: C.Frame, +sh: List<&2, Laws.Sh>, rest: List<&1, V.Slot>, s: V.Slot, ef: {f2 == f : C.Frame}, hs: SlotTy(t, k, Laws.klen(k, h), s), ev: Laws.StkTy(h, sh, rest)) -> PushW(h, t, k, tot, f, f2, sh, rest, Done{s}):
  match s:
    case V.Slot{+k2, c}:
      (hk, hc) = hs
      (V.EvSt{f2, Done{V.Slot{k2, c} <> rest}}, {==}, (ef, (hk, hc, ev)))

def push_w(+h: U32, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, f2: C.Frame, +sh: List<&2, Laws.Sh>, rest: List<&1, V.Slot>, r: E.ResT(V.Slot), ef: {f2 == f : C.Frame}, hr: SResTy(t, k, Laws.klen(k, h), tot, r), ev: Laws.StkTy(h, sh, rest)) -> PushW(h, t, k, tot, f, f2, sh, rest, r):
  match r:
    case Fail{e}:
      (V.EvSt{f2, Fail{e}}, {==}, hr)
    case Done{s}:
      push_s(h, t, k, tot, f, f2, sh, rest, s, ef, hr, ev)

# a slot result witness pushed: the state witness
def push_r(+h: U32, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, f2: C.Frame, +sh: List<&2, Laws.Sh>, rest: List<&1, V.Slot>, ef: {f2 == f : C.Frame}, ev: Laws.StkTy(h, sh, rest), -r0: E.ResT(V.Slot), w: SResW(t, k, Laws.klen(k, h), tot, r0)) -> PushW(h, t, k, tot, f, f2, sh, rest, r0):
  (r, e, hr) = w
  %Equal.sym(E.ResT(V.Slot), r0, r, e) : PushW(h, t, k, tot, f, f2, sh, rest, _)
  push_w(h, t, k, tot, f, f2, sh, rest, r, ef, hr, ev)

# ---- Ana injectivity --------------------------------------------------------------------------------

def ana_tot(a: A.Ana) -> Bool:
  match a:
    case A.Ana{t, rs, k, tot, loc}:
      tot

def ana_t_inj(-t1: D.DType, -rs1: List<&2, String>, -k1: A.AKind, -tot1: Bool, -loc1: Bool, -t2: D.DType, -rs2: List<&2, String>, -k2: A.AKind, -tot2: Bool, -loc2: Bool, e: {A.Ana{t1, rs1, k1, tot1, loc1} == A.Ana{t2, rs2, k2, tot2, loc2} : A.Ana}) -> {t1 == t2 : D.DType}:
  Equal.cong(A.Ana, D.DType, a => A.Ana.dtype(a), A.Ana{t1, rs1, k1, tot1, loc1}, A.Ana{t2, rs2, k2, tot2, loc2}, e)

def ana_k_inj(-t1: D.DType, -rs1: List<&2, String>, -k1: A.AKind, -tot1: Bool, -loc1: Bool, -t2: D.DType, -rs2: List<&2, String>, -k2: A.AKind, -tot2: Bool, -loc2: Bool, e: {A.Ana{t1, rs1, k1, tot1, loc1} == A.Ana{t2, rs2, k2, tot2, loc2} : A.Ana}) -> {k1 == k2 : A.AKind}:
  Equal.cong(A.Ana, A.AKind, a => A.Ana.kind(a), A.Ana{t1, rs1, k1, tot1, loc1}, A.Ana{t2, rs2, k2, tot2, loc2}, e)

def ana_tot_inj(-t1: D.DType, -rs1: List<&2, String>, -k1: A.AKind, -tot1: Bool, -loc1: Bool, -t2: D.DType, -rs2: List<&2, String>, -k2: A.AKind, -tot2: Bool, -loc2: Bool, e: {A.Ana{t1, rs1, k1, tot1, loc1} == A.Ana{t2, rs2, k2, tot2, loc2} : A.Ana}) -> {tot1 == tot2 : Bool}:
  Equal.cong(A.Ana, Bool, a => ana_tot(a), A.Ana{t1, rs1, k1, tot1, loc1}, A.Ana{t2, rs2, k2, tot2, loc2}, e)

# the stack machine's kind of a joined analysis kind is the combination of the kinds
def skind_join(ka: A.AKind, kb: A.AKind) -> {Laws.skind(A.AKind.join(ka, kb)) == V.SKind.comb(Laws.skind(ka), Laws.skind(kb)) : V.SKind}:
  match ka kb:
    case A.KRow{} A.KRow{}:
      {==}
    case A.KRow{} A.KScalar{}:
      {==}
    case A.KRow{} A.KRed{}:
      {==}
    case A.KScalar{} A.KRow{}:
      {==}
    case A.KScalar{} A.KScalar{}:
      {==}
    case A.KScalar{} A.KRed{}:
      {==}
    case A.KRed{} A.KRow{}:
      {==}
    case A.KRed{} A.KScalar{}:
      {==}
    case A.KRed{} A.KRed{}:
      {==}

# ---- one machine step on a typed state --------------------------------------------------------------

def StepW(+h: U32, +i: V.Instr, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, +sh: List<&2, Laws.Sh>, -st: V.EvSt) -> Type:
  &st2: V.EvSt -> {V.Eval.step(h, i, st) == st2 : V.EvSt} & Laws.RunTy(h, t, k, tot, f, sh, st2)

# a RunW for `i <> acc` composed with a step for i is a RunW for acc
def run_step(+h: U32, +i: V.Instr, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, -st: V.EvSt,
  eq: {V.Eval.run(code, h, V.EvSt{f, Done{stk}}) == V.Eval.run(i <> acc, h, st) : V.EvSt}, w: StepW(h, i, t, k, tot, f, sh, st)) -> Laws.RunW(h, t, k, tot, f, sh, stk, acc, code):
  (st2, es, ty) = w
  (st2, (%es : {V.Eval.run(code, h, V.EvSt{f, Done{stk}}) == V.Eval.run(acc, h, _) : V.EvSt}; eq), ty)

# the same with the run split at an intermediate state (two- and three-operand nodes)
def run_step2(+h: U32, +i: V.Instr, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, -code1: List<&2, V.Instr>, -st1: V.EvSt, -st: V.EvSt,
  eq1: {V.Eval.run(code, h, V.EvSt{f, Done{stk}}) == V.Eval.run(code1, h, st1) : V.EvSt}, eq: {V.Eval.run(code1, h, st1) == V.Eval.run(i <> acc, h, st) : V.EvSt}, w: StepW(h, i, t, k, tot, f, sh, st)) -> Laws.RunW(h, t, k, tot, f, sh, stk, acc, code):
  (st2, es, ty) = w
  (st2, Equal.trans(V.EvSt, V.Eval.run(code, h, V.EvSt{f, Done{stk}}), V.Eval.run(code1, h, st1), V.Eval.run(acc, h, st2), eq1, (%es : {V.Eval.run(code1, h, st1) == V.Eval.run(acc, h, _) : V.EvSt}; eq)), ty)

# an operand whose run failed: the rest of the code keeps the failure, which the analysis allowed
def run_failed(+h: U32, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>, code1: List<&2, V.Instr>, f2: C.Frame, e: E.Err,
  eq1: {V.Eval.run(code, h, V.EvSt{f, Done{stk}}) == V.Eval.run(code1, h, V.EvSt{f2, Fail{e}}) : V.EvSt}, htot: {tot == False{} : Bool}) -> Laws.RunW(h, t, k, tot, f, sh, stk, acc, code):
  (V.EvSt{f2, Fail{e}}, Equal.trans(V.EvSt, V.Eval.run(code, h, V.EvSt{f, Done{stk}}), V.Eval.run(code1, h, V.EvSt{f2, Fail{e}}), V.Eval.run(acc, h, V.EvSt{f2, Fail{e}}), eq1, Equal.trans(V.EvSt, V.Eval.run(code1, h, V.EvSt{f2, Fail{e}}), V.EvSt{f2, Fail{e}}, V.Eval.run(acc, h, V.EvSt{f2, Fail{e}}), run_fail(code1, h, f2, e), Equal.sym(V.EvSt, V.Eval.run(acc, h, V.EvSt{f2, Fail{e}}), V.EvSt{f2, Fail{e}}, run_fail(acc, h, f2, e)))), htot)

# the IH as a hypothesis: the operand's code from any typed frame / stack
def IH(+e: X.Expr, +s: List<&2, S.Field>, +h: U32) -> Type:
  @acc: List<&2, V.Instr> -> @f: C.Frame -> @stk: List<&1, V.Slot> -> @sh: List<&2, Laws.Sh> -> @hs: {Laws.fschema(f) == s : List<&2, S.Field>} -> @hf: {Laws.frame_ok(h, f) == True{} : Bool} -> @ev: Laws.StkTy(h, sh, stk) -> @t: D.DType -> @rs: List<&2, String> -> @k: A.AKind -> @tot: Bool -> @loc: Bool -> @ha: {A.Expr.analyse(e, s) == Done{A.Ana{t, rs, k, tot, loc}} : E.Res(A.Ana)} -> Laws.RunW(h, t, Laws.skind(k), tot, f, sh, stk, acc, V.Eval.compile(e, acc))

# the frame facts restated over an equal frame
def hs_along(-f: C.Frame, -f2: C.Frame, +s: List<&2, S.Field>, ef: {f2 == f : C.Frame}, hs: {Laws.fschema(f) == s : List<&2, S.Field>}) -> {Laws.fschema(f2) == s : List<&2, S.Field>}:
  %Equal.sym(C.Frame, f2, f, ef) : {Laws.fschema(_) == s : List<&2, S.Field>}
  hs

def hf_along(-f: C.Frame, -f2: C.Frame, +h: U32, ef: {f2 == f : C.Frame}, hf: {Laws.frame_ok(h, f) == True{} : Bool}) -> {Laws.frame_ok(h, f2) == True{} : Bool}:
  %Equal.sym(C.Frame, f2, f, ef) : {Laws.frame_ok(h, _) == True{} : Bool}
  hf

# ---- one-operand instructions (Eval.app1 / do1) ----------------------------------------------------

def step1_d(+h: U32, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, +sh: List<&2, Laws.Sh>, f2: C.Frame, rest: List<&1, V.Slot>, ef: {f2 == f : C.Frame}, ev: Laws.StkTy(h, sh, rest), -r0: E.ResT(V.Slot), w: SResW(t, k, Laws.klen(k, h), tot, r0))
  -> PushW(h, t, k, tot, f, f2, sh, rest, r0):
  push_r(h, t, k, tot, f, f2, sh, rest, ef, ev, r0, w)

def step1_c(+h: U32, +i: V.Instr, +t2: D.DType, +k2: V.SKind, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, +sh: List<&2, Laws.Sh>, f2: C.Frame, k3: V.SKind, c: C.Column, rest: List<&1, V.Slot>,
  ef: {f2 == f : C.Frame}, hk: {k3 == k2 : V.SKind}, hc: Laws.ColTy(t2, Laws.klen(k2, h), c), ev: Laws.StkTy(h, sh, rest),
  stepc: @c4: C.Column -> @hc4: Laws.ColTy(t2, Laws.klen(k2, h), c4) -> SResW(t, k, Laws.klen(k, h), tot, V.Eval.do1(h, i, k2, c4)))
  -> &st2: V.EvSt -> {V.EvSt{f2, V.Eval.app1(h, i, V.Slot{k3, c} <> rest)} == st2 : V.EvSt} & Laws.RunTy(h, t, k, tot, f, sh, st2):
  %Equal.sym(V.SKind, k3, k2, hk) : &st2: V.EvSt -> {V.EvSt{f2, V.Eval.push(rest, V.Eval.do1(h, i, _, c))} == st2 : V.EvSt} & Laws.RunTy(h, t, k, tot, f, sh, st2)
  step1_d(h, t, k, tot, f, sh, f2, rest, ef, ev, V.Eval.do1(h, i, k2, c), stepc(c, hc))

def step1_b(+h: U32, +i: V.Instr, +t2: D.DType, +k2: V.SKind, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, +sh: List<&2, Laws.Sh>, f2: C.Frame, stk2: List<&1, V.Slot>,
  ty: {f2 == f : C.Frame} & Laws.StkTy(h, Laws.Sh{t2, k2} <> sh, stk2),
  hex: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, i, f3, stk3) == V.EvSt{f3, V.Eval.app1(h, i, stk3)} : V.EvSt},
  stepc: @c4: C.Column -> @hc4: Laws.ColTy(t2, Laws.klen(k2, h), c4) -> SResW(t, k, Laws.klen(k, h), tot, V.Eval.do1(h, i, k2, c4)))
  -> StepW(h, i, t, k, tot, f, sh, V.EvSt{f2, Done{stk2}}):
  match stk2:
    case Nil{}:
      (ef, ev) = ty
      Empty.absurd(StepW(h, i, t, k, tot, f, sh, V.EvSt{f2, Done{Nil{}}}), ev)
    case V.Slot{+k3, c} <> rest:
      (ef, hk, hc, ev) = ty
      %Equal.sym(V.EvSt, V.Eval.exec(h, i, f2, V.Slot{k3, c} <> rest), V.EvSt{f2, V.Eval.app1(h, i, V.Slot{k3, c} <> rest)}, hex(f2, V.Slot{k3, c} <> rest)) : &st2: V.EvSt -> {_ == st2 : V.EvSt} & Laws.RunTy(h, t, k, tot, f, sh, st2)
      step1_c(h, i, t2, k2, t, k, tot, f, sh, f2, k3, c, rest, ef, hk, hc, ev, stepc)

def step1_a(+h: U32, +i: V.Instr, +t2: D.DType, +k2: V.SKind, +tot2: Bool, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, +sh: List<&2, Laws.Sh>, f2: C.Frame, r: E.ResT(List<&1, V.Slot>),
  ty: Laws.ResSt(h, t2, k2, tot2, f, sh, f2, r),
  hex: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, i, f3, stk3) == V.EvSt{f3, V.Eval.app1(h, i, stk3)} : V.EvSt},
  stepc: @c4: C.Column -> @hc4: Laws.ColTy(t2, Laws.klen(k2, h), c4) -> SResW(t, k, Laws.klen(k, h), tot, V.Eval.do1(h, i, k2, c4)),
  htot: @_x: {tot2 == False{} : Bool} -> {tot == False{} : Bool})
  -> StepW(h, i, t, k, tot, f, sh, V.EvSt{f2, r}):
  match r:
    case Fail{e}:
      (V.EvSt{f2, Fail{e}}, {==}, htot(ty))
    case Done{stk2}:
      step1_b(h, i, t2, k2, t, k, tot, f, sh, f2, stk2, ty, hex, stepc)

# one unary instruction (IUn / ICast / ITry / IAgg / IIsIn / IClip / IStr) on a typed state
def step1(+h: U32, +i: V.Instr, +t2: D.DType, +k2: V.SKind, +tot2: Bool, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, +sh: List<&2, Laws.Sh>, st: V.EvSt,
  ty: Laws.RunTy(h, t2, k2, tot2, f, sh, st),
  hex: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, i, f3, stk3) == V.EvSt{f3, V.Eval.app1(h, i, stk3)} : V.EvSt},
  stepc: @c4: C.Column -> @hc4: Laws.ColTy(t2, Laws.klen(k2, h), c4) -> SResW(t, k, Laws.klen(k, h), tot, V.Eval.do1(h, i, k2, c4)),
  htot: @_x: {tot2 == False{} : Bool} -> {tot == False{} : Bool})
  -> StepW(h, i, t, k, tot, f, sh, st):
  match st:
    case V.EvSt{f2, r}:
      step1_a(h, i, t2, k2, tot2, t, k, tot, f, sh, f2, r, ty, hex, stepc, htot)

# a unary node: the operand's RunW for `i <> acc` and the step for i
def un_run(+h: U32, +i: V.Instr, +t2: D.DType, +k2: V.SKind, +tot2: Bool, +t: D.DType, +k: V.SKind, +tot: Bool, -f: C.Frame, +sh: List<&2, Laws.Sh>, -stk: List<&1, V.Slot>, +acc: List<&2, V.Instr>, -code: List<&2, V.Instr>,
  w: Laws.RunW(h, t2, k2, tot2, f, sh, stk, i <> acc, code),
  hex: @-f3: C.Frame -> @-stk3: List<&1, V.Slot> -> {V.Eval.exec(h, i, f3, stk3) == V.EvSt{f3, V.Eval.app1(h, i, stk3)} : V.EvSt},
  stepc: @c4: C.Column -> @hc4: Laws.ColTy(t2, Laws.klen(k2, h), c4) -> SResW(t, k, Laws.klen(k, h), tot, V.Eval.do1(h, i, k2, c4)),
  htot: @_x: {tot2 == False{} : Bool} -> {tot == False{} : Bool}) -> Laws.RunW(h, t, k, tot, f, sh, stk, acc, code):
  (st, eq, ty) = w
  run_step(h, i, t, k, tot, f, sh, stk, acc, code, st, eq, step1(h, i, t2, k2, tot2, t, k, tot, f, sh, st, ty, hex, stepc, htot))

