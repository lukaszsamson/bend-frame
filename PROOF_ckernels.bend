          Empty.absurd({Word.adc(1n+p, Word.adc(1n+p, a, b, False{}, False{}), c, False{}, False{}) == Word.adc(1n+p, a, Word.adc(1n+p, b, c, False{}, True{}), False{}, False{}) : Word(1n+p)}, n01(h))
