          Empty.absurd({Word.adc(1n+p, Word.adc(1n+p, a, b, False{}, True{}), c, False{}, False{}) == Word.adc(1n+p, a, Word.adc(1n+p, b, c, False{}, True{}), False{}, True{}) : Word(1n+p)}, n12(h))
        case True{} True{} False{} False{} a b c:
          Empty.absurd({Word.adc(1n+p, Word.adc(1n+p, a, b, False{}, True{}), c, False{}, True{}) == Word.adc(1n+p, a, Word.adc(1n+p, b, c, False{}, False{}), False{}, False{}) : Word(1n+p)}, n20(h))
        case True{} True{} False{} True{} a b c:
          Empty.absurd({Word.adc(1n+p, Word.adc(1n+p, a, b, False{}, True{}), c, False{}, True{}) == Word.adc(1n+p, a, Word.adc(1n+p, b, c, False{}, False{}), False{}, True{}) : Word(1n+p)}, n21(h))
        case True{} True{} True{} False{} a b c:
          Empty.absurd({Word.adc(1n+p, Word.adc(1n+p, a, b, False{}, True{}), c, False{}, True{}) == Word.adc(1n+p, a, Word.adc(1n+p, b, c, False{}, True{}), False{}, False{}) : Word(1n+p)}, n21(h))
        case True{} True{} True{} True{} WCon{False{}, at} WCon{False{}, bt} WCon{False{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, False{}), ct, False{}, True{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, False{}), False{}, True{}), adc3(p, False{}, True{}, False{}, True{}, at, bt, ct, {==}))
        case True{} True{} True{} True{} WCon{False{}, at} WCon{False{}, bt} WCon{True{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{True{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, False{}), ct, False{}, True{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, True{}), False{}, False{}), adc3(p, False{}, True{}, True{}, False{}, at, bt, ct, {==}))
        case True{} True{} True{} True{} WCon{False{}, at} WCon{True{}, bt} WCon{False{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{True{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, True{}), ct, False{}, False{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, True{}), False{}, False{}), adc3(p, True{}, False{}, True{}, False{}, at, bt, ct, {==}))
        case True{} True{} True{} True{} WCon{False{}, at} WCon{True{}, bt} WCon{True{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, True{}), ct, False{}, True{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, True{}), False{}, True{}), adc3(p, True{}, True{}, True{}, True{}, at, bt, ct, {==}))
        case True{} True{} True{} True{} WCon{True{}, at} WCon{False{}, bt} WCon{False{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{True{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, True{}), ct, False{}, False{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, False{}), False{}, True{}), adc3(p, True{}, False{}, False{}, True{}, at, bt, ct, {==}))
        case True{} True{} True{} True{} WCon{True{}, at} WCon{False{}, bt} WCon{True{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, True{}), ct, False{}, True{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, True{}), False{}, True{}), adc3(p, True{}, True{}, True{}, True{}, at, bt, ct, {==}))
        case True{} True{} True{} True{} WCon{True{}, at} WCon{True{}, bt} WCon{False{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, True{}), ct, False{}, True{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, True{}), False{}, True{}), adc3(p, True{}, True{}, True{}, True{}, at, bt, ct, {==}))
        case True{} True{} True{} True{} WCon{True{}, at} WCon{True{}, bt} WCon{True{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{True{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, True{}), ct, False{}, True{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, True{}), False{}, True{}), adc3(p, True{}, True{}, True{}, True{}, at, bt, ct, {==}))

def u32_add_assoc(a: U32, b: U32, c: U32) -> {U32.add(U32.add(a, b), c) == U32.add(a, U32.add(b, c)) : U32}:
  match a b c:
    case U32{x} U32{y} U32{z}:
      Equal.cong(Word(32n), U32, w => U32{w}, Word.adc(32n, Word.adc(32n, x, y, False{}, False{}), z, False{}, False{}), Word.adc(32n, x, Word.adc(32n, y, z, False{}, False{}), False{}, False{}), adc3(32n, False{}, False{}, False{}, False{}, x, y, z, {==}))

# ==== F5: the kept count is the tree sum of the mask tree =================================================

def Laws.ck_pc_count(lit, a, va, b, vb, fits):
  match a va b vb:
    case CH.WL{+n0, +d0, x0} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      Laws.pred_count_count(KC.CK.dmax(d0, d2), n0, lit, x0, x1, x2, x3, fits)
    case CH.WL{+n0, +d0, x0} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      (f1, f2) = fits
      %Laws.ck_pc_count(lit, p0, p1, p2, p3, f1) : {U32.add(Laws.PcK(lit, p0, p1, p2, p3), Laws.PcK(lit, q0, q1, q2, q3)) == U32.add(_, Laws.TSum(Laws.PcM(lit, q0, q1, q2, q3))) : U32}
      %Laws.ck_pc_count(lit, q0, q1, q2, q3, f2) : {U32.add(Laws.PcK(lit, p0, p1, p2, p3), Laws.PcK(lit, q0, q1, q2, q3)) == U32.add(Laws.PcK(lit, p0, p1, p2, p3), _) : U32}
      {==}

# ==== the U32 tree sum (ck_sum): NSum over the logical rows ==============================================

# the fold Kernel.popcount and CK.sum.w run at a leaf, in pair form: the array comes back, the result is
# the FSum of the leaf's slots (u32_fold_keeps, u32_fold_sum over three copies of the array)
def FoldW(+n: U32, -a: Array<U32>) -> Type:
  &b: Array<U32> -> &s: U32 -> {K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a, 0) == (b, s) : Array<U32> & U32} & {b == a : Array<U32>} & Laws.FSum(U32.to_nat(n), 0, 0, a, s)

def fold_k(+n: U32, -a: Array<U32>, -a2: Array<U32>, -a3: Array<U32>, p: Array<U32> & U32,
  +ep: {K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a, 0) == p : Array<U32> & U32},
  +ek: {Pair.fst(Array<U32>, U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a2, 0)) == a2 : Array<U32>},
  fs: Laws.FSum(U32.to_nat(n), 0, 0, a3, Pair.snd(Array<U32>, U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a3, 0))),
  +e2: {a2 == a : Array<U32>}, +e3: {a3 == a : Array<U32>}) -> FoldW(n, a):
  match p:
    case (b, +s):
      +ef = Equal.cong(Array<U32> & U32, Array<U32>, q => Pair.fst(Array<U32>, U32, q), K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a, 0), (b, s), ep)
      +ek2 = Equal.trans(Array<U32>, Pair.fst(Array<U32>, U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a, 0)), Pair.fst(Array<U32>, U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a2, 0)), a, Equal.cong(Array<U32>, Array<U32>, q => Pair.fst(Array<U32>, U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, q, 0)), a, a2, Equal.sym(Array<U32>, a2, a, e2)), Equal.trans(Array<U32>, Pair.fst(Array<U32>, U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a2, 0)), a2, a, ek, e2))
      (b, s, ep, Equal.trans(Array<U32>, b, Pair.fst(Array<U32>, U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a, 0)), a, Equal.sym(Array<U32>, Pair.fst(Array<U32>, U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a, 0)), b, ef), ek2), (%Equal.cong(Array<U32> & U32, U32, q => Pair.snd(Array<U32>, U32, q), K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a, 0), (b, s), ep) : Laws.FSum(U32.to_nat(n), 0, 0, a, _); %e3 : Laws.FSum(U32.to_nat(n), 0, 0, _, Pair.snd(Array<U32>, U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, _, 0))); fs))

def fold_c(+n: U32, -a: Array<U32>, w: &a1: Array<U32> -> &a2: Array<U32> -> &a3: Array<U32> -> {a1 == a : Array<U32>} & {a2 == a : Array<U32>} & {a3 == a : Array<U32>}) -> FoldW(n, a):
  (a1, a2, a3, +e1, +e2, e3) = w
  fold_k(n, a, a2, a3, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a1, 0), Equal.cong(Array<U32>, Array<U32> & U32, q => K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, q, 0), a, a1, Equal.sym(Array<U32>, a1, a, e1)), Laws.u32_fold_keeps(n, a2, 0), Laws.u32_fold_sum(n, a3, 0), e2, e3)

def fold_w(+n: U32, a: Array<U32>) -> FoldW(n, a):
  fold_c(n, a, PF.clone3(U32, a))

# a leaf's FSum over its slots is the NSum over its logical rows (ncell reads the slot addn(0, m))
def fsum_nsum(f: Nat, +m: Nat, +acc: U32, -a: Array<U32>, +res: U32, -n: U32, -d: Nat, h: Laws.FSum(f, Laws.addn(0, m), acc, a, res)) -> Laws.NSum(f, m, acc, CH.WL{n, d, a}, res):
  match f:
    case 0n:
      h
    case 1n+p:
      (+x, ex, rest) = h
      (x, ex, fsum_nsum(p, 1n+m, U32.add(acc, x), a, res, n, d, rest))

# casts: the count, the start row and the accumulator of an NSum, by equations
def nsum_cnt(-f1: Nat, -f2: Nat, -m: Nat, -acc: U32, -t: CH.CW, -res: U32, e: {f1 == f2 : Nat}, h: Laws.NSum(f1, m, acc, t, res)) -> Laws.NSum(f2, m, acc, t, res):
  %e : Laws.NSum(_, m, acc, t, res)
  h

def nsum_idx(-f: Nat, -i: Nat, -j: Nat, -acc: U32, -t: CH.CW, -res: U32, e: {i == j : Nat}, h: Laws.NSum(f, i, acc, t, res)) -> Laws.NSum(f, j, acc, t, res):
  %e : Laws.NSum(f, _, acc, t, res)
  h

def nsum_acc(-f: Nat, -m: Nat, -a1: U32, -a2: U32, -t: CH.CW, -res: U32, e: {a1 == a2 : U32}, h: Laws.NSum(f, m, a1, t, res)) -> Laws.NSum(f, m, a2, t, res):
  %e : Laws.NSum(f, m, _, t, res)
  h

# c + (running sum from acc) is the running sum from c + acc (U32.add associativity at every step)
def nsum_shift(f: Nat, +m: Nat, +acc: U32, +c: U32, -t: CH.CW, +res: U32, h: Laws.NSum(f, m, acc, t, res)) -> Laws.NSum(f, m, U32.add(c, acc), t, U32.add(c, res)):
  match f:
    case 0n:
      Equal.cong(U32, U32, q => U32.add(c, q), res, acc, h)
    case 1n+p:
      (+x, ex, rest) = h
      (x, ex, (%Equal.sym(U32, U32.add(U32.add(c, acc), x), U32.add(c, U32.add(acc, x)), u32_add_assoc(c, acc, x)) : Laws.NSum(p, 1n+m, _, t, U32.add(c, res)); nsum_shift(p, 1n+m, U32.add(acc, x), c, t, res, rest)))

# rows m .. m + f - 1 of the left child are the node's rows m .. (all below lrows)
def nsum_left(f: Nat, +m: Nat, +acc: U32, -l: CH.CW, +res: U32, -rows: U32, +lrows: U32, -r: CH.CW,
  +hb: {Nat.is_le(Nat.add(m, f), U32.to_nat(lrows)) == True{} : Bool}, h: Laws.NSum(f, m, acc, l, res))
  -> Laws.NSum(f, m, acc, CH.WN{rows, lrows, l, r}, res):
  match f:
    case 0n:
      h
    case 1n++p:
      (+x, ex, rest) = h
      +lt = B.lt_of_le_add(m, p, U32.to_nat(lrows), hb)
      (x, (%Equal.sym(Bool, Nat.is_lt(m, U32.to_nat(lrows)), True{}, lt) : {x == Bool.pick(U32, _, Laws.ncell(l, m), Laws.ncell(r, Nat.sub(m, U32.to_nat(lrows)))) : U32}; ex), nsum_left(p, 1n+m, U32.add(acc, x), l, res, rows, lrows, r, (%B.add_succ(m, p) : {Nat.is_le(_, U32.to_nat(lrows)) == True{} : Bool}; hb), rest))

# L + m is never below L
def nat_not_lt_addl(l: Nat, +m: Nat) -> {Nat.is_lt(Nat.add(l, m), l) == False{} : Bool}:
  match l:
    case 0n:
      PCH.nat_lt_zero_f(m)
    case 1n+p:
      nat_not_lt_addl(p, m)

# rows m .. of the right child are the node's rows lrows + m ..
def nsum_right(f: Nat, +m: Nat, +acc: U32, -r: CH.CW, +res: U32, -rows: U32, +lrows: U32, -l: CH.CW, h: Laws.NSum(f, m, acc, r, res))
  -> Laws.NSum(f, Nat.add(U32.to_nat(lrows), m), acc, CH.WN{rows, lrows, l, r}, res):
  match f:
    case 0n:
      h
    case 1n+p:
      (+x, ex, rest) = h
      (x, (%Equal.sym(Bool, Nat.is_lt(Nat.add(U32.to_nat(lrows), m), U32.to_nat(lrows)), False{}, nat_not_lt_addl(U32.to_nat(lrows), m)) : {x == Bool.pick(U32, _, Laws.ncell(l, Nat.add(U32.to_nat(lrows), m)), Laws.ncell(r, Nat.sub(Nat.add(U32.to_nat(lrows), m), U32.to_nat(lrows)))) : U32}; %Equal.sym(Nat, Nat.sub(Nat.add(U32.to_nat(lrows), m), U32.to_nat(lrows)), m, PCH.nat_add_sub(U32.to_nat(lrows), m)) : {x == Laws.ncell(r, _) : U32}; ex), (%B.add_succ(U32.to_nat(lrows), m) : Laws.NSum(p, _, U32.add(acc, x), CH.WN{rows, lrows, l, r}, res); nsum_right(p, 1n+m, U32.add(acc, x), r, res, rows, lrows, l, rest)))

# two runs back to back are one run
def nsum_cat(f1: Nat, +f2: Nat, +m: Nat, +acc: U32, +mid: U32, +res: U32, -t: CH.CW, h1: Laws.NSum(f1, m, acc, t, mid), h2: Laws.NSum(f2, Nat.add(m, f1), mid, t, res)) -> Laws.NSum(Nat.add(f1, f2), m, acc, t, res):
  match f1:
    case 0n:
      %PCH.nat_add_zero_r(m) : Laws.NSum(f2, _, acc, t, res)
      %h1 : Laws.NSum(f2, Nat.add(m, 0n), _, t, res)
      h2
    case 1n++p:
      (+x, ex, rest) = h1
      (x, ex, nsum_cat(p, f2, 1n+m, U32.add(acc, x), mid, res, t, rest, (%B.add_succ(m, p) : Laws.NSum(f2, _, mid, t, res); h2)))

def u32_add_zero(x: U32) -> {U32.add(x, 0) == x : U32}:
  match x:
    case U32{w}:
      Equal.cong(Word(32n), U32, q => U32{q}, Word.adc(32n, w, Word.zero(32n), False{}, False{}), w, PC.add_zero_r(32n, w))

# the node's run from the children's runs (the left one as is, the right one shifted by the left sum and
# moved to rows lrows ..)
def nsum_node(+rows: U32, +lrows: U32, -l: CH.CW, -r: CH.CW, +sl: U32, +sr: U32,
  +e1: {lrows == Laws.crows(l) : U32}, +e2: {Nat.add(U32.to_nat(lrows), Laws.nrows(r)) == U32.to_nat(rows) : Nat},
  nl: Laws.NSum(Laws.nrows(l), 0n, 0, l, sl), nr: Laws.NSum(Laws.nrows(r), 0n, 0, r, sr))
  -> Laws.NSum(U32.to_nat(rows), 0n, 0, CH.WN{rows, lrows, l, r}, U32.add(sl, sr)):
  +el = Equal.cong(U32, Nat, q => U32.to_nat(q), Laws.crows(l), lrows, Equal.sym(U32, lrows, Laws.crows(l), e1))
  +hle = PCH.nat_le_of_sum(U32.to_nat(lrows), Laws.nrows(r), U32.to_nat(rows), e2)
  +esa = PCH.nat_sub_add(U32.to_nat(lrows), U32.to_nat(rows), hle)
  +er = PCH.nat_add_cancel_l(U32.to_nat(lrows), Laws.nrows(r), Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), U32.to_nat(rows), e2, esa)
  nl2 = nsum_cnt(Laws.nrows(l), U32.to_nat(lrows), 0n, 0, l, sl, el, nl)
  nr2 = nsum_cnt(Laws.nrows(r), Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, 0, r, sr, er, nr)
  left = nsum_left(U32.to_nat(lrows), 0n, 0, l, sl, rows, lrows, r, PCH.nat_le_refl(U32.to_nat(lrows)), nl2)
  sh = nsum_acc(Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, U32.add(sl, 0), sl, r, U32.add(sl, sr), u32_add_zero(sl), nsum_shift(Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, 0, sl, r, sr, nr2))
  right = nsum_idx(Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), Nat.add(U32.to_nat(lrows), 0n), U32.to_nat(lrows), sl, CH.WN{rows, lrows, l, r}, U32.add(sl, sr), PCH.nat_add_zero_r(U32.to_nat(lrows)), nsum_right(Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, sl, r, U32.add(sl, sr), rows, lrows, l, sh))
  nsum_cnt(Nat.add(U32.to_nat(lrows), Nat.sub(U32.to_nat(rows), U32.to_nat(lrows))), U32.to_nat(rows), 0n, 0, CH.WN{rows, lrows, l, r}, U32.add(sl, sr), esa, nsum_cat(U32.to_nat(lrows), Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, 0, sl, U32.add(sl, sr), CH.WN{rows, lrows, l, r}, left, right))

def SumA(-t: CH.CW) -> Type:
  &t2: CH.CW -> &s: U32 -> {KC.CK.sum.w(t) == (t2, s) : CH.CW & U32} & {t2 == t : CH.CW} & {s == Laws.TSum(t) : U32} & Laws.NSum(Laws.nrows(t), 0n, 0, t, s)

def sum_leaf(+n: U32, +d: Nat, -a: Array<U32>, w: FoldW(n, a)) -> SumA(CH.WL{n, d, a}):
  (b, +s, +ep, +eb, fs) = w
  (CH.WL{n, d, b}, s, (%Equal.sym(Array<U32> & U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a, 0), (b, s), ep) : {KC.CK.fold.w.l(n, d, _) == (CH.WL{n, d, b}, s) : CH.CW & U32}; {==}), Equal.cong(Array<U32>, CH.CW, q => CH.WL{n, d, q}, b, a, eb), Equal.cong(Array<U32> & U32, U32, q => Pair.snd(Array<U32>, U32, q), (b, s), K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a, 0), Equal.sym(Array<U32> & U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.add(acc, x)), n, a, 0), (b, s), ep)), fsum_nsum(U32.to_nat(n), 0n, 0, a, s, n, d, fs))

def sum_node(+rows: U32, +lrows: U32, -l: CH.CW, -r: CH.CW, +e1: {lrows == Laws.crows(l) : U32}, +e2: {Nat.add(U32.to_nat(lrows), Laws.nrows(r)) == U32.to_nat(rows) : Nat}, x: SumA(l), y: SumA(r)) -> SumA(CH.WN{rows, lrows, l, r}):
  (l2, +sl, +eql, +el2, +esl, nl) = x
  (r2, +sr, +eqr, +er2, +esr, nr) = y
  (CH.WN{rows, lrows, l2, r2}, U32.add(sl, sr), (%Equal.sym(CH.CW & U32, KC.CK.sum.w(l), (l2, sl), eql) : {KC.CK.fold.w.j(~(a => b => U32.add(a, b)), rows, lrows, _, KC.CK.sum.w(r)) == (CH.WN{rows, lrows, l2, r2}, U32.add(sl, sr)) : CH.CW & U32}; %Equal.sym(CH.CW & U32, KC.CK.sum.w(r), (r2, sr), eqr) : {KC.CK.fold.w.j(~(a => b => U32.add(a, b)), rows, lrows, (l2, sl), _) == (CH.WN{rows, lrows, l2, r2}, U32.add(sl, sr)) : CH.CW & U32}; {==}), (%el2 : {CH.WN{rows, lrows, l2, r2} == CH.WN{rows, lrows, _, r} : CH.CW}; %er2 : {CH.WN{rows, lrows, l2, r2} == CH.WN{rows, lrows, l2, _} : CH.CW}; {==}), (%esl : {U32.add(sl, sr) == U32.add(_, Laws.TSum(r)) : U32}; %esr : {U32.add(sl, sr) == U32.add(sl, _) : U32}; {==}), nsum_node(rows, lrows, l, r, sl, sr, e1, e2, nl, nr))

def sum_all(t: CH.CW, wf: Laws.WFChunks(t)) -> SumA(t):
  match t:
    case CH.WL{+n, +d, a}:
      sum_leaf(n, d, a, fold_w(n, a))
    case CH.WN{+rows, +lrows, l, r}:
      (+e1, +e2, wl, wr) = wf
      sum_node(rows, lrows, l, r, e1, e2, sum_all(l, wl), sum_all(r, wr))

def ck_sum_k(-t: CH.CW, w: SumA(t)) -> {Pair.fst(CH.CW, U32, KC.CK.sum.w(t)) == t : CH.CW} & {Pair.snd(CH.CW, U32, KC.CK.sum.w(t)) == Laws.TSum(t) : U32} & Laws.NSum(Laws.nrows(t), 0n, 0, t, Laws.TSum(t)):
  (t2, +s, +eq, +et, +es, ns) = w
  ((%Equal.sym(CH.CW & U32, KC.CK.sum.w(t), (t2, s), eq) : {Pair.fst(CH.CW, U32, _) == t : CH.CW}; et), (%Equal.sym(CH.CW & U32, KC.CK.sum.w(t), (t2, s), eq) : {Pair.snd(CH.CW, U32, _) == Laws.TSum(t) : U32}; es), (%es : Laws.NSum(Laws.nrows(t), 0n, 0, t, _); ns))

def Laws.ck_sum(t, wf):
  ck_sum_k(t, sum_all(t, wf))

# ==== per-leaf compaction: CK.c3.www (ck_c3) =============================================================

def K3(+n: U32, +d: Nat, m: Array<U32>, x1: Array<U32>, x2: Array<U32>, x3: Array<U32>) -> K.C3<U32, U32, U32>:
  K.Kernel.compact3(~U32, ~U32, ~U32, n, d, m, x1, x2, x3, 0, 0, 0)

def c3_m(r: K.C3<U32, U32, U32>) -> Array<U32>:
  match r:
    case K.C3{o1, o2, o3, m, a1, a2, a3, k}:
      m

def c3_a1(r: K.C3<U32, U32, U32>) -> Array<U32>:
  match r:
    case K.C3{o1, o2, o3, m, a1, a2, a3, k}:
      a1

def c3_a2(r: K.C3<U32, U32, U32>) -> Array<U32>:
  match r:
    case K.C3{o1, o2, o3, m, a1, a2, a3, k}:
      a2

def c3_a3(r: K.C3<U32, U32, U32>) -> Array<U32>:
  match r:
    case K.C3{o1, o2, o3, m, a1, a2, a3, k}:
      a3

def c3_k(r: K.C3<U32, U32, U32>) -> U32:
  match r:
    case K.C3{o1, o2, o3, m, a1, a2, a3, k}:
      k

# the three CSpecs of compact3_contents, over the copies, restated to the originals
def CS3(+n: U32, +d: Nat, -m: Array<U32>, -x1: Array<U32>, -x2: Array<U32>, -x3: Array<U32>) -> Type:
  Laws.CSpec(U32, U32.to_nat(n), 0, 0, d, x1, m, Laws.c3_o1(U32, U32, U32, K.Kernel.compact3(~U32, ~U32, ~U32, n, d, m, x1, x2, x3, 0, 0, 0))) & Laws.CSpec(U32, U32.to_nat(n), 0, 0, d, x2, m, Laws.c3_o2(U32, U32, U32, K.Kernel.compact3(~U32, ~U32, ~U32, n, d, m, x1, x2, x3, 0, 0, 0))) & Laws.CSpec(U32, U32.to_nat(n), 0, 0, d, x3, m, Laws.c3_o3(U32, U32, U32, K.Kernel.compact3(~U32, ~U32, ~U32, n, d, m, x1, x2, x3, 0, 0, 0)))

def cs3_back(+n: U32, +d: Nat, -m: Array<U32>, -x1: Array<U32>, -x2: Array<U32>, -x3: Array<U32>, -m2: Array<U32>, -y1: Array<U32>, -y2: Array<U32>, -y3: Array<U32>,
  em: {m2 == m : Array<U32>}, e1: {y1 == x1 : Array<U32>}, e2: {y2 == x2 : Array<U32>}, e3: {y3 == x3 : Array<U32>}, h: CS3(n, d, m2, y1, y2, y3)) -> CS3(n, d, m, x1, x2, x3):
  %em : CS3(n, d, _, x1, x2, x3)
  %e1 : CS3(n, d, m2, _, x2, x3)
  %e2 : CS3(n, d, m2, y1, _, x3)
  %e3 : CS3(n, d, m2, y1, y2, _)
  h

def wfw_to(+d: Nat, -m: Array<U32>, -m2: Array<U32>, e: {m2 == m : Array<U32>}, h: Laws.WFWords(True{}, d, m)) -> Laws.WFWords(True{}, d, m2):
  %Equal.sym(Array<U32>, m2, m, e) : Laws.WFWords(True{}, d, _)
  h

def croom_to(+n: U32, +d: Nat, -m: Array<U32>, -m2: Array<U32>, e: {m2 == m : Array<U32>}, h: Laws.CRoom(U32.to_nat(n), 0, 0, d, m2)) -> Laws.CRoom(U32.to_nat(n), 0, 0, d, m):
  %e : Laws.CRoom(U32.to_nat(n), 0, 0, d, _)
  h

# K3 over the copies is K3 over the originals
def k3_eq(+n: U32, +d: Nat, -m: Array<U32>, -x1: Array<U32>, -x2: Array<U32>, -x3: Array<U32>, -m2: Array<U32>, -y1: Array<U32>, -y2: Array<U32>, -y3: Array<U32>,
  em: {m2 == m : Array<U32>}, e1: {y1 == x1 : Array<U32>}, e2: {y2 == x2 : Array<U32>}, e3: {y3 == x3 : Array<U32>}) -> {K3(n, d, m, x1, x2, x3) == K3(n, d, m2, y1, y2, y3) : K.C3<U32, U32, U32>}:
  %Equal.sym(Array<U32>, m2, m, em) : {K3(n, d, m, x1, x2, x3) == K3(n, d, _, y1, y2, y3) : K.C3<U32, U32, U32>}
  %Equal.sym(Array<U32>, y1, x1, e1) : {K3(n, d, m, x1, x2, x3) == K3(n, d, m, _, y2, y3) : K.C3<U32, U32, U32>}
  %Equal.sym(Array<U32>, y2, x2, e2) : {K3(n, d, m, x1, x2, x3) == K3(n, d, m, x1, _, y3) : K.C3<U32, U32, U32>}
  %Equal.sym(Array<U32>, y3, x3, e3) : {K3(n, d, m, x1, x2, x3) == K3(n, d, m, x1, x2, _) : K.C3<U32, U32, U32>}
  {==}

# the leaf, once the kernel's record R is in hand (matched live), with the unfused equation (eta) and the
# contents (cs) over the originals
def c3_leaf_r(+n: U32, +d: Nat, -mm: Array<U32>, -x1: Array<U32>, -x2: Array<U32>, -x3: Array<U32>, +n1: U32, +d1: Nat, +n2: U32, +d2: Nat, +n3: U32, +d3: Nat,
  R: K.C3<U32, U32, U32>, +eR: {K3(n, d, mm, x1, x2, x3) == R : K.C3<U32, U32, U32>}, eta: PF.C3E(n, d, mm, x1, x2, x3, 0, 0, 0), cs: CS3(n, d, mm, x1, x2, x3))
  -> Laws.C3Spec(CH.WL{n, d, mm}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}):
  match R:
    case K.C3{o1, o2, o3, mr, b1, b2, b3, +k}:
      (cs1, cs2, cs3) = cs
      +ee = Equal.trans(K.C3<U32, U32, U32>, K.C3{o1, o2, o3, mr, b1, b2, b3, k}, K3(n, d, mm, x1, x2, x3), K.C3{Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x1, mm, 0)), Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x2, mm, 0)), Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x3, mm, 0)), mm, x1, x2, x3, Pair.snd(Array<U32>, U32, K.Kernel.popcount(n, mm))}, Equal.sym(K.C3<U32, U32, U32>, K3(n, d, mm, x1, x2, x3), K.C3{o1, o2, o3, mr, b1, b2, b3, k}, eR), eta)
      +emr = Equal.cong(K.C3<U32, U32, U32>, Array<U32>, q => c3_m(q), K.C3{o1, o2, o3, mr, b1, b2, b3, k}, K.C3{Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x1, mm, 0)), Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x2, mm, 0)), Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x3, mm, 0)), mm, x1, x2, x3, Pair.snd(Array<U32>, U32, K.Kernel.popcount(n, mm))}, ee)
      +eb1 = Equal.cong(K.C3<U32, U32, U32>, Array<U32>, q => c3_a1(q), K.C3{o1, o2, o3, mr, b1, b2, b3, k}, K.C3{Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x1, mm, 0)), Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x2, mm, 0)), Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x3, mm, 0)), mm, x1, x2, x3, Pair.snd(Array<U32>, U32, K.Kernel.popcount(n, mm))}, ee)
      +eb2 = Equal.cong(K.C3<U32, U32, U32>, Array<U32>, q => c3_a2(q), K.C3{o1, o2, o3, mr, b1, b2, b3, k}, K.C3{Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x1, mm, 0)), Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x2, mm, 0)), Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x3, mm, 0)), mm, x1, x2, x3, Pair.snd(Array<U32>, U32, K.Kernel.popcount(n, mm))}, ee)
      +eb3 = Equal.cong(K.C3<U32, U32, U32>, Array<U32>, q => c3_a3(q), K.C3{o1, o2, o3, mr, b1, b2, b3, k}, K.C3{Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x1, mm, 0)), Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x2, mm, 0)), Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x3, mm, 0)), mm, x1, x2, x3, Pair.snd(Array<U32>, U32, K.Kernel.popcount(n, mm))}, ee)
      +ek = Equal.cong(K.C3<U32, U32, U32>, U32, q => c3_k(q), K.C3{o1, o2, o3, mr, b1, b2, b3, k}, K.C3{Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x1, mm, 0)), Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x2, mm, 0)), Pair.fst(Array<U32>, Array<U32>, K.Kernel.compact_keep(~U32, n, d, x3, mm, 0)), mm, x1, x2, x3, Pair.snd(Array<U32>, U32, K.Kernel.popcount(n, mm))}, ee)
      (CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.WL{k, d, o3}, k, (%Equal.sym(K.C3<U32, U32, U32>, K3(n, d, mm, x1, x2, x3), K.C3{o1, o2, o3, mr, b1, b2, b3, k}, eR) : {KC.CK.c3.www.l(n, d, n1, d1, n2, d2, n3, d3, _) == KC.CC3{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.WL{k, d, o3}, CH.WL{n, d, mm}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}, k} : KC.CC3<CH.CW, CH.CW, CH.CW>}; %emr : {KC.CC3{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.WL{k, d, o3}, CH.WL{n, d, mr}, CH.WL{n1, d1, b1}, CH.WL{n2, d2, b2}, CH.WL{n3, d3, b3}, k} == KC.CC3{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.WL{k, d, o3}, CH.WL{n, d, _}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}, k} : KC.CC3<CH.CW, CH.CW, CH.CW>}; %eb1 : {KC.CC3{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.WL{k, d, o3}, CH.WL{n, d, mr}, CH.WL{n1, d1, b1}, CH.WL{n2, d2, b2}, CH.WL{n3, d3, b3}, k} == KC.CC3{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.WL{k, d, o3}, CH.WL{n, d, mr}, CH.WL{n1, d1, _}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}, k} : KC.CC3<CH.CW, CH.CW, CH.CW>}; %eb2 : {KC.CC3{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.WL{k, d, o3}, CH.WL{n, d, mr}, CH.WL{n1, d1, b1}, CH.WL{n2, d2, b2}, CH.WL{n3, d3, b3}, k} == KC.CC3{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.WL{k, d, o3}, CH.WL{n, d, mr}, CH.WL{n1, d1, b1}, CH.WL{n2, d2, _}, CH.WL{n3, d3, x3}, k} : KC.CC3<CH.CW, CH.CW, CH.CW>}; %eb3 : {KC.CC3{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.WL{k, d, o3}, CH.WL{n, d, mr}, CH.WL{n1, d1, b1}, CH.WL{n2, d2, b2}, CH.WL{n3, d3, b3}, k} == KC.CC3{CH.WL{k, d, o1}, CH.WL{k, d, o2}, CH.WL{k, d, o3}, CH.WL{n, d, mr}, CH.WL{n1, d1, b1}, CH.WL{n2, d2, b2}, CH.WL{n3, d3, _}, k} : KC.CC3<CH.CW, CH.CW, CH.CW>}; {==}), (ek, {==}, (%Equal.cong(K.C3<U32, U32, U32>, Array<U32>, q => Laws.c3_o1(U32, U32, U32, q), K3(n, d, mm, x1, x2, x3), K.C3{o1, o2, o3, mr, b1, b2, b3, k}, eR) : Laws.CSpec(U32, U32.to_nat(n), 0, 0, d, x1, mm, _); cs1)), (ek, {==}, (%Equal.cong(K.C3<U32, U32, U32>, Array<U32>, q => Laws.c3_o2(U32, U32, U32, q), K3(n, d, mm, x1, x2, x3), K.C3{o1, o2, o3, mr, b1, b2, b3, k}, eR) : Laws.CSpec(U32, U32.to_nat(n), 0, 0, d, x2, mm, _); cs2)), (ek, {==}, (%Equal.cong(K.C3<U32, U32, U32>, Array<U32>, q => Laws.c3_o3(U32, U32, U32, q), K3(n, d, mm, x1, x2, x3), K.C3{o1, o2, o3, mr, b1, b2, b3, k}, eR) : Laws.CSpec(U32, U32.to_nat(n), 0, 0, d, x3, mm, _); cs3)), {==}, {==}, {==}, ek)

# the leaf: four copies of the mask (the kernel run, the unfused equation, the room, the contents) and three
# of each buffer
def c3_leaf_c(+n: U32, +d: Nat, -mm: Array<U32>, -x1: Array<U32>, -x2: Array<U32>, -x3: Array<U32>, +n1: U32, +d1: Nat, +n2: U32, +d2: Nat, +n3: U32, +d3: Nat,
  +fits: {U32.is_le(n, U32.shln(1, d)) == True{} : Bool}, wb: Laws.WFWords(True{}, d, mm),
  wm: &m1: Array<U32> -> &m2: Array<U32> -> &m3: Array<U32> -> &m4: Array<U32> -> {m1 == mm : Array<U32>} & {m2 == mm : Array<U32>} & {m3 == mm : Array<U32>} & {m4 == mm : Array<U32>},
  w1: &y1: Array<U32> -> &z1: Array<U32> -> &v1: Array<U32> -> {y1 == x1 : Array<U32>} & {z1 == x1 : Array<U32>} & {v1 == x1 : Array<U32>},
  w2: &y2: Array<U32> -> &z2: Array<U32> -> &v2: Array<U32> -> {y2 == x2 : Array<U32>} & {z2 == x2 : Array<U32>} & {v2 == x2 : Array<U32>},
  w3: &y3: Array<U32> -> &z3: Array<U32> -> &v3: Array<U32> -> {y3 == x3 : Array<U32>} & {z3 == x3 : Array<U32>} & {v3 == x3 : Array<U32>})
  -> Laws.C3Spec(CH.WL{n, d, mm}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}):
  (m1, m2, m3, m4, +em1, +em2, +em3, em4a) = wm
  (y1, z1, v1, +ey1, +ez1, ev1) = w1
  (y2, z2, v2, +ey2, +ez2, ev2) = w2
  (y3, z3, v3, +ey3, +ez3, ev3) = w3
  +em4 = Equal.sym(Array<U32>, mm, m4, Equal.sym(Array<U32>, m4, mm, em4a))
  c3_leaf_r(n, d, mm, x1, x2, x3, n1, d1, n2, d2, n3, d3, K3(n, d, m1, y1, y2, y3), k3_eq(n, d, mm, x1, x2, x3, m1, y1, y2, y3, em1, ey1, ey2, ey3), PF.c3e_back(n, d, mm, x1, x2, x3, 0, 0, 0, m2, z1, z2, z3, em2, ez1, ez2, ez3, PF.c3_sim(~U32, ~U32, ~U32, U32.to_nat(n), 0, 0, Array.new(U32, d, 0), Array.new(U32, d, 0), Array.new(U32, d, 0), z1, z2, z3, m2)), cs3_back(n, d, mm, x1, x2, x3, m4, v1, v2, v3, em4, ev1, ev2, ev3, Laws.compact3_contents(d, n, m4, v1, v2, v3, 0, 0, 0, croom_to(n, d, m4, m3, Equal.trans(Array<U32>, m3, mm, m4, em3, Equal.sym(Array<U32>, m4, mm, em4)), Laws.croom_of_cap(n, d, m3, fits, wfw_to(d, mm, m3, em3, wb))))))

def c3_leaf(+n: U32, +d: Nat, mm: Array<U32>, +n1: U32, +d1: Nat, x1: Array<U32>, +n2: U32, +d2: Nat, x2: Array<U32>, +n3: U32, +d3: Nat, x3: Array<U32>, bits: Laws.MaskBits(CH.WL{n, d, mm}))
  -> Laws.C3Spec(CH.WL{n, d, mm}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}):
  (+fits, wb) = bits
  c3_leaf_c(n, d, mm, x1, x2, x3, n1, d1, n2, d2, n3, d3, fits, wb, PF.clone4(U32, mm), PF.clone3(U32, x1), PF.clone3(U32, x2), PF.clone3(U32, x3))

def c3_node(+r0: U32, +l0: U32, -m1: CH.CW, -m2: CH.CW, +r1: U32, +l1: U32, -p1: CH.CW, -q1: CH.CW, +r2: U32, +l2: U32, -p2: CH.CW, -q2: CH.CW, +r3: U32, +l3: U32, -p3: CH.CW, -q3: CH.CW,
  x: Laws.C3Spec(m1, p1, p2, p3), y: Laws.C3Spec(m2, q1, q2, q3)) -> Laws.C3Spec(CH.WN{r0, l0, m1, m2}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}):
  (o1, o2, o3, +k, +eq, c1, c2, c3, +ek1, +ek2, +ek3, ekm) = x
  (u1, u2, u3, +j, +eqy, d1, d2, d3, +ej1, +ej2, +ej3, ejm) = y
  (CH.WN{U32.add(k, j), k, o1, u1}, CH.WN{U32.add(k, j), k, o2, u2}, CH.WN{U32.add(k, j), k, o3, u3}, U32.add(k, j), (%Equal.sym(KC.CC3<CH.CW, CH.CW, CH.CW>, KC.CK.c3.www(m1, p1, p2, p3), KC.CC3{o1, o2, o3, m1, p1, p2, p3, k}, eq) : {KC.CK.c3.www.j(r0, l0, r1, l1, r2, l2, r3, l3, _, KC.CK.c3.www(m2, q1, q2, q3)) == KC.CC3{CH.WN{U32.add(k, j), k, o1, u1}, CH.WN{U32.add(k, j), k, o2, u2}, CH.WN{U32.add(k, j), k, o3, u3}, CH.WN{r0, l0, m1, m2}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}, U32.add(k, j)} : KC.CC3<CH.CW, CH.CW, CH.CW>}; %Equal.sym(KC.CC3<CH.CW, CH.CW, CH.CW>, KC.CK.c3.www(m2, q1, q2, q3), KC.CC3{u1, u2, u3, m2, q1, q2, q3, j}, eqy) : {KC.CK.c3.www.j(r0, l0, r1, l1, r2, l2, r3, l3, KC.CC3{o1, o2, o3, m1, p1, p2, p3, k}, _) == KC.CC3{CH.WN{U32.add(k, j), k, o1, u1}, CH.WN{U32.add(k, j), k, o2, u2}, CH.WN{U32.add(k, j), k, o3, u3}, CH.WN{r0, l0, m1, m2}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}, U32.add(k, j)} : KC.CC3<CH.CW, CH.CW, CH.CW>}; {==}), (Equal.sym(U32, Laws.crows(o1), k, ek1), (%Equal.sym(U32, Laws.crows(o1), k, ek1) : {U32.add(k, j) == U32.add(_, Laws.crows(u1)) : U32}; %Equal.sym(U32, Laws.crows(u1), j, ej1) : {U32.add(k, j) == U32.add(k, _) : U32}; {==}), c1, d1), (Equal.sym(U32, Laws.crows(o2), k, ek2), (%Equal.sym(U32, Laws.crows(o2), k, ek2) : {U32.add(k, j) == U32.add(_, Laws.crows(u2)) : U32}; %Equal.sym(U32, Laws.crows(u2), j, ej2) : {U32.add(k, j) == U32.add(k, _) : U32}; {==}), c2, d2), (Equal.sym(U32, Laws.crows(o3), k, ek3), (%Equal.sym(U32, Laws.crows(o3), k, ek3) : {U32.add(k, j) == U32.add(_, Laws.crows(u3)) : U32}; %Equal.sym(U32, Laws.crows(u3), j, ej3) : {U32.add(k, j) == U32.add(k, _) : U32}; {==}), c3, d3), {==}, {==}, {==}, (%ekm : {U32.add(k, j) == U32.add(_, Laws.TSum(m2)) : U32}; %ejm : {U32.add(k, j) == U32.add(k, _) : U32}; {==}))


# skeleton discrimination: a node's skeleton is no leaf's (and the converse), the children of a node's
def sk_dl(s: CH.Skel) -> Type:
  match s:
    case CH.KLeaf{n}:
      Unit
    case CH.KNode{rows, lrows, l, r}:
      Empty

def sk_dn(s: CH.Skel) -> Type:
  match s:
    case CH.KLeaf{n}:
      Empty
    case CH.KNode{rows, lrows, l, r}:
      Unit

def ref_nl(-rows: U32, -lrows: U32, -l: CH.Skel, -r: CH.Skel, -n: U32, h: {CH.KNode{rows, lrows, l, r} == CH.KLeaf{n} : CH.Skel}) -> Empty:
  %h : sk_dn(_)
  Unit{}

def ref_ln(-rows: U32, -lrows: U32, -l: CH.Skel, -r: CH.Skel, -n: U32, h: {CH.KLeaf{n} == CH.KNode{rows, lrows, l, r} : CH.Skel}) -> Empty:
  %h : sk_dl(_)
  Unit{}

def sk_l(s: CH.Skel) -> CH.Skel:
  match s:
    case CH.KLeaf{n}:
      CH.KLeaf{n}
    case CH.KNode{rows, lrows, l, r}:
      l

def sk_r(s: CH.Skel) -> CH.Skel:
  match s:
    case CH.KLeaf{n}:
      CH.KLeaf{n}
    case CH.KNode{rows, lrows, l, r}:
      r

def Laws.ck_c3(m, a1, a2, a3, bits, s1, s2, s3):
  match m a1 a2 a3:
    case CH.WL{+n, +d, mm} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      c3_leaf(n, d, mm, n1, d1, x1, n2, d2, x2, n3, d3, x3, bits)
    case CH.WL{+n, +d, mm} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      Empty.absurd(Laws.C3Spec(CH.WL{n, d, mm}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WN{r3, l3, p3, q3}), ref_nl(r3, l3, Laws.skel(p3), Laws.skel(q3), n, s3))
    case CH.WL{+n, +d, mm} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      Empty.absurd(Laws.C3Spec(CH.WL{n, d, mm}, CH.WL{n1, d1, x1}, CH.WN{r2, l2, p2, q2}, CH.WL{n3, d3, x3}), ref_nl(r2, l2, Laws.skel(p2), Laws.skel(q2), n, s2))
    case CH.WL{+n, +d, mm} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      Empty.absurd(Laws.C3Spec(CH.WL{n, d, mm}, CH.WL{n1, d1, x1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}), ref_nl(r2, l2, Laws.skel(p2), Laws.skel(q2), n, s2))
    case CH.WL{+n, +d, mm} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      Empty.absurd(Laws.C3Spec(CH.WL{n, d, mm}, CH.WN{r1, l1, p1, q1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}), ref_nl(r1, l1, Laws.skel(p1), Laws.skel(q1), n, s1))
    case CH.WL{+n, +d, mm} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      Empty.absurd(Laws.C3Spec(CH.WL{n, d, mm}, CH.WN{r1, l1, p1, q1}, CH.WL{n2, d2, x2}, CH.WN{r3, l3, p3, q3}), ref_nl(r1, l1, Laws.skel(p1), Laws.skel(q1), n, s1))
    case CH.WL{+n, +d, mm} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      Empty.absurd(Laws.C3Spec(CH.WL{n, d, mm}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WL{n3, d3, x3}), ref_nl(r1, l1, Laws.skel(p1), Laws.skel(q1), n, s1))
    case CH.WL{+n, +d, mm} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      Empty.absurd(Laws.C3Spec(CH.WL{n, d, mm}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}), ref_nl(r1, l1, Laws.skel(p1), Laws.skel(q1), n, s1))
    case CH.WN{+r0, +l0, m1, m2} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      Empty.absurd(Laws.C3Spec(CH.WN{r0, l0, m1, m2}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}), ref_ln(r0, l0, Laws.skel(m1), Laws.skel(m2), n1, s1))
    case CH.WN{+r0, +l0, m1, m2} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      Empty.absurd(Laws.C3Spec(CH.WN{r0, l0, m1, m2}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WN{r3, l3, p3, q3}), ref_ln(r0, l0, Laws.skel(m1), Laws.skel(m2), n1, s1))
    case CH.WN{+r0, +l0, m1, m2} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      Empty.absurd(Laws.C3Spec(CH.WN{r0, l0, m1, m2}, CH.WL{n1, d1, x1}, CH.WN{r2, l2, p2, q2}, CH.WL{n3, d3, x3}), ref_ln(r0, l0, Laws.skel(m1), Laws.skel(m2), n1, s1))
    case CH.WN{+r0, +l0, m1, m2} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      Empty.absurd(Laws.C3Spec(CH.WN{r0, l0, m1, m2}, CH.WL{n1, d1, x1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}), ref_ln(r0, l0, Laws.skel(m1), Laws.skel(m2), n1, s1))
    case CH.WN{+r0, +l0, m1, m2} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      Empty.absurd(Laws.C3Spec(CH.WN{r0, l0, m1, m2}, CH.WN{r1, l1, p1, q1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}), ref_ln(r0, l0, Laws.skel(m1), Laws.skel(m2), n2, s2))
    case CH.WN{+r0, +l0, m1, m2} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      Empty.absurd(Laws.C3Spec(CH.WN{r0, l0, m1, m2}, CH.WN{r1, l1, p1, q1}, CH.WL{n2, d2, x2}, CH.WN{r3, l3, p3, q3}), ref_ln(r0, l0, Laws.skel(m1), Laws.skel(m2), n2, s2))
    case CH.WN{+r0, +l0, m1, m2} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      Empty.absurd(Laws.C3Spec(CH.WN{r0, l0, m1, m2}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WL{n3, d3, x3}), ref_ln(r0, l0, Laws.skel(m1), Laws.skel(m2), n3, s3))
    case CH.WN{+r0, +l0, m1, m2} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      (bl, br) = bits
      c3_node(r0, l0, m1, m2, r1, l1, p1, q1, r2, l2, p2, q2, r3, l3, p3, q3, Laws.ck_c3(m1, p1, p2, p3, bl, Equal.cong(CH.Skel, CH.Skel, q => sk_l(q), CH.KNode{r1, l1, Laws.skel(p1), Laws.skel(q1)}, CH.KNode{r0, l0, Laws.skel(m1), Laws.skel(m2)}, s1), Equal.cong(CH.Skel, CH.Skel, q => sk_l(q), CH.KNode{r2, l2, Laws.skel(p2), Laws.skel(q2)}, CH.KNode{r0, l0, Laws.skel(m1), Laws.skel(m2)}, s2), Equal.cong(CH.Skel, CH.Skel, q => sk_l(q), CH.KNode{r3, l3, Laws.skel(p3), Laws.skel(q3)}, CH.KNode{r0, l0, Laws.skel(m1), Laws.skel(m2)}, s3)), Laws.ck_c3(m2, q1, q2, q3, br, Equal.cong(CH.Skel, CH.Skel, q => sk_r(q), CH.KNode{r1, l1, Laws.skel(p1), Laws.skel(q1)}, CH.KNode{r0, l0, Laws.skel(m1), Laws.skel(m2)}, s1), Equal.cong(CH.Skel, CH.Skel, q => sk_r(q), CH.KNode{r2, l2, Laws.skel(p2), Laws.skel(q2)}, CH.KNode{r0, l0, Laws.skel(m1), Laws.skel(m2)}, s2), Equal.cong(CH.Skel, CH.Skel, q => sk_r(q), CH.KNode{r3, l3, Laws.skel(p3), Laws.skel(q3)}, CH.KNode{r0, l0, Laws.skel(m1), Laws.skel(m2)}, s3)))

# ==== the chunked map's rows (ck_map_cells, ck_map_flat) ==================================================

def map_leaf_k(+n: U32, +d: Nat, -a: Array<U32>, +fits: {U32.is_le(n, U32.shln(1, d)) == True{} : Bool}, -o: Array<U32>,
  +eq: {K.Kernel.map.go(~U32, ~U32, ~(x => U32.xor(x, 1)), U32.to_nat(n), 0, Array.new(U32, d, 0), Array.get(U32, a, 0)) == o : Array<U32>},
  spec: @k: U32 -> {U32.is_lt(k, Laws.addn(0, U32.to_nat(n))) == True{} : Bool} -> {Laws.rdN(U32, d, o, k) == U32.xor(Laws.rd_at(U32, a, k), 1) : U32},
  rd: PA.RdAll2(~U32, d, o))
  -> Laws.MapC(CH.WL{n, d, a}):
  (o2, +e2, w2, cv, cv2) = rd
  (CH.WL{n, d, o2}, (%Equal.sym(Array<U32>, K.Kernel.map.go(~U32, ~U32, ~(x => U32.xor(x, 1)), U32.to_nat(n), 0, Array.new(U32, d, 0), Array.get(U32, a, 0)), o, eq) : {CH.WL{n, d, _} == CH.WL{n, d, o2} : CH.CW}; %Equal.sym(Array<U32>, o2, o, e2) : {CH.WL{n, d, o} == CH.WL{n, d, _} : CH.CW}; {==}), (fits, w2), {==}, +m => +hm => Equal.trans(U32, Laws.rd_at(U32, o2, Laws.addn(0, m)), Laws.rdN(U32, d, o, Laws.addn(0, m)), U32.xor(Laws.rd_at(U32, a, Laws.addn(0, m)), 1), cv(Laws.addn(0, m)), spec(Laws.addn(0, m), (%Equal.sym(U32, Laws.addn(0, U32.to_nat(n)), n, B.addn_to_nat(n)) : {U32.is_lt(Laws.addn(0, m), _) == True{} : Bool}; PCH.hk_ltw(n, m, hm)))))

def map_leaf_w(+n: U32, +d: Nat, -a: Array<U32>, +fits: {U32.is_le(n, U32.shln(1, d)) == True{} : Bool},
  w: &o: Array<U32> -> {K.Kernel.map.go(~U32, ~U32, ~(x => U32.xor(x, 1)), U32.to_nat(n), 0, Array.new(U32, d, 0), Array.get(U32, a, 0)) == o : Array<U32>} & PC.MRes(~U32, ~U32, ~(x => U32.xor(x, 1)), d, a, o, Laws.addn(0, U32.to_nat(n))))
  -> Laws.MapC(CH.WL{n, d, a}):
  (o, +eq, wo, spec) = w
  map_leaf_k(n, d, a, fits, o, eq, spec, PA.rd_all2(~U32, d, o, wo))

def map_cells_b(bb: Bool, +rows: U32, +lrows: U32, -l: CH.CW, -r: CH.CW, -x: CH.CW, -y: CH.CW, +m: Nat,
  +ebb: {Nat.is_lt(m, U32.to_nat(lrows)) == bb : Bool}, +hm: {Nat.is_lt(m, U32.to_nat(rows)) == True{} : Bool}, +el: {lrows == Laws.crows(l) : U32}, +esum: {Nat.add(U32.to_nat(lrows), Laws.nrows(r)) == U32.to_nat(rows) : Nat},
  fx: @m2: Nat -> {Nat.is_lt(m2, Laws.nrows(l)) == True{} : Bool} -> {Laws.ncell(x, m2) == U32.xor(Laws.ncell(l, m2), 1) : U32},
  fy: @m2: Nat -> {Nat.is_lt(m2, Laws.nrows(r)) == True{} : Bool} -> {Laws.ncell(y, m2) == U32.xor(Laws.ncell(r, m2), 1) : U32})
  -> {Laws.ncell(CH.WN{rows, lrows, x, y}, m) == U32.xor(Laws.ncell(CH.WN{rows, lrows, l, r}, m), 1) : U32}:
  match bb:
    case True{}:
      %Equal.sym(Bool, Nat.is_lt(m, U32.to_nat(lrows)), True{}, ebb) : {Bool.pick(U32, _, Laws.ncell(x, m), Laws.ncell(y, Nat.sub(m, U32.to_nat(lrows)))) == U32.xor(Bool.pick(U32, _, Laws.ncell(l, m), Laws.ncell(r, Nat.sub(m, U32.to_nat(lrows)))), 1) : U32}
      fx(m, (%el : {Nat.is_lt(m, U32.to_nat(_)) == True{} : Bool}; ebb))
    case False{}:
      %Equal.sym(Bool, Nat.is_lt(m, U32.to_nat(lrows)), False{}, ebb) : {Bool.pick(U32, _, Laws.ncell(x, m), Laws.ncell(y, Nat.sub(m, U32.to_nat(lrows)))) == U32.xor(Bool.pick(U32, _, Laws.ncell(l, m), Laws.ncell(r, Nat.sub(m, U32.to_nat(lrows)))), 1) : U32}
      fy(Nat.sub(m, U32.to_nat(lrows)), PCH.nat_lt_sub(m, U32.to_nat(lrows), Laws.nrows(r), (%Equal.sym(Nat, Nat.add(U32.to_nat(lrows), Laws.nrows(r)), U32.to_nat(rows), esum) : {Nat.is_lt(m, _) == True{} : Bool}; hm), ebb))

def map_node(+rows: U32, +lrows: U32, -l: CH.CW, -r: CH.CW, +e1: {lrows == Laws.crows(l) : U32}, +e2: {Nat.add(U32.to_nat(lrows), Laws.nrows(r)) == U32.to_nat(rows) : Nat}, wx: Laws.MapC(l), wy: Laws.MapC(r))
  -> Laws.MapC(CH.WN{rows, lrows, l, r}):
  (x, +ex, wfx, +cx, fx) = wx
  (y, +ey, wfy, +cy, fy) = wy
  (CH.WN{rows, lrows, x, y}, (%Equal.sym(CH.CW, KC.CK.map.ww(~(x => U32.xor(x, 1)), l, 0), x, ex) : {CH.WN{rows, lrows, _, KC.CK.map.ww(~(x => U32.xor(x, 1)), r, 0)} == CH.WN{rows, lrows, x, y} : CH.CW}; %Equal.sym(CH.CW, KC.CK.map.ww(~(x => U32.xor(x, 1)), r, 0), y, ey) : {CH.WN{rows, lrows, x, _} == CH.WN{rows, lrows, x, y} : CH.CW}; {==}), (Equal.trans(U32, lrows, Laws.crows(l), Laws.crows(x), e1, Equal.sym(U32, Laws.crows(x), Laws.crows(l), cx)), (%Equal.sym(U32, Laws.crows(y), Laws.crows(r), cy) : {Nat.add(U32.to_nat(lrows), U32.to_nat(_)) == U32.to_nat(rows) : Nat}; e2), wfx, wfy), {==}, +m => +hm => map_cells_b(Nat.is_lt(m, U32.to_nat(lrows)), rows, lrows, l, r, x, y, m, {==}, hm, e1, e2, fx, fy))

def Laws.ck_map_cells(t, wf):
  match t:
    case CH.WL{+n, +d, a}:
      (+fits, wfa) = wf
      map_leaf_w(n, d, a, fits, PC.map_go(~U32, ~U32, ~(x => U32.xor(x, 1)), U32.to_nat(n), 0, d, a, Array.new(U32, d, 0), Laws.wf_new(U32, d, 0), B.room_from(d, n, fits))(PC.mhyp0(~U32, ~U32, ~(x => U32.xor(x, 1)), d, a, Array.new(U32, d, 0))))
    case CH.WN{+rows, +lrows, l, r}:
      (+e1, +e2, wl, wr) = wf
      map_node(rows, lrows, l, r, e1, e2, Laws.ck_map_cells(l, wl), Laws.ck_map_cells(r, wr))

def map_flat_k(+dd: Nat, -t: CH.CW, -t2: CH.CW, +m: Nat, +e: {KC.CK.map.ww(~(x => U32.xor(x, 1)), t, 0) == t2 : CH.CW}, +hm2: {Nat.is_lt(m, Laws.nrows(t2)) == True{} : Bool},
  cells: {Laws.ncell(t2, m) == U32.xor(Laws.ncell(t, m), 1) : U32}, w: Laws.FlatW(dd, t2))
  -> {Laws.rdN(U32, dd, CH.CW.flatten(dd, KC.CK.map.ww(~(x => U32.xor(x, 1)), t, 0)), Laws.addn(0, m)) == U32.xor(Laws.ncell(t, m), 1) : U32}:
  (o, +eo, wo, fo) = w
  %Equal.sym(CH.CW, KC.CK.map.ww(~(x => U32.xor(x, 1)), t, 0), t2, e) : {Laws.rdN(U32, dd, CH.CW.flatten(dd, _), Laws.addn(0, m)) == U32.xor(Laws.ncell(t, m), 1) : U32}
  %Equal.sym(Array<U32>, CH.CW.flatten(dd, t2), o, eo) : {Laws.rdN(U32, dd, _, Laws.addn(0, m)) == U32.xor(Laws.ncell(t, m), 1) : U32}
  Equal.trans(U32, Laws.rdN(U32, dd, o, Laws.addn(0, m)), Laws.ncell(t2, m), U32.xor(Laws.ncell(t, m), 1), fo(m, hm2), cells)

def map_flat_c(+dd: Nat, -t: CH.CW, +fits: {U32.is_le(Laws.crows(t), U32.shln(1, dd)) == True{} : Bool}, +m: Nat, +hm: {Nat.is_lt(m, Laws.nrows(t)) == True{} : Bool}, w: Laws.MapC(t))
  -> {Laws.rdN(U32, dd, CH.CW.flatten(dd, KC.CK.map.ww(~(x => U32.xor(x, 1)), t, 0)), Laws.addn(0, m)) == U32.xor(Laws.ncell(t, m), 1) : U32}:
  (t2, +e, wf2, +ec, cells) = w
  map_flat_k(dd, t, t2, m, e, (%Equal.sym(U32, Laws.crows(t2), Laws.crows(t), ec) : {Nat.is_lt(m, U32.to_nat(_)) == True{} : Bool}; hm), cells(m, hm), Laws.cw_flatten(dd, t2, wf2, (%Equal.sym(U32, Laws.crows(t2), Laws.crows(t), ec) : {U32.is_le(_, U32.shln(1, dd)) == True{} : Bool}; fits)))

def Laws.ck_map_flat(dd, t, wf, fits, m, hm):
  map_flat_c(dd, t, fits, m, hm, Laws.ck_map_cells(t, wf))

# ==== U32.min / U32.max: associativity (min: section 7's u32_min_assoc) and the identities of the folds ======

def u32_min_assoc2(a: U32, b: U32, c: U32) -> {U32.min(U32.min(a, b), c) == U32.min(a, U32.min(b, c)) : U32}:
  Equal.sym(U32, U32.min(a, U32.min(b, c)), U32.min(U32.min(a, b), c), Laws.u32_min_assoc(a, b, c))

def wones(n: Nat) -> Word(n):
  match n:
    case 0n:
      WNil{}
    case 1n+p:
      WCon{True{}, wones(p)}

# the all-ones word is never below: cmp(x, ones) is never GT; the zero word: cmp(x, 0) is never LT
def fin_ones(b: Bool, c: Cmp, h: {Cmp.is_gt(c) == False{} : Bool}) -> {Cmp.is_gt(Word.cmp.fin(b, True{}, c)) == False{} : Bool}:
  match b c:
    case False{} LT{}:
      {==}
    case True{} LT{}:
      {==}
    case False{} EQ{}:
      {==}
    case True{} EQ{}:
      {==}
    case False{} GT{}:
      Empty.absurd({Cmp.is_gt(Word.cmp.fin(False{}, True{}, GT{})) == False{} : Bool}, L.true_false(h))
    case True{} GT{}:
      Empty.absurd({Cmp.is_gt(Word.cmp.fin(True{}, True{}, GT{})) == False{} : Bool}, L.true_false(h))

def cmp_ones(n: Nat, x: Word(n)) -> {Cmp.is_gt(Word.cmp(n, x, wones(n))) == False{} : Bool}:
  match n:
    case 0n:
      match x:
        case WNil{}:
          {==}
    case 1n++p:
      match x:
        case WCon{b, +t}:
          fin_ones(b, Word.cmp(p, t, wones(p)), cmp_ones(p, t))

def fin_zero(b: Bool, c: Cmp, h: {Cmp.is_lt(c) == False{} : Bool}) -> {Cmp.is_lt(Word.cmp.fin(b, False{}, c)) == False{} : Bool}:
  match b c:
    case False{} LT{}:
      Empty.absurd({Cmp.is_lt(Word.cmp.fin(False{}, False{}, LT{})) == False{} : Bool}, L.true_false(h))
    case True{} LT{}:
      Empty.absurd({Cmp.is_lt(Word.cmp.fin(True{}, False{}, LT{})) == False{} : Bool}, L.true_false(h))
    case False{} EQ{}:
      {==}
    case True{} EQ{}:
      {==}
    case False{} GT{}:
      {==}
    case True{} GT{}:
      {==}

def cmp_zero(n: Nat, x: Word(n)) -> {Cmp.is_lt(Word.cmp(n, x, Word.zero(n))) == False{} : Bool}:
  match n:
    case 0n:
      match x:
        case WNil{}:
          {==}
    case 1n++p:
      match x:
        case WCon{b, +t}:
          fin_zero(b, Word.cmp(p, t, Word.zero(p)), cmp_zero(p, t))

def min_id_k(+w: Word(32n), c: Cmp, +e: {Word.cmp(32n, w, wones(32n)) == c : Cmp}) -> {Bool.pick(U32, Cmp.is_lt(c), U32{w}, U32{wones(32n)}) == U32{w} : U32}:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      Equal.cong(Word(32n), U32, q => U32{q}, wones(32n), w, Equal.sym(Word(32n), w, wones(32n), L.word_cmp_eq(32n, w, wones(32n), e)))
    case GT{}:
      Empty.absurd({Bool.pick(U32, Cmp.is_lt(GT{}), U32{w}, U32{wones(32n)}) == U32{w} : U32}, L.true_false(Equal.trans(Bool, True{}, Cmp.is_gt(Word.cmp(32n, w, wones(32n))), False{}, Equal.cong(Cmp, Bool, q => Cmp.is_gt(q), GT{}, Word.cmp(32n, w, wones(32n)), Equal.sym(Cmp, Word.cmp(32n, w, wones(32n)), GT{}, e)), cmp_ones(32n, w))))

# min(x, 2^32 - 1) == x: the identity the U32 min fold starts from
def u32_min_id(x: U32) -> {U32.min(x, 4294967295) == x : U32}:
  match x:
    case U32{+w}:
      min_id_k(w, Word.cmp(32n, w, wones(32n)), {==})

def max_id_k(+w: Word(32n), c: Cmp, +e: {Word.cmp(32n, w, Word.zero(32n)) == c : Cmp}) -> {Bool.pick(U32, Cmp.is_lt(c), U32{Word.zero(32n)}, U32{w}) == U32{w} : U32}:
  match c:
    case LT{}:
      Empty.absurd({Bool.pick(U32, Cmp.is_lt(LT{}), U32{Word.zero(32n)}, U32{w}) == U32{w} : U32}, L.true_false(Equal.trans(Bool, True{}, Cmp.is_lt(Word.cmp(32n, w, Word.zero(32n))), False{}, Equal.cong(Cmp, Bool, q => Cmp.is_lt(q), LT{}, Word.cmp(32n, w, Word.zero(32n)), Equal.sym(Cmp, Word.cmp(32n, w, Word.zero(32n)), LT{}, e)), cmp_zero(32n, w))))
    case EQ{}:
      {==}
    case GT{}:
      {==}

# max(x, 0) == x: the identity the U32 max fold starts from
def u32_max_id(x: U32) -> {U32.max(x, 0) == x : U32}:
  match x:
    case U32{+w}:
      max_id_k(w, Word.cmp(32n, w, Word.zero(32n)), {==})

# max(max(x, y), z) == max(x, max(y, z)), with c1 = cmp(x, y) and c2 = cmp(y, z) as parameters (u32_min_assoc's
# case analysis, the picks swapped)
def max_assoc_k(+x: Word(32n), +y: Word(32n), +z: Word(32n), c1: Cmp, c2: Cmp, +e1: {Word.cmp(32n, x, y) == c1 : Cmp}, +e2: {Word.cmp(32n, y, z) == c2 : Cmp})
  -> {U32.max(Bool.pick(U32, Cmp.is_lt(c1), U32{y}, U32{x}), U32{z}) == U32.max(U32{x}, Bool.pick(U32, Cmp.is_lt(c2), U32{z}, U32{y})) : U32}:
  match c1 c2:
    case LT{} LT{}:
      %Equal.sym(Cmp, Word.cmp(32n, y, z), LT{}, e2) : {Bool.pick(U32, Cmp.is_lt(_), U32{z}, U32{y}) == U32.max(U32{x}, U32{z}) : U32}
      %Equal.sym(Cmp, Word.cmp(32n, x, z), LT{}, L.word_lt_trans(32n, x, y, z, e1, e2)) : {U32{z} == Bool.pick(U32, Cmp.is_lt(_), U32{z}, U32{x}) : U32}
      {==}
    case LT{} EQ{}:
      %L.word_cmp_eq(32n, y, z, e2) : {U32.max(U32{y}, U32{_}) == U32.max(U32{x}, U32{y}) : U32}
      %Equal.sym(Cmp, Word.cmp(32n, y, y), EQ{}, L.word_cmp_refl(32n, y)) : {Bool.pick(U32, Cmp.is_lt(_), U32{y}, U32{y}) == U32.max(U32{x}, U32{y}) : U32}
      %Equal.sym(Cmp, Word.cmp(32n, x, y), LT{}, e1) : {U32{y} == Bool.pick(U32, Cmp.is_lt(_), U32{y}, U32{x}) : U32}
      {==}
    case LT{} GT{}:
      %Equal.sym(Cmp, Word.cmp(32n, y, z), GT{}, e2) : {Bool.pick(U32, Cmp.is_lt(_), U32{z}, U32{y}) == U32.max(U32{x}, U32{y}) : U32}
      %Equal.sym(Cmp, Word.cmp(32n, x, y), LT{}, e1) : {U32{y} == Bool.pick(U32, Cmp.is_lt(_), U32{y}, U32{x}) : U32}
      {==}
    case EQ{} LT{}:
      {==}
    case EQ{} EQ{}:
      %L.word_cmp_eq(32n, y, z, e2) : {U32.max(U32{x}, U32{_}) == U32.max(U32{x}, U32{y}) : U32}
      {==}
    case EQ{} GT{}:
      %L.word_cmp_eq(32n, x, y, e1) : {U32.max(U32{x}, U32{z}) == U32.max(U32{x}, U32{_}) : U32}
      %Equal.sym(Cmp, Word.cmp(32n, x, z), GT{}, Equal.trans(Cmp, Word.cmp(32n, x, z), Word.cmp(32n, y, z), GT{}, Equal.cong(Word(32n), Cmp, q => Word.cmp(32n, q, z), x, y, L.word_cmp_eq(32n, x, y, e1)), e2)) : {Bool.pick(U32, Cmp.is_lt(_), U32{z}, U32{x}) == U32.max(U32{x}, U32{x}) : U32}
      %Equal.sym(Cmp, Word.cmp(32n, x, x), EQ{}, L.word_cmp_refl(32n, x)) : {U32{x} == Bool.pick(U32, Cmp.is_lt(_), U32{x}, U32{x}) : U32}
      {==}
    case GT{} LT{}:
      {==}
    case GT{} EQ{}:
      %L.word_cmp_eq(32n, y, z, e2) : {U32.max(U32{x}, U32{_}) == U32.max(U32{x}, U32{y}) : U32}
      {==}
    case GT{} GT{}:
      %Equal.sym(Cmp, Word.cmp(32n, x, z), GT{}, L.word_gt_trans(32n, x, y, z, e1, e2)) : {Bool.pick(U32, Cmp.is_lt(_), U32{z}, U32{x}) == U32.max(U32{x}, U32{y}) : U32}
      %Equal.sym(Cmp, Word.cmp(32n, x, y), GT{}, e1) : {U32{x} == Bool.pick(U32, Cmp.is_lt(_), U32{y}, U32{x}) : U32}
      {==}

def u32_max_assoc2(a: U32, b: U32, c: U32) -> {U32.max(U32.max(a, b), c) == U32.max(a, U32.max(b, c)) : U32}:
  match a b c:
    case U32{+x} U32{+y} U32{+z}:
      max_assoc_k(x, y, z, Word.cmp(32n, x, y), Word.cmp(32n, y, z), {==}, {==})

# ==== the U32 tree min (ck_min): the sum's machinery over U32.min ===================================

# the running min of the first f slots from index i, started at acc (FSum over U32.min)
def FMin(f: Nat, +i: U32, +acc: U32, -a: Array<U32>, +res: U32) -> Type:
  match f:
    case 0n:
      {res == acc : U32}
    case 1n+p:
      &x: U32 -> {x == Laws.rd_at(U32, a, i) : U32} & FMin(p, U32.inc(i), U32.min(acc, x), a, res)

# the fold with fl steps left at index i and accumulator acc, pending read r of a[i]
def FGoal_min(fl: Nat, +i: U32, +acc: U32, -a: Array<U32>, -r: Array<U32> & U32) -> Type:
  &a2: Array<U32> -> &res: U32 -> {K.Kernel.fold.go(~U32, ~U32, ~(acc => x => U32.min(acc, x)), fl, i, acc, r) == (a2, res) : Array<U32> & U32} & {a2 == a : Array<U32>} & FMin(fl, i, acc, a, res)

def fold_zero_min(+i: U32, +acc: U32, -a: Array<U32>, w: &b: Array<U32> -> &x: U32 -> {b == a : Array<U32>} & {Array.get(U32, a, i) == (a, x) : Array<U32> & U32} & {x == Laws.rd_at(U32, a, i) : U32}) -> FGoal_min(0n, i, acc, a, Array.get(U32, a, i)):
  (a2, +x, ea, e1, ex) = w
  %Equal.sym(Array<U32> & U32, Array.get(U32, a, i), (a, x), e1) : FGoal_min(0n, i, acc, a, _)
  %ea : FGoal_min(0n, i, acc, _, (_, x))
  (a2, acc, {==}, {==}, {==})

# the induction hypothesis repackaged: the cell x read at i names the step of FSum
def fold_step_min(p: Nat, +i: U32, +acc: U32, -a: Array<U32>, +x: U32, ex: {x == Laws.rd_at(U32, a, i) : U32},
  w: &a3: Array<U32> -> &res: U32 -> {K.Kernel.fold.go(~U32, ~U32, ~(acc => x => U32.min(acc, x)), p, U32.inc(i), U32.min(acc, x), Array.get(U32, a, U32.inc(i))) == (a3, res) : Array<U32> & U32} & {a3 == a : Array<U32>} & FMin(p, U32.inc(i), U32.min(acc, x), a, res))
  -> FGoal_min(1n+p, i, acc, a, (a, x)):
  (a3, +res, eq, ea3, spec) = w
  (a3, res, eq, ea3, (x, ex, spec))

def fold_cons_min(p: Nat, +i: U32, +acc: U32, -a: Array<U32>, w: &b: Array<U32> -> &x: U32 -> {b == a : Array<U32>} & {Array.get(U32, a, i) == (a, x) : Array<U32> & U32} & {x == Laws.rd_at(U32, a, i) : U32},
  ih: @a2: Array<U32> -> @x: U32 -> FGoal_min(p, U32.inc(i), U32.min(acc, x), a2, Array.get(U32, a2, U32.inc(i))))
  -> FGoal_min(1n+p, i, acc, a, Array.get(U32, a, i)):
  (a2, +x, +ea, e1, ex) = w
  %Equal.sym(Array<U32> & U32, Array.get(U32, a, i), (a, x), e1) : FGoal_min(1n+p, i, acc, a, _)
  %ea : FGoal_min(1n+p, i, acc, _, (_, x))
  fold_step_min(p, i, acc, a2, x, Equal.trans(U32, x, Laws.rd_at(U32, a, i), Laws.rd_at(U32, a2, i), ex, Equal.sym(U32, Laws.rd_at(U32, a2, i), Laws.rd_at(U32, a, i), Equal.cong(Array<U32>, U32, q => Laws.rd_at(U32, q, i), a2, a, ea))), ih(a2, x))

def fold_go_min(fl: Nat, +i: U32, +acc: U32, a: Array<U32>) -> FGoal_min(fl, i, acc, a, Array.get(U32, a, i)):
  match fl:
    case 0n:
      fold_zero_min(i, acc, a, PC.get_w(U32, a, i))
    case 1n++p:
      fold_cons_min(p, i, acc, a, PC.get_w(U32, a, i), a2 => x => fold_go_min(p, U32.inc(i), U32.min(acc, x), a2))

# a leaf's FSum over its slots is the NSum over its logical rows (ncell reads the slot addn(0, m))
def fsum_nsum_min(f: Nat, +m: Nat, +acc: U32, -a: Array<U32>, +res: U32, -n: U32, -d: Nat, h: FMin(f, Laws.addn(0, m), acc, a, res)) -> Laws.NMin(f, m, acc, CH.WL{n, d, a}, res):
  match f:
    case 0n:
      h
    case 1n+p:
      (+x, ex, rest) = h
      (x, ex, fsum_nsum_min(p, 1n+m, U32.min(acc, x), a, res, n, d, rest))

# casts: the count, the start row and the accumulator of an NSum, by equations
def nsum_cnt_min(-f1: Nat, -f2: Nat, -m: Nat, -acc: U32, -t: CH.CW, -res: U32, e: {f1 == f2 : Nat}, h: Laws.NMin(f1, m, acc, t, res)) -> Laws.NMin(f2, m, acc, t, res):
  %e : Laws.NMin(_, m, acc, t, res)
  h

def nsum_idx_min(-f: Nat, -i: Nat, -j: Nat, -acc: U32, -t: CH.CW, -res: U32, e: {i == j : Nat}, h: Laws.NMin(f, i, acc, t, res)) -> Laws.NMin(f, j, acc, t, res):
  %e : Laws.NMin(f, _, acc, t, res)
  h

def nsum_acc_min(-f: Nat, -m: Nat, -a1: U32, -a2: U32, -t: CH.CW, -res: U32, e: {a1 == a2 : U32}, h: Laws.NMin(f, m, a1, t, res)) -> Laws.NMin(f, m, a2, t, res):
  %e : Laws.NMin(f, m, _, t, res)
  h

# c + (running sum from acc) is the running sum from c + acc (U32.add associativity at every step)
def nsum_shift_min(f: Nat, +m: Nat, +acc: U32, +c: U32, -t: CH.CW, +res: U32, h: Laws.NMin(f, m, acc, t, res)) -> Laws.NMin(f, m, U32.min(c, acc), t, U32.min(c, res)):
  match f:
    case 0n:
      Equal.cong(U32, U32, q => U32.min(c, q), res, acc, h)
    case 1n+p:
      (+x, ex, rest) = h
      (x, ex, (%Equal.sym(U32, U32.min(U32.min(c, acc), x), U32.min(c, U32.min(acc, x)), u32_min_assoc2(c, acc, x)) : Laws.NMin(p, 1n+m, _, t, U32.min(c, res)); nsum_shift_min(p, 1n+m, U32.min(acc, x), c, t, res, rest)))

# rows m .. m + f - 1 of the left child are the node's rows m .. (all below lrows)
def nsum_left_min(f: Nat, +m: Nat, +acc: U32, -l: CH.CW, +res: U32, -rows: U32, +lrows: U32, -r: CH.CW,
  +hb: {Nat.is_le(Nat.add(m, f), U32.to_nat(lrows)) == True{} : Bool}, h: Laws.NMin(f, m, acc, l, res))
  -> Laws.NMin(f, m, acc, CH.WN{rows, lrows, l, r}, res):
  match f:
    case 0n:
      h
    case 1n++p:
      (+x, ex, rest) = h
      +lt = B.lt_of_le_add(m, p, U32.to_nat(lrows), hb)
      (x, (%Equal.sym(Bool, Nat.is_lt(m, U32.to_nat(lrows)), True{}, lt) : {x == Bool.pick(U32, _, Laws.ncell(l, m), Laws.ncell(r, Nat.sub(m, U32.to_nat(lrows)))) : U32}; ex), nsum_left_min(p, 1n+m, U32.min(acc, x), l, res, rows, lrows, r, (%B.add_succ(m, p) : {Nat.is_le(_, U32.to_nat(lrows)) == True{} : Bool}; hb), rest))

# rows m .. of the right child are the node's rows lrows + m ..
def nsum_right_min(f: Nat, +m: Nat, +acc: U32, -r: CH.CW, +res: U32, -rows: U32, +lrows: U32, -l: CH.CW, h: Laws.NMin(f, m, acc, r, res))
  -> Laws.NMin(f, Nat.add(U32.to_nat(lrows), m), acc, CH.WN{rows, lrows, l, r}, res):
  match f:
    case 0n:
      h
    case 1n+p:
      (+x, ex, rest) = h
      (x, (%Equal.sym(Bool, Nat.is_lt(Nat.add(U32.to_nat(lrows), m), U32.to_nat(lrows)), False{}, nat_not_lt_addl(U32.to_nat(lrows), m)) : {x == Bool.pick(U32, _, Laws.ncell(l, Nat.add(U32.to_nat(lrows), m)), Laws.ncell(r, Nat.sub(Nat.add(U32.to_nat(lrows), m), U32.to_nat(lrows)))) : U32}; %Equal.sym(Nat, Nat.sub(Nat.add(U32.to_nat(lrows), m), U32.to_nat(lrows)), m, PCH.nat_add_sub(U32.to_nat(lrows), m)) : {x == Laws.ncell(r, _) : U32}; ex), (%B.add_succ(U32.to_nat(lrows), m) : Laws.NMin(p, _, U32.min(acc, x), CH.WN{rows, lrows, l, r}, res); nsum_right_min(p, 1n+m, U32.min(acc, x), r, res, rows, lrows, l, rest)))

# two runs back to back are one run
def nsum_cat_min(f1: Nat, +f2: Nat, +m: Nat, +acc: U32, +mid: U32, +res: U32, -t: CH.CW, h1: Laws.NMin(f1, m, acc, t, mid), h2: Laws.NMin(f2, Nat.add(m, f1), mid, t, res)) -> Laws.NMin(Nat.add(f1, f2), m, acc, t, res):
  match f1:
    case 0n:
      %PCH.nat_add_zero_r(m) : Laws.NMin(f2, _, acc, t, res)
      %h1 : Laws.NMin(f2, Nat.add(m, 0n), _, t, res)
      h2
    case 1n++p:
      (+x, ex, rest) = h1
      (x, ex, nsum_cat_min(p, f2, 1n+m, U32.min(acc, x), mid, res, t, rest, (%B.add_succ(m, p) : Laws.NMin(f2, _, mid, t, res); h2)))

# the node's run from the children's runs (the left one as is, the right one shifted by the left sum and
# moved to rows lrows ..)
def nsum_node_min(+rows: U32, +lrows: U32, -l: CH.CW, -r: CH.CW, +sl: U32, +sr: U32,
  +e1: {lrows == Laws.crows(l) : U32}, +e2: {Nat.add(U32.to_nat(lrows), Laws.nrows(r)) == U32.to_nat(rows) : Nat},
  nl: Laws.NMin(Laws.nrows(l), 0n, 4294967295, l, sl), nr: Laws.NMin(Laws.nrows(r), 0n, 4294967295, r, sr))
  -> Laws.NMin(U32.to_nat(rows), 0n, 4294967295, CH.WN{rows, lrows, l, r}, U32.min(sl, sr)):
  +el = Equal.cong(U32, Nat, q => U32.to_nat(q), Laws.crows(l), lrows, Equal.sym(U32, lrows, Laws.crows(l), e1))
  +hle = PCH.nat_le_of_sum(U32.to_nat(lrows), Laws.nrows(r), U32.to_nat(rows), e2)
  +esa = PCH.nat_sub_add(U32.to_nat(lrows), U32.to_nat(rows), hle)
  +er = PCH.nat_add_cancel_l(U32.to_nat(lrows), Laws.nrows(r), Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), U32.to_nat(rows), e2, esa)
  nl2 = nsum_cnt_min(Laws.nrows(l), U32.to_nat(lrows), 0n, 4294967295, l, sl, el, nl)
  nr2 = nsum_cnt_min(Laws.nrows(r), Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, 4294967295, r, sr, er, nr)
  left = nsum_left_min(U32.to_nat(lrows), 0n, 4294967295, l, sl, rows, lrows, r, PCH.nat_le_refl(U32.to_nat(lrows)), nl2)
  sh = nsum_acc_min(Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, U32.min(sl, 4294967295), sl, r, U32.min(sl, sr), u32_min_id(sl), nsum_shift_min(Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, 4294967295, sl, r, sr, nr2))
  right = nsum_idx_min(Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), Nat.add(U32.to_nat(lrows), 0n), U32.to_nat(lrows), sl, CH.WN{rows, lrows, l, r}, U32.min(sl, sr), PCH.nat_add_zero_r(U32.to_nat(lrows)), nsum_right_min(Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, sl, r, U32.min(sl, sr), rows, lrows, l, sh))
  nsum_cnt_min(Nat.add(U32.to_nat(lrows), Nat.sub(U32.to_nat(rows), U32.to_nat(lrows))), U32.to_nat(rows), 0n, 4294967295, CH.WN{rows, lrows, l, r}, U32.min(sl, sr), esa, nsum_cat_min(U32.to_nat(lrows), Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, 4294967295, sl, U32.min(sl, sr), CH.WN{rows, lrows, l, r}, left, right))

def SumA_min(-t: CH.CW) -> Type:
  &t2: CH.CW -> &s: U32 -> {KC.CK.min.w(t) == (t2, s) : CH.CW & U32} & {t2 == t : CH.CW} & {s == Laws.TMin(t) : U32} & Laws.NMin(Laws.nrows(t), 0n, 4294967295, t, s)

def sum_leaf_min(+n: U32, +d: Nat, -a: Array<U32>, w: FGoal_min(U32.to_nat(n), 0, 4294967295, a, Array.get(U32, a, 0))) -> SumA_min(CH.WL{n, d, a}):
  (b, +s, +ep, +eb, fs) = w
  (CH.WL{n, d, b}, s, (%Equal.sym(Array<U32> & U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.min(acc, x)), n, a, 4294967295), (b, s), ep) : {KC.CK.fold.w.l(n, d, _) == (CH.WL{n, d, b}, s) : CH.CW & U32}; {==}), Equal.cong(Array<U32>, CH.CW, q => CH.WL{n, d, q}, b, a, eb), Equal.cong(Array<U32> & U32, U32, q => Pair.snd(Array<U32>, U32, q), (b, s), K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.min(acc, x)), n, a, 4294967295), Equal.sym(Array<U32> & U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.min(acc, x)), n, a, 4294967295), (b, s), ep)), fsum_nsum_min(U32.to_nat(n), 0n, 4294967295, a, s, n, d, fs))

def sum_node_min(+rows: U32, +lrows: U32, -l: CH.CW, -r: CH.CW, +e1: {lrows == Laws.crows(l) : U32}, +e2: {Nat.add(U32.to_nat(lrows), Laws.nrows(r)) == U32.to_nat(rows) : Nat}, x: SumA_min(l), y: SumA_min(r)) -> SumA_min(CH.WN{rows, lrows, l, r}):
  (l2, +sl, +eql, +el2, +esl, nl) = x
  (r2, +sr, +eqr, +er2, +esr, nr) = y
  (CH.WN{rows, lrows, l2, r2}, U32.min(sl, sr), (%Equal.sym(CH.CW & U32, KC.CK.min.w(l), (l2, sl), eql) : {KC.CK.fold.w.j(~(a => b => U32.min(a, b)), rows, lrows, _, KC.CK.min.w(r)) == (CH.WN{rows, lrows, l2, r2}, U32.min(sl, sr)) : CH.CW & U32}; %Equal.sym(CH.CW & U32, KC.CK.min.w(r), (r2, sr), eqr) : {KC.CK.fold.w.j(~(a => b => U32.min(a, b)), rows, lrows, (l2, sl), _) == (CH.WN{rows, lrows, l2, r2}, U32.min(sl, sr)) : CH.CW & U32}; {==}), (%el2 : {CH.WN{rows, lrows, l2, r2} == CH.WN{rows, lrows, _, r} : CH.CW}; %er2 : {CH.WN{rows, lrows, l2, r2} == CH.WN{rows, lrows, l2, _} : CH.CW}; {==}), (%esl : {U32.min(sl, sr) == U32.min(_, Laws.TMin(r)) : U32}; %esr : {U32.min(sl, sr) == U32.min(sl, _) : U32}; {==}), nsum_node_min(rows, lrows, l, r, sl, sr, e1, e2, nl, nr))

def sum_all_min(t: CH.CW, wf: Laws.WFChunks(t)) -> SumA_min(t):
  match t:
    case CH.WL{+n, +d, a}:
      sum_leaf_min(n, d, a, fold_go_min(U32.to_nat(n), 0, 4294967295, a))
    case CH.WN{+rows, +lrows, l, r}:
      (+e1, +e2, wl, wr) = wf
      sum_node_min(rows, lrows, l, r, e1, e2, sum_all_min(l, wl), sum_all_min(r, wr))

def ck_sum_k_min(-t: CH.CW, w: SumA_min(t)) -> {Pair.fst(CH.CW, U32, KC.CK.min.w(t)) == t : CH.CW} & {Pair.snd(CH.CW, U32, KC.CK.min.w(t)) == Laws.TMin(t) : U32} & Laws.NMin(Laws.nrows(t), 0n, 4294967295, t, Laws.TMin(t)):
  (t2, +s, +eq, +et, +es, ns) = w
  ((%Equal.sym(CH.CW & U32, KC.CK.min.w(t), (t2, s), eq) : {Pair.fst(CH.CW, U32, _) == t : CH.CW}; et), (%Equal.sym(CH.CW & U32, KC.CK.min.w(t), (t2, s), eq) : {Pair.snd(CH.CW, U32, _) == Laws.TMin(t) : U32}; es), (%es : Laws.NMin(Laws.nrows(t), 0n, 4294967295, t, _); ns))

def Laws.ck_min(t, wf):
  ck_sum_k_min(t, sum_all_min(t, wf))


# ==== the U32 tree max (ck_max): the sum's machinery over U32.max ===================================

# the running max of the first f slots from index i, started at acc (FSum over U32.max)
def FMax(f: Nat, +i: U32, +acc: U32, -a: Array<U32>, +res: U32) -> Type:
  match f:
    case 0n:
      {res == acc : U32}
    case 1n+p:
      &x: U32 -> {x == Laws.rd_at(U32, a, i) : U32} & FMax(p, U32.inc(i), U32.max(acc, x), a, res)

# the fold with fl steps left at index i and accumulator acc, pending read r of a[i]
def FGoal_max(fl: Nat, +i: U32, +acc: U32, -a: Array<U32>, -r: Array<U32> & U32) -> Type:
  &a2: Array<U32> -> &res: U32 -> {K.Kernel.fold.go(~U32, ~U32, ~(acc => x => U32.max(acc, x)), fl, i, acc, r) == (a2, res) : Array<U32> & U32} & {a2 == a : Array<U32>} & FMax(fl, i, acc, a, res)

def fold_zero_max(+i: U32, +acc: U32, -a: Array<U32>, w: &b: Array<U32> -> &x: U32 -> {b == a : Array<U32>} & {Array.get(U32, a, i) == (a, x) : Array<U32> & U32} & {x == Laws.rd_at(U32, a, i) : U32}) -> FGoal_max(0n, i, acc, a, Array.get(U32, a, i)):
  (a2, +x, ea, e1, ex) = w
  %Equal.sym(Array<U32> & U32, Array.get(U32, a, i), (a, x), e1) : FGoal_max(0n, i, acc, a, _)
  %ea : FGoal_max(0n, i, acc, _, (_, x))
  (a2, acc, {==}, {==}, {==})

# the induction hypothesis repackaged: the cell x read at i names the step of FSum
def fold_step_max(p: Nat, +i: U32, +acc: U32, -a: Array<U32>, +x: U32, ex: {x == Laws.rd_at(U32, a, i) : U32},
  w: &a3: Array<U32> -> &res: U32 -> {K.Kernel.fold.go(~U32, ~U32, ~(acc => x => U32.max(acc, x)), p, U32.inc(i), U32.max(acc, x), Array.get(U32, a, U32.inc(i))) == (a3, res) : Array<U32> & U32} & {a3 == a : Array<U32>} & FMax(p, U32.inc(i), U32.max(acc, x), a, res))
  -> FGoal_max(1n+p, i, acc, a, (a, x)):
  (a3, +res, eq, ea3, spec) = w
  (a3, res, eq, ea3, (x, ex, spec))

def fold_cons_max(p: Nat, +i: U32, +acc: U32, -a: Array<U32>, w: &b: Array<U32> -> &x: U32 -> {b == a : Array<U32>} & {Array.get(U32, a, i) == (a, x) : Array<U32> & U32} & {x == Laws.rd_at(U32, a, i) : U32},
  ih: @a2: Array<U32> -> @x: U32 -> FGoal_max(p, U32.inc(i), U32.max(acc, x), a2, Array.get(U32, a2, U32.inc(i))))
  -> FGoal_max(1n+p, i, acc, a, Array.get(U32, a, i)):
  (a2, +x, +ea, e1, ex) = w
  %Equal.sym(Array<U32> & U32, Array.get(U32, a, i), (a, x), e1) : FGoal_max(1n+p, i, acc, a, _)
  %ea : FGoal_max(1n+p, i, acc, _, (_, x))
  fold_step_max(p, i, acc, a2, x, Equal.trans(U32, x, Laws.rd_at(U32, a, i), Laws.rd_at(U32, a2, i), ex, Equal.sym(U32, Laws.rd_at(U32, a2, i), Laws.rd_at(U32, a, i), Equal.cong(Array<U32>, U32, q => Laws.rd_at(U32, q, i), a2, a, ea))), ih(a2, x))

def fold_go_max(fl: Nat, +i: U32, +acc: U32, a: Array<U32>) -> FGoal_max(fl, i, acc, a, Array.get(U32, a, i)):
  match fl:
    case 0n:
      fold_zero_max(i, acc, a, PC.get_w(U32, a, i))
    case 1n++p:
      fold_cons_max(p, i, acc, a, PC.get_w(U32, a, i), a2 => x => fold_go_max(p, U32.inc(i), U32.max(acc, x), a2))

# a leaf's FSum over its slots is the NSum over its logical rows (ncell reads the slot addn(0, m))
def fsum_nsum_max(f: Nat, +m: Nat, +acc: U32, -a: Array<U32>, +res: U32, -n: U32, -d: Nat, h: FMax(f, Laws.addn(0, m), acc, a, res)) -> Laws.NMax(f, m, acc, CH.WL{n, d, a}, res):
  match f:
    case 0n:
      h
    case 1n+p:
      (+x, ex, rest) = h
      (x, ex, fsum_nsum_max(p, 1n+m, U32.max(acc, x), a, res, n, d, rest))

# casts: the count, the start row and the accumulator of an NSum, by equations
def nsum_cnt_max(-f1: Nat, -f2: Nat, -m: Nat, -acc: U32, -t: CH.CW, -res: U32, e: {f1 == f2 : Nat}, h: Laws.NMax(f1, m, acc, t, res)) -> Laws.NMax(f2, m, acc, t, res):
  %e : Laws.NMax(_, m, acc, t, res)
  h

def nsum_idx_max(-f: Nat, -i: Nat, -j: Nat, -acc: U32, -t: CH.CW, -res: U32, e: {i == j : Nat}, h: Laws.NMax(f, i, acc, t, res)) -> Laws.NMax(f, j, acc, t, res):
  %e : Laws.NMax(f, _, acc, t, res)
  h

def nsum_acc_max(-f: Nat, -m: Nat, -a1: U32, -a2: U32, -t: CH.CW, -res: U32, e: {a1 == a2 : U32}, h: Laws.NMax(f, m, a1, t, res)) -> Laws.NMax(f, m, a2, t, res):
  %e : Laws.NMax(f, m, _, t, res)
  h

# c + (running sum from acc) is the running sum from c + acc (U32.add associativity at every step)
def nsum_shift_max(f: Nat, +m: Nat, +acc: U32, +c: U32, -t: CH.CW, +res: U32, h: Laws.NMax(f, m, acc, t, res)) -> Laws.NMax(f, m, U32.max(c, acc), t, U32.max(c, res)):
  match f:
    case 0n:
      Equal.cong(U32, U32, q => U32.max(c, q), res, acc, h)
    case 1n+p:
      (+x, ex, rest) = h
      (x, ex, (%Equal.sym(U32, U32.max(U32.max(c, acc), x), U32.max(c, U32.max(acc, x)), u32_max_assoc2(c, acc, x)) : Laws.NMax(p, 1n+m, _, t, U32.max(c, res)); nsum_shift_max(p, 1n+m, U32.max(acc, x), c, t, res, rest)))

# rows m .. m + f - 1 of the left child are the node's rows m .. (all below lrows)
def nsum_left_max(f: Nat, +m: Nat, +acc: U32, -l: CH.CW, +res: U32, -rows: U32, +lrows: U32, -r: CH.CW,
  +hb: {Nat.is_le(Nat.add(m, f), U32.to_nat(lrows)) == True{} : Bool}, h: Laws.NMax(f, m, acc, l, res))
  -> Laws.NMax(f, m, acc, CH.WN{rows, lrows, l, r}, res):
  match f:
    case 0n:
      h
    case 1n++p:
      (+x, ex, rest) = h
      +lt = B.lt_of_le_add(m, p, U32.to_nat(lrows), hb)
      (x, (%Equal.sym(Bool, Nat.is_lt(m, U32.to_nat(lrows)), True{}, lt) : {x == Bool.pick(U32, _, Laws.ncell(l, m), Laws.ncell(r, Nat.sub(m, U32.to_nat(lrows)))) : U32}; ex), nsum_left_max(p, 1n+m, U32.max(acc, x), l, res, rows, lrows, r, (%B.add_succ(m, p) : {Nat.is_le(_, U32.to_nat(lrows)) == True{} : Bool}; hb), rest))

# rows m .. of the right child are the node's rows lrows + m ..
def nsum_right_max(f: Nat, +m: Nat, +acc: U32, -r: CH.CW, +res: U32, -rows: U32, +lrows: U32, -l: CH.CW, h: Laws.NMax(f, m, acc, r, res))
  -> Laws.NMax(f, Nat.add(U32.to_nat(lrows), m), acc, CH.WN{rows, lrows, l, r}, res):
  match f:
    case 0n:
      h
    case 1n+p:
      (+x, ex, rest) = h
      (x, (%Equal.sym(Bool, Nat.is_lt(Nat.add(U32.to_nat(lrows), m), U32.to_nat(lrows)), False{}, nat_not_lt_addl(U32.to_nat(lrows), m)) : {x == Bool.pick(U32, _, Laws.ncell(l, Nat.add(U32.to_nat(lrows), m)), Laws.ncell(r, Nat.sub(Nat.add(U32.to_nat(lrows), m), U32.to_nat(lrows)))) : U32}; %Equal.sym(Nat, Nat.sub(Nat.add(U32.to_nat(lrows), m), U32.to_nat(lrows)), m, PCH.nat_add_sub(U32.to_nat(lrows), m)) : {x == Laws.ncell(r, _) : U32}; ex), (%B.add_succ(U32.to_nat(lrows), m) : Laws.NMax(p, _, U32.max(acc, x), CH.WN{rows, lrows, l, r}, res); nsum_right_max(p, 1n+m, U32.max(acc, x), r, res, rows, lrows, l, rest)))

# two runs back to back are one run
def nsum_cat_max(f1: Nat, +f2: Nat, +m: Nat, +acc: U32, +mid: U32, +res: U32, -t: CH.CW, h1: Laws.NMax(f1, m, acc, t, mid), h2: Laws.NMax(f2, Nat.add(m, f1), mid, t, res)) -> Laws.NMax(Nat.add(f1, f2), m, acc, t, res):
  match f1:
    case 0n:
      %PCH.nat_add_zero_r(m) : Laws.NMax(f2, _, acc, t, res)
      %h1 : Laws.NMax(f2, Nat.add(m, 0n), _, t, res)
      h2
    case 1n++p:
      (+x, ex, rest) = h1
      (x, ex, nsum_cat_max(p, f2, 1n+m, U32.max(acc, x), mid, res, t, rest, (%B.add_succ(m, p) : Laws.NMax(f2, _, mid, t, res); h2)))

# the node's run from the children's runs (the left one as is, the right one shifted by the left sum and
# moved to rows lrows ..)
def nsum_node_max(+rows: U32, +lrows: U32, -l: CH.CW, -r: CH.CW, +sl: U32, +sr: U32,
  +e1: {lrows == Laws.crows(l) : U32}, +e2: {Nat.add(U32.to_nat(lrows), Laws.nrows(r)) == U32.to_nat(rows) : Nat},
  nl: Laws.NMax(Laws.nrows(l), 0n, 0, l, sl), nr: Laws.NMax(Laws.nrows(r), 0n, 0, r, sr))
  -> Laws.NMax(U32.to_nat(rows), 0n, 0, CH.WN{rows, lrows, l, r}, U32.max(sl, sr)):
  +el = Equal.cong(U32, Nat, q => U32.to_nat(q), Laws.crows(l), lrows, Equal.sym(U32, lrows, Laws.crows(l), e1))
  +hle = PCH.nat_le_of_sum(U32.to_nat(lrows), Laws.nrows(r), U32.to_nat(rows), e2)
  +esa = PCH.nat_sub_add(U32.to_nat(lrows), U32.to_nat(rows), hle)
  +er = PCH.nat_add_cancel_l(U32.to_nat(lrows), Laws.nrows(r), Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), U32.to_nat(rows), e2, esa)
  nl2 = nsum_cnt_max(Laws.nrows(l), U32.to_nat(lrows), 0n, 0, l, sl, el, nl)
  nr2 = nsum_cnt_max(Laws.nrows(r), Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, 0, r, sr, er, nr)
  left = nsum_left_max(U32.to_nat(lrows), 0n, 0, l, sl, rows, lrows, r, PCH.nat_le_refl(U32.to_nat(lrows)), nl2)
  sh = nsum_acc_max(Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, U32.max(sl, 0), sl, r, U32.max(sl, sr), u32_max_id(sl), nsum_shift_max(Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, 0, sl, r, sr, nr2))
  right = nsum_idx_max(Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), Nat.add(U32.to_nat(lrows), 0n), U32.to_nat(lrows), sl, CH.WN{rows, lrows, l, r}, U32.max(sl, sr), PCH.nat_add_zero_r(U32.to_nat(lrows)), nsum_right_max(Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, sl, r, U32.max(sl, sr), rows, lrows, l, sh))
  nsum_cnt_max(Nat.add(U32.to_nat(lrows), Nat.sub(U32.to_nat(rows), U32.to_nat(lrows))), U32.to_nat(rows), 0n, 0, CH.WN{rows, lrows, l, r}, U32.max(sl, sr), esa, nsum_cat_max(U32.to_nat(lrows), Nat.sub(U32.to_nat(rows), U32.to_nat(lrows)), 0n, 0, sl, U32.max(sl, sr), CH.WN{rows, lrows, l, r}, left, right))

def SumA_max(-t: CH.CW) -> Type:
  &t2: CH.CW -> &s: U32 -> {KC.CK.max.w(t) == (t2, s) : CH.CW & U32} & {t2 == t : CH.CW} & {s == Laws.TMax(t) : U32} & Laws.NMax(Laws.nrows(t), 0n, 0, t, s)

def sum_leaf_max(+n: U32, +d: Nat, -a: Array<U32>, w: FGoal_max(U32.to_nat(n), 0, 0, a, Array.get(U32, a, 0))) -> SumA_max(CH.WL{n, d, a}):
  (b, +s, +ep, +eb, fs) = w
  (CH.WL{n, d, b}, s, (%Equal.sym(Array<U32> & U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.max(acc, x)), n, a, 0), (b, s), ep) : {KC.CK.fold.w.l(n, d, _) == (CH.WL{n, d, b}, s) : CH.CW & U32}; {==}), Equal.cong(Array<U32>, CH.CW, q => CH.WL{n, d, q}, b, a, eb), Equal.cong(Array<U32> & U32, U32, q => Pair.snd(Array<U32>, U32, q), (b, s), K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.max(acc, x)), n, a, 0), Equal.sym(Array<U32> & U32, K.Kernel.fold(~U32, ~U32, ~(acc => x => U32.max(acc, x)), n, a, 0), (b, s), ep)), fsum_nsum_max(U32.to_nat(n), 0n, 0, a, s, n, d, fs))

def sum_node_max(+rows: U32, +lrows: U32, -l: CH.CW, -r: CH.CW, +e1: {lrows == Laws.crows(l) : U32}, +e2: {Nat.add(U32.to_nat(lrows), Laws.nrows(r)) == U32.to_nat(rows) : Nat}, x: SumA_max(l), y: SumA_max(r)) -> SumA_max(CH.WN{rows, lrows, l, r}):
  (l2, +sl, +eql, +el2, +esl, nl) = x
  (r2, +sr, +eqr, +er2, +esr, nr) = y
  (CH.WN{rows, lrows, l2, r2}, U32.max(sl, sr), (%Equal.sym(CH.CW & U32, KC.CK.max.w(l), (l2, sl), eql) : {KC.CK.fold.w.j(~(a => b => U32.max(a, b)), rows, lrows, _, KC.CK.max.w(r)) == (CH.WN{rows, lrows, l2, r2}, U32.max(sl, sr)) : CH.CW & U32}; %Equal.sym(CH.CW & U32, KC.CK.max.w(r), (r2, sr), eqr) : {KC.CK.fold.w.j(~(a => b => U32.max(a, b)), rows, lrows, (l2, sl), _) == (CH.WN{rows, lrows, l2, r2}, U32.max(sl, sr)) : CH.CW & U32}; {==}), (%el2 : {CH.WN{rows, lrows, l2, r2} == CH.WN{rows, lrows, _, r} : CH.CW}; %er2 : {CH.WN{rows, lrows, l2, r2} == CH.WN{rows, lrows, l2, _} : CH.CW}; {==}), (%esl : {U32.max(sl, sr) == U32.max(_, Laws.TMax(r)) : U32}; %esr : {U32.max(sl, sr) == U32.max(sl, _) : U32}; {==}), nsum_node_max(rows, lrows, l, r, sl, sr, e1, e2, nl, nr))

def sum_all_max(t: CH.CW, wf: Laws.WFChunks(t)) -> SumA_max(t):
  match t:
    case CH.WL{+n, +d, a}:
      sum_leaf_max(n, d, a, fold_go_max(U32.to_nat(n), 0, 0, a))
    case CH.WN{+rows, +lrows, l, r}:
      (+e1, +e2, wl, wr) = wf
      sum_node_max(rows, lrows, l, r, e1, e2, sum_all_max(l, wl), sum_all_max(r, wr))

def ck_sum_k_max(-t: CH.CW, w: SumA_max(t)) -> {Pair.fst(CH.CW, U32, KC.CK.max.w(t)) == t : CH.CW} & {Pair.snd(CH.CW, U32, KC.CK.max.w(t)) == Laws.TMax(t) : U32} & Laws.NMax(Laws.nrows(t), 0n, 0, t, Laws.TMax(t)):
  (t2, +s, +eq, +et, +es, ns) = w
  ((%Equal.sym(CH.CW & U32, KC.CK.max.w(t), (t2, s), eq) : {Pair.fst(CH.CW, U32, _) == t : CH.CW}; et), (%Equal.sym(CH.CW & U32, KC.CK.max.w(t), (t2, s), eq) : {Pair.snd(CH.CW, U32, _) == Laws.TMax(t) : U32}; es), (%es : Laws.NMax(Laws.nrows(t), 0n, 0, t, _); ns))

def Laws.ck_max(t, wf):
  ck_sum_k_max(t, sum_all_max(t, wf))

