# PROOF_ckernels.bend -- proofs of LAWS.bend section 22 (v0.2 T5.2, DESIGN.md 16.1 / 16.3 / 16.4): the
# chunked kernel wrappers of src/ckernels.bend (generated by bench/w5/gen_ckernels.py: every instance of one
# wrapper is the same text, so the proofs here are written once per wrapper at the instance the law names).
#
# Shape of the proofs:
#  - LEAFWISE / UNFUSED laws are inductions over the input tree(s) that reduce the wrapper one step: at a
#    leaf the wrapper IS the flat kernel (by conversion, `{==}`), or the flat kernel's own unfused / hand-back
#    law rewrites the kernel's answer record into constructor form (Laws.map_pb_unfused, Laws.zipb_unfused,
#    Laws.zipv_valid, Laws.pred_count_keeps, PF.c3_sim) so the wrapper's leaf helper reduces; at a node the
#    parallel let reduces and the two induction hypotheses are used once each (a live child goes to ONE
#    lemma);
#  - lockstep wrappers are proven over all shape combinations: a mismatch reduces to the fallback branch;
#  - the count / sum combine is the row-order modular sum of section 21's logical cells (NSum), built from
#    u32_fold_sum at the leaves and U32.add associativity (word_add_assoc, a carry case analysis) at nodes.
import Base
import ./src/dtype.bend as D
import ./src/err.bend as E
import ./src/kernels.bend as K
import ./src/chunks.bend as CH
import ./src/ckernels.bend as KC
import ./LAWS.bend as Laws
import ./PROOF_lib.bend as L
import ./PROOF_kernels.bend as PK
import ./PROOF_bits.bend as B
import ./PROOF_contents.bend as PC
import ./PROOF_append.bend as PA
import ./PROOF_fused.bend as PF
import ./PROOF_chunks.bend as PCH

# ==== maps ==============================================================================================

def Laws.ck_map_leafwise(t):
  match t:
    case CH.WL{+n, +d, a}:
      ({==}, {==}, {==})
    case CH.WN{+rows, +lrows, l, r}:
      ({==}, {==}, Laws.ck_map_leafwise(l), Laws.ck_map_leafwise(r))

def Laws.ck_mapp_leafwise(t, lit):
  match t:
    case CH.WL{+n, +d, a}:
      ({==}, {==}, {==})
    case CH.WN{+rows, +lrows, l, r}:
      ({==}, {==}, Laws.ck_mapp_leafwise(l, lit), Laws.ck_mapp_leafwise(r, lit))

# the unfused law in the rewriting direction: (mapp(t), t) == mappb(t)
def mpbu(t: CH.CW, +lit: U32, +z: U32) -> {(KC.CK.mapp.ww(~U32, ~(p => w => Bool.to_u32(U32.is_gt(w, p))), t, lit, z), t) == KC.CK.mappb.ww(~U32, ~(p => w => Bool.to_u32(U32.is_gt(w, p))), t, lit, z) : CH.CW & CH.CW}:
  match t:
    case CH.WL{+n, +d, a}:
      %Equal.sym(Array<U32> & Array<U32>, K.Kernel.map_pb(~U32, ~U32, ~U32, ~(p => w => Bool.to_u32(U32.is_gt(w, p))), n, d, a, lit, z), (K.Kernel.map_p(~U32, ~U32, ~U32, ~(p => w => Bool.to_u32(U32.is_gt(w, p))), n, d, a, lit, z), a), Laws.map_pb_unfused(d, n, a, lit, z)) : {(KC.CK.mapp.ww(~U32, ~(p => w => Bool.to_u32(U32.is_gt(w, p))), CH.WL{n, d, a}, lit, z), CH.WL{n, d, a}) == KC.CK.mappb.ww.l(n, d, _) : CH.CW & CH.CW}
      {==}
    case CH.WN{+rows, +lrows, l, r}:
      %mpbu(l, lit, z) : {(KC.CK.mapp.ww(~U32, ~(p => w => Bool.to_u32(U32.is_gt(w, p))), CH.WN{rows, lrows, l, r}, lit, z), CH.WN{rows, lrows, l, r}) == KC.CK.mappb.ww.j(rows, lrows, _, KC.CK.mappb.ww(~U32, ~(p => w => Bool.to_u32(U32.is_gt(w, p))), r, lit, z)) : CH.CW & CH.CW}
      %mpbu(r, lit, z) : {(KC.CK.mapp.ww(~U32, ~(p => w => Bool.to_u32(U32.is_gt(w, p))), CH.WN{rows, lrows, l, r}, lit, z), CH.WN{rows, lrows, l, r}) == KC.CK.mappb.ww.j(rows, lrows, (KC.CK.mapp.ww(~U32, ~(p => w => Bool.to_u32(U32.is_gt(w, p))), l, lit, z), l), _) : CH.CW & CH.CW}
      {==}

def Laws.ck_mappb_unfused(t, lit, z):
  Equal.sym(CH.CW & CH.CW, (KC.CK.mapp.ww(~U32, ~(p => w => Bool.to_u32(U32.is_gt(w, p))), t, lit, z), t), KC.CK.mappb.ww(~U32, ~(p => w => Bool.to_u32(U32.is_gt(w, p))), t, lit, z), mpbu(t, lit, z))

# ==== zips ==============================================================================================

def Laws.ck_zip_leafwise(a, b):
  match a b:
    case CH.WL{+na, +da, xa} CH.WL{+nb, +db, xb}:
      ({==}, {==}, {==})
    case CH.WN{+r1, +l1, x1, y1} CH.WN{+r2, +l2, x2, y2}:
      ({==}, {==}, Laws.ck_zip_leafwise(x1, x2), Laws.ck_zip_leafwise(y1, y2))
    case CH.WL{+na, +da, xa} CH.WN{+r2, +l2, x2, y2}:
      {==}
    case CH.WN{+r1, +l1, x1, y1} CH.WL{+nb, +db, xb}:
      {==}

# the unfused law in the rewriting direction: CZB{zip(a, b), a, b} == zipb(a, b)
def zbu(a: CH.CW, b: CH.CF, +z: F32) -> {KC.CZB{KC.CK.zip.wff(~(x => y => F32.mul(U32.to_f32(x), y)), a, b, z), a, b} == KC.CK.zipb.wff(~(x => y => F32.mul(U32.to_f32(x), y)), a, b, z) : KC.CZB<CH.CW, CH.CF, CH.CF>}:
  match a b:
    case CH.WL{+na, +da, xa} CH.FL{+nb, +db, xb}:
      %Equal.sym(K.ZB<U32, F32, F32>, K.Kernel.zipb(~U32, ~F32, ~F32, ~(x => y => F32.mul(U32.to_f32(x), y)), na, KC.CK.dmax(da, db), xa, xb, z), K.ZB{K.Kernel.zip(~U32, ~F32, ~F32, ~(x => y => F32.mul(U32.to_f32(x), y)), na, KC.CK.dmax(da, db), xa, xb, z), xa, xb}, Laws.zipb_unfused(KC.CK.dmax(da, db), na, xa, xb, z)) : {KC.CZB{KC.CK.zip.wff(~(x => y => F32.mul(U32.to_f32(x), y)), CH.WL{na, da, xa}, CH.FL{nb, db, xb}, z), CH.WL{na, da, xa}, CH.FL{nb, db, xb}} == KC.CK.zipb.wff.l(na, KC.CK.dmax(da, db), da, nb, db, _) : KC.CZB<CH.CW, CH.CF, CH.CF>}
      {==}
    case CH.WN{+r1, +l1, x1, y1} CH.FN{+r2, +l2, x2, y2}:
      %zbu(x1, x2, z) : {KC.CZB{KC.CK.zip.wff(~(x => y => F32.mul(U32.to_f32(x), y)), CH.WN{r1, l1, x1, y1}, CH.FN{r2, l2, x2, y2}, z), CH.WN{r1, l1, x1, y1}, CH.FN{r2, l2, x2, y2}} == KC.CK.zipb.wff.j(r1, l1, r2, l2, _, KC.CK.zipb.wff(~(x => y => F32.mul(U32.to_f32(x), y)), y1, y2, z)) : KC.CZB<CH.CW, CH.CF, CH.CF>}
      %zbu(y1, y2, z) : {KC.CZB{KC.CK.zip.wff(~(x => y => F32.mul(U32.to_f32(x), y)), CH.WN{r1, l1, x1, y1}, CH.FN{r2, l2, x2, y2}, z), CH.WN{r1, l1, x1, y1}, CH.FN{r2, l2, x2, y2}} == KC.CK.zipb.wff.j(r1, l1, r2, l2, KC.CZB{KC.CK.zip.wff(~(x => y => F32.mul(U32.to_f32(x), y)), x1, x2, z), x1, x2}, _) : KC.CZB<CH.CW, CH.CF, CH.CF>}
      {==}
    case CH.WL{+na, +da, xa} CH.FN{+r2, +l2, x2, y2}:
      {==}
    case CH.WN{+r1, +l1, x1, y1} CH.FL{+nb, +db, xb}:
      {==}

def Laws.ck_zipb_unfused(a, b, z):
  Equal.sym(KC.CZB<CH.CW, CH.CF, CH.CF>, KC.CZB{KC.CK.zip.wff(~(x => y => F32.mul(U32.to_f32(x), y)), a, b, z), a, b}, KC.CK.zipb.wff(~(x => y => F32.mul(U32.to_f32(x), y)), a, b, z), zbu(a, b, z))

# ==== F2: zipv ===========================================================================================

def zvu(a: CH.CW, va: CH.CW, b: CH.CW, vb: CH.CW, +z: U32) -> {KC.CZV{Laws.ZvO(a, va, b, vb, z), Laws.ZvVo(a, va, b, vb), a, va, b, vb} == KC.CK.zipv.www(~(x => y => U32.add(x, y)), a, va, b, vb, z) : KC.CZV<CH.CW, CH.CW, CH.CW>}:
  match a va b vb:
    case CH.WL{+n0, +d0, x0} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      %Equal.sym(K.ZV<U32, U32, U32>, K.Kernel.zipv(~U32, ~U32, ~U32, ~(x => y => U32.add(x, y)), n0, KC.CK.dmax(d0, d2), x0, x1, x2, x3, z), K.ZV{Laws.zv_o(U32, U32, U32, K.Kernel.zipv(~U32, ~U32, ~U32, ~(x => y => U32.add(x, y)), n0, KC.CK.dmax(d0, d2), x0, x1, x2, x3, z)), K.Kernel.mask_and(n0, KC.CK.dmax(d0, d2), x1, x3), x0, x1, x2, x3}, Laws.zipv_valid(KC.CK.dmax(d0, d2), n0, x0, x1, x2, x3, z)) : {KC.CZV{Laws.ZvO(CH.WL{n0, d0, x0}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}, z), Laws.ZvVo(CH.WL{n0, d0, x0}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}), CH.WL{n0, d0, x0}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}} == KC.CK.zipv.www.l(n0, KC.CK.dmax(d0, d2), d0, n1, d1, n2, d2, n3, d3, _) : KC.CZV<CH.CW, CH.CW, CH.CW>}
      {==}
    case CH.WL{+n0, +d0, x0} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      %zvu(p0, p1, p2, p3, z) : {KC.CZV{Laws.ZvO(CH.WN{r0, l0, p0, q0}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}, z), Laws.ZvVo(CH.WN{r0, l0, p0, q0}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}), CH.WN{r0, l0, p0, q0}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}} == KC.CK.zipv.www.j(r0, l0, r1, l1, r2, l2, r3, l3, _, KC.CK.zipv.www(~(x => y => U32.add(x, y)), q0, q1, q2, q3, z)) : KC.CZV<CH.CW, CH.CW, CH.CW>}
      %zvu(q0, q1, q2, q3, z) : {KC.CZV{Laws.ZvO(CH.WN{r0, l0, p0, q0}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}, z), Laws.ZvVo(CH.WN{r0, l0, p0, q0}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}), CH.WN{r0, l0, p0, q0}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}} == KC.CK.zipv.www.j(r0, l0, r1, l1, r2, l2, r3, l3, KC.CZV{Laws.ZvO(p0, p1, p2, p3, z), Laws.ZvVo(p0, p1, p2, p3), p0, p1, p2, p3}, _) : KC.CZV<CH.CW, CH.CW, CH.CW>}
      {==}

def Laws.ck_zipv(a, va, b, vb, z):
  Equal.sym(KC.CZV<CH.CW, CH.CW, CH.CW>, KC.CZV{Laws.ZvO(a, va, b, vb, z), Laws.ZvVo(a, va, b, vb), a, va, b, vb}, KC.CK.zipv.www(~(x => y => U32.add(x, y)), a, va, b, vb, z), zvu(a, va, b, vb, z))

# ==== F5: pred_count ====================================================================================

def pcu(+lit: U32, a: CH.CW, va: CH.CW, b: CH.CW, vb: CH.CW) -> {KC.CPC{Laws.PcM(lit, a, va, b, vb), Laws.PcK(lit, a, va, b, vb), a, va, b, vb} == KC.CK.pc.ww(~U32, ~(p => x => y => U32.and(x, Bool.to_u32(U32.is_gt(y, p)))), lit, a, va, b, vb) : KC.CPC<CH.CW, CH.CW>}:
  match a va b vb:
    case CH.WL{+n0, +d0, x0} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      %Equal.sym(K.PC<U32, U32>, K.Kernel.pred_count(~U32, ~U32, ~U32, ~(p => x => y => U32.and(x, Bool.to_u32(U32.is_gt(y, p)))), n0, KC.CK.dmax(d0, d2), lit, x0, x1, x2, x3), K.PC{Laws.pc_m(U32, U32, K.Kernel.pred_count(~U32, ~U32, ~U32, ~(p => x => y => U32.and(x, Bool.to_u32(U32.is_gt(y, p)))), n0, KC.CK.dmax(d0, d2), lit, x0, x1, x2, x3)), Laws.pc_k(U32, U32, K.Kernel.pred_count(~U32, ~U32, ~U32, ~(p => x => y => U32.and(x, Bool.to_u32(U32.is_gt(y, p)))), n0, KC.CK.dmax(d0, d2), lit, x0, x1, x2, x3)), x0, x1, x2, x3}, Laws.pred_count_keeps(KC.CK.dmax(d0, d2), n0, lit, x0, x1, x2, x3)) : {KC.CPC{Laws.PcM(lit, CH.WL{n0, d0, x0}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}), Laws.PcK(lit, CH.WL{n0, d0, x0}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}), CH.WL{n0, d0, x0}, CH.WL{n1, d1, x1}, CH.WL{n2, d2, x2}, CH.WL{n3, d3, x3}} == KC.CK.pc.ww.l(n0, KC.CK.dmax(d0, d2), d0, n1, d1, n2, d2, n3, d3, _) : KC.CPC<CH.CW, CH.CW>}
      {==}
    case CH.WL{+n0, +d0, x0} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WL{+n0, +d0, x0} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WL{+n1, +d1, x1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WL{+n1, +d1, x1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WN{+r1, +l1, p1, q1} CH.WL{+n2, +d2, x2} CH.WN{+r3, +l3, p3, q3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WL{+n3, +d3, x3}:
      {==}
    case CH.WN{+r0, +l0, p0, q0} CH.WN{+r1, +l1, p1, q1} CH.WN{+r2, +l2, p2, q2} CH.WN{+r3, +l3, p3, q3}:
      %pcu(lit, p0, p1, p2, p3) : {KC.CPC{Laws.PcM(lit, CH.WN{r0, l0, p0, q0}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}), Laws.PcK(lit, CH.WN{r0, l0, p0, q0}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}), CH.WN{r0, l0, p0, q0}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}} == KC.CK.pc.ww.j(r0, l0, r1, l1, r2, l2, r3, l3, _, KC.CK.pc.ww(~U32, ~(p => x => y => U32.and(x, Bool.to_u32(U32.is_gt(y, p)))), lit, q0, q1, q2, q3)) : KC.CPC<CH.CW, CH.CW>}
      %pcu(lit, q0, q1, q2, q3) : {KC.CPC{Laws.PcM(lit, CH.WN{r0, l0, p0, q0}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}), Laws.PcK(lit, CH.WN{r0, l0, p0, q0}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}), CH.WN{r0, l0, p0, q0}, CH.WN{r1, l1, p1, q1}, CH.WN{r2, l2, p2, q2}, CH.WN{r3, l3, p3, q3}} == KC.CK.pc.ww.j(r0, l0, r1, l1, r2, l2, r3, l3, KC.CPC{Laws.PcM(lit, p0, p1, p2, p3), Laws.PcK(lit, p0, p1, p2, p3), p0, p1, p2, p3}, _) : KC.CPC<CH.CW, CH.CW>}
      {==}

def Laws.ck_pc(lit, a, va, b, vb):
  Equal.sym(KC.CPC<CH.CW, CH.CW>, KC.CPC{Laws.PcM(lit, a, va, b, vb), Laws.PcK(lit, a, va, b, vb), a, va, b, vb}, KC.CK.pc.ww(~U32, ~(p => x => y => U32.and(x, Bool.to_u32(U32.is_gt(y, p)))), lit, a, va, b, vb), pcu(lit, a, va, b, vb))

# ==== U32.add is associative (the node combine of the U32 tree reductions) ================================
#
# Word.adc over the bits, least significant first. adc3 carries TWO carry-ins per side: the left side adds
# (a + b + x1) + c + y1, the right side a + (b + c + x2) + y2; with x1 + y1 = x2 + y2 (cnt2) the low bits
# agree and the carries out have again equal weights, so the tails are the same claim one bit shorter. The
# 58 cases (6 carry combinations of equal weight x 8 bit triples, 10 combinations refuted) are a mechanical
# case analysis, written out by a script (T5.2).

def cnt2(x: Bool, y: Bool) -> Nat:
  match x y:
    case False{} False{}:
      0n
    case True{} True{}:
      2n
    case _ _:
      1n

def n01(h: {0n == 1n : Nat}) -> Empty:
  PCH.succ_ne_zero(0n, Equal.sym(Nat, 0n, 1n, h))

def n02(h: {0n == 2n : Nat}) -> Empty:
  PCH.succ_ne_zero(1n, Equal.sym(Nat, 0n, 2n, h))

def n10(h: {1n == 0n : Nat}) -> Empty:
  PCH.succ_ne_zero(0n, h)

def n20(h: {2n == 0n : Nat}) -> Empty:
  PCH.succ_ne_zero(1n, h)

def n12(h: {1n == 2n : Nat}) -> Empty:
  PCH.succ_ne_zero(0n, Equal.cong(Nat, Nat, x => PCH.npred(x), 2n, 1n, Equal.sym(Nat, 1n, 2n, h)))

def n21(h: {2n == 1n : Nat}) -> Empty:
  PCH.succ_ne_zero(0n, Equal.cong(Nat, Nat, x => PCH.npred(x), 2n, 1n, h))

def adc3(n: Nat, x1: Bool, y1: Bool, x2: Bool, y2: Bool, a: Word(n), b: Word(n), c: Word(n), h: {cnt2(x1, y1) == cnt2(x2, y2) : Nat}) -> {Word.adc(n, Word.adc(n, a, b, False{}, x1), c, False{}, y1) == Word.adc(n, a, Word.adc(n, b, c, False{}, x2), False{}, y2) : Word(n)}:
  match n:
    case 0n:
      match a b c:
        case WNil{} WNil{} WNil{}:
          {==}
    case 1n+p:
      match x1 y1 x2 y2 a b c:
        case False{} False{} False{} False{} WCon{False{}, at} WCon{False{}, bt} WCon{False{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, False{}), ct, False{}, False{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, False{}), False{}, False{}), adc3(p, False{}, False{}, False{}, False{}, at, bt, ct, {==}))
        case False{} False{} False{} False{} WCon{False{}, at} WCon{False{}, bt} WCon{True{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{True{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, False{}), ct, False{}, False{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, False{}), False{}, False{}), adc3(p, False{}, False{}, False{}, False{}, at, bt, ct, {==}))
        case False{} False{} False{} False{} WCon{False{}, at} WCon{True{}, bt} WCon{False{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{True{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, False{}), ct, False{}, False{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, False{}), False{}, False{}), adc3(p, False{}, False{}, False{}, False{}, at, bt, ct, {==}))
        case False{} False{} False{} False{} WCon{False{}, at} WCon{True{}, bt} WCon{True{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, False{}), ct, False{}, True{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, True{}), False{}, False{}), adc3(p, False{}, True{}, True{}, False{}, at, bt, ct, {==}))
        case False{} False{} False{} False{} WCon{True{}, at} WCon{False{}, bt} WCon{False{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{True{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, False{}), ct, False{}, False{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, False{}), False{}, False{}), adc3(p, False{}, False{}, False{}, False{}, at, bt, ct, {==}))
        case False{} False{} False{} False{} WCon{True{}, at} WCon{False{}, bt} WCon{True{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, False{}), ct, False{}, True{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, False{}), False{}, True{}), adc3(p, False{}, True{}, False{}, True{}, at, bt, ct, {==}))
        case False{} False{} False{} False{} WCon{True{}, at} WCon{True{}, bt} WCon{False{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, True{}), ct, False{}, False{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, False{}), False{}, True{}), adc3(p, True{}, False{}, False{}, True{}, at, bt, ct, {==}))
        case False{} False{} False{} False{} WCon{True{}, at} WCon{True{}, bt} WCon{True{}, ct}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{True{}, w}, Word.adc(p, Word.adc(p, at, bt, False{}, True{}), ct, False{}, False{}), Word.adc(p, at, Word.adc(p, bt, ct, False{}, True{}), False{}, False{}), adc3(p, True{}, False{}, True{}, False{}, at, bt, ct, {==}))
        case False{} False{} False{} True{} a b c:
          Empty.absurd({Word.adc(1n+p, Word.adc(1n+p, a, b, False{}, False{}), c, False{}, False{}) == Word.adc(1n+p, a, Word.adc(1n+p, b, c, False{}, False{}), False{}, True{}) : Word(1n+p)}, n01(h))
