# tests/diff/lib/dx.bend -- shared helpers of the generated differential cases (bench/diff).
# GENERATED by `python bench/diff/gen.py --lib`: the static part below, one `e_<verb>` wrapper
# per facade verb (an Fail passes through, like tests/regress/lib/rx.bend) and shims for the
# few expression builders frame.bend does not export yet. Do not edit by hand.
# Not a test itself: its main prints nothing.
import Base
import ./../../../frame.bend as DF
import ./../../../src/dtype.bend as D
import ./../../../src/err.bend as E
import ./../../../src/column.bend as C
import ./../../../src/schema.bend as S
import ./../../../src/expr.bend as X
import ./../../../src/sort.bend as O
import ./../../../src/plan.bend as P

# ---- dtypes ---------------------------------------------------------------------------

def t_bool() -> D.DType:
  D.TBool{}

def t_u32() -> D.DType:
  D.TU32{}

def t_i32() -> D.DType:
  D.TI32{}

def t_f32() -> D.DType:
  D.TF32{}

def t_str() -> D.DType:
  D.TStr{}

# ---- frames ---------------------------------------------------------------------------

def mk.k(name: String, r: E.ResT(C.Column)) -> C.Named:
  match r:
    case Fail{e}:
      C.Named{E.Err.show(e), C.CU32{0, 0n, C.AllValid{}, [0 : U32*1n]}}
    case Done{c}:
      C.Named{name, c}

def mk(name: String, xs: List<&2, D.Scalar>, +t: D.DType) -> C.Named:
  mk.k(name, C.Column.from_scalars(xs, t))

def cbool(name: String, xs: List<&2, D.Scalar>) -> C.Named:
  mk(name, xs, D.TBool{})

def cu32(name: String, xs: List<&2, D.Scalar>) -> C.Named:
  mk(name, xs, D.TU32{})

def ci32(name: String, xs: List<&2, D.Scalar>) -> C.Named:
  mk(name, xs, D.TI32{})

def cf32(name: String, xs: List<&2, D.Scalar>) -> C.Named:
  mk(name, xs, D.TF32{})

def cstr(name: String, xs: List<&2, D.Scalar>) -> C.Named:
  mk(name, xs, D.TStr{})

# a str column in the Dictionary storage (M4; `run.py --dict` emits it for every str column)
def mkd.k(nc: C.Named) -> C.Named:
  match nc:
    case C.Named{n, c}:
      C.Named{n, C.Column.encode(c)}

def cstrd(name: String, xs: List<&2, D.Scalar>) -> C.Named:
  mkd.k(mk(name, xs, D.TStr{}))

def frame(cols: List<&1, C.Named>) -> E.ResT(C.Frame):
  DF.from_columns(cols)

# ---- scalars --------------------------------------------------------------------------

def n() -> D.Scalar:
  D.SNull{}

def b(x: Bool) -> D.Scalar:
  D.SBool{x}

def u(x: U32) -> D.Scalar:
  D.SU32{x}

def i(x: U32) -> D.Scalar:
  D.SI32{D.I32{x}}

def ineg(x: U32) -> D.Scalar:
  D.SI32{D.I32.neg(D.I32{x})}

def f(x: F32) -> D.Scalar:
  D.SF32{x}

def s(x: String) -> D.Scalar:
  D.SStr{x}

def ch(c: U32) -> String:
  SCon{Chr{c}, SNil{}}

def nan() -> F32:
  F32.div(0.0, 0.0)

def inf() -> F32:
  F32.div(1.0, 0.0)

def ninf() -> F32:
  F32.neg(F32.div(1.0, 0.0))

def nzero() -> F32:
  F32.neg(0.0)

# ---- lazy sources ---------------------------------------------------------------------

def env.k(r: P.Env & P.Plan) -> P.Env:
  (env, p) = r
  env

def plan.k(r: P.Env & P.Plan) -> P.Plan:
  (env, p) = r
  p

def env1(+name: String, r: E.ResT(C.Frame)) -> P.Env:
  match r:
    case Fail{e}:
      DF.empty_env()
    case Done{fr}:
      env.k(DF.source(name, fr))

def env_add(env: P.Env, +name: String, r: E.ResT(C.Frame)) -> P.Env:
  match r:
    case Fail{e}:
      env
    case Done{fr}:
      env.k(P.Env.add(env, name, fr))

def env2(+n1: String, r1: E.ResT(C.Frame), +n2: String, r2: E.ResT(C.Frame)) -> P.Env:
  env_add(env1(n1, r1), n2, r2)

# the Source plan of a frame (its schema); the frame itself is dropped
def src(+name: String, r: E.ResT(C.Frame)) -> P.Plan:
  match r:
    case Fail{e}:
      P.Source{name, Nil{}}
    case Done{fr}:
      plan.k(DF.source(name, fr))

# ---- printing -------------------------------------------------------------------------

def show(+tag: String, how: String, r: E.ResT(C.Frame)) -> String:
  "-- " ++ tag ++ " " ++ how ++ "\n" ++ DF.dump(r)

# eager, raw-lazy (DF.collect_raw), default-optimised (DF.collect) and fully optimised
# (DF.collect_full) dumps of one case; each lazy run gets its own env (collect consumes it)
def four(+tag: String, eager: E.ResT(C.Frame), +p: P.Plan, e1: P.Env, e2: P.Env, e3: P.Env) -> IO(Unit):
  do IO<Unit>:
    r1 : E.ResT(C.Frame) <- DF.collect_raw(p, e1)
    r2 : E.ResT(C.Frame) <- DF.collect(p, e2)
    r3 : E.ResT(C.Frame) <- DF.collect_full(p, e3)
    IO.print(show(tag, "eager", eager))
    IO.print(show(tag, "raw", r1))
    IO.print(show(tag, "opt", r2))
    IO.print(show(tag, "full", r3))

# ---- shims (facade defs missing from frame.bend) ----

def abs(e: X.Expr) -> X.Expr:
  X.Un{X.Abs{}, e}

def sqrt(e: X.Expr) -> X.Expr:
  X.Un{X.Sqrt{}, e}

# ---- eager verb wrappers ----

def e_select(r: E.ResT(C.Frame), es: List<&2, X.Expr>) -> E.ResT(C.Frame):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{fr}:
      DF.select(fr, es)

def e_with_columns(r: E.ResT(C.Frame), es: List<&2, X.Expr>) -> E.ResT(C.Frame):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{fr}:
      DF.with_columns(fr, es)

