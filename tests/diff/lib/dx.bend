def e_left_join(l: E.ResT(C.Frame), r: E.ResT(C.Frame), lo: List<&2, String>, ro: List<&2, String>) -> E.ResT(C.Frame):
  match l:
    case Fail{e}:
      Fail{e}
    case Done{fl}:
      e_left_join.k(fl, r, lo, ro)

def main() -> IO(Unit):
  IO.pure(Unit, Unit{})
