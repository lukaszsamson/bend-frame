def e_head(r: E.ResT(C.Frame), n: U32) -> E.ResT(C.Frame):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{fr}:
      DF.head(fr, n)

def e_inner_join.k(l: C.Frame, r: E.ResT(C.Frame), lo: List<&2, String>, ro: List<&2, String>) -> E.ResT(C.Frame):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{fr}:
      DF.inner_join(l, fr, lo, ro)

def e_inner_join(l: E.ResT(C.Frame), r: E.ResT(C.Frame), lo: List<&2, String>, ro: List<&2, String>) -> E.ResT(C.Frame):
  match l:
    case Fail{e}:
      Fail{e}
    case Done{fl}:
      e_inner_join.k(fl, r, lo, ro)

def e_left_join.k(l: C.Frame, r: E.ResT(C.Frame), lo: List<&2, String>, ro: List<&2, String>) -> E.ResT(C.Frame):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{fr}:
