def ncount_mask_s(+len: U32, +d: Nat, -m: Array<U32>, x: Array<String>, w: PC.FGoal(U32.to_nat(len), 0, 0, m, Array.get(U32, m, 0))) -> NullCountW(C.CStr{len, d, C.Mask{m}, x}):
  (a2, +res, eq, ea, spec) = w
  %Equal.sym(Array<U32> & U32, K.Kernel.fold.go(~U32, ~U32, ~(acc => x => U32.add(acc, x)), U32.to_nat(len), 0, 0, Array.get(U32, m, 0)), (a2, res), eq) : &c2: C.Column -> &k: U32 -> {C.Column.null_count.c(len, C.CStr{len, d, C.AllValid{}, x}, C.Valid.count.k(len, _)) == (c2, k) : C.Column & U32} & {c2 == C.CStr{len, d, C.Mask{m}, x} : C.Column}
  %ea : &c2: C.Column -> &k: U32 -> {C.Column.null_count.c(len, C.CStr{len, d, C.AllValid{}, x}, C.Valid.count.k(len, (a2, res))) == (c2, k) : C.Column & U32} & {c2 == C.CStr{len, d, C.Mask{_}, x} : C.Column}
  (C.CStr{len, d, C.Mask{a2}, x}, U32.sub(len, res), {==}, {==})

def ncount_s(+len: U32, +d: Nat, v: C.Valid, x: Array<String>) -> NullCountW(C.CStr{len, d, v, x}):
  match v:
    case C.AllValid{}:
      (C.CStr{len, d, C.AllValid{}, x}, U32.sub(len, len), {==}, {==})
    case C.Mask{m}:
      ncount_mask_s(len, d, m, x, PC.fold_go(U32.to_nat(len), 0, 0, m))

def null_count_w(c: C.Column) -> NullCountW(c):
  match c:
    case C.CBool{len, d, v, x}:
      ncount_b(len, d, v, x)
    case C.CU32{len, d, v, x}:
      ncount_u(len, d, v, x)
    case C.CI32{len, d, v, x}:
      ncount_i(len, d, v, x)
    case C.CF32{len, d, v, x}:
      ncount_f(len, d, v, x)
    case C.CStr{len, d, v, x}:
      ncount_s(len, d, v, x)

# Column.out.w / out.f / out.s: the result column (dtype mkd(t) / F32 / Str, n rows) and the index array
def OutW(+t: D.DType, +n: U32, -r0: C.Column & Array<U32>) -> Type:
  &c2: C.Column -> &ix: Array<U32> -> {r0 == (c2, ix) : C.Column & Array<U32>} & {Laws.cdtype(c2) == t : D.DType} & {Laws.clen(c2) == n : U32}

def outw_w(t: D.DType, +n: U32, +d: Nat, r: Array<U32> & Array<U32>) -> OutW(Laws.mkd(t), n, C.Column.out.w(t, n, d, r)):
  match t:
    case D.TBool{}:
      (o, ix) = r
      (C.CBool{n, d, C.AllValid{}, o}, ix, {==}, {==}, {==})
    case D.TI32{}:
      (o, ix) = r
      (C.CI32{n, d, C.AllValid{}, o}, ix, {==}, {==}, {==})
    case D.TU32{}:
      (o, ix) = r
      (C.CU32{n, d, C.AllValid{}, o}, ix, {==}, {==}, {==})
    case D.TF32{}:
      (o, ix) = r
      (C.CU32{n, d, C.AllValid{}, o}, ix, {==}, {==}, {==})
    case D.TStr{}:
      (o, ix) = r
      (C.CU32{n, d, C.AllValid{}, o}, ix, {==}, {==}, {==})

def outf_w(+n: U32, +d: Nat, r: Array<F32> & Array<U32>) -> OutW(D.TF32{}, n, C.Column.out.f(n, d, r)):
  (o, ix) = r
  (C.CF32{n, d, C.AllValid{}, o}, ix, {==}, {==}, {==})

def outs_w(+n: U32, +d: Nat, r: Array<String> & Array<U32>) -> OutW(D.TStr{}, n, C.Column.out.s(n, d, r)):
  (o, ix) = r
  (C.CStr{n, d, C.AllValid{}, o}, ix, {==}, {==}, {==})

# Eval.dropnull: the valid rows, a column of the same dtype
def DropW(-c: C.Column) -> Type:
  &c2: C.Column -> {V.Eval.dropnull(c) == c2 : C.Column} & {Laws.cdtype(c2) == Laws.cdtype(c) : D.DType}

def drop_fin2(+t: D.DType, -c2: C.Column, ed: {Laws.cdtype(c2) == t : D.DType}, w: SetValidW(c2, C.AllValid{})) -> &c3: C.Column -> {C.Column.set_valid(c2, C.AllValid{}) == c3 : C.Column} & {Laws.cdtype(c3) == t : D.DType}:
  (c3, e, e2, e3) = w
  (c3, e, Equal.trans(D.DType, Laws.cdtype(c3), Laws.cdtype(c2), t, e2, ed))

# the compacted data column through gather.d (set_valid AllValid) and slice.c
def drop_fin(+t: D.DType, +n: U32, -r0: C.Column & Array<U32>, w: OutW(t, n, r0)) -> &c3: C.Column -> {C.Column.slice.c(C.Column.gather.d(C.AllValid{}, r0)) == c3 : C.Column} & {Laws.cdtype(c3) == t : D.DType}:
  (c2, ix, e, ed, el) = w
  %Equal.sym(C.Column & Array<U32>, r0, (c2, ix), e) : &c3: C.Column -> {C.Column.slice.c(C.Column.gather.d(C.AllValid{}, _)) == c3 : C.Column} & {Laws.cdtype(c3) == t : D.DType}
  drop_fin2(t, c2, ed, set_valid_w(c2, C.AllValid{}))

def drop_mask_b(+len: U32, +d: Nat, -m: Array<U32>, x: Array<U32>, w: PC.FGoal(U32.to_nat(len), 0, 0, m, Array.get(U32, m, 0))) -> DropW(C.CBool{len, d, C.Mask{m}, x}):
  (a2, +res, eq, ea, spec) = w
  %Equal.sym(Array<U32> & U32, K.Kernel.fold.go(~U32, ~U32, ~(acc => x => U32.add(acc, x)), U32.to_nat(len), 0, 0, Array.get(U32, m, 0)), (a2, res), eq) : &c2: C.Column -> {V.Eval.dropnull.c(C.CBool{len, d, C.AllValid{}, x}, _) == c2 : C.Column} & {Laws.cdtype(c2) == D.TBool{} : D.DType}
  drop_fin(D.TBool{}, res, C.Column.compact.data(C.CBool{len, d, C.AllValid{}, x}, a2, res, K.Kernel.depth_for(U32.add(res, 1))), outw_w(D.TBool{}, res, K.Kernel.depth_for(U32.add(res, 1)), K.Kernel.compact_keep(~U32, len, K.Kernel.depth_for(U32.add(res, 1)), x, a2, 0)))

def drop_b(+len: U32, +d: Nat, v: C.Valid, x: Array<U32>) -> DropW(C.CBool{len, d, v, x}):
  match v:
    case C.AllValid{}:
      (C.CBool{len, d, C.AllValid{}, x}, {==}, {==})
    case C.Mask{m}:
      drop_mask_b(len, d, m, x, PC.fold_go(U32.to_nat(len), 0, 0, m))

def drop_mask_u(+len: U32, +d: Nat, -m: Array<U32>, x: Array<U32>, w: PC.FGoal(U32.to_nat(len), 0, 0, m, Array.get(U32, m, 0))) -> DropW(C.CU32{len, d, C.Mask{m}, x}):
  (a2, +res, eq, ea, spec) = w
  %Equal.sym(Array<U32> & U32, K.Kernel.fold.go(~U32, ~U32, ~(acc => x => U32.add(acc, x)), U32.to_nat(len), 0, 0, Array.get(U32, m, 0)), (a2, res), eq) : &c2: C.Column -> {V.Eval.dropnull.c(C.CU32{len, d, C.AllValid{}, x}, _) == c2 : C.Column} & {Laws.cdtype(c2) == D.TU32{} : D.DType}
  drop_fin(D.TU32{}, res, C.Column.compact.data(C.CU32{len, d, C.AllValid{}, x}, a2, res, K.Kernel.depth_for(U32.add(res, 1))), outw_w(D.TU32{}, res, K.Kernel.depth_for(U32.add(res, 1)), K.Kernel.compact_keep(~U32, len, K.Kernel.depth_for(U32.add(res, 1)), x, a2, 0)))

def drop_u(+len: U32, +d: Nat, v: C.Valid, x: Array<U32>) -> DropW(C.CU32{len, d, v, x}):
  match v:
    case C.AllValid{}:
      (C.CU32{len, d, C.AllValid{}, x}, {==}, {==})
    case C.Mask{m}:
