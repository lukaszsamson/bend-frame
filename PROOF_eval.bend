def cellm_i(+len: U32, +d: Nat, -m: Array<U32>, x: Array<U32>, +i: U32, w: &m2: Array<U32> -> &y: U32 -> {m2 == m : Array<U32>} & {Array.get(U32, m, i) == (m, y) : Array<U32> & U32} & {y == Laws.rd_at(U32, m, i) : U32}) -> Laws.CellW(C.CI32{len, d, C.Mask{m}, x}, i):
  (m2, +y, e1, e2, e3) = w
  %Equal.sym(Array<U32> & U32, Array.get(U32, m, i), (m, y), e2) : &sc: D.Scalar -> {C.Column.cell.b(i, C.CI32{len, d, C.AllValid{}, x}, C.Valid.get.k(_)) == (C.CI32{len, d, C.Mask{m}, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TI32{}) == D.TI32{} : D.DType}
