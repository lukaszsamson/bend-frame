  %ea : &c2: C.Column -> &k: U32 -> {C.Column.null_count.c(len, C.CU32{len, d, C.AllValid{}, x}, C.Valid.count.k(len, (a2, res))) == (c2, k) : C.Column & U32} & {c2 == C.CU32{len, d, C.Mask{_}, x} : C.Column}
  (C.CU32{len, d, C.Mask{a2}, x}, U32.sub(len, res), {==}, {==})

