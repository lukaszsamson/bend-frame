      dcell_s(len, d, C.Mask{m}, x, i, PC.get_w(String, x, i))
    case False{}:
      (D.SNull{}, {==}, {==})

def cellm_s(+len: U32, +d: Nat, -m: Array<U32>, x: Array<String>, +i: U32, w: &m2: Array<U32> -> &y: U32 -> {m2 == m : Array<U32>} & {Array.get(U32, m, i) == (m, y) : Array<U32> & U32} & {y == Laws.rd_at(U32, m, i) : U32}) -> Laws.CellW(C.CStr{len, d, C.Mask{m}, x}, i):
  (m2, +y, e1, e2, e3) = w
  %Equal.sym(Array<U32> & U32, Array.get(U32, m, i), (m, y), e2) : &sc: D.Scalar -> {C.Column.cell.b(i, C.CStr{len, d, C.AllValid{}, x}, C.Valid.get.k(_)) == (C.CStr{len, d, C.Mask{m}, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TStr{}) == D.TStr{} : D.DType}
  cellc_s(U32.is_ne(y, 0), len, d, m, x, i)

def cellw_s(+len: U32, +d: Nat, v: C.Valid, x: Array<String>, +i: U32) -> Laws.CellW(C.CStr{len, d, v, x}, i):
  match v:
    case C.AllValid{}:
      dcell_s(len, d, C.AllValid{}, x, i, PC.get_w(String, x, i))
    case C.Mask{m}:
      cellm_s(len, d, m, x, i, PC.get_w(U32, m, i))

def Laws.cell_w(c, i):
  match c:
    case C.CBool{len, d, v, x}:
      cellw_b(len, d, v, x, i)
    case C.CU32{len, d, v, x}:
      cellw_u(len, d, v, x, i)
    case C.CI32{len, d, v, x}:
      cellw_i(len, d, v, x, i)
    case C.CF32{len, d, v, x}:
      cellw_f(len, d, v, x, i)
    case C.CStr{len, d, v, x}:
      cellw_s(len, d, v, x, i)

# ---- Array.clone / Valid.clone / Column.clone give two copies equal to the original -----------------

def aclone_node(-T: Data, -xs: Array<T>, -ys: Array<T>,
  wx: &x1: Array<T> -> &x2: Array<T> -> {Array.clone(T, xs) == (x1, x2) : Array<T> & Array<T>} & {x1 == xs : Array<T>} & {x2 == xs : Array<T>},
  wy: &y1: Array<T> -> &y2: Array<T> -> {Array.clone(T, ys) == (y1, y2) : Array<T> & Array<T>} & {y1 == ys : Array<T>} & {y2 == ys : Array<T>})
  -> &a1: Array<T> -> &a2: Array<T> -> {Array.clone(T, ANode{xs, ys}) == (a1, a2) : Array<T> & Array<T>} & {a1 == ANode{xs, ys} : Array<T>} & {a2 == ANode{xs, ys} : Array<T>}:
  (x1, x2, ex, ex1, ex2) = wx
  (y1, y2, ey, ey1, ey2) = wy
  %Equal.sym(Array<T> & Array<T>, Array.clone(T, xs), (x1, x2), ex) : &a1: Array<T> -> &a2: Array<T> -> {Array.clone.node(T, _, Array.clone(T, ys)) == (a1, a2) : Array<T> & Array<T>} & {a1 == ANode{xs, ys} : Array<T>} & {a2 == ANode{xs, ys} : Array<T>}
  %Equal.sym(Array<T> & Array<T>, Array.clone(T, ys), (y1, y2), ey) : &a1: Array<T> -> &a2: Array<T> -> {Array.clone.node(T, (x1, x2), _) == (a1, a2) : Array<T> & Array<T>} & {a1 == ANode{xs, ys} : Array<T>} & {a2 == ANode{xs, ys} : Array<T>}
  %ex1 : &a1: Array<T> -> &a2: Array<T> -> {Array.clone.node(T, (x1, x2), (y1, y2)) == (a1, a2) : Array<T> & Array<T>} & {a1 == ANode{_, ys} : Array<T>} & {a2 == ANode{xs, ys} : Array<T>}
  %ex2 : &a1: Array<T> -> &a2: Array<T> -> {Array.clone.node(T, (x1, x2), (y1, y2)) == (a1, a2) : Array<T> & Array<T>} & {a1 == ANode{x1, ys} : Array<T>} & {a2 == ANode{_, ys} : Array<T>}
  %ey1 : &a1: Array<T> -> &a2: Array<T> -> {Array.clone.node(T, (x1, x2), (y1, y2)) == (a1, a2) : Array<T> & Array<T>} & {a1 == ANode{x1, _} : Array<T>} & {a2 == ANode{x2, ys} : Array<T>}
  %ey2 : &a1: Array<T> -> &a2: Array<T> -> {Array.clone.node(T, (x1, x2), (y1, y2)) == (a1, a2) : Array<T> & Array<T>} & {a1 == ANode{x1, y1} : Array<T>} & {a2 == ANode{x2, _} : Array<T>}
  (ANode{x1, y1}, ANode{x2, y2}, {==}, {==}, {==})

def aclone_w(-T: Data, a: Array<T>) -> &a1: Array<T> -> &a2: Array<T> -> {Array.clone(T, a) == (a1, a2) : Array<T> & Array<T>} & {a1 == a : Array<T>} & {a2 == a : Array<T>}:
  match a:
    case ALeaf{+x}:
      (ALeaf{x}, ALeaf{x}, {==}, {==}, {==})
    case ANode{xs, ys}:
      aclone_node(T, xs, ys, aclone_w(T, xs), aclone_w(T, ys))

def vclone_mask(-m: Array<U32>, w: &m1: Array<U32> -> &m2: Array<U32> -> {Array.clone(U32, m) == (m1, m2) : Array<U32> & Array<U32>} & {m1 == m : Array<U32>} & {m2 == m : Array<U32>})
  -> &v1: C.Valid -> &v2: C.Valid -> {C.Valid.clone(C.Mask{m}) == (v1, v2) : C.Valid & C.Valid} & {v1 == C.Mask{m} : C.Valid} & {v2 == C.Mask{m} : C.Valid}:
  (m1, m2, e, e1, e2) = w
  %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, m), (m1, m2), e) : &v1: C.Valid -> &v2: C.Valid -> {C.Valid.clone.k(_) == (v1, v2) : C.Valid & C.Valid} & {v1 == C.Mask{m} : C.Valid} & {v2 == C.Mask{m} : C.Valid}
  %e1 : &v1: C.Valid -> &v2: C.Valid -> {C.Valid.clone.k((m1, m2)) == (v1, v2) : C.Valid & C.Valid} & {v1 == C.Mask{_} : C.Valid} & {v2 == C.Mask{m} : C.Valid}
  %e2 : &v1: C.Valid -> &v2: C.Valid -> {C.Valid.clone.k((m1, m2)) == (v1, v2) : C.Valid & C.Valid} & {v1 == C.Mask{m1} : C.Valid} & {v2 == C.Mask{_} : C.Valid}
  (C.Mask{m1}, C.Mask{m2}, {==}, {==}, {==})

def vclone_w(v: C.Valid) -> &v1: C.Valid -> &v2: C.Valid -> {C.Valid.clone(v) == (v1, v2) : C.Valid & C.Valid} & {v1 == v : C.Valid} & {v2 == v : C.Valid}:
  match v:
    case C.AllValid{}:
      (C.AllValid{}, C.AllValid{}, {==}, {==}, {==})
    case C.Mask{m}:
      vclone_mask(m, aclone_w(U32, m))

# the production Column.clone(c) as two live columns equal to c
def CloneW(-c: C.Column) -> Type:
  &c1: C.Column -> &c2: C.Column -> {C.Column.clone(c) == (c1, c2) : C.Column & C.Column} & {c1 == c : C.Column} & {c2 == c : C.Column}

def clone_b(+len: U32, +d: Nat, -v: C.Valid, -x: Array<U32>,
  wv: &v1: C.Valid -> &v2: C.Valid -> {C.Valid.clone(v) == (v1, v2) : C.Valid & C.Valid} & {v1 == v : C.Valid} & {v2 == v : C.Valid},
  wx: &x1: Array<U32> -> &x2: Array<U32> -> {Array.clone(U32, x) == (x1, x2) : Array<U32> & Array<U32>} & {x1 == x : Array<U32>} & {x2 == x : Array<U32>}) -> CloneW(C.CBool{len, d, v, x}):
  (v1, v2, ev, ev1, ev2) = wv
  (x1, x2, ex, ex1, ex2) = wx
  %Equal.sym(C.Valid & C.Valid, C.Valid.clone(v), (v1, v2), ev) : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TBool{}, len, d, _, Array.clone(U32, x)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CBool{len, d, v, x} : C.Column} & {c2 == C.CBool{len, d, v, x} : C.Column}
  %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, x), (x1, x2), ex) : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TBool{}, len, d, (v1, v2), _) == (c1, c2) : C.Column & C.Column} & {c1 == C.CBool{len, d, v, x} : C.Column} & {c2 == C.CBool{len, d, v, x} : C.Column}
  %ev1 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TBool{}, len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CBool{len, d, _, x} : C.Column} & {c2 == C.CBool{len, d, v, x} : C.Column}
  %ev2 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TBool{}, len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CBool{len, d, v1, x} : C.Column} & {c2 == C.CBool{len, d, _, x} : C.Column}
  %ex1 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TBool{}, len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CBool{len, d, v1, _} : C.Column} & {c2 == C.CBool{len, d, v2, x} : C.Column}
  %ex2 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TBool{}, len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CBool{len, d, v1, x1} : C.Column} & {c2 == C.CBool{len, d, v2, _} : C.Column}
  (C.CBool{len, d, v1, x1}, C.CBool{len, d, v2, x2}, {==}, {==}, {==})

def clone_u(+len: U32, +d: Nat, -v: C.Valid, -x: Array<U32>,
  wv: &v1: C.Valid -> &v2: C.Valid -> {C.Valid.clone(v) == (v1, v2) : C.Valid & C.Valid} & {v1 == v : C.Valid} & {v2 == v : C.Valid},
  wx: &x1: Array<U32> -> &x2: Array<U32> -> {Array.clone(U32, x) == (x1, x2) : Array<U32> & Array<U32>} & {x1 == x : Array<U32>} & {x2 == x : Array<U32>}) -> CloneW(C.CU32{len, d, v, x}):
  (v1, v2, ev, ev1, ev2) = wv
  (x1, x2, ex, ex1, ex2) = wx
  %Equal.sym(C.Valid & C.Valid, C.Valid.clone(v), (v1, v2), ev) : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TU32{}, len, d, _, Array.clone(U32, x)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CU32{len, d, v, x} : C.Column} & {c2 == C.CU32{len, d, v, x} : C.Column}
  %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, x), (x1, x2), ex) : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TU32{}, len, d, (v1, v2), _) == (c1, c2) : C.Column & C.Column} & {c1 == C.CU32{len, d, v, x} : C.Column} & {c2 == C.CU32{len, d, v, x} : C.Column}
  %ev1 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TU32{}, len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CU32{len, d, _, x} : C.Column} & {c2 == C.CU32{len, d, v, x} : C.Column}
  %ev2 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TU32{}, len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CU32{len, d, v1, x} : C.Column} & {c2 == C.CU32{len, d, _, x} : C.Column}
  %ex1 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TU32{}, len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CU32{len, d, v1, _} : C.Column} & {c2 == C.CU32{len, d, v2, x} : C.Column}
  %ex2 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TU32{}, len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CU32{len, d, v1, x1} : C.Column} & {c2 == C.CU32{len, d, v2, _} : C.Column}
  (C.CU32{len, d, v1, x1}, C.CU32{len, d, v2, x2}, {==}, {==}, {==})

def clone_i(+len: U32, +d: Nat, -v: C.Valid, -x: Array<U32>,
  wv: &v1: C.Valid -> &v2: C.Valid -> {C.Valid.clone(v) == (v1, v2) : C.Valid & C.Valid} & {v1 == v : C.Valid} & {v2 == v : C.Valid},
  wx: &x1: Array<U32> -> &x2: Array<U32> -> {Array.clone(U32, x) == (x1, x2) : Array<U32> & Array<U32>} & {x1 == x : Array<U32>} & {x2 == x : Array<U32>}) -> CloneW(C.CI32{len, d, v, x}):
  (v1, v2, ev, ev1, ev2) = wv
  (x1, x2, ex, ex1, ex2) = wx
  %Equal.sym(C.Valid & C.Valid, C.Valid.clone(v), (v1, v2), ev) : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TI32{}, len, d, _, Array.clone(U32, x)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CI32{len, d, v, x} : C.Column} & {c2 == C.CI32{len, d, v, x} : C.Column}
  %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, x), (x1, x2), ex) : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TI32{}, len, d, (v1, v2), _) == (c1, c2) : C.Column & C.Column} & {c1 == C.CI32{len, d, v, x} : C.Column} & {c2 == C.CI32{len, d, v, x} : C.Column}
  %ev1 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TI32{}, len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CI32{len, d, _, x} : C.Column} & {c2 == C.CI32{len, d, v, x} : C.Column}
  %ev2 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TI32{}, len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CI32{len, d, v1, x} : C.Column} & {c2 == C.CI32{len, d, _, x} : C.Column}
  %ex1 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TI32{}, len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CI32{len, d, v1, _} : C.Column} & {c2 == C.CI32{len, d, v2, x} : C.Column}
  %ex2 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.w(D.TI32{}, len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CI32{len, d, v1, x1} : C.Column} & {c2 == C.CI32{len, d, v2, _} : C.Column}
  (C.CI32{len, d, v1, x1}, C.CI32{len, d, v2, x2}, {==}, {==}, {==})

def clone_f(+len: U32, +d: Nat, -v: C.Valid, -x: Array<F32>,
  wv: &v1: C.Valid -> &v2: C.Valid -> {C.Valid.clone(v) == (v1, v2) : C.Valid & C.Valid} & {v1 == v : C.Valid} & {v2 == v : C.Valid},
  wx: &x1: Array<F32> -> &x2: Array<F32> -> {Array.clone(F32, x) == (x1, x2) : Array<F32> & Array<F32>} & {x1 == x : Array<F32>} & {x2 == x : Array<F32>}) -> CloneW(C.CF32{len, d, v, x}):
  (v1, v2, ev, ev1, ev2) = wv
  (x1, x2, ex, ex1, ex2) = wx
  %Equal.sym(C.Valid & C.Valid, C.Valid.clone(v), (v1, v2), ev) : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.f(len, d, _, Array.clone(F32, x)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CF32{len, d, v, x} : C.Column} & {c2 == C.CF32{len, d, v, x} : C.Column}
  %Equal.sym(Array<F32> & Array<F32>, Array.clone(F32, x), (x1, x2), ex) : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.f(len, d, (v1, v2), _) == (c1, c2) : C.Column & C.Column} & {c1 == C.CF32{len, d, v, x} : C.Column} & {c2 == C.CF32{len, d, v, x} : C.Column}
  %ev1 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.f(len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CF32{len, d, _, x} : C.Column} & {c2 == C.CF32{len, d, v, x} : C.Column}
  %ev2 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.f(len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CF32{len, d, v1, x} : C.Column} & {c2 == C.CF32{len, d, _, x} : C.Column}
  %ex1 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.f(len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CF32{len, d, v1, _} : C.Column} & {c2 == C.CF32{len, d, v2, x} : C.Column}
  %ex2 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.f(len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CF32{len, d, v1, x1} : C.Column} & {c2 == C.CF32{len, d, v2, _} : C.Column}
  (C.CF32{len, d, v1, x1}, C.CF32{len, d, v2, x2}, {==}, {==}, {==})

def clone_s(+len: U32, +d: Nat, -v: C.Valid, -x: Array<String>,
  wv: &v1: C.Valid -> &v2: C.Valid -> {C.Valid.clone(v) == (v1, v2) : C.Valid & C.Valid} & {v1 == v : C.Valid} & {v2 == v : C.Valid},
  wx: &x1: Array<String> -> &x2: Array<String> -> {Array.clone(String, x) == (x1, x2) : Array<String> & Array<String>} & {x1 == x : Array<String>} & {x2 == x : Array<String>}) -> CloneW(C.CStr{len, d, v, x}):
  (v1, v2, ev, ev1, ev2) = wv
  (x1, x2, ex, ex1, ex2) = wx
  %Equal.sym(C.Valid & C.Valid, C.Valid.clone(v), (v1, v2), ev) : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.s(len, d, _, Array.clone(String, x)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CStr{len, d, v, x} : C.Column} & {c2 == C.CStr{len, d, v, x} : C.Column}
  %Equal.sym(Array<String> & Array<String>, Array.clone(String, x), (x1, x2), ex) : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.s(len, d, (v1, v2), _) == (c1, c2) : C.Column & C.Column} & {c1 == C.CStr{len, d, v, x} : C.Column} & {c2 == C.CStr{len, d, v, x} : C.Column}
  %ev1 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.s(len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CStr{len, d, _, x} : C.Column} & {c2 == C.CStr{len, d, v, x} : C.Column}
  %ev2 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.s(len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CStr{len, d, v1, x} : C.Column} & {c2 == C.CStr{len, d, _, x} : C.Column}
  %ex1 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.s(len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CStr{len, d, v1, _} : C.Column} & {c2 == C.CStr{len, d, v2, x} : C.Column}
  %ex2 : &c1: C.Column -> &c2: C.Column -> {C.Column.clone.s(len, d, (v1, v2), (x1, x2)) == (c1, c2) : C.Column & C.Column} & {c1 == C.CStr{len, d, v1, x1} : C.Column} & {c2 == C.CStr{len, d, v2, _} : C.Column}
  (C.CStr{len, d, v1, x1}, C.CStr{len, d, v2, x2}, {==}, {==}, {==})

def clone_w(c: C.Column) -> CloneW(c):
  match c:
    case C.CBool{len, d, v, x}:
      clone_b(len, d, v, x, vclone_w(v), aclone_w(U32, x))
    case C.CU32{len, d, v, x}:
      clone_u(len, d, v, x, vclone_w(v), aclone_w(U32, x))
    case C.CI32{len, d, v, x}:
      clone_i(len, d, v, x, vclone_w(v), aclone_w(U32, x))
    case C.CF32{len, d, v, x}:
      clone_f(len, d, v, x, vclone_w(v), aclone_w(F32, x))
    case C.CStr{len, d, v, x}:
      clone_s(len, d, v, x, vclone_w(v), aclone_w(String, x))

# ---- set_valid / null_count / dropnull keep the dtype (witness form) ----------------------------------

def SetValidW(-c: C.Column, -v: C.Valid) -> Type:
  &c2: C.Column -> {C.Column.set_valid(c, v) == c2 : C.Column} & {Laws.cdtype(c2) == Laws.cdtype(c) : D.DType} & {Laws.clen(c2) == Laws.clen(c) : U32}

def set_valid_w(c: C.Column, v: C.Valid) -> SetValidW(c, v):
  match c:
    case C.CBool{len, d, v0, x}:
      (C.CBool{len, d, v, x}, {==}, {==}, {==})
    case C.CU32{len, d, v0, x}:
      (C.CU32{len, d, v, x}, {==}, {==}, {==})
    case C.CI32{len, d, v0, x}:
      (C.CI32{len, d, v, x}, {==}, {==}, {==})
    case C.CF32{len, d, v0, x}:
      (C.CF32{len, d, v, x}, {==}, {==}, {==})
    case C.CStr{len, d, v0, x}:
      (C.CStr{len, d, v, x}, {==}, {==}, {==})

# Column.null_count: the column back (equal to the input) and a count
def NullCountW(-c: C.Column) -> Type:
  &c2: C.Column -> &k: U32 -> {C.Column.null_count(c) == (c2, k) : C.Column & U32} & {c2 == c : C.Column}

def ncount_mask_b(+len: U32, +d: Nat, -m: Array<U32>, x: Array<U32>, w: PC.FGoal(U32.to_nat(len), 0, 0, m, Array.get(U32, m, 0))) -> NullCountW(C.CBool{len, d, C.Mask{m}, x}):
  (a2, +res, eq, ea, spec) = w
  %Equal.sym(Array<U32> & U32, K.Kernel.fold.go(~U32, ~U32, ~(acc => x => U32.add(acc, x)), U32.to_nat(len), 0, 0, Array.get(U32, m, 0)), (a2, res), eq) : &c2: C.Column -> &k: U32 -> {C.Column.null_count.c(len, C.CBool{len, d, C.AllValid{}, x}, C.Valid.count.k(len, _)) == (c2, k) : C.Column & U32} & {c2 == C.CBool{len, d, C.Mask{m}, x} : C.Column}
  %ea : &c2: C.Column -> &k: U32 -> {C.Column.null_count.c(len, C.CBool{len, d, C.AllValid{}, x}, C.Valid.count.k(len, (a2, res))) == (c2, k) : C.Column & U32} & {c2 == C.CBool{len, d, C.Mask{_}, x} : C.Column}
  (C.CBool{len, d, C.Mask{a2}, x}, U32.sub(len, res), {==}, {==})

def ncount_b(+len: U32, +d: Nat, v: C.Valid, x: Array<U32>) -> NullCountW(C.CBool{len, d, v, x}):
  match v:
    case C.AllValid{}:
      (C.CBool{len, d, C.AllValid{}, x}, U32.sub(len, len), {==}, {==})
    case C.Mask{m}:
      ncount_mask_b(len, d, m, x, PC.fold_go(U32.to_nat(len), 0, 0, m))

