def dcell_i(+len: U32, +d: Nat, -v: C.Valid, -x: Array<U32>, +i: U32, w: &x2: Array<U32> -> &y: U32 -> {x2 == x : Array<U32>} & {Array.get(U32, x, i) == (x, y) : Array<U32> & U32} & {y == Laws.rd_at(U32, x, i) : U32}) -> &sc: D.Scalar -> {C.Column.data_cell(C.CI32{len, d, v, x}, i) == (C.CI32{len, d, v, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TI32{}) == D.TI32{} : D.DType}:
