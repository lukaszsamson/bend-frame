def drop_mask_i(+len: U32, +d: Nat, -m: Array<U32>, x: Array<U32>, w: PC.FGoal(U32.to_nat(len), 0, 0, m, Array.get(U32, m, 0))) -> DropW(C.CI32{len, d, C.Mask{m}, x}):
  (a2, +res, eq, ea, spec) = w
  %Equal.sym(Array<U32> & U32, K.Kernel.fold.go(~U32, ~U32, ~(acc => x => U32.add(acc, x)), U32.to_nat(len), 0, 0, Array.get(U32, m, 0)), (a2, res), eq) : &c2: C.Column -> {V.Eval.dropnull.c(C.CI32{len, d, C.AllValid{}, x}, _) == c2 : C.Column} & {Laws.cdtype(c2) == D.TI32{} : D.DType}
  drop_fin(D.TI32{}, res, C.Column.compact.data(C.CI32{len, d, C.AllValid{}, x}, a2, res, K.Kernel.depth_for(U32.add(res, 1))), outw_w(D.TI32{}, res, K.Kernel.depth_for(U32.add(res, 1)), K.Kernel.compact_keep(~U32, len, K.Kernel.depth_for(U32.add(res, 1)), x, a2, 0)))

def drop_i(+len: U32, +d: Nat, v: C.Valid, x: Array<U32>) -> DropW(C.CI32{len, d, v, x}):
  match v:
    case C.AllValid{}:
      (C.CI32{len, d, C.AllValid{}, x}, {==}, {==})
    case C.Mask{m}:
      drop_mask_i(len, d, m, x, PC.fold_go(U32.to_nat(len), 0, 0, m))

def drop_mask_f(+len: U32, +d: Nat, -m: Array<U32>, x: Array<F32>, w: PC.FGoal(U32.to_nat(len), 0, 0, m, Array.get(U32, m, 0))) -> DropW(C.CF32{len, d, C.Mask{m}, x}):
  (a2, +res, eq, ea, spec) = w
  %Equal.sym(Array<U32> & U32, K.Kernel.fold.go(~U32, ~U32, ~(acc => x => U32.add(acc, x)), U32.to_nat(len), 0, 0, Array.get(U32, m, 0)), (a2, res), eq) : &c2: C.Column -> {V.Eval.dropnull.c(C.CF32{len, d, C.AllValid{}, x}, _) == c2 : C.Column} & {Laws.cdtype(c2) == D.TF32{} : D.DType}
  drop_fin(D.TF32{}, res, C.Column.compact.data(C.CF32{len, d, C.AllValid{}, x}, a2, res, K.Kernel.depth_for(U32.add(res, 1))), outf_w(res, K.Kernel.depth_for(U32.add(res, 1)), K.Kernel.compact_keep(~F32, len, K.Kernel.depth_for(U32.add(res, 1)), x, a2, 0.0)))

def drop_f(+len: U32, +d: Nat, v: C.Valid, x: Array<F32>) -> DropW(C.CF32{len, d, v, x}):
  match v:
    case C.AllValid{}:
      (C.CF32{len, d, C.AllValid{}, x}, {==}, {==})
    case C.Mask{m}:
      drop_mask_f(len, d, m, x, PC.fold_go(U32.to_nat(len), 0, 0, m))

def drop_mask_s(+len: U32, +d: Nat, -m: Array<U32>, x: Array<String>, w: PC.FGoal(U32.to_nat(len), 0, 0, m, Array.get(U32, m, 0))) -> DropW(C.CStr{len, d, C.Mask{m}, x}):
  (a2, +res, eq, ea, spec) = w
  %Equal.sym(Array<U32> & U32, K.Kernel.fold.go(~U32, ~U32, ~(acc => x => U32.add(acc, x)), U32.to_nat(len), 0, 0, Array.get(U32, m, 0)), (a2, res), eq) : &c2: C.Column -> {V.Eval.dropnull.c(C.CStr{len, d, C.AllValid{}, x}, _) == c2 : C.Column} & {Laws.cdtype(c2) == D.TStr{} : D.DType}
  drop_fin(D.TStr{}, res, C.Column.compact.data(C.CStr{len, d, C.AllValid{}, x}, a2, res, K.Kernel.depth_for(U32.add(res, 1))), outs_w(res, K.Kernel.depth_for(U32.add(res, 1)), K.Kernel.compact_keep(~String, len, K.Kernel.depth_for(U32.add(res, 1)), x, a2, "")))

def drop_s(+len: U32, +d: Nat, v: C.Valid, x: Array<String>) -> DropW(C.CStr{len, d, v, x}):
  match v:
    case C.AllValid{}:
      (C.CStr{len, d, C.AllValid{}, x}, {==}, {==})
    case C.Mask{m}:
      drop_mask_s(len, d, m, x, PC.fold_go(U32.to_nat(len), 0, 0, m))

def dropnull_w(c: C.Column) -> DropW(c):
  match c:
    case C.CBool{len, d, v, x}:
      drop_b(len, d, v, x)
    case C.CU32{len, d, v, x}:
      drop_u(len, d, v, x)
    case C.CI32{len, d, v, x}:
      drop_i(len, d, v, x)
    case C.CF32{len, d, v, x}:
      drop_f(len, d, v, x)
    case C.CStr{len, d, v, x}:
      drop_s(len, d, v, x)

# ---- the shapes Eval builds: mk_w, fix, const_col, unit, bcast, kleene, when, fill, cast.pw ---------

def mkw_w(t: D.DType, +n: U32, d: Nat, v: C.Valid, x: Array<U32>) -> Laws.ColW(Laws.mkd(t), n, C.Column.mk_w(t, n, d, v, x)):
  match t:
    case D.TBool{}:
      (C.CBool{n, d, v, x}, {==}, ({==}, {==}))
    case D.TI32{}:
      (C.CI32{n, d, v, x}, {==}, ({==}, {==}))
    case D.TU32{}:
      (C.CU32{n, d, v, x}, {==}, ({==}, {==}))
    case D.TF32{}:
      (C.CU32{n, d, v, x}, {==}, ({==}, {==}))
    case D.TStr{}:
      (C.CU32{n, d, v, x}, {==}, ({==}, {==}))

def fixw2_w(t: D.DType, +n: U32, d: Nat, r: Array<U32> & Array<U32>) -> Laws.ColW(Laws.mkd(t), n, V.Eval.fix.w2(t, n, d, r)):
  (x, m) = r
  mkw_w(t, n, d, C.Mask{m}, x)

def fixw_w(t: D.DType, +n: U32, d: Nat, v: C.Valid, x: Array<U32>) -> Laws.ColW(Laws.mkd(t), n, V.Eval.fix.w(t, n, d, v, x)):
  match v:
    case C.AllValid{}:
      mkw_w(t, n, d, C.AllValid{}, x)
    case C.Mask{m}:
      fixw2_w(t, n, d, K.Kernel.mask_data(~U32, n, x, m, 0))

def fixf2_w(+n: U32, d: Nat, r: Array<F32> & Array<U32>) -> Laws.ColW(D.TF32{}, n, V.Eval.fix.f2(n, d, r)):
  (x, m) = r
  (C.CF32{n, d, C.Mask{m}, x}, {==}, ({==}, {==}))

def fixf_w(+n: U32, d: Nat, v: C.Valid, x: Array<F32>) -> Laws.ColW(D.TF32{}, n, V.Eval.fix.f(n, d, v, x)):
  match v:
    case C.AllValid{}:
      (C.CF32{n, d, C.AllValid{}, x}, {==}, ({==}, {==}))
    case C.Mask{m}:
      fixf2_w(n, d, K.Kernel.mask_data(~F32, n, x, m, 0.0))

def fixs2_w(+n: U32, d: Nat, r: Array<String> & Array<U32>) -> Laws.ColW(D.TStr{}, n, V.Eval.fix.s2(n, d, r)):
  (x, m) = r
  (C.CStr{n, d, C.Mask{m}, x}, {==}, ({==}, {==}))

def fixs_w(+n: U32, d: Nat, v: C.Valid, x: Array<String>) -> Laws.ColW(D.TStr{}, n, V.Eval.fix.s(n, d, v, x)):
  match v:
    case C.AllValid{}:
      (C.CStr{n, d, C.AllValid{}, x}, {==}, ({==}, {==}))
    case C.Mask{m}:
      fixs2_w(n, d, K.Kernel.mask_data(~String, n, x, m, ""))

# Eval.fix of Column.mk_w(t, ..) for any t: a word column of dtype mkd(t)
def fix_mkw_w(t: D.DType, +n: U32, +d: Nat, v: C.Valid, x: Array<U32>) -> Laws.ColW(Laws.mkd(t), n, V.Eval.fix(C.Column.mk_w(t, n, d, v, x))):
  match t:
    case D.TBool{}:
      fixw_w(D.TBool{}, n, d, v, x)
    case D.TI32{}:
      fixw_w(D.TI32{}, n, d, v, x)
    case D.TU32{}:
      fixw_w(D.TU32{}, n, d, v, x)
    case D.TF32{}:
      fixw_w(D.TU32{}, n, d, v, x)
    case D.TStr{}:
      fixw_w(D.TU32{}, n, d, v, x)

# a column witness lifted to a Done result
def done_w(+t: D.DType, +n: U32, -c: C.Column, w: Laws.ColW(t, n, c)) -> Laws.ResW(True{}, t, n, Done{c}):
  (c2, e, ty) = w
  (Done{c2}, Equal.cong(C.Column, E.ResT(C.Column), q => Done{q}, c, c2, e), ty)

# a result witness with its dtype rewritten through t2 == t
def resw_dtype(+tot: Bool, +t: D.DType, +t2: D.DType, +n: U32, -r0: E.ResT(C.Column), e: {t2 == t : D.DType}, w: Laws.ResW(tot, t2, n, r0)) -> Laws.ResW(tot, t, n, r0):
  %e : Laws.ResW(tot, _, n, r0)
  w

def kl_fin_w(+n: U32, +d: Nat, r: Array<U32> & Array<U32>) -> Laws.ColW(D.TBool{}, n, V.Eval.kl.fin(n, d, r)):
  (x, ok) = r
  (C.CBool{n, d, V.Eval.cast.allv(n, K.Kernel.popcount(n, ok)), x}, {==}, ({==}, {==}))

def bin_idiv_w(+t: D.DType, +n: U32, +d: Nat, v: C.Valid, r: Array<U32> & Array<U32>) -> Laws.ResW(True{}, Laws.mkd(t), n, V.Eval.bin.idiv(t, n, d, v, r)):
  (x, ok) = r
  done_w(Laws.mkd(t), n, V.Eval.fix(C.Column.mk_w(t, n, d, V.Eval.okv(n, d, v, ok), x)), fix_mkw_w(t, n, d, V.Eval.okv(n, d, v, ok), x))

def cast_pw_w(+t: D.DType, +n: U32, +d: Nat, v: C.Valid, r: Array<U32> & Array<U32>) -> Laws.ResW(True{}, Laws.mkd(t), n, V.Eval.cast.pw(t, n, d, v, r)):
  (x, ok) = r
  done_w(Laws.mkd(t), n, V.Eval.fix(C.Column.mk_w(t, n, d, V.Eval.okv(n, d, v, ok), x)), fix_mkw_w(t, n, d, V.Eval.okv(n, d, v, ok), x))

def cast_pf_w(+n: U32, +d: Nat, v: C.Valid, r: Array<F32> & Array<U32>) -> Laws.ResW(True{}, D.TF32{}, n, V.Eval.cast.pf(n, d, v, r)):
  (x, ok) = r
  done_w(D.TF32{}, n, V.Eval.fix.f(n, d, V.Eval.okv(n, d, v, ok), x), fixf_w(n, d, V.Eval.okv(n, d, v, ok), x))

def fill_w_w(+t: D.DType, +n: U32, d: Nat, r: C.Valid & Array<U32>) -> Laws.ResW(True{}, Laws.mkd(t), n, V.Eval.fill.w(t, n, d, r)):
  (v, x) = r
  done_w(Laws.mkd(t), n, C.Column.mk_w(t, n, d, v, x), mkw_w(t, n, d, v, x))

def fill_f_w(+n: U32, d: Nat, r: C.Valid & Array<F32>) -> Laws.ResW(True{}, D.TF32{}, n, V.Eval.fill.f(n, d, r)):
  (v, x) = r
  (Done{C.CF32{n, d, v, x}}, {==}, ({==}, {==}))

def fill_s_w(+n: U32, d: Nat, r: C.Valid & Array<String>) -> Laws.ResW(True{}, D.TStr{}, n, V.Eval.fill.s(n, d, r)):
  (v, x) = r
  (Done{C.CStr{n, d, v, x}}, {==}, ({==}, {==}))

def when_w_w(+t: D.DType, +n: U32, +d: Nat, va: C.Valid, vb: C.Valid, r: Array<U32> & Array<U32>) -> Laws.ResW(True{}, Laws.mkd(t), n, V.Eval.when.w(t, n, d, va, vb, r)):
  (m, x) = r
  done_w(Laws.mkd(t), n, C.Column.mk_w(t, n, d, V.Eval.when.valid(n, d, va, vb, m), x), mkw_w(t, n, d, V.Eval.when.valid(n, d, va, vb, m), x))

def when_f_w(+n: U32, +d: Nat, va: C.Valid, vb: C.Valid, r: Array<U32> & Array<F32>) -> Laws.ResW(True{}, D.TF32{}, n, V.Eval.when.f(n, d, va, vb, r)):
  (m, x) = r
  (Done{C.CF32{n, d, V.Eval.when.valid(n, d, va, vb, m), x}}, {==}, ({==}, {==}))

def when_s_w(+n: U32, +d: Nat, va: C.Valid, vb: C.Valid, r: Array<U32> & Array<String>) -> Laws.ResW(True{}, D.TStr{}, n, V.Eval.when.s(n, d, va, vb, r)):
  (m, x) = r
  (Done{C.CStr{n, d, V.Eval.when.valid(n, d, va, vb, m), x}}, {==}, ({==}, {==}))

def constnull_w(t: D.DType, +n: U32, +d: Nat) -> Laws.ColW(t, n, V.Eval.const_null(t, n, d)):
  match t:
    case D.TBool{}:
      (C.CBool{n, d, C.Mask{Array.new(U32, d, 0)}, Array.new(U32, d, 0)}, {==}, ({==}, {==}))
    case D.TU32{}:
      (C.CU32{n, d, C.Mask{Array.new(U32, d, 0)}, Array.new(U32, d, 0)}, {==}, ({==}, {==}))
    case D.TI32{}:
      (C.CI32{n, d, C.Mask{Array.new(U32, d, 0)}, Array.new(U32, d, 0)}, {==}, ({==}, {==}))
    case D.TF32{}:
      (C.CF32{n, d, C.Mask{Array.new(U32, d, 0)}, Array.new(F32, d, 0.0)}, {==}, ({==}, {==}))
    case D.TStr{}:
      (C.CStr{n, d, C.Mask{Array.new(U32, d, 0)}, Array.new(String, d, "")}, {==}, ({==}, {==}))

# Eval.const_col.d of a scalar whose dtype (t for null) is t2: dtype t2, n rows
def constcol_w(s: D.Scalar, +t: D.DType, +t2: D.DType, +n: U32, +d: Nat, hs: {Laws.lit_dtype(s, t) == t2 : D.DType}) -> Laws.ColW(t2, n, V.Eval.const_col.d(s, t, n, d)):
  match s:
    case D.SNull{}:
      %hs : Laws.ColW(_, n, V.Eval.const_null(t, n, d))
      constnull_w(t, n, d)
    case D.SBool{b}:
      (C.CBool{n, d, C.AllValid{}, Array.new(U32, d, Bool.to_u32(b))}, {==}, (hs, {==}))
    case D.SU32{v}:
      (C.CU32{n, d, C.AllValid{}, Array.new(U32, d, v)}, {==}, (hs, {==}))
    case D.SI32{v}:
      (C.CI32{n, d, C.AllValid{}, Array.new(U32, d, D.I32.to_u32(v))}, {==}, (hs, {==}))
    case D.SF32{v}:
      (C.CF32{n, d, C.AllValid{}, Array.new(F32, d, v)}, {==}, (hs, {==}))
    case D.SStr{v}:
      (C.CStr{n, d, C.AllValid{}, Array.new(String, d, v)}, {==}, (hs, {==}))

def unit_fin(+t: D.DType, -c0: C.Column, w: Laws.ColW(t, 1, c0)) -> Laws.ColTy(t, 1, c0):
  (c2, e, ty) = w
  %Equal.sym(C.Column, c0, c2, e) : Laws.ColTy(t, 1, _)
  ty

def Laws.unit_typed(v, t):
  unit_fin(Laws.lit_dtype(v, t), V.Eval.const_col.d(v, t, 1, K.Kernel.depth_for(1)), constcol_w(v, t, Laws.lit_dtype(v, t), 1, K.Kernel.depth_for(1), {==}))

# Eval.bcast: row 0 as a scalar (cell_w), then a constant column of n rows
def bcast_fin(+t: D.DType, +n: U32, -c: C.Column, w: Laws.CellW(c, 0), et: {Laws.cdtype(c) == t : D.DType}) -> Laws.ColW(t, n, V.Eval.bcast.b(n, t, C.Column.cell(c, 0))):
  (s, e, ed) = w
  %Equal.sym(C.Column & D.Scalar, C.Column.cell(c, 0), (c, s), e) : Laws.ColW(t, n, V.Eval.bcast.b(n, t, _))
  constcol_w(s, t, t, n, K.Kernel.depth_for(n), (%et : {Laws.lit_dtype(s, _) == _ : D.DType}; ed))

def Laws.bcast_typed(c, n):
  match c:
    case C.CBool{+len, +d, v, x}:
      bcast_fin(D.TBool{}, n, C.CBool{len, d, v, x}, cellw_b(len, d, v, x, 0), {==})
    case C.CU32{+len, +d, v, x}:
      bcast_fin(D.TU32{}, n, C.CU32{len, d, v, x}, cellw_u(len, d, v, x, 0), {==})
    case C.CI32{+len, +d, v, x}:
      bcast_fin(D.TI32{}, n, C.CI32{len, d, v, x}, cellw_i(len, d, v, x, 0), {==})
    case C.CF32{+len, +d, v, x}:
      bcast_fin(D.TF32{}, n, C.CF32{len, d, v, x}, cellw_f(len, d, v, x, 0), {==})
    case C.CStr{+len, +d, v, x}:
      bcast_fin(D.TStr{}, n, C.CStr{len, d, v, x}, cellw_s(len, d, v, x, 0), {==})

# ---- frames: height / schema purity, the WF bridge, get_cloned -------------------------------------

def Laws.frame_height_w(f):
  match f:
    case C.Frame{h, cols}:
      (C.Frame{h, cols}, {==}, {==})

def CSchemaW(-cols: List<&1, C.Named>) -> Type:
  &cols2: List<&1, C.Named> -> {S.Cols.schema(cols) == (cols2, Laws.cschema(cols)) : List<&1, C.Named> & List<&2, S.Field>} & {cols2 == cols : List<&1, C.Named>}

def cschema_cons(+n: String, -col: C.Column, -rest: List<&1, C.Named>, wc: Laws.DtypeW(col), wr: CSchemaW(rest)) -> CSchemaW(C.Named{n, col} <> rest):
  (c2, e1, e2) = wc
  (cols3, f1, f2) = wr
  %Equal.sym(C.Column & D.DType, C.Column.dtype(col), (c2, Laws.cdtype(col)), e1) : &cols2: List<&1, C.Named> -> {S.Cols.schema.k(n, _, S.Cols.schema(rest)) == (cols2, S.Field{n, Laws.cdtype(col)} <> Laws.cschema(rest)) : List<&1, C.Named> & List<&2, S.Field>} & {cols2 == C.Named{n, col} <> rest : List<&1, C.Named>}
  %Equal.sym(List<&1, C.Named> & List<&2, S.Field>, S.Cols.schema(rest), (cols3, Laws.cschema(rest)), f1) : &cols2: List<&1, C.Named> -> {S.Cols.schema.k(n, (c2, Laws.cdtype(col)), _) == (cols2, S.Field{n, Laws.cdtype(col)} <> Laws.cschema(rest)) : List<&1, C.Named> & List<&2, S.Field>} & {cols2 == C.Named{n, col} <> rest : List<&1, C.Named>}
  %e2 : &cols2: List<&1, C.Named> -> {S.Cols.schema.k(n, (c2, Laws.cdtype(col)), (cols3, Laws.cschema(rest))) == (cols2, S.Field{n, Laws.cdtype(col)} <> Laws.cschema(rest)) : List<&1, C.Named> & List<&2, S.Field>} & {cols2 == C.Named{n, _} <> rest : List<&1, C.Named>}
  %f2 : &cols2: List<&1, C.Named> -> {S.Cols.schema.k(n, (c2, Laws.cdtype(col)), (cols3, Laws.cschema(rest))) == (cols2, S.Field{n, Laws.cdtype(col)} <> Laws.cschema(rest)) : List<&1, C.Named> & List<&2, S.Field>} & {cols2 == C.Named{n, c2} <> _ : List<&1, C.Named>}
  (C.Named{n, c2} <> cols3, {==}, {==})

def cschema_w(cols: List<&1, C.Named>) -> CSchemaW(cols):
  match cols:
    case Nil{}:
      (Nil{}, {==}, {==})
    case C.Named{+n, col} <> rest:
      cschema_cons(n, col, rest, Laws.dtype_w(col), cschema_w(rest))

def fschema_fin(+h: U32, -cols: List<&1, C.Named>, w: CSchemaW(cols)) -> Laws.SchemaW(C.Frame{h, cols}):
  (cols2, e1, e2) = w
  %Equal.sym(List<&1, C.Named> & List<&2, S.Field>, S.Cols.schema(cols), (cols2, Laws.cschema(cols)), e1) : &f2: C.Frame -> {S.Frame.schema.k(h, _) == (f2, Laws.cschema(cols)) : C.Frame & List<&2, S.Field>} & {f2 == C.Frame{h, cols} : C.Frame}
  %e2 : &f2: C.Frame -> {S.Frame.schema.k(h, (cols2, Laws.cschema(cols))) == (f2, Laws.cschema(cols)) : C.Frame & List<&2, S.Field>} & {f2 == C.Frame{h, _} : C.Frame}
  (C.Frame{h, cols2}, {==}, {==})

def Laws.frame_schema_w(f):
  match f:
    case C.Frame{+h, cols}:
      fschema_fin(h, cols, cschema_w(cols))

# a column of height h (WFColumnH) has U32.is_eq(clen, h)
def colh_eq(+h: U32, c: C.Column, hc: Laws.WFColumnH(h, c)) -> {U32.is_eq(Laws.clen(c), h) == True{} : Bool}:
  match c:
    case C.CBool{+len, d, v, x}:
      (hl, hw) = hc
      %Equal.sym(U32, len, h, hl) : {U32.is_eq(_, h) == True{} : Bool}
      u32_eq_refl(h)
    case C.CU32{+len, d, v, x}:
      (hl, hw) = hc
      %Equal.sym(U32, len, h, hl) : {U32.is_eq(_, h) == True{} : Bool}
      u32_eq_refl(h)
    case C.CI32{+len, d, v, x}:
      (hl, hw) = hc
      %Equal.sym(U32, len, h, hl) : {U32.is_eq(_, h) == True{} : Bool}
      u32_eq_refl(h)
    case C.CF32{+len, d, v, x}:
      (hl, hw) = hc
      %Equal.sym(U32, len, h, hl) : {U32.is_eq(_, h) == True{} : Bool}
      u32_eq_refl(h)
    case C.CStr{+len, d, v, x}:
      (hl, hw) = hc
      %Equal.sym(U32, len, h, hl) : {U32.is_eq(_, h) == True{} : Bool}
      u32_eq_refl(h)

def cols_ok_of(+h: U32, cols: List<&1, C.Named>, +seen: List<&2, String>, wf: Laws.WFCols(h, cols, seen)) -> {Laws.cols_ok(h, cols, seen) == True{} : Bool}:
  match cols:
    case Nil{}:
      {==}
    case C.Named{+n, c} <> rest:
      (hn, hc, hrest) = wf
      %Equal.sym(Bool, C.Names.has(seen, n), False{}, hn) : {Bool.and(Bool.not(_), Bool.and(U32.is_eq(Laws.clen(c), h), Laws.cols_ok(h, rest, n <> seen))) == True{} : Bool}
      %Equal.sym(Bool, U32.is_eq(Laws.clen(c), h), True{}, colh_eq(h, c, hc)) : {Bool.and(_, Laws.cols_ok(h, rest, n <> seen)) == True{} : Bool}
      cols_ok_of(h, rest, n <> seen, hrest)

def Laws.wf_frame_ok(f, wf):
  match f:
    case C.Frame{+h, cols}:
      %Equal.sym(Bool, U32.is_eq(h, h), True{}, u32_eq_refl(h)) : {Bool.and(_, Laws.cols_ok(h, cols, Nil{})) == True{} : Bool}
      cols_ok_of(h, cols, Nil{}, wf)


# ---- Frame.get_cloned: the loop Cols.cg.go walks the columns, cloning the one named n ---------------
#
# Invariant: with accumulator acc (the reversed prefix) the loop answers the list
# List.reverse.go(acc, cols) (prefix back in order, then the rest), so with acc = Nil it is
# cols itself; the slot is the clone of the FIRST column named n (Schema.find's answer), and
# no later column has that name (cols_ok: each name is new to the earlier ones). One recursive
# lemma over the columns carries the slot state: None (searching: Schema.find still has to
# answer Some{t} on the rest) or Some{c0} (found: n is among the names seen, c0 typed). It
# also hands back the schema of its columns as Data, so the Schema.find.go facts (find_hit,
# find_found) are stated over a live Data list, never over cschema of an erased column list.

def CgHyp(sl: Maybe<&1, C.Column>, -cols: List<&1, C.Named>, +n: String, +seen: List<&2, String>, +h: U32, +t: D.DType) -> Type:
  match sl:
    case None{}:
      {S.Schema.find(Laws.cschema(cols), n) == Some{t} : Maybe<&2, D.DType>}
    case Some{c0}:
      {C.Names.has(seen, n) == True{} : Bool} & Laws.ColTy(t, h, c0)

def CgW(-cols: List<&1, C.Named>, +n: String, -acc: List<&1, C.Named>, -sl: Maybe<&1, C.Column>, +h: U32, +t: D.DType) -> Type:
  &cols2: List<&1, C.Named> -> &c3: C.Column -> {C.Cols.cg.go(cols, n, (acc, sl)) == (cols2, Some{c3}) : List<&1, C.Named> & Maybe<&1, C.Column>} & {cols2 == List.reverse.go(&1, C.Named, acc, cols) : List<&1, C.Named>} & Laws.ColTy(t, h, c3)

# the loop's claim over any accumulator and slot state (the recursion's result for a list)
def CgRec(-cols: List<&1, C.Named>, +n: String, +seen: List<&2, String>, +h: U32, +t: D.DType) -> Type:
  @hok: {Laws.cols_ok(h, cols, seen) == True{} : Bool} -> @acc: List<&1, C.Named> -> @sl: Maybe<&1, C.Column> -> @hy: CgHyp(sl, cols, n, seen, h, t) -> CgW(cols, n, acc, sl, h, t)

# the column back with its length and dtype as Data values
def col_dup2(c: C.Column) -> &c2: C.Column -> &k: U32 -> &dt: D.DType -> {c2 == c : C.Column} & {dt == Laws.cdtype(c) : D.DType} & {k == Laws.clen(c) : U32}:
  match c:
    case C.CBool{+len, depth, valid, data}:
      (C.CBool{len, depth, valid, data}, len, D.TBool{}, {==}, {==}, {==})
    case C.CU32{+len, depth, valid, data}:
      (C.CU32{len, depth, valid, data}, len, D.TU32{}, {==}, {==}, {==})
    case C.CI32{+len, depth, valid, data}:
      (C.CI32{len, depth, valid, data}, len, D.TI32{}, {==}, {==}, {==})
    case C.CF32{+len, depth, valid, data}:
      (C.CF32{len, depth, valid, data}, len, D.TF32{}, {==}, {==}, {==})
    case C.CStr{+len, depth, valid, data}:
      (C.CStr{len, depth, valid, data}, len, D.TStr{}, {==}, {==}, {==})

# ColTy transfers along an equation to the column it is about
def colty_along(+t: D.DType, +h: U32, -col: C.Column, -c3: C.Column, e: {c3 == col : C.Column}, ed: {Laws.cdtype(col) == t : D.DType}, el: {Laws.clen(col) == h : U32}) -> Laws.ColTy(t, h, c3):
  %Equal.sym(C.Column, c3, col, e) : Laws.ColTy(t, h, _)
  (ed, el)

def cg_nil(+n: String, acc: List<&1, C.Named>, sl: Maybe<&1, C.Column>, +seen: List<&2, String>, +h: U32, +t: D.DType, hy: CgHyp(sl, Nil{}, n, seen, h, t)) -> CgW(Nil{}, n, acc, sl, h, t):
  match sl:
    case None{}:
      Empty.absurd(CgW(Nil{}, n, acc, None{}, h, t), none_some(D.DType, t, hy))
    case Some{c0}:
      (hin, ty) = hy
      (List.reverse(&1, C.Named, acc), c0, {==}, {==}, ty)

# the hit (searching, String.eq(nj, n)): the clone c3 of c2 becomes the slot; the tail's answer
# is restated over c2 (the kept copy c1 equals it)
def cg_hit_fin(+n: String, +nj: String, -c2: C.Column, -c1: C.Column, -c3: C.Column, -acc: List<&1, C.Named>, -rest: List<&1, C.Named>, +h: U32, +t: D.DType, e1: {c1 == c2 : C.Column}, w: CgW(rest, n, C.Named{nj, c1} <> acc, Some{c3}, h, t))
  -> &cols2: List<&1, C.Named> -> &c4: C.Column -> {C.Cols.cg.go(rest, n, (C.Named{nj, c1} <> acc, Some{c3})) == (cols2, Some{c4}) : List<&1, C.Named> & Maybe<&1, C.Column>} & {cols2 == List.reverse.go(&1, C.Named, acc, C.Named{nj, c2} <> rest) : List<&1, C.Named>} & Laws.ColTy(t, h, c4):
  (cols2, c4, eq, ecols, ty) = w
  %e1 : &cols2: List<&1, C.Named> -> &c4: C.Column -> {C.Cols.cg.go(rest, n, (C.Named{nj, c1} <> acc, Some{c3})) == (cols2, Some{c4}) : List<&1, C.Named> & Maybe<&1, C.Column>} & {cols2 == List.reverse.go(&1, C.Named, acc, C.Named{nj, _} <> rest) : List<&1, C.Named>} & Laws.ColTy(t, h, c4)
  (cols2, c4, eq, ecols, ty)

def cg_hit(+n: String, +nj: String, -c2: C.Column, acc: List<&1, C.Named>, +seen: List<&2, String>, +h: U32, +t: D.DType, -rest: List<&1, C.Named>,
  +eb: {String.eq(n, nj) == True{} : Bool}, ed: {Laws.cdtype(c2) == t : D.DType}, el: {Laws.clen(c2) == h : U32}, hrest: {Laws.cols_ok(h, rest, nj <> seen) == True{} : Bool}, rec: CgRec(rest, n, nj <> seen, h, t), w: CloneW(c2))
  -> CgW(C.Named{nj, c2} <> rest, n, acc, None{}, h, t):
  (c1, c3, ec, e1, e3) = w
  %Equal.sym(Bool, String.eq(n, nj), True{}, eb) : &cols2: List<&1, C.Named> -> &c4: C.Column -> {C.Cols.cg.go(rest, n, C.Cols.cg.step(_, nj, c2, (acc, None{}))) == (cols2, Some{c4}) : List<&1, C.Named> & Maybe<&1, C.Column>} & {cols2 == List.reverse.go(&1, C.Named, acc, C.Named{nj, c2} <> rest) : List<&1, C.Named>} & Laws.ColTy(t, h, c4)
  %Equal.sym(C.Column & C.Column, C.Column.clone(c2), (c1, c3), ec) : &cols2: List<&1, C.Named> -> &c4: C.Column -> {C.Cols.cg.go(rest, n, C.Cols.cg.cl(nj, acc, _)) == (cols2, Some{c4}) : List<&1, C.Named> & Maybe<&1, C.Column>} & {cols2 == List.reverse.go(&1, C.Named, acc, C.Named{nj, c2} <> rest) : List<&1, C.Named>} & Laws.ColTy(t, h, c4)
  cg_hit_fin(n, nj, c2, c1, c3, acc, rest, h, t, e1, rec(hrest, C.Named{nj, c1} <> acc, Some{c3}, ((%Equal.sym(Bool, String.eq(n, nj), True{}, eb) : {Bool.or(_, C.Names.has(seen, n)) == True{} : Bool}; {==}), colty_along(t, h, c2, c3, e3, ed, el))))

# searching, no hit: the loop's own test String.eq(n, nj) is False too
def cg_none_miss(+n: String, +nj: String, b2: Bool, eb2: {String.eq(n, nj) == b2 : Bool}, c2: C.Column, acc: List<&1, C.Named>, +seen: List<&2, String>, +h: U32, +t: D.DType, -rest: List<&1, C.Named>,
  eb: {String.eq(nj, n) == False{} : Bool}, hrest: {Laws.cols_ok(h, rest, nj <> seen) == True{} : Bool},
  hfind: {S.Schema.find(Laws.cschema(rest), n) == Some{t} : Maybe<&2, D.DType>}, rec: CgRec(rest, n, nj <> seen, h, t))
  -> CgW(C.Named{nj, c2} <> rest, n, acc, None{}, h, t):
  match b2:
    case True{}:
      true_false_any(CgW(C.Named{nj, c2} <> rest, n, acc, None{}, h, t), Equal.trans(Bool, True{}, String.eq(n, n), False{}, Equal.sym(Bool, String.eq(n, n), True{}, Laws.str_eq_refl(n)), (%Equal.sym(String, n, nj, Laws.str_eq_sound(n, nj, eb2)) : {String.eq(_, n) == False{} : Bool}; eb)))
    case False{}:
      %Equal.sym(Bool, String.eq(n, nj), False{}, eb2) : &cols2: List<&1, C.Named> -> &c3: C.Column -> {C.Cols.cg.go(rest, n, C.Cols.cg.step(_, nj, c2, (acc, None{}))) == (cols2, Some{c3}) : List<&1, C.Named> & Maybe<&1, C.Column>} & {cols2 == List.reverse.go(&1, C.Named, acc, C.Named{nj, c2} <> rest) : List<&1, C.Named>} & Laws.ColTy(t, h, c3)
      rec(hrest, C.Named{nj, c2} <> acc, None{}, hfind)

# searching: b = String.eq(nj, n) is Schema.find's test on this field; s is the rest's schema as
# Data (es), dt the column's dtype as Data (edt)
def cg_none(+n: String, +nj: String, b: Bool, eb: {String.eq(nj, n) == b : Bool}, c2: C.Column, +k: U32, +dt: D.DType, +s: List<&2, S.Field>, acc: List<&1, C.Named>, +seen: List<&2, String>, +h: U32, +t: D.DType, -rest: List<&1, C.Named>,
  +ek: {k == Laws.clen(c2) : U32}, +edt: {dt == Laws.cdtype(c2) : D.DType}, +es: {s == Laws.cschema(rest) : List<&2, S.Field>}, +hl: {U32.is_eq(k, h) == True{} : Bool}, hrest: {Laws.cols_ok(h, rest, nj <> seen) == True{} : Bool},
  hfind: {S.Schema.find.go(s, n, b, dt) == Some{t} : Maybe<&2, D.DType>}, rec: CgRec(rest, n, nj <> seen, h, t))
  -> CgW(C.Named{nj, c2} <> rest, n, acc, None{}, h, t):
  match b:
    case True{}:
      cg_hit(n, nj, c2, acc, seen, h, t, rest, (%Equal.sym(String, nj, n, Laws.str_eq_sound(nj, n, eb)) : {String.eq(n, _) == True{} : Bool}; Laws.str_eq_refl(n)), Equal.trans(D.DType, Laws.cdtype(c2), dt, t, Equal.sym(D.DType, dt, Laws.cdtype(c2), edt), some_inj(D.DType, dt, t, (%find_hit(s, n, dt) : {_ == Some{t} : Maybe<&2, D.DType>}; hfind))), Equal.trans(U32, Laws.clen(c2), k, h, Equal.sym(U32, k, Laws.clen(c2), ek), u32_eq_sound(k, h, hl)), hrest, rec, clone_w(c2))
    case False{}:
      cg_none_miss(n, nj, String.eq(n, nj), {==}, c2, acc, seen, h, t, rest, eb, hrest, (%es : {S.Schema.find(_, n) == Some{t} : Maybe<&2, D.DType>}; (%find_found(s, n, dt, D.TBool{}) : {_ == Some{t} : Maybe<&2, D.DType>}; hfind)), rec)

# found already: every later name differs from n
def cg_some(+n: String, +nj: String, b2: Bool, +eb2: {String.eq(n, nj) == b2 : Bool}, c2: C.Column, acc: List<&1, C.Named>, c0: C.Column, +seen: List<&2, String>, +h: U32, +t: D.DType, -rest: List<&1, C.Named>,
  hn: {C.Names.has(seen, nj) == False{} : Bool}, hrest: {Laws.cols_ok(h, rest, nj <> seen) == True{} : Bool}, +hin: {C.Names.has(seen, n) == True{} : Bool}, ty0: Laws.ColTy(t, h, c0), rec: CgRec(rest, n, nj <> seen, h, t))
  -> CgW(C.Named{nj, c2} <> rest, n, acc, Some{c0}, h, t):
  match b2:
    case True{}:
      true_false_any(CgW(C.Named{nj, c2} <> rest, n, acc, Some{c0}, h, t), Equal.trans(Bool, True{}, C.Names.has(seen, n), False{}, Equal.sym(Bool, C.Names.has(seen, n), True{}, hin), (%Equal.sym(String, n, nj, Laws.str_eq_sound(n, nj, eb2)) : {C.Names.has(seen, _) == False{} : Bool}; hn)))
    case False{}:
      %Equal.sym(Bool, String.eq(n, nj), False{}, eb2) : &cols2: List<&1, C.Named> -> &c3: C.Column -> {C.Cols.cg.go(rest, n, C.Cols.cg.step(_, nj, c2, (acc, Some{c0}))) == (cols2, Some{c3}) : List<&1, C.Named> & Maybe<&1, C.Column>} & {cols2 == List.reverse.go(&1, C.Named, acc, C.Named{nj, c2} <> rest) : List<&1, C.Named>} & Laws.ColTy(t, h, c3)
      rec(hrest, C.Named{nj, c2} <> acc, Some{c0}, ((%Equal.sym(Bool, String.eq(n, nj), False{}, eb2) : {Bool.or(_, C.Names.has(seen, n)) == True{} : Bool}; hin), ty0))

# the cons step with the Bool facts over the length as a number k
def cg_cons_k(+n: String, +nj: String, c2: C.Column, +k: U32, +dt: D.DType, +s: List<&2, S.Field>, acc: List<&1, C.Named>, sl: Maybe<&1, C.Column>, +seen: List<&2, String>, +h: U32, +t: D.DType, -rest: List<&1, C.Named>,
  +ek: {k == Laws.clen(c2) : U32}, +edt: {dt == Laws.cdtype(c2) : D.DType}, +es: {s == Laws.cschema(rest) : List<&2, S.Field>},
  +hok: {Bool.and(Bool.not(C.Names.has(seen, nj)), Bool.and(U32.is_eq(k, h), Laws.cols_ok(h, rest, nj <> seen))) == True{} : Bool},
  hy: CgHyp(sl, C.Named{nj, c2} <> rest, n, seen, h, t), rec: CgRec(rest, n, nj <> seen, h, t))
  -> CgW(C.Named{nj, c2} <> rest, n, acc, sl, h, t):
  match sl:
    case None{}:
      cg_none(n, nj, String.eq(nj, n), {==}, c2, k, dt, s, acc, seen, h, t, rest, ek, edt, es, and_l(U32.is_eq(k, h), Laws.cols_ok(h, rest, nj <> seen), L.and_right(Bool.not(C.Names.has(seen, nj)), Bool.and(U32.is_eq(k, h), Laws.cols_ok(h, rest, nj <> seen)), hok)), L.and_right(U32.is_eq(k, h), Laws.cols_ok(h, rest, nj <> seen), L.and_right(Bool.not(C.Names.has(seen, nj)), Bool.and(U32.is_eq(k, h), Laws.cols_ok(h, rest, nj <> seen)), hok)), (%Equal.sym(List<&2, S.Field>, s, Laws.cschema(rest), es) : {S.Schema.find.go(_, n, String.eq(nj, n), dt) == Some{t} : Maybe<&2, D.DType>}; (%Equal.sym(D.DType, dt, Laws.cdtype(c2), edt) : {S.Schema.find.go(Laws.cschema(rest), n, String.eq(nj, n), _) == Some{t} : Maybe<&2, D.DType>}; hy)), rec)
    case Some{c0}:
      (hin, ty0) = hy
      cg_some(n, nj, String.eq(n, nj), {==}, c2, acc, c0, seen, h, t, rest, L.not_true(C.Names.has(seen, nj), and_l(Bool.not(C.Names.has(seen, nj)), Bool.and(U32.is_eq(k, h), Laws.cols_ok(h, rest, nj <> seen)), hok)), L.and_right(U32.is_eq(k, h), Laws.cols_ok(h, rest, nj <> seen), L.and_right(Bool.not(C.Names.has(seen, nj)), Bool.and(U32.is_eq(k, h), Laws.cols_ok(h, rest, nj <> seen)), hok)), hin, ty0, rec)

# the cons step: the column's length as a number first, so the Bool facts hold Data only
def cg_cons(+n: String, +nj: String, c2: C.Column, +k: U32, +dt: D.DType, +s: List<&2, S.Field>, acc: List<&1, C.Named>, sl: Maybe<&1, C.Column>, +seen: List<&2, String>, +h: U32, +t: D.DType, -rest: List<&1, C.Named>,
  +ek: {k == Laws.clen(c2) : U32}, +edt: {dt == Laws.cdtype(c2) : D.DType}, +es: {s == Laws.cschema(rest) : List<&2, S.Field>},
  +hok: {Laws.cols_ok(h, C.Named{nj, c2} <> rest, seen) == True{} : Bool}, hy: CgHyp(sl, C.Named{nj, c2} <> rest, n, seen, h, t), rec: CgRec(rest, n, nj <> seen, h, t))
  -> CgW(C.Named{nj, c2} <> rest, n, acc, sl, h, t):
  cg_cons_k(n, nj, c2, k, dt, s, acc, sl, seen, h, t, rest, ek, edt, es, (%Equal.sym(U32, k, Laws.clen(c2), ek) : {Bool.and(Bool.not(C.Names.has(seen, nj)), Bool.and(U32.is_eq(_, h), Laws.cols_ok(h, rest, nj <> seen))) == True{} : Bool}; hok), hy, rec)

# the dtype / length facts of col restated over an equal column c2
def dt_along(-c2: C.Column, -col: C.Column, +dt: D.DType, ec: {c2 == col : C.Column}, edt: {dt == Laws.cdtype(col) : D.DType}) -> {dt == Laws.cdtype(c2) : D.DType}:
  %Equal.sym(C.Column, c2, col, ec) : {dt == Laws.cdtype(_) : D.DType}
  edt

def len_along(-c2: C.Column, -col: C.Column, +k: U32, ec: {c2 == col : C.Column}, ek: {k == Laws.clen(col) : U32}) -> {k == Laws.clen(c2) : U32}:
  %Equal.sym(C.Column, c2, col, ec) : {k == Laws.clen(_) : U32}
  ek

# one level of the recursion: the schema of the columns as Data, and the loop's claim
def CgOut(-cols: List<&1, C.Named>, +n: String, +seen: List<&2, String>, +h: U32, +t: D.DType) -> Type:
  &s: List<&2, S.Field> -> {s == Laws.cschema(cols) : List<&2, S.Field>} & CgRec(cols, n, seen, h, t)

def cg_cons_w(+n: String, +nj: String, -col: C.Column, -rest: List<&1, C.Named>, +seen: List<&2, String>, +h: U32, +t: D.DType, w: CgOut(rest, n, nj <> seen, h, t),
  wd: &c2: C.Column -> &k: U32 -> &dt: D.DType -> {c2 == col : C.Column} & {dt == Laws.cdtype(col) : D.DType} & {k == Laws.clen(col) : U32})
  -> CgOut(C.Named{nj, col} <> rest, n, seen, h, t):
  (+s, +es, rec) = w
  (c2, +k, +dt, +ec, +edt, ek) = wd
  %ec : CgOut(C.Named{nj, _} <> rest, n, seen, h, t)
  (S.Field{nj, dt} <> s, (%dt_along(c2, col, dt, ec, edt) : {S.Field{nj, dt} <> s == S.Field{nj, _} <> Laws.cschema(rest) : List<&2, S.Field>}; %es : {S.Field{nj, dt} <> s == S.Field{nj, dt} <> _ : List<&2, S.Field>}; {==}), hok => acc => sl => hy => cg_cons(n, nj, c2, k, dt, s, acc, sl, seen, h, t, rest, len_along(c2, col, k, ec, ek), dt_along(c2, col, dt, ec, edt), es, hok, hy, rec))

def cg_go_w(cols: List<&1, C.Named>, +n: String, +seen: List<&2, String>, +h: U32, +t: D.DType) -> CgOut(cols, n, seen, h, t):
  match cols:
    case Nil{}:
      (Nil{}, {==}, hok => acc => sl => hy => cg_nil(n, acc, sl, seen, h, t, hy))
    case C.Named{+nj, col} <> rest:
      cg_cons_w(n, nj, col, rest, seen, h, t, cg_go_w(rest, n, nj <> seen, h, t), col_dup2(col))

def get_cloned_fin(+h2: U32, -cols: List<&1, C.Named>, +n: String, +h: U32, +t: D.DType, w: CgW(cols, n, Nil{}, None{}, h, t)) -> Laws.GetW(C.Frame{h2, cols}, n, h, t):
  (cols2, c3, eq, ecols, ty) = w
  %Equal.sym(List<&1, C.Named> & Maybe<&1, C.Column>, C.Cols.cg.go(cols, n, (Nil{}, None{})), (cols2, Some{c3}), eq) : &f2: C.Frame -> &c: C.Column -> {C.Frame.get_cloned.k(h2, n, _) == (f2, Done{c}) : C.Frame & E.ResT(C.Column)} & {f2 == C.Frame{h2, cols} : C.Frame} & Laws.ColTy(t, h, c)
  %ecols : &f2: C.Frame -> &c: C.Column -> {C.Frame.get_cloned.k(h2, n, (cols2, Some{c3})) == (f2, Done{c}) : C.Frame & E.ResT(C.Column)} & {f2 == C.Frame{h2, _} : C.Frame} & Laws.ColTy(t, h, c)
  (C.Frame{h2, cols2}, c3, {==}, {==}, ty)

def get_cloned_k(+h2: U32, -cols: List<&1, C.Named>, +n: String, +h: U32, +t: D.DType, hok: {Laws.cols_ok(h, cols, Nil{}) == True{} : Bool}, hfind: {S.Schema.find(Laws.cschema(cols), n) == Some{t} : Maybe<&2, D.DType>}, w: CgOut(cols, n, Nil{}, h, t)) -> Laws.GetW(C.Frame{h2, cols}, n, h, t):
  (+s, +es, rec) = w
  get_cloned_fin(h2, cols, n, h, t, rec(hok, Nil{}, None{}, hfind))

def Laws.get_cloned_typed(f, n, h, t, hf, hfind):
  match f:
    case C.Frame{+h2, cols}:
      get_cloned_k(h2, cols, n, h, t, L.and_right(U32.is_eq(h2, h), Laws.cols_ok(h, cols, Nil{}), hf), hfind, cg_go_w(cols, n, Nil{}, h, t))

