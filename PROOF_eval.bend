def dcell_f(+len: U32, +d: Nat, -v: C.Valid, -x: Array<F32>, +i: U32, w: &x2: Array<F32> -> &y: F32 -> {x2 == x : Array<F32>} & {Array.get(F32, x, i) == (x, y) : Array<F32> & F32} & {y == Laws.rd_at(F32, x, i) : F32}) -> &sc: D.Scalar -> {C.Column.data_cell(C.CF32{len, d, v, x}, i) == (C.CF32{len, d, v, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TF32{}) == D.TF32{} : D.DType}:
