def cellm_u(+len: U32, +d: Nat, -m: Array<U32>, x: Array<U32>, +i: U32, w: &m2: Array<U32> -> &y: U32 -> {m2 == m : Array<U32>} & {Array.get(U32, m, i) == (m, y) : Array<U32> & U32} & {y == Laws.rd_at(U32, m, i) : U32}) -> Laws.CellW(C.CU32{len, d, C.Mask{m}, x}, i):
  (m2, +y, e1, e2, e3) = w
  %Equal.sym(Array<U32> & U32, Array.get(U32, m, i), (m, y), e2) : &sc: D.Scalar -> {C.Column.cell.b(i, C.CU32{len, d, C.AllValid{}, x}, C.Valid.get.k(_)) == (C.CU32{len, d, C.Mask{m}, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TU32{}) == D.TU32{} : D.DType}
  cellc_u(U32.is_ne(y, 0), len, d, m, x, i)

def cellw_u(+len: U32, +d: Nat, v: C.Valid, x: Array<U32>, +i: U32) -> Laws.CellW(C.CU32{len, d, v, x}, i):
  match v:
    case C.AllValid{}:
      dcell_u(len, d, C.AllValid{}, x, i, PC.get_w(U32, x, i))
    case C.Mask{m}:
