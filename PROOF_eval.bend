# PROOF_eval.bend -- proofs of LAWS.bend section 13 (M5 part 2, plan M_01 P2): typing of the
# production evaluator (src/eval.bend). Generated by scratchpad/gen_eval.py from kind tables:
# the per-kind / per-op case lists are mechanical, so they are written by a script.
#
# Shape (the P1 witness idiom throughout): a lemma over an affine value (column, frame, state)
# consumes it once and hands the production result back as a live Sigma witness beside an
# equation to the production term (`ColW`, `ResW`, `RunW` in LAWS.bend); facts about the
# witness are equalities over the models cdtype / clen, so they transfer along the witness
# equations by rewriting. Pairs a production function destructures (`(x, m) = r`) are taken
# apart in a helper's parameter; a Bool the production code matches on is passed as a
# parameter and matched in a helper. A column whose length is needed as a NUMBER is first
# split by clen_dup (the column back, its length as a Data value), since a term such as
# clen(col) used live would consume the column.
import Base
import ./src/dtype.bend as D
import ./src/err.bend as E
import ./src/kernels.bend as K
import ./src/column.bend as C
import ./src/schema.bend as S
import ./src/expr.bend as X
import ./src/analysis.bend as A
import ./src/eval.bend as V
import ./LAWS.bend as Laws
import ./PROOF_lib.bend as L
import ./PROOF_kernels.bend as PK
import ./PROOF_contents.bend as PC

# ---- small toolkit ------------------------------------------------------------------------------

# Some is injective
def some_inj(-A: Data, -xs: A, -ys: A, e: {Some{xs} == Some{ys} : Maybe<&2, A>}) -> {xs == ys : A}:
  Equal.cong(Maybe<&2, A>, A, m => Maybe.default(&2, A, m, xs), Some{xs}, Some{ys}, e)

def maybe_disc(-A: Data, m: Maybe<&2, A>) -> Type:
  match m:
    case None{}:
      Unit
    case Some{x}:
      Empty

def none_some(-A: Data, -x: A, h: {None{} == Some{x} : Maybe<&2, A>}) -> Empty:
  %h : maybe_disc(A, _)
  Unit{}

# a computed result that is a Fail cannot be a Done
def is_fail(-A: Data, r: E.Res(A)) -> Bool:
  match r:
    case Fail{e}:
      True{}
    case Done{x}:
      False{}

def fail_done_r(-A: Data, r: E.Res(A), -x: A, hf: {is_fail(A, r) == True{} : Bool}, h: {r == Done{x} : E.Res(A)}) -> Empty:
  match r:
    case Fail{e}:
      L.fail_done(A, e, x, h)
    case Done{y}:
      L.true_false(Equal.sym(Bool, False{}, True{}, hf))

def true_false_any(-G: Type, h: {True{} == False{} : Bool}) -> G:
  Empty.absurd(G, L.true_false(h))

# Bool.and facts with the other side erased
def and_l(a: Bool, -b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      h

def or_true_r(b: Bool) -> {Bool.or(b, True{}) == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def and_false_r(b: Bool) -> {Bool.and(b, False{}) == False{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

# U32.is_eq is reflexive and sound (Cmp.is_eq of Word.cmp)
def u32_eq_refl(a: U32) -> {U32.is_eq(a, a) == True{} : Bool}:
  match a:
    case U32{x}:
      %Equal.sym(Cmp, Word.cmp(32n, x, x), EQ{}, L.word_cmp_refl(32n, x)) : {Cmp.is_eq(_) == True{} : Bool}
      {==}

def u32_eq_sound_k(+x: Word(32n), +y: Word(32n), c: Cmp, e: {Word.cmp(32n, x, y) == c : Cmp}, h: {Cmp.is_eq(c) == True{} : Bool}) -> {U32{x} == U32{y} : U32}:
  match c:
    case EQ{}:
      Equal.cong(Word(32n), U32, w => U32{w}, x, y, L.word_cmp_eq(32n, x, y, e))
    case LT{}:
      true_false_any({U32{x} == U32{y} : U32}, Equal.sym(Bool, False{}, True{}, h))
    case GT{}:
      true_false_any({U32{x} == U32{y} : U32}, Equal.sym(Bool, False{}, True{}, h))

def u32_eq_sound(a: U32, b: U32, h: {U32.is_eq(a, b) == True{} : Bool}) -> {a == b : U32}:
  match a b:
    case U32{+x} U32{+y}:
      u32_eq_sound_k(x, y, Word.cmp(32n, x, y), {==}, h)

def u32_ne_refl(a: U32) -> {U32.is_ne(a, a) == False{} : Bool}:
  %Equal.sym(Bool, U32.is_eq(a, a), True{}, u32_eq_refl(a)) : {Bool.not(_) == False{} : Bool}
  {==}

# the `found` argument of Schema.find.go is irrelevant while nothing has matched
def find_found(s: List<&2, S.Field>, +n: String, -fd1: D.DType, -fd2: D.DType) -> {S.Schema.find.go(s, n, False{}, fd1) == S.Schema.find.go(s, n, False{}, fd2) : Maybe<&2, D.DType>}:
  match s:
    case Nil{}:
      {==}
    case S.Field{k, t} <> rest:
      {==}

# once hit, Schema.find.go answers the field found (whatever the rest of the schema)
def find_hit(s: List<&2, S.Field>, -n: String, -found: D.DType) -> {S.Schema.find.go(s, n, True{}, found) == Some{found} : Maybe<&2, D.DType>}:
  match s:
    case Nil{}:
      {==}
    case S.Field{k, t} <> rest:
      {==}

# ---- Column.len / Column.dtype are pure (the column back as a live witness) ----------------------

def Laws.len_w(c):
  match c:
    case C.CBool{len, depth, valid, data}:
      (C.CBool{len, depth, valid, data}, {==}, {==})
    case C.CU32{len, depth, valid, data}:
      (C.CU32{len, depth, valid, data}, {==}, {==})
    case C.CI32{len, depth, valid, data}:
      (C.CI32{len, depth, valid, data}, {==}, {==})
    case C.CF32{len, depth, valid, data}:
      (C.CF32{len, depth, valid, data}, {==}, {==})
    case C.CStr{len, depth, valid, data}:
      (C.CStr{len, depth, valid, data}, {==}, {==})

def Laws.dtype_w(c):
  match c:
    case C.CBool{len, depth, valid, data}:
      (C.CBool{len, depth, valid, data}, {==}, {==})
    case C.CU32{len, depth, valid, data}:
      (C.CU32{len, depth, valid, data}, {==}, {==})
    case C.CI32{len, depth, valid, data}:
      (C.CI32{len, depth, valid, data}, {==}, {==})
    case C.CF32{len, depth, valid, data}:
      (C.CF32{len, depth, valid, data}, {==}, {==})
    case C.CStr{len, depth, valid, data}:
      (C.CStr{len, depth, valid, data}, {==}, {==})

# the column back and its length as a Data value
def clen_dup(c: C.Column) -> &c2: C.Column -> &k: U32 -> {c2 == c : C.Column} & {k == Laws.clen(c) : U32}:
  match c:
    case C.CBool{+len, depth, valid, data}:
      (C.CBool{len, depth, valid, data}, len, {==}, {==})
    case C.CU32{+len, depth, valid, data}:
      (C.CU32{len, depth, valid, data}, len, {==}, {==})
    case C.CI32{+len, depth, valid, data}:
      (C.CI32{len, depth, valid, data}, len, {==}, {==})
    case C.CF32{+len, depth, valid, data}:
      (C.CF32{len, depth, valid, data}, len, {==}, {==})
    case C.CStr{+len, depth, valid, data}:
      (C.CStr{len, depth, valid, data}, len, {==}, {==})

# ---- Column.cell answers a scalar of the column's dtype or SNull (CellW), through get_w ---------

def dcell_b(+len: U32, +d: Nat, -v: C.Valid, -x: Array<U32>, +i: U32, w: &x2: Array<U32> -> &y: U32 -> {x2 == x : Array<U32>} & {Array.get(U32, x, i) == (x, y) : Array<U32> & U32} & {y == Laws.rd_at(U32, x, i) : U32}) -> &sc: D.Scalar -> {C.Column.data_cell(C.CBool{len, d, v, x}, i) == (C.CBool{len, d, v, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TBool{}) == D.TBool{} : D.DType}:
  (x2, +y, e1, e2, e3) = w
  %Equal.sym(Array<U32> & U32, Array.get(U32, x, i), (x, y), e2) : &sc: D.Scalar -> {C.Column.cell.w(D.TBool{}, len, d, v, _) == (C.CBool{len, d, v, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TBool{}) == D.TBool{} : D.DType}
  (D.SBool{U32.is_ne(y, 0)}, {==}, {==})

def cellc_b(ok: Bool, +len: U32, +d: Nat, -m: Array<U32>, x: Array<U32>, +i: U32) -> &sc: D.Scalar -> {C.Column.cell.c(ok, i, C.CBool{len, d, C.Mask{m}, x}) == (C.CBool{len, d, C.Mask{m}, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TBool{}) == D.TBool{} : D.DType}:
  match ok:
    case True{}:
      dcell_b(len, d, C.Mask{m}, x, i, PC.get_w(U32, x, i))
    case False{}:
      (D.SNull{}, {==}, {==})

def cellm_b(+len: U32, +d: Nat, -m: Array<U32>, x: Array<U32>, +i: U32, w: &m2: Array<U32> -> &y: U32 -> {m2 == m : Array<U32>} & {Array.get(U32, m, i) == (m, y) : Array<U32> & U32} & {y == Laws.rd_at(U32, m, i) : U32}) -> Laws.CellW(C.CBool{len, d, C.Mask{m}, x}, i):
  (m2, +y, e1, e2, e3) = w
  %Equal.sym(Array<U32> & U32, Array.get(U32, m, i), (m, y), e2) : &sc: D.Scalar -> {C.Column.cell.b(i, C.CBool{len, d, C.AllValid{}, x}, C.Valid.get.k(_)) == (C.CBool{len, d, C.Mask{m}, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TBool{}) == D.TBool{} : D.DType}
  cellc_b(U32.is_ne(y, 0), len, d, m, x, i)

def cellw_b(+len: U32, +d: Nat, v: C.Valid, x: Array<U32>, +i: U32) -> Laws.CellW(C.CBool{len, d, v, x}, i):
  match v:
    case C.AllValid{}:
      dcell_b(len, d, C.AllValid{}, x, i, PC.get_w(U32, x, i))
    case C.Mask{m}:
      cellm_b(len, d, m, x, i, PC.get_w(U32, m, i))

def dcell_u(+len: U32, +d: Nat, -v: C.Valid, -x: Array<U32>, +i: U32, w: &x2: Array<U32> -> &y: U32 -> {x2 == x : Array<U32>} & {Array.get(U32, x, i) == (x, y) : Array<U32> & U32} & {y == Laws.rd_at(U32, x, i) : U32}) -> &sc: D.Scalar -> {C.Column.data_cell(C.CU32{len, d, v, x}, i) == (C.CU32{len, d, v, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TU32{}) == D.TU32{} : D.DType}:
  (x2, +y, e1, e2, e3) = w
  %Equal.sym(Array<U32> & U32, Array.get(U32, x, i), (x, y), e2) : &sc: D.Scalar -> {C.Column.cell.w(D.TU32{}, len, d, v, _) == (C.CU32{len, d, v, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TU32{}) == D.TU32{} : D.DType}
  (D.SU32{y}, {==}, {==})

def cellc_u(ok: Bool, +len: U32, +d: Nat, -m: Array<U32>, x: Array<U32>, +i: U32) -> &sc: D.Scalar -> {C.Column.cell.c(ok, i, C.CU32{len, d, C.Mask{m}, x}) == (C.CU32{len, d, C.Mask{m}, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TU32{}) == D.TU32{} : D.DType}:
  match ok:
    case True{}:
      dcell_u(len, d, C.Mask{m}, x, i, PC.get_w(U32, x, i))
