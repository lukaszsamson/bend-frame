  %Equal.sym(Array<U32> & U32, Array.get(U32, x, i), (x, y), e2) : &sc: D.Scalar -> {C.Column.cell.w(D.TI32{}, len, d, v, _) == (C.CI32{len, d, v, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TI32{}) == D.TI32{} : D.DType}
  (D.SI32{D.I32{y}}, {==}, {==})

def cellc_i(ok: Bool, +len: U32, +d: Nat, -m: Array<U32>, x: Array<U32>, +i: U32) -> &sc: D.Scalar -> {C.Column.cell.c(ok, i, C.CI32{len, d, C.Mask{m}, x}) == (C.CI32{len, d, C.Mask{m}, x}, sc) : C.Column & D.Scalar} & {Laws.lit_dtype(sc, D.TI32{}) == D.TI32{} : D.DType}:
