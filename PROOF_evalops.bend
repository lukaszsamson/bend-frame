# PROOF_evalops.bend -- proofs of LAWS.bend section 13, the operation laws (eval_un_typed ..
# eval_agg_typed): every Eval operation answers a column of the dtype its typing rule gives, as
# long as its operand, failing only where the analysis allows (the strict cast of a fallible
# pair). Generated by scratchpad/gen_evalops.py from op / kind tables: one line per (op, kind)
# case; a case the typing rule refuses is refuted (the rule computes to a Fail), a case it
# accepts is the production term as a live witness with its shape facts (PROOF_eval.bend).
import Base
import ./src/dtype.bend as D
import ./src/err.bend as E
import ./src/kernels.bend as K
import ./src/column.bend as C
import ./src/strs.bend as ST
import ./src/schema.bend as S
import ./src/expr.bend as X
import ./src/analysis.bend as A
import ./src/eval.bend as V
import ./LAWS.bend as Laws
import ./PROOF_lib.bend as L
import ./PROOF_kernels.bend as PK
import ./PROOF_contents.bend as PC
import ./PROOF_eval.bend as PV

# ---- the typing rules' shapes: Expr.chk / or_done / lit_of, DType.eq soundness ---------------------

def chk_done(ok: Bool, -e: E.Err, -r: E.Res(D.DType), -t: D.DType, h: {X.Expr.chk(ok, e, r) == Done{t} : E.Res(D.DType)}) -> {r == Done{t} : E.Res(D.DType)}:
  match ok:
    case True{}:
      h
    case False{}:
      Empty.absurd({r == Done{t} : E.Res(D.DType)}, L.fail_done(D.DType, e, t, h))

def chk_ok(ok: Bool, -e: E.Err, -r: E.Res(D.DType), -t: D.DType, h: {X.Expr.chk(ok, e, r) == Done{t} : E.Res(D.DType)}) -> {ok == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, L.fail_done(D.DType, e, t, h))

def or_done_done(m: Maybe<&2, E.Err>, -r: E.Res(D.DType), -t: D.DType, h: {X.Expr.or_done(m, r) == Done{t} : E.Res(D.DType)}) -> {r == Done{t} : E.Res(D.DType)}:
  match m:
    case None{}:
      h
    case Some{e}:
      Empty.absurd({r == Done{t} : E.Res(D.DType)}, L.fail_done(D.DType, e, t, h))

def dtype_disc_bool(t: D.DType) -> Type:
  match t:
    case D.TBool{}:
      Unit
    case _:
      Empty

def dtype_disc_u32(t: D.DType) -> Type:
  match t:
    case D.TU32{}:
      Unit
    case _:
      Empty

def dtype_disc_i32(t: D.DType) -> Type:
  match t:
    case D.TI32{}:
      Unit
    case _:
      Empty

def dtype_disc_f32(t: D.DType) -> Type:
  match t:
    case D.TF32{}:
      Unit
    case _:
      Empty

def dtype_disc_str(t: D.DType) -> Type:
  match t:
    case D.TStr{}:
      Unit
    case _:
      Empty

def dtype_eq_sound(a: D.DType, b: D.DType, h: {D.DType.eq(a, b) == True{} : Bool}) -> {a == b : D.DType}:
  match a b:
    case D.TBool{} D.TBool{}:
      {==}
    case D.TBool{} D.TU32{}:
      PV.true_false_any({D.TBool{} == D.TU32{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TBool{} D.TI32{}:
      PV.true_false_any({D.TBool{} == D.TI32{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TBool{} D.TF32{}:
      PV.true_false_any({D.TBool{} == D.TF32{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TBool{} D.TStr{}:
      PV.true_false_any({D.TBool{} == D.TStr{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TU32{} D.TBool{}:
      PV.true_false_any({D.TU32{} == D.TBool{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TU32{} D.TU32{}:
      {==}
    case D.TU32{} D.TI32{}:
      PV.true_false_any({D.TU32{} == D.TI32{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TU32{} D.TF32{}:
      PV.true_false_any({D.TU32{} == D.TF32{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TU32{} D.TStr{}:
      PV.true_false_any({D.TU32{} == D.TStr{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TI32{} D.TBool{}:
      PV.true_false_any({D.TI32{} == D.TBool{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TI32{} D.TU32{}:
      PV.true_false_any({D.TI32{} == D.TU32{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TI32{} D.TI32{}:
      {==}
    case D.TI32{} D.TF32{}:
      PV.true_false_any({D.TI32{} == D.TF32{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TI32{} D.TStr{}:
      PV.true_false_any({D.TI32{} == D.TStr{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TF32{} D.TBool{}:
      PV.true_false_any({D.TF32{} == D.TBool{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TF32{} D.TU32{}:
      PV.true_false_any({D.TF32{} == D.TU32{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TF32{} D.TI32{}:
      PV.true_false_any({D.TF32{} == D.TI32{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TF32{} D.TF32{}:
      {==}
    case D.TF32{} D.TStr{}:
      PV.true_false_any({D.TF32{} == D.TStr{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TStr{} D.TBool{}:
      PV.true_false_any({D.TStr{} == D.TBool{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TStr{} D.TU32{}:
      PV.true_false_any({D.TStr{} == D.TU32{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TStr{} D.TI32{}:
      PV.true_false_any({D.TStr{} == D.TI32{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TStr{} D.TF32{}:
      PV.true_false_any({D.TStr{} == D.TF32{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TStr{} D.TStr{}:
      {==}

def is_bool_sound(a: D.DType, h: {X.DType.is_bool(a) == True{} : Bool}) -> {a == D.TBool{} : D.DType}:
  match a:
    case D.TBool{}:
      {==}
    case D.TU32{}:
      PV.true_false_any({D.TU32{} == D.TBool{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TI32{}:
      PV.true_false_any({D.TI32{} == D.TBool{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TF32{}:
      PV.true_false_any({D.TF32{} == D.TBool{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))
    case D.TStr{}:
      PV.true_false_any({D.TStr{} == D.TBool{} : D.DType}, Equal.sym(Bool, False{}, True{}, h))

# a well-typed binary operation has operands of one dtype (every rule asks for it)
def bin_same(op: X.BinOp, +ta: D.DType, +tb: D.DType, +t: D.DType, +hok: {X.Expr.type.bin.ok(op, ta, tb) == Done{t} : E.Res(D.DType)}) -> {ta == tb : D.DType}:
  match op:
    case X.Mod{}:
      dtype_eq_sound(ta, tb, chk_ok(D.DType.eq(ta, tb), E.TypeMismatch{"mod", D.DType.show(ta), D.DType.show(tb)}, Done{ta}, t, chk_done(X.DType.is_int(ta), E.TypeMismatch{"mod", "u32 or i32", D.DType.show(ta)}, X.Expr.chk(D.DType.eq(ta, tb), E.TypeMismatch{"mod", D.DType.show(ta), D.DType.show(tb)}, Done{ta}), t, hok)))
    case X.FloorDiv{}:
      dtype_eq_sound(ta, tb, chk_ok(D.DType.eq(ta, tb), E.TypeMismatch{"floor_div", D.DType.show(ta), D.DType.show(tb)}, Done{ta}, t, chk_done(X.DType.is_int(ta), E.TypeMismatch{"floor_div", "u32 or i32", D.DType.show(ta)}, X.Expr.chk(D.DType.eq(ta, tb), E.TypeMismatch{"floor_div", D.DType.show(ta), D.DType.show(tb)}, Done{ta}), t, hok)))
    case X.Add{}:
      dtype_eq_sound(ta, tb, chk_ok(D.DType.eq(ta, tb), E.TypeMismatch{"add", D.DType.show(ta), D.DType.show(tb)}, Done{ta}, t, chk_done(X.DType.is_num(ta), E.TypeMismatch{"add", "numeric", D.DType.show(ta)}, X.Expr.chk(D.DType.eq(ta, tb), E.TypeMismatch{"add", D.DType.show(ta), D.DType.show(tb)}, Done{ta}), t, hok)))
    case X.Sub{}:
      dtype_eq_sound(ta, tb, chk_ok(D.DType.eq(ta, tb), E.TypeMismatch{"sub", D.DType.show(ta), D.DType.show(tb)}, Done{ta}, t, chk_done(X.DType.is_num(ta), E.TypeMismatch{"sub", "numeric", D.DType.show(ta)}, X.Expr.chk(D.DType.eq(ta, tb), E.TypeMismatch{"sub", D.DType.show(ta), D.DType.show(tb)}, Done{ta}), t, hok)))
    case X.Mul{}:
      dtype_eq_sound(ta, tb, chk_ok(D.DType.eq(ta, tb), E.TypeMismatch{"mul", D.DType.show(ta), D.DType.show(tb)}, Done{ta}, t, chk_done(X.DType.is_num(ta), E.TypeMismatch{"mul", "numeric", D.DType.show(ta)}, X.Expr.chk(D.DType.eq(ta, tb), E.TypeMismatch{"mul", D.DType.show(ta), D.DType.show(tb)}, Done{ta}), t, hok)))
    case X.Div{}:
      Equal.trans(D.DType, ta, D.TF32{}, tb, dtype_eq_sound(ta, D.TF32{}, chk_ok(D.DType.eq(ta, D.TF32{}), E.TypeMismatch{"div", "f32", D.DType.show(ta)}, X.Expr.chk(D.DType.eq(tb, D.TF32{}), E.TypeMismatch{"div", "f32", D.DType.show(tb)}, Done{D.TF32{}}), t, hok)), Equal.sym(D.DType, tb, D.TF32{}, dtype_eq_sound(tb, D.TF32{}, chk_ok(D.DType.eq(tb, D.TF32{}), E.TypeMismatch{"div", "f32", D.DType.show(tb)}, Done{D.TF32{}}, t, chk_done(D.DType.eq(ta, D.TF32{}), E.TypeMismatch{"div", "f32", D.DType.show(ta)}, X.Expr.chk(D.DType.eq(tb, D.TF32{}), E.TypeMismatch{"div", "f32", D.DType.show(tb)}, Done{D.TF32{}}), t, hok)))))
    case X.And{}:
      Equal.trans(D.DType, ta, D.TBool{}, tb, is_bool_sound(ta, chk_ok(X.DType.is_bool(ta), E.TypeMismatch{"and", "bool", D.DType.show(ta)}, X.Expr.chk(X.DType.is_bool(tb), E.TypeMismatch{"and", "bool", D.DType.show(tb)}, Done{D.TBool{}}), t, hok)), Equal.sym(D.DType, tb, D.TBool{}, is_bool_sound(tb, chk_ok(X.DType.is_bool(tb), E.TypeMismatch{"and", "bool", D.DType.show(tb)}, Done{D.TBool{}}, t, chk_done(X.DType.is_bool(ta), E.TypeMismatch{"and", "bool", D.DType.show(ta)}, X.Expr.chk(X.DType.is_bool(tb), E.TypeMismatch{"and", "bool", D.DType.show(tb)}, Done{D.TBool{}}), t, hok)))))
    case X.Or{}:
      Equal.trans(D.DType, ta, D.TBool{}, tb, is_bool_sound(ta, chk_ok(X.DType.is_bool(ta), E.TypeMismatch{"or", "bool", D.DType.show(ta)}, X.Expr.chk(X.DType.is_bool(tb), E.TypeMismatch{"or", "bool", D.DType.show(tb)}, Done{D.TBool{}}), t, hok)), Equal.sym(D.DType, tb, D.TBool{}, is_bool_sound(tb, chk_ok(X.DType.is_bool(tb), E.TypeMismatch{"or", "bool", D.DType.show(tb)}, Done{D.TBool{}}, t, chk_done(X.DType.is_bool(ta), E.TypeMismatch{"or", "bool", D.DType.show(ta)}, X.Expr.chk(X.DType.is_bool(tb), E.TypeMismatch{"or", "bool", D.DType.show(tb)}, Done{D.TBool{}}), t, hok)))))
    case X.Eq{}:
      dtype_eq_sound(ta, tb, chk_ok(D.DType.eq(ta, tb), E.TypeMismatch{X.BinOp.name(X.Eq{}), D.DType.show(ta), D.DType.show(tb)}, Done{D.TBool{}}, t, hok))
    case X.Ne{}:
      dtype_eq_sound(ta, tb, chk_ok(D.DType.eq(ta, tb), E.TypeMismatch{X.BinOp.name(X.Ne{}), D.DType.show(ta), D.DType.show(tb)}, Done{D.TBool{}}, t, hok))
    case X.Lt{}:
      dtype_eq_sound(ta, tb, chk_ok(D.DType.eq(ta, tb), E.TypeMismatch{X.BinOp.name(X.Lt{}), D.DType.show(ta), D.DType.show(tb)}, Done{D.TBool{}}, t, hok))
    case X.Le{}:
      dtype_eq_sound(ta, tb, chk_ok(D.DType.eq(ta, tb), E.TypeMismatch{X.BinOp.name(X.Le{}), D.DType.show(ta), D.DType.show(tb)}, Done{D.TBool{}}, t, hok))
    case X.Gt{}:
      dtype_eq_sound(ta, tb, chk_ok(D.DType.eq(ta, tb), E.TypeMismatch{X.BinOp.name(X.Gt{}), D.DType.show(ta), D.DType.show(tb)}, Done{D.TBool{}}, t, hok))
    case X.Ge{}:
      dtype_eq_sound(ta, tb, chk_ok(D.DType.eq(ta, tb), E.TypeMismatch{X.BinOp.name(X.Ge{}), D.DType.show(ta), D.DType.show(tb)}, Done{D.TBool{}}, t, hok))

# is_in's rule always answers bool
def isin_ok_bool(vs: List<&2, D.Scalar>, +t2: D.DType, +t: D.DType, hok: {X.Expr.type.isin.ok(vs, t2) == Done{t} : E.Res(D.DType)}) -> {D.TBool{} == t : D.DType}:
  match vs:
    case Nil{}:
      L.done_inj(D.DType, D.TBool{}, t, hok)
    case v <> rest:
      isin_ok_bool(rest, t2, t, or_done_done(X.Expr.lit_of("is_in", t2, v), X.Expr.type.isin.ok(rest, t2), t, hok))

# clip's rule keeps the operand's dtype
def clip_ok_t(+lo: D.Scalar, +hi: D.Scalar, +t2: D.DType, +t: D.DType, hok: {X.Expr.type.clip.ok(lo, hi, t2) == Done{t} : E.Res(D.DType)}) -> {t2 == t : D.DType}:
  L.done_inj(D.DType, t2, t, or_done_done(X.Expr.lit_of("clip", t2, hi), Done{t2}, t, or_done_done(X.Expr.lit_of("clip", t2, lo), X.Expr.or_done(X.Expr.lit_of("clip", t2, hi), Done{t2}), t, chk_done(X.DType.is_num(t2), E.TypeMismatch{"clip", "numeric", D.DType.show(t2)}, X.Expr.or_done(X.Expr.lit_of("clip", t2, lo), X.Expr.or_done(X.Expr.lit_of("clip", t2, hi), Done{t2})), t, hok))))

# ---- Eval.un ---------------------------------------------------------------------------------------

def isnull_w(neg: Bool, +n: U32, +d: Nat, v: C.Valid) -> Laws.ColW(D.TBool{}, n, V.Eval.un.isnull(neg, n, d, v)):
  match neg v:
    case True{} C.AllValid{}:
      (C.CBool{n, d, C.AllValid{}, Array.new(U32, d, 0)}, {==}, ({==}, {==}))
    case False{} C.AllValid{}:
      (C.CBool{n, d, C.AllValid{}, Array.new(U32, d, 1)}, {==}, ({==}, {==}))
    case True{} C.Mask{m}:
      (C.CBool{n, d, C.AllValid{}, K.Kernel.mask_not(n, d, m)}, {==}, ({==}, {==}))
    case False{} C.Mask{m}:
      (C.CBool{n, d, C.AllValid{}, m}, {==}, ({==}, {==}))

def Laws.eval_un_typed(op, c, t, hok):
  match op c:
    case X.Neg{} C.CBool{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.un(X.Neg{}, C.CBool{n, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.un.ok(X.Neg{}, D.TBool{}), t, {==}, hok))
    case X.Neg{} C.CU32{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.un(X.Neg{}, C.CU32{n, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.un.ok(X.Neg{}, D.TU32{}), t, {==}, hok))
    case X.Neg{} C.CI32{+n, +d, v, x}:
      (V.Eval.un(X.Neg{}, C.CI32{n, d, v, x}), {==}, (L.done_inj(D.DType, D.TI32{}, t, hok), {==}))
    case X.Neg{} C.CF32{+n, +d, v, x}:
      (V.Eval.un(X.Neg{}, C.CF32{n, d, v, x}), {==}, (L.done_inj(D.DType, D.TF32{}, t, hok), {==}))
    case X.Neg{} C.CStr{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.un(X.Neg{}, C.CStr{n, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.un.ok(X.Neg{}, D.TStr{}), t, {==}, hok))
    case X.Not{} C.CBool{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.fix.w(D.TBool{}, n, d, v, K.Kernel.map(~U32, ~U32, ~(w => U32.xor(w, 1)), n, d, x, 0))}, L.done_inj(D.DType, D.TBool{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.fix.w(D.TBool{}, n, d, v, K.Kernel.map(~U32, ~U32, ~(w => U32.xor(w, 1)), n, d, x, 0)), PV.fixw_w(D.TBool{}, n, d, v, K.Kernel.map(~U32, ~U32, ~(w => U32.xor(w, 1)), n, d, x, 0))))
    case X.Not{} C.CU32{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.un(X.Not{}, C.CU32{n, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.un.ok(X.Not{}, D.TU32{}), t, {==}, hok))
    case X.Not{} C.CI32{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.un(X.Not{}, C.CI32{n, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.un.ok(X.Not{}, D.TI32{}), t, {==}, hok))
    case X.Not{} C.CF32{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.un(X.Not{}, C.CF32{n, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.un.ok(X.Not{}, D.TF32{}), t, {==}, hok))
    case X.Not{} C.CStr{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.un(X.Not{}, C.CStr{n, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.un.ok(X.Not{}, D.TStr{}), t, {==}, hok))
    case X.IsNull{} C.CBool{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.un.isnull(True{}, n, d, v)}, L.done_inj(D.DType, D.TBool{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.un.isnull(True{}, n, d, v), isnull_w(True{}, n, d, v)))
    case X.IsNull{} C.CU32{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.un.isnull(True{}, n, d, v)}, L.done_inj(D.DType, D.TBool{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.un.isnull(True{}, n, d, v), isnull_w(True{}, n, d, v)))
    case X.IsNull{} C.CI32{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.un.isnull(True{}, n, d, v)}, L.done_inj(D.DType, D.TBool{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.un.isnull(True{}, n, d, v), isnull_w(True{}, n, d, v)))
    case X.IsNull{} C.CF32{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.un.isnull(True{}, n, d, v)}, L.done_inj(D.DType, D.TBool{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.un.isnull(True{}, n, d, v), isnull_w(True{}, n, d, v)))
    case X.IsNull{} C.CStr{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.un.isnull(True{}, n, d, v)}, L.done_inj(D.DType, D.TBool{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.un.isnull(True{}, n, d, v), isnull_w(True{}, n, d, v)))
    case X.IsNotNull{} C.CBool{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.un.isnull(False{}, n, d, v)}, L.done_inj(D.DType, D.TBool{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.un.isnull(False{}, n, d, v), isnull_w(False{}, n, d, v)))
    case X.IsNotNull{} C.CU32{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.un.isnull(False{}, n, d, v)}, L.done_inj(D.DType, D.TBool{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.un.isnull(False{}, n, d, v), isnull_w(False{}, n, d, v)))
    case X.IsNotNull{} C.CI32{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.un.isnull(False{}, n, d, v)}, L.done_inj(D.DType, D.TBool{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.un.isnull(False{}, n, d, v), isnull_w(False{}, n, d, v)))
    case X.IsNotNull{} C.CF32{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.un.isnull(False{}, n, d, v)}, L.done_inj(D.DType, D.TBool{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.un.isnull(False{}, n, d, v), isnull_w(False{}, n, d, v)))
    case X.IsNotNull{} C.CStr{+n, +d, v, x}:
