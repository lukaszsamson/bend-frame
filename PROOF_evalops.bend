      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.fix.w(D.TBool{}, n, d, V.Eval.vand(n, d, va, vb), V.Eval.zip.str(X.Ge{}, n, d, xa, xb))}, L.done_inj(D.DType, D.TBool{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.fix.w(D.TBool{}, n, d, V.Eval.vand(n, d, va, vb), V.Eval.zip.str(X.Ge{}, n, d, xa, xb)), PV.fixw_w(D.TBool{}, n, d, V.Eval.vand(n, d, va, vb), V.Eval.zip.str(X.Ge{}, n, d, xa, xb))))
    case X.And{}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(X.And{}, C.CStr{n, d, va, xa}, C.CStr{n2, d2, vb, xb})), PV.fail_done_r(D.DType, X.Expr.type.bin.ok(X.And{}, D.TStr{}, D.TStr{}), t, {==}, hok))
    case X.Or{}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(X.Or{}, C.CStr{n, d, va, xa}, C.CStr{n2, d2, vb, xb})), PV.fail_done_r(D.DType, X.Expr.type.bin.ok(X.Or{}, D.TStr{}, D.TStr{}), t, {==}, hok))

def Laws.eval_bin_typed(op, a, b, t, hok):
  match a b:
    case C.CBool{+n, +d, va, xa} C.CBool{+n2, +d2, vb, xb}:
      bin_cbool(op, n, d, va, vb, xa, xb, n2, d2, t, hok)
    case C.CBool{+n, +d, va, xa} C.CU32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CBool{n, d, va, xa}, C.CU32{n2, d2, vb, xb})), (%bin_same(op, D.TBool{}, D.TU32{}, t, hok) : dtype_disc_bool(_); Unit{}))
    case C.CBool{+n, +d, va, xa} C.CI32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CBool{n, d, va, xa}, C.CI32{n2, d2, vb, xb})), (%bin_same(op, D.TBool{}, D.TI32{}, t, hok) : dtype_disc_bool(_); Unit{}))
    case C.CBool{+n, +d, va, xa} C.CF32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CBool{n, d, va, xa}, C.CF32{n2, d2, vb, xb})), (%bin_same(op, D.TBool{}, D.TF32{}, t, hok) : dtype_disc_bool(_); Unit{}))
    case C.CBool{+n, +d, va, xa} C.CStr{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CBool{n, d, va, xa}, C.CStr{n2, d2, vb, xb})), (%bin_same(op, D.TBool{}, D.TStr{}, t, hok) : dtype_disc_bool(_); Unit{}))
    case C.CU32{+n, +d, va, xa} C.CBool{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CU32{n, d, va, xa}, C.CBool{n2, d2, vb, xb})), (%bin_same(op, D.TU32{}, D.TBool{}, t, hok) : dtype_disc_u32(_); Unit{}))
    case C.CU32{+n, +d, va, xa} C.CU32{+n2, +d2, vb, xb}:
      bin_cu32(op, n, d, va, vb, xa, xb, n2, d2, t, hok)
    case C.CU32{+n, +d, va, xa} C.CI32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CU32{n, d, va, xa}, C.CI32{n2, d2, vb, xb})), (%bin_same(op, D.TU32{}, D.TI32{}, t, hok) : dtype_disc_u32(_); Unit{}))
    case C.CU32{+n, +d, va, xa} C.CF32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CU32{n, d, va, xa}, C.CF32{n2, d2, vb, xb})), (%bin_same(op, D.TU32{}, D.TF32{}, t, hok) : dtype_disc_u32(_); Unit{}))
    case C.CU32{+n, +d, va, xa} C.CStr{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CU32{n, d, va, xa}, C.CStr{n2, d2, vb, xb})), (%bin_same(op, D.TU32{}, D.TStr{}, t, hok) : dtype_disc_u32(_); Unit{}))
    case C.CI32{+n, +d, va, xa} C.CBool{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CI32{n, d, va, xa}, C.CBool{n2, d2, vb, xb})), (%bin_same(op, D.TI32{}, D.TBool{}, t, hok) : dtype_disc_i32(_); Unit{}))
    case C.CI32{+n, +d, va, xa} C.CU32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CI32{n, d, va, xa}, C.CU32{n2, d2, vb, xb})), (%bin_same(op, D.TI32{}, D.TU32{}, t, hok) : dtype_disc_i32(_); Unit{}))
    case C.CI32{+n, +d, va, xa} C.CI32{+n2, +d2, vb, xb}:
      bin_ci32(op, n, d, va, vb, xa, xb, n2, d2, t, hok)
    case C.CI32{+n, +d, va, xa} C.CF32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CI32{n, d, va, xa}, C.CF32{n2, d2, vb, xb})), (%bin_same(op, D.TI32{}, D.TF32{}, t, hok) : dtype_disc_i32(_); Unit{}))
    case C.CI32{+n, +d, va, xa} C.CStr{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CI32{n, d, va, xa}, C.CStr{n2, d2, vb, xb})), (%bin_same(op, D.TI32{}, D.TStr{}, t, hok) : dtype_disc_i32(_); Unit{}))
    case C.CF32{+n, +d, va, xa} C.CBool{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CF32{n, d, va, xa}, C.CBool{n2, d2, vb, xb})), (%bin_same(op, D.TF32{}, D.TBool{}, t, hok) : dtype_disc_f32(_); Unit{}))
    case C.CF32{+n, +d, va, xa} C.CU32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CF32{n, d, va, xa}, C.CU32{n2, d2, vb, xb})), (%bin_same(op, D.TF32{}, D.TU32{}, t, hok) : dtype_disc_f32(_); Unit{}))
    case C.CF32{+n, +d, va, xa} C.CI32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CF32{n, d, va, xa}, C.CI32{n2, d2, vb, xb})), (%bin_same(op, D.TF32{}, D.TI32{}, t, hok) : dtype_disc_f32(_); Unit{}))
    case C.CF32{+n, +d, va, xa} C.CF32{+n2, +d2, vb, xb}:
      bin_cf32(op, n, d, va, vb, xa, xb, n2, d2, t, hok)
    case C.CF32{+n, +d, va, xa} C.CStr{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CF32{n, d, va, xa}, C.CStr{n2, d2, vb, xb})), (%bin_same(op, D.TF32{}, D.TStr{}, t, hok) : dtype_disc_f32(_); Unit{}))
    case C.CStr{+n, +d, va, xa} C.CBool{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CStr{n, d, va, xa}, C.CBool{n2, d2, vb, xb})), (%bin_same(op, D.TStr{}, D.TBool{}, t, hok) : dtype_disc_str(_); Unit{}))
    case C.CStr{+n, +d, va, xa} C.CU32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CStr{n, d, va, xa}, C.CU32{n2, d2, vb, xb})), (%bin_same(op, D.TStr{}, D.TU32{}, t, hok) : dtype_disc_str(_); Unit{}))
    case C.CStr{+n, +d, va, xa} C.CI32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CStr{n, d, va, xa}, C.CI32{n2, d2, vb, xb})), (%bin_same(op, D.TStr{}, D.TI32{}, t, hok) : dtype_disc_str(_); Unit{}))
    case C.CStr{+n, +d, va, xa} C.CF32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.bin(op, C.CStr{n, d, va, xa}, C.CF32{n2, d2, vb, xb})), (%bin_same(op, D.TStr{}, D.TF32{}, t, hok) : dtype_disc_str(_); Unit{}))
    case C.CStr{+n, +d, va, xa} C.CStr{+n2, +d2, vb, xb}:
      bin_cstr(op, n, d, va, vb, xa, xb, n2, d2, t, hok)

# ---- Eval.try_cast / Eval.cast: the conversion table of X.Cast.ok, totality of X.Cast.total -------------

def Laws.eval_try_cast_typed(to, c, hok):
  match to c:
    case D.TBool{} C.CBool{+n, +d, v, x}:
      (V.Eval.try_cast(D.TBool{}, C.CBool{n, d, v, x}), {==}, ({==}, {==}))
    case D.TBool{} C.CU32{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, D.TBool{}, n, V.Eval.try_cast(D.TBool{}, C.CU32{n, d, v, x})), L.false_true(hok))
    case D.TBool{} C.CI32{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, D.TBool{}, n, V.Eval.try_cast(D.TBool{}, C.CI32{n, d, v, x})), L.false_true(hok))
    case D.TBool{} C.CF32{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, D.TBool{}, n, V.Eval.try_cast(D.TBool{}, C.CF32{n, d, v, x})), L.false_true(hok))
    case D.TBool{} C.CStr{+n, +d, v, x}:
      PV.cast_pw_w(D.TBool{}, n, d, v, ST.Strs.map_r(~U32, ~(s => K.Kernel.r_of(~U32, V.Eval.read_bool(s), 0)), n, d, x, 0))
    case D.TU32{} C.CBool{+n, +d, v, x}:
      (V.Eval.try_cast(D.TU32{}, C.CBool{n, d, v, x}), {==}, ({==}, {==}))
    case D.TU32{} C.CU32{+n, +d, v, x}:
      (V.Eval.try_cast(D.TU32{}, C.CU32{n, d, v, x}), {==}, ({==}, {==}))
    case D.TU32{} C.CI32{+n, +d, v, x}:
      PV.cast_pw_w(D.TU32{}, n, d, v, K.Kernel.map_r(~U32, ~U32, ~(w => V.Eval.lo31(w)), n, d, x, 0))
    case D.TU32{} C.CF32{+n, +d, v, x}:
      PV.cast_pw_w(D.TU32{}, n, d, v, K.Kernel.map_r(~F32, ~U32, ~(w => V.Eval.f2u(w)), n, d, x, 0))
    case D.TU32{} C.CStr{+n, +d, v, x}:
      PV.cast_pw_w(D.TU32{}, n, d, v, ST.Strs.map_r(~U32, ~(s => K.Kernel.r_of(~U32, U32.read(s), 0)), n, d, x, 0))
    case D.TI32{} C.CBool{+n, +d, v, x}:
      (V.Eval.try_cast(D.TI32{}, C.CBool{n, d, v, x}), {==}, ({==}, {==}))
    case D.TI32{} C.CU32{+n, +d, v, x}:
      PV.cast_pw_w(D.TI32{}, n, d, v, K.Kernel.map_r(~U32, ~U32, ~(w => V.Eval.lo31(w)), n, d, x, 0))
    case D.TI32{} C.CI32{+n, +d, v, x}:
      (V.Eval.try_cast(D.TI32{}, C.CI32{n, d, v, x}), {==}, ({==}, {==}))
    case D.TI32{} C.CF32{+n, +d, v, x}:
      PV.cast_pw_w(D.TI32{}, n, d, v, K.Kernel.map_r(~F32, ~U32, ~(w => V.Eval.f2i_m(w)), n, d, x, 0))
    case D.TI32{} C.CStr{+n, +d, v, x}:
      PV.cast_pw_w(D.TI32{}, n, d, v, ST.Strs.map_r(~U32, ~(s => K.Kernel.r_of(~U32, V.Eval.i32_bits(D.I32.read(s)), 0)), n, d, x, 0))
    case D.TF32{} C.CBool{+n, +d, v, x}:
      (V.Eval.try_cast(D.TF32{}, C.CBool{n, d, v, x}), {==}, ({==}, {==}))
    case D.TF32{} C.CU32{+n, +d, v, x}:
      (V.Eval.try_cast(D.TF32{}, C.CU32{n, d, v, x}), {==}, ({==}, {==}))
    case D.TF32{} C.CI32{+n, +d, v, x}:
      (V.Eval.try_cast(D.TF32{}, C.CI32{n, d, v, x}), {==}, ({==}, {==}))
    case D.TF32{} C.CF32{+n, +d, v, x}:
      (V.Eval.try_cast(D.TF32{}, C.CF32{n, d, v, x}), {==}, ({==}, {==}))
    case D.TF32{} C.CStr{+n, +d, v, x}:
      PV.cast_pf_w(n, d, v, ST.Strs.map_r(~F32, ~(s => K.Kernel.r_of(~F32, V.Eval.read_f32(s), 0.0)), n, d, x, 0.0))
    case D.TStr{} C.CBool{+n, +d, v, x}:
      PV.done_w(D.TStr{}, n, V.Eval.fix.s(n, d, v, ST.SRaw{K.Kernel.map(~U32, ~String, ~(w => V.Eval.show_bool(w)), n, d, x, "")}), PV.fixs_w(n, d, v, ST.SRaw{K.Kernel.map(~U32, ~String, ~(w => V.Eval.show_bool(w)), n, d, x, "")}))
    case D.TStr{} C.CU32{+n, +d, v, x}:
      PV.done_w(D.TStr{}, n, V.Eval.fix.s(n, d, v, ST.SRaw{K.Kernel.map(~U32, ~String, ~(w => U32.show(w)), n, d, x, "")}), PV.fixs_w(n, d, v, ST.SRaw{K.Kernel.map(~U32, ~String, ~(w => U32.show(w)), n, d, x, "")}))
    case D.TStr{} C.CI32{+n, +d, v, x}:
      PV.done_w(D.TStr{}, n, V.Eval.fix.s(n, d, v, ST.SRaw{K.Kernel.map(~U32, ~String, ~(w => D.I32.show(D.I32{w})), n, d, x, "")}), PV.fixs_w(n, d, v, ST.SRaw{K.Kernel.map(~U32, ~String, ~(w => D.I32.show(D.I32{w})), n, d, x, "")}))
    case D.TStr{} C.CF32{+n, +d, v, x}:
      PV.done_w(D.TStr{}, n, V.Eval.fix.s(n, d, v, ST.SRaw{K.Kernel.map(~F32, ~String, ~(w => F32.show(w)), n, d, x, "")}), PV.fixs_w(n, d, v, ST.SRaw{K.Kernel.map(~F32, ~String, ~(w => F32.show(w)), n, d, x, "")}))
    case D.TStr{} C.CStr{+n, +d, v, x}:
      (V.Eval.try_cast(D.TStr{}, C.CStr{n, d, v, x}), {==}, ({==}, {==}))

# the strict cast of a fallible pair: try_cast of a clone, then the null counts compared
def cast_cmp2_w(same: Bool, +from: D.DType, +to: D.DType, +n: U32, -tc: C.Column, src3: C.Column, tc2: C.Column, e4: {tc2 == tc : C.Column}, ty: Laws.ColTy(to, n, tc)) -> Laws.ResW(False{}, to, n, V.Eval.cast.cmp2(same, from, to, src3, tc2)):
  match same:
    case True{}:
      (ed, el) = ty
      (Done{tc2}, {==}, PV.colty_along(to, n, tc, tc2, e4, ed, el))
    case False{}:
      (Fail{V.Eval.cast.fail(from, to, src3, tc2)}, {==}, {==})

def cast_cmp_w(+from: D.DType, +to: D.DType, +n: U32, -src: C.Column, -tc: C.Column, ty: Laws.ColTy(to, n, tc), ws: PV.NullCountW(src), wt: PV.NullCountW(tc)) -> Laws.ResW(False{}, to, n, V.Eval.cast.cmp(from, to, C.Column.null_count(src), C.Column.null_count(tc))):
  (src3, +k1, eq1, e3) = ws
  (tc2, +k2, eq2, e4) = wt
  %Equal.sym(C.Column & U32, C.Column.null_count(src), (src3, k1), eq1) : Laws.ResW(False{}, to, n, V.Eval.cast.cmp(from, to, _, C.Column.null_count(tc)))
  %Equal.sym(C.Column & U32, C.Column.null_count(tc), (tc2, k2), eq2) : Laws.ResW(False{}, to, n, V.Eval.cast.cmp(from, to, (src3, k1), _))
  cast_cmp2_w(U32.is_eq(k1, k2), from, to, n, tc, src3, tc2, e4, ty)

def cast_chk2_w(+from: D.DType, +to: D.DType, +n: U32, src: C.Column, r: E.ResT(C.Column), rt: Laws.ResTy(True{}, to, n, r)) -> Laws.ResW(False{}, to, n, V.Eval.cast.chk2(from, to, src, r)):
  match r:
    case Fail{e}:
      PV.true_false_any(Laws.ResW(False{}, to, n, V.Eval.cast.chk2(from, to, src, Fail{e})), rt)
    case Done{tc}:
      cast_cmp_w(from, to, n, src, tc, rt, PV.null_count_w(src), PV.null_count_w(tc))

def cast_chk_w(+from: D.DType, +to: D.DType, +n: U32, -c1: C.Column, src: C.Column, el: {Laws.clen(c1) == n : U32}, w: Laws.ResW(True{}, to, Laws.clen(c1), V.Eval.try_cast(to, c1))) -> Laws.ResW(False{}, to, n, V.Eval.cast.chk2(from, to, src, V.Eval.try_cast(to, c1))):
  (r, e, rt) = w
  %Equal.sym(E.ResT(C.Column), V.Eval.try_cast(to, c1), r, e) : Laws.ResW(False{}, to, n, V.Eval.cast.chk2(from, to, src, _))
  cast_chk2_w(from, to, n, src, r, (%el : Laws.ResTy(True{}, to, _, r); rt))

def cast_fallible_k(+from: D.DType, +to: D.DType, -c: C.Column, +n: U32, +ek: {n == Laws.clen(c) : U32}, hok: {X.Cast.ok(Laws.cdtype(c), to) == True{} : Bool}, w: PV.CloneW(c)) -> Laws.ResW(False{}, to, n, V.Eval.cast.chk(from, to, C.Column.clone(c))):
  (c1, c2, ec, +e1, e2) = w
  %Equal.sym(C.Column & C.Column, C.Column.clone(c), (c1, c2), ec) : Laws.ResW(False{}, to, n, V.Eval.cast.chk(from, to, _))
  cast_chk_w(from, to, n, c1, c2, Equal.trans(U32, Laws.clen(c1), Laws.clen(c), n, Equal.cong(C.Column, U32, q => Laws.clen(q), c1, c, e1), Equal.sym(U32, n, Laws.clen(c), ek)), Laws.eval_try_cast_typed(to, c1, (%Equal.sym(C.Column, c1, c, e1) : {X.Cast.ok(Laws.cdtype(_), to) == True{} : Bool}; hok)))

def cast_fallible_d2(+from: D.DType, +to: D.DType, c2: C.Column, +k: U32, +ek2: {k == Laws.clen(c2) : U32}, hok2: {X.Cast.ok(Laws.cdtype(c2), to) == True{} : Bool}) -> Laws.ResW(False{}, to, Laws.clen(c2), V.Eval.cast.chk(from, to, C.Column.clone(c2))):
  %ek2 : Laws.ResW(False{}, to, _, V.Eval.cast.chk(from, to, C.Column.clone(c2)))
  cast_fallible_k(from, to, c2, k, ek2, hok2, PV.clone_w(c2))

def cast_fallible_d(+from: D.DType, +to: D.DType, -c: C.Column, hok: {X.Cast.ok(Laws.cdtype(c), to) == True{} : Bool}, w: &c2: C.Column -> &k: U32 -> &dt: D.DType -> {c2 == c : C.Column} & {dt == Laws.cdtype(c) : D.DType} & {k == Laws.clen(c) : U32}) -> Laws.ResW(False{}, to, Laws.clen(c), V.Eval.cast.chk(from, to, C.Column.clone(c))):
  (c2, +k, dt, +ec, edt, ek) = w
  %ec : Laws.ResW(False{}, to, Laws.clen(_), V.Eval.cast.chk(from, to, C.Column.clone(_)))
  cast_fallible_d2(from, to, c2, k, PV.len_along(c2, c, k, ec, ek), (%Equal.sym(C.Column, c2, c, ec) : {X.Cast.ok(Laws.cdtype(_), to) == True{} : Bool}; hok))

# the strict cast of a fallible pair: cast.chk over a clone
def cast_fallible(+from: D.DType, +to: D.DType, c: C.Column, hok: {X.Cast.ok(Laws.cdtype(c), to) == True{} : Bool}) -> Laws.ResW(False{}, to, Laws.clen(c), V.Eval.cast.chk(from, to, C.Column.clone(c))):
  cast_fallible_d(from, to, c, hok, PV.col_dup2(c))

def Laws.eval_cast_typed(to, c, hok):
  match to c:
    case D.TBool{} C.CBool{+n, +d, v, x}:
      Laws.eval_try_cast_typed(D.TBool{}, C.CBool{n, d, v, x}, hok)
    case D.TBool{} C.CU32{+n, +d, v, x}:
      cast_fallible(D.TU32{}, D.TBool{}, C.CU32{n, d, v, x}, hok)
    case D.TBool{} C.CI32{+n, +d, v, x}:
      cast_fallible(D.TI32{}, D.TBool{}, C.CI32{n, d, v, x}, hok)
