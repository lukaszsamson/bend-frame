# the reductions over the valid rows: dropnull, then agg.dense (the dtype is kept by dropnull_w)
def agg_drop(op: X.AggOp, -c: C.Column, +t: D.DType, hok: {X.Expr.type.agg.ok(op, Laws.cdtype(c)) == Done{t} : E.Res(D.DType)}, w: PV.DropW(c)) -> Laws.ResW(True{}, t, 1, V.Eval.agg.dense(op, V.Eval.dropnull(c))):
  (c3, e, ed) = w
  %Equal.sym(C.Column, V.Eval.dropnull(c), c3, e) : Laws.ResW(True{}, t, 1, V.Eval.agg.dense(op, _))
  aggdense_w(op, c3, t, (%Equal.sym(D.DType, Laws.cdtype(c3), Laws.cdtype(c), ed) : {X.Expr.type.agg.ok(op, _) == Done{t} : E.Res(D.DType)}; hok))

# count: n minus the null count
def agg_count_w(+n: U32, -c: C.Column, +t: D.DType, e: {D.TU32{} == t : D.DType}, w: PV.NullCountW(c)) -> Laws.ResW(True{}, t, 1, Done{V.Eval.agg.count.b(n, C.Column.null_count(c))}):
  (c2, +k, eq, e2) = w
  %Equal.sym(C.Column & U32, C.Column.null_count(c), (c2, k), eq) : Laws.ResW(True{}, t, 1, Done{V.Eval.agg.count.b(n, _)})
  (Done{V.Eval.agg.count.b(n, (c2, k))}, {==}, (e, {==}))

# M4: n_unique over either Str storage (Raw: the strings; Dictionary: Eval.ds.nu over the codes)
def aggdense_nu_s(+k: U32, x: ST.Strs) -> &w: U32 -> {V.Eval.agg.s(X.NUnique{}, k, x) == Done{V.Eval.unit(D.SU32{w}, D.TU32{})} : E.ResT(C.Column)}:
  match x:
    case ST.SRaw{xs}:
      (V.Eval.nuniq(~String, ~(a => b => String.is_le(a, b)), ~(a => b => String.eq(a, b)), k, xs), {==})
    case ST.SDict{codes, dict}:
      (V.Eval.ds.nu(k, codes, dict), {==})

# n_unique: the distinct valid values plus one for a null
def aggdense_nu(c3: C.Column) -> &w: U32 -> {V.Eval.agg.dense(X.NUnique{}, c3) == Done{V.Eval.unit(D.SU32{w}, D.TU32{})} : E.ResT(C.Column)}:
  match c3:
    case C.CBool{k, d, v, x}:
      (V.Eval.nuniq(~U32, ~(a => b => U32.is_le(a, b)), ~(a => b => U32.is_eq(a, b)), k, x), {==})
    case C.CU32{k, d, v, x}:
      (V.Eval.nuniq(~U32, ~(a => b => U32.is_le(a, b)), ~(a => b => U32.is_eq(a, b)), k, x), {==})
    case C.CI32{k, d, v, x}:
      (V.Eval.nuniq(~U32, ~(a => b => U32.is_le(a, b)), ~(a => b => U32.is_eq(a, b)), k, x), {==})
    case C.CF32{+k, d, v, x}:
      (V.Eval.nuniq(~U32, ~(a => b => U32.is_le(a, b)), ~(a => b => U32.is_eq(a, b)), k, K.Kernel.map(~F32, ~U32, ~(w => K.Kernel.fword(w)), k, K.Kernel.depth_for(k), x, 0)), {==})
    case C.CStr{k, d, v, x}:
      aggdense_nu_s(k, x)

def nu_fin(+nulls: U32, -c3: C.Column, +t: D.DType, e: {D.TU32{} == t : D.DType}, w: &w: U32 -> {V.Eval.agg.dense(X.NUnique{}, c3) == Done{V.Eval.unit(D.SU32{w}, D.TU32{})} : E.ResT(C.Column)}) -> Laws.ResW(True{}, t, 1, V.Eval.nu.r(nulls, V.Eval.agg.dense(X.NUnique{}, c3))):
  (+w, eq) = w
  %Equal.sym(E.ResT(C.Column), V.Eval.agg.dense(X.NUnique{}, c3), Done{V.Eval.unit(D.SU32{w}, D.TU32{})}, eq) : Laws.ResW(True{}, t, 1, V.Eval.nu.r(nulls, _))
  (Done{V.Eval.unit(D.SU32{U32.add(w, Bool.to_u32(U32.is_ne(nulls, 0)))}, D.TU32{})}, {==}, (e, {==}))

def nu_drop(+nulls: U32, -c2: C.Column, +t: D.DType, e: {D.TU32{} == t : D.DType}, w: PV.DropW(c2)) -> Laws.ResW(True{}, t, 1, V.Eval.nu.r(nulls, V.Eval.agg.dense(X.NUnique{}, V.Eval.dropnull(c2)))):
  (c3, eq, ed) = w
  %Equal.sym(C.Column, V.Eval.dropnull(c2), c3, eq) : Laws.ResW(True{}, t, 1, V.Eval.nu.r(nulls, V.Eval.agg.dense(X.NUnique{}, _)))
  nu_fin(nulls, c3, t, e, aggdense_nu(c3))

def nu_count(-c: C.Column, +t: D.DType, e: {D.TU32{} == t : D.DType}, w: PV.NullCountW(c)) -> Laws.ResW(True{}, t, 1, V.Eval.nu.c(C.Column.null_count(c))):
  (c2, +k, eq, e2) = w
  %Equal.sym(C.Column & U32, C.Column.null_count(c), (c2, k), eq) : Laws.ResW(True{}, t, 1, V.Eval.nu.c(_))
  nu_drop(k, c2, t, e, PV.dropnull_w(c2))

# first / last: the cell at row 0 / n - 1 (null when empty), of the column's dtype
def pick_w(+t2: D.DType, +empty: Bool, +i: U32, -c: C.Column, +t: D.DType, e: {t2 == t : D.DType}, et: {Laws.cdtype(c) == t2 : D.DType}, w: Laws.CellW(c, i)) -> Laws.ResW(True{}, t, 1, Done{V.Eval.pick.c(t2, empty, C.Column.cell(c, i))}):
  (+s, eq, ed) = w
  %Equal.sym(C.Column & D.Scalar, C.Column.cell(c, i), (c, s), eq) : Laws.ResW(True{}, t, 1, Done{V.Eval.pick.c(t2, empty, _)})
  %e : Laws.ResW(True{}, _, 1, Done{V.Eval.pick.c(t2, empty, (c, s))})
  (Done{V.Eval.unit(Bool.pick(D.Scalar, empty, D.SNull{}, s), t2)}, {==}, unit_pick_lit(empty, s, t2, (%et : {Laws.lit_dtype(s, _) == _ : D.DType}; ed)))

def Laws.eval_agg_typed(op, c, t, hok):
  match op c:
    case X.Sum{} C.CBool{+n, +d, v, x}:
      agg_drop(X.Sum{}, C.CBool{n, d, v, x}, t, hok, PV.dropnull_w(C.CBool{n, d, v, x}))
    case X.Sum{} C.CU32{+n, +d, v, x}:
      agg_drop(X.Sum{}, C.CU32{n, d, v, x}, t, hok, PV.dropnull_w(C.CU32{n, d, v, x}))
    case X.Sum{} C.CI32{+n, +d, v, x}:
      agg_drop(X.Sum{}, C.CI32{n, d, v, x}, t, hok, PV.dropnull_w(C.CI32{n, d, v, x}))
    case X.Sum{} C.CF32{+n, +d, v, x}:
      agg_drop(X.Sum{}, C.CF32{n, d, v, x}, t, hok, PV.dropnull_w(C.CF32{n, d, v, x}))
    case X.Sum{} C.CStr{+n, +d, v, x}:
      agg_drop(X.Sum{}, C.CStr{n, d, v, x}, t, hok, PV.dropnull_w(C.CStr{n, d, v, x}))
    case X.Mean{} C.CBool{+n, +d, v, x}:
      agg_drop(X.Mean{}, C.CBool{n, d, v, x}, t, hok, PV.dropnull_w(C.CBool{n, d, v, x}))
    case X.Mean{} C.CU32{+n, +d, v, x}:
      agg_drop(X.Mean{}, C.CU32{n, d, v, x}, t, hok, PV.dropnull_w(C.CU32{n, d, v, x}))
    case X.Mean{} C.CI32{+n, +d, v, x}:
      agg_drop(X.Mean{}, C.CI32{n, d, v, x}, t, hok, PV.dropnull_w(C.CI32{n, d, v, x}))
    case X.Mean{} C.CF32{+n, +d, v, x}:
      agg_drop(X.Mean{}, C.CF32{n, d, v, x}, t, hok, PV.dropnull_w(C.CF32{n, d, v, x}))
    case X.Mean{} C.CStr{+n, +d, v, x}:
      agg_drop(X.Mean{}, C.CStr{n, d, v, x}, t, hok, PV.dropnull_w(C.CStr{n, d, v, x}))
    case X.Min{} C.CBool{+n, +d, v, x}:
      agg_drop(X.Min{}, C.CBool{n, d, v, x}, t, hok, PV.dropnull_w(C.CBool{n, d, v, x}))
    case X.Min{} C.CU32{+n, +d, v, x}:
      agg_drop(X.Min{}, C.CU32{n, d, v, x}, t, hok, PV.dropnull_w(C.CU32{n, d, v, x}))
    case X.Min{} C.CI32{+n, +d, v, x}:
      agg_drop(X.Min{}, C.CI32{n, d, v, x}, t, hok, PV.dropnull_w(C.CI32{n, d, v, x}))
    case X.Min{} C.CF32{+n, +d, v, x}:
      agg_drop(X.Min{}, C.CF32{n, d, v, x}, t, hok, PV.dropnull_w(C.CF32{n, d, v, x}))
    case X.Min{} C.CStr{+n, +d, v, x}:
      agg_drop(X.Min{}, C.CStr{n, d, v, x}, t, hok, PV.dropnull_w(C.CStr{n, d, v, x}))
    case X.Max{} C.CBool{+n, +d, v, x}:
      agg_drop(X.Max{}, C.CBool{n, d, v, x}, t, hok, PV.dropnull_w(C.CBool{n, d, v, x}))
    case X.Max{} C.CU32{+n, +d, v, x}:
      agg_drop(X.Max{}, C.CU32{n, d, v, x}, t, hok, PV.dropnull_w(C.CU32{n, d, v, x}))
    case X.Max{} C.CI32{+n, +d, v, x}:
      agg_drop(X.Max{}, C.CI32{n, d, v, x}, t, hok, PV.dropnull_w(C.CI32{n, d, v, x}))
    case X.Max{} C.CF32{+n, +d, v, x}:
      agg_drop(X.Max{}, C.CF32{n, d, v, x}, t, hok, PV.dropnull_w(C.CF32{n, d, v, x}))
    case X.Max{} C.CStr{+n, +d, v, x}:
      agg_drop(X.Max{}, C.CStr{n, d, v, x}, t, hok, PV.dropnull_w(C.CStr{n, d, v, x}))
    case X.Count{} C.CBool{+n, +d, v, x}:
      agg_count_w(n, C.CBool{n, d, v, x}, t, L.done_inj(D.DType, D.TU32{}, t, hok), PV.null_count_w(C.CBool{n, d, v, x}))
    case X.Count{} C.CU32{+n, +d, v, x}:
      agg_count_w(n, C.CU32{n, d, v, x}, t, L.done_inj(D.DType, D.TU32{}, t, hok), PV.null_count_w(C.CU32{n, d, v, x}))
    case X.Count{} C.CI32{+n, +d, v, x}:
      agg_count_w(n, C.CI32{n, d, v, x}, t, L.done_inj(D.DType, D.TU32{}, t, hok), PV.null_count_w(C.CI32{n, d, v, x}))
    case X.Count{} C.CF32{+n, +d, v, x}:
      agg_count_w(n, C.CF32{n, d, v, x}, t, L.done_inj(D.DType, D.TU32{}, t, hok), PV.null_count_w(C.CF32{n, d, v, x}))
    case X.Count{} C.CStr{+n, +d, v, x}:
      agg_count_w(n, C.CStr{n, d, v, x}, t, L.done_inj(D.DType, D.TU32{}, t, hok), PV.null_count_w(C.CStr{n, d, v, x}))
    case X.Len{} C.CBool{+n, +d, v, x}:
      (V.Eval.agg(X.Len{}, C.CBool{n, d, v, x}), {==}, (L.done_inj(D.DType, D.TU32{}, t, hok), {==}))
    case X.Len{} C.CU32{+n, +d, v, x}:
      (V.Eval.agg(X.Len{}, C.CU32{n, d, v, x}), {==}, (L.done_inj(D.DType, D.TU32{}, t, hok), {==}))
    case X.Len{} C.CI32{+n, +d, v, x}:
      (V.Eval.agg(X.Len{}, C.CI32{n, d, v, x}), {==}, (L.done_inj(D.DType, D.TU32{}, t, hok), {==}))
    case X.Len{} C.CF32{+n, +d, v, x}:
      (V.Eval.agg(X.Len{}, C.CF32{n, d, v, x}), {==}, (L.done_inj(D.DType, D.TU32{}, t, hok), {==}))
    case X.Len{} C.CStr{+n, +d, v, x}:
      (V.Eval.agg(X.Len{}, C.CStr{n, d, v, x}), {==}, (L.done_inj(D.DType, D.TU32{}, t, hok), {==}))
    case X.NUnique{} C.CBool{+n, +d, v, x}:
      nu_count(C.CBool{n, d, v, x}, t, L.done_inj(D.DType, D.TU32{}, t, hok), PV.null_count_w(C.CBool{n, d, v, x}))
    case X.NUnique{} C.CU32{+n, +d, v, x}:
      nu_count(C.CU32{n, d, v, x}, t, L.done_inj(D.DType, D.TU32{}, t, hok), PV.null_count_w(C.CU32{n, d, v, x}))
    case X.NUnique{} C.CI32{+n, +d, v, x}:
      nu_count(C.CI32{n, d, v, x}, t, L.done_inj(D.DType, D.TU32{}, t, hok), PV.null_count_w(C.CI32{n, d, v, x}))
    case X.NUnique{} C.CF32{+n, +d, v, x}:
      nu_count(C.CF32{n, d, v, x}, t, L.done_inj(D.DType, D.TU32{}, t, hok), PV.null_count_w(C.CF32{n, d, v, x}))
    case X.NUnique{} C.CStr{+n, +d, v, x}:
      nu_count(C.CStr{n, d, v, x}, t, L.done_inj(D.DType, D.TU32{}, t, hok), PV.null_count_w(C.CStr{n, d, v, x}))
    case X.First{} C.CBool{+n, +d, v, x}:
      pick_w(D.TBool{}, U32.is_zero(n), 0, C.CBool{n, d, v, x}, t, L.done_inj(D.DType, D.TBool{}, t, hok), {==}, Laws.cell_w(C.CBool{n, d, v, x}, 0))
    case X.First{} C.CU32{+n, +d, v, x}:
      pick_w(D.TU32{}, U32.is_zero(n), 0, C.CU32{n, d, v, x}, t, L.done_inj(D.DType, D.TU32{}, t, hok), {==}, Laws.cell_w(C.CU32{n, d, v, x}, 0))
    case X.First{} C.CI32{+n, +d, v, x}:
      pick_w(D.TI32{}, U32.is_zero(n), 0, C.CI32{n, d, v, x}, t, L.done_inj(D.DType, D.TI32{}, t, hok), {==}, Laws.cell_w(C.CI32{n, d, v, x}, 0))
    case X.First{} C.CF32{+n, +d, v, x}:
      pick_w(D.TF32{}, U32.is_zero(n), 0, C.CF32{n, d, v, x}, t, L.done_inj(D.DType, D.TF32{}, t, hok), {==}, Laws.cell_w(C.CF32{n, d, v, x}, 0))
    case X.First{} C.CStr{+n, +d, v, x}:
      pick_w(D.TStr{}, U32.is_zero(n), 0, C.CStr{n, d, v, x}, t, L.done_inj(D.DType, D.TStr{}, t, hok), {==}, Laws.cell_w(C.CStr{n, d, v, x}, 0))
    case X.Last{} C.CBool{+n, +d, v, x}:
      pick_w(D.TBool{}, U32.is_zero(n), U32.sub(n, 1), C.CBool{n, d, v, x}, t, L.done_inj(D.DType, D.TBool{}, t, hok), {==}, Laws.cell_w(C.CBool{n, d, v, x}, U32.sub(n, 1)))
    case X.Last{} C.CU32{+n, +d, v, x}:
      pick_w(D.TU32{}, U32.is_zero(n), U32.sub(n, 1), C.CU32{n, d, v, x}, t, L.done_inj(D.DType, D.TU32{}, t, hok), {==}, Laws.cell_w(C.CU32{n, d, v, x}, U32.sub(n, 1)))
    case X.Last{} C.CI32{+n, +d, v, x}:
      pick_w(D.TI32{}, U32.is_zero(n), U32.sub(n, 1), C.CI32{n, d, v, x}, t, L.done_inj(D.DType, D.TI32{}, t, hok), {==}, Laws.cell_w(C.CI32{n, d, v, x}, U32.sub(n, 1)))
    case X.Last{} C.CF32{+n, +d, v, x}:
      pick_w(D.TF32{}, U32.is_zero(n), U32.sub(n, 1), C.CF32{n, d, v, x}, t, L.done_inj(D.DType, D.TF32{}, t, hok), {==}, Laws.cell_w(C.CF32{n, d, v, x}, U32.sub(n, 1)))
    case X.Last{} C.CStr{+n, +d, v, x}:
      pick_w(D.TStr{}, U32.is_zero(n), U32.sub(n, 1), C.CStr{n, d, v, x}, t, L.done_inj(D.DType, D.TStr{}, t, hok), {==}, Laws.cell_w(C.CStr{n, d, v, x}, U32.sub(n, 1)))
    case X.Std{} C.CBool{+n, +d, v, x}:
      agg_drop(X.Std{}, C.CBool{n, d, v, x}, t, hok, PV.dropnull_w(C.CBool{n, d, v, x}))
    case X.Std{} C.CU32{+n, +d, v, x}:
      agg_drop(X.Std{}, C.CU32{n, d, v, x}, t, hok, PV.dropnull_w(C.CU32{n, d, v, x}))
    case X.Std{} C.CI32{+n, +d, v, x}:
      agg_drop(X.Std{}, C.CI32{n, d, v, x}, t, hok, PV.dropnull_w(C.CI32{n, d, v, x}))
    case X.Std{} C.CF32{+n, +d, v, x}:
      agg_drop(X.Std{}, C.CF32{n, d, v, x}, t, hok, PV.dropnull_w(C.CF32{n, d, v, x}))
    case X.Std{} C.CStr{+n, +d, v, x}:
      agg_drop(X.Std{}, C.CStr{n, d, v, x}, t, hok, PV.dropnull_w(C.CStr{n, d, v, x}))
    case X.Var{} C.CBool{+n, +d, v, x}:
      agg_drop(X.Var{}, C.CBool{n, d, v, x}, t, hok, PV.dropnull_w(C.CBool{n, d, v, x}))
    case X.Var{} C.CU32{+n, +d, v, x}:
      agg_drop(X.Var{}, C.CU32{n, d, v, x}, t, hok, PV.dropnull_w(C.CU32{n, d, v, x}))
    case X.Var{} C.CI32{+n, +d, v, x}:
      agg_drop(X.Var{}, C.CI32{n, d, v, x}, t, hok, PV.dropnull_w(C.CI32{n, d, v, x}))
    case X.Var{} C.CF32{+n, +d, v, x}:
      agg_drop(X.Var{}, C.CF32{n, d, v, x}, t, hok, PV.dropnull_w(C.CF32{n, d, v, x}))
    case X.Var{} C.CStr{+n, +d, v, x}:
      agg_drop(X.Var{}, C.CStr{n, d, v, x}, t, hok, PV.dropnull_w(C.CStr{n, d, v, x}))
    case X.Median{} C.CBool{+n, +d, v, x}:
      agg_drop(X.Median{}, C.CBool{n, d, v, x}, t, hok, PV.dropnull_w(C.CBool{n, d, v, x}))
    case X.Median{} C.CU32{+n, +d, v, x}:
      agg_drop(X.Median{}, C.CU32{n, d, v, x}, t, hok, PV.dropnull_w(C.CU32{n, d, v, x}))
    case X.Median{} C.CI32{+n, +d, v, x}:
      agg_drop(X.Median{}, C.CI32{n, d, v, x}, t, hok, PV.dropnull_w(C.CI32{n, d, v, x}))
    case X.Median{} C.CF32{+n, +d, v, x}:
      agg_drop(X.Median{}, C.CF32{n, d, v, x}, t, hok, PV.dropnull_w(C.CF32{n, d, v, x}))
    case X.Median{} C.CStr{+n, +d, v, x}:
      agg_drop(X.Median{}, C.CStr{n, d, v, x}, t, hok, PV.dropnull_w(C.CStr{n, d, v, x}))

