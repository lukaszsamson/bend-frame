# the condition's 0/1 mask (Eval.when.c on a bool column), as a live witness
def whenc_w(+nc: U32, +dc: Nat, vc: C.Valid, xc: Array<U32>) -> &m: Array<U32> -> &n2: U32 -> {V.Eval.when.cv(nc, dc, vc, xc) == (m, n2) : Array<U32> & U32}:
  match vc:
    case C.AllValid{}:
      (xc, nc, {==})
    case C.Mask{mm}:
      (K.Kernel.mask_and(nc, dc, xc, mm), nc, {==})

# when.v over the branches, the condition mask m given
def whenv_w(m: Array<U32>, a: C.Column, b: C.Column, +t: D.DType, hok: {X.Expr.type.when.ok(D.TBool{}, Laws.cdtype(a), Laws.cdtype(b)) == Done{t} : E.Res(D.DType)}) -> Laws.ResW(True{}, t, Laws.clen(a), V.Eval.when.v(m, a, b)):
  match a b:
    case C.CBool{+n, +d, va, xa} C.CBool{+n2, +d2, vb, xb}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, V.Eval.when.w(D.TBool{}, n, d, va, vb, K.Kernel.choose(~U32, n, m, xa, xb)), L.done_inj(D.DType, D.TBool{}, t, hok), PV.when_w_w(D.TBool{}, n, d, va, vb, K.Kernel.choose(~U32, n, m, xa, xb)))
