      PV.resw_dtype(True{}, t, D.TF32{}, n, V.Eval.when.f(n, d, va, vb, K.Kernel.choose(~F32, n, m, xa, xb)), L.done_inj(D.DType, D.TF32{}, t, hok), PV.when_f_w(n, d, va, vb, K.Kernel.choose(~F32, n, m, xa, xb)))
    case C.CF32{+n, +d, va, xa} C.CStr{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.when.v(m, C.CF32{n, d, va, xa}, C.CStr{n2, d2, vb, xb})), PV.fail_done_r(D.DType, X.Expr.type.when.ok(D.TBool{}, D.TF32{}, D.TStr{}), t, {==}, hok))
    case C.CStr{+n, +d, va, xa} C.CBool{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.when.v(m, C.CStr{n, d, va, xa}, C.CBool{n2, d2, vb, xb})), PV.fail_done_r(D.DType, X.Expr.type.when.ok(D.TBool{}, D.TStr{}, D.TBool{}), t, {==}, hok))
    case C.CStr{+n, +d, va, xa} C.CU32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.when.v(m, C.CStr{n, d, va, xa}, C.CU32{n2, d2, vb, xb})), PV.fail_done_r(D.DType, X.Expr.type.when.ok(D.TBool{}, D.TStr{}, D.TU32{}), t, {==}, hok))
    case C.CStr{+n, +d, va, xa} C.CI32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.when.v(m, C.CStr{n, d, va, xa}, C.CI32{n2, d2, vb, xb})), PV.fail_done_r(D.DType, X.Expr.type.when.ok(D.TBool{}, D.TStr{}, D.TI32{}), t, {==}, hok))
    case C.CStr{+n, +d, va, xa} C.CF32{+n2, +d2, vb, xb}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.when.v(m, C.CStr{n, d, va, xa}, C.CF32{n2, d2, vb, xb})), PV.fail_done_r(D.DType, X.Expr.type.when.ok(D.TBool{}, D.TStr{}, D.TF32{}), t, {==}, hok))
    case C.CStr{+n, +d, va, xa} C.CStr{+n2, +d2, vb, xb}:
      PV.resw_dtype(True{}, t, D.TStr{}, n, V.Eval.when.str(n, d, m, va, vb, xa, xb), L.done_inj(D.DType, D.TStr{}, t, hok), PV.when_str_w(n, d, m, va, vb, xa, xb))

def when_bool(+nc: U32, +dc: Nat, -vc: C.Valid, -xc: Array<U32>, a: C.Column, b: C.Column, +t: D.DType, hok: {X.Expr.type.when.ok(D.TBool{}, Laws.cdtype(a), Laws.cdtype(b)) == Done{t} : E.Res(D.DType)}, w: &m: Array<U32> -> &n2: U32 -> {V.Eval.when.cv(nc, dc, vc, xc) == (m, n2) : Array<U32> & U32}) -> Laws.ResW(True{}, t, Laws.clen(a), V.Eval.when.m(a, b, V.Eval.when.cv(nc, dc, vc, xc))):
  (m, n2, e) = w
  %Equal.sym(Array<U32> & U32, V.Eval.when.cv(nc, dc, vc, xc), (m, n2), e) : Laws.ResW(True{}, t, Laws.clen(a), V.Eval.when.m(a, b, _))
  whenv_w(m, a, b, t, hok)

def Laws.eval_when_typed(c, a, b, t, hok):
  match c:
    case C.CBool{+nc, +dc, vc, xc}:
      when_bool(nc, dc, vc, xc, a, b, t, hok, whenc_w(nc, dc, vc, xc))
    case C.CU32{nc, dc, vc, xc}:
      Empty.absurd(Laws.ResW(True{}, t, Laws.clen(a), V.Eval.when(C.CU32{nc, dc, vc, xc}, a, b)), L.fail_done(D.DType, E.TypeMismatch{"when", "bool", D.DType.show(D.TU32{})}, t, hok))
    case C.CI32{nc, dc, vc, xc}:
      Empty.absurd(Laws.ResW(True{}, t, Laws.clen(a), V.Eval.when(C.CI32{nc, dc, vc, xc}, a, b)), L.fail_done(D.DType, E.TypeMismatch{"when", "bool", D.DType.show(D.TI32{})}, t, hok))
    case C.CF32{nc, dc, vc, xc}:
      Empty.absurd(Laws.ResW(True{}, t, Laws.clen(a), V.Eval.when(C.CF32{nc, dc, vc, xc}, a, b)), L.fail_done(D.DType, E.TypeMismatch{"when", "bool", D.DType.show(D.TF32{})}, t, hok))
    case C.CStr{nc, dc, vc, xc}:
      Empty.absurd(Laws.ResW(True{}, t, Laws.clen(a), V.Eval.when(C.CStr{nc, dc, vc, xc}, a, b)), L.fail_done(D.DType, E.TypeMismatch{"when", "bool", D.DType.show(D.TStr{})}, t, hok))

