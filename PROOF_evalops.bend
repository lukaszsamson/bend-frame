    case C.CU32{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.fix.w(D.TBool{}, n, d, v, K.Kernel.map_p(~U32, ~List<&2, U32>, ~U32, ~(p => w => Bool.to_u32(V.Eval.wmem(w, p))), n, d, x, V.Eval.isin.words(vs), 0))}, isin_ok_bool(vs, D.TU32{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.fix.w(D.TBool{}, n, d, v, K.Kernel.map_p(~U32, ~List<&2, U32>, ~U32, ~(p => w => Bool.to_u32(V.Eval.wmem(w, p))), n, d, x, V.Eval.isin.words(vs), 0)), PV.fixw_w(D.TBool{}, n, d, v, K.Kernel.map_p(~U32, ~List<&2, U32>, ~U32, ~(p => w => Bool.to_u32(V.Eval.wmem(w, p))), n, d, x, V.Eval.isin.words(vs), 0))))
    case C.CI32{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.fix.w(D.TBool{}, n, d, v, K.Kernel.map_p(~U32, ~List<&2, U32>, ~U32, ~(p => w => Bool.to_u32(V.Eval.wmem(w, p))), n, d, x, V.Eval.isin.words(vs), 0))}, isin_ok_bool(vs, D.TI32{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.fix.w(D.TBool{}, n, d, v, K.Kernel.map_p(~U32, ~List<&2, U32>, ~U32, ~(p => w => Bool.to_u32(V.Eval.wmem(w, p))), n, d, x, V.Eval.isin.words(vs), 0)), PV.fixw_w(D.TBool{}, n, d, v, K.Kernel.map_p(~U32, ~List<&2, U32>, ~U32, ~(p => w => Bool.to_u32(V.Eval.wmem(w, p))), n, d, x, V.Eval.isin.words(vs), 0))))
    case C.CF32{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.fix.w(D.TBool{}, n, d, v, K.Kernel.map_p(~F32, ~List<&2, U32>, ~U32, ~(p => w => Bool.to_u32(V.Eval.wmem(K.Kernel.fword(w), p))), n, d, x, V.Eval.isin.words(vs), 0))}, isin_ok_bool(vs, D.TF32{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.fix.w(D.TBool{}, n, d, v, K.Kernel.map_p(~F32, ~List<&2, U32>, ~U32, ~(p => w => Bool.to_u32(V.Eval.wmem(K.Kernel.fword(w), p))), n, d, x, V.Eval.isin.words(vs), 0)), PV.fixw_w(D.TBool{}, n, d, v, K.Kernel.map_p(~F32, ~List<&2, U32>, ~U32, ~(p => w => Bool.to_u32(V.Eval.wmem(K.Kernel.fword(w), p))), n, d, x, V.Eval.isin.words(vs), 0))))
    case C.CStr{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.fix.w(D.TBool{}, n, d, v, ST.Strs.map_p(~List<&2, String>, ~U32, ~(p => w => Bool.to_u32(V.Eval.smem(w, p))), n, d, x, V.Eval.isin.strs(vs), 0))}, isin_ok_bool(vs, D.TStr{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.fix.w(D.TBool{}, n, d, v, ST.Strs.map_p(~List<&2, String>, ~U32, ~(p => w => Bool.to_u32(V.Eval.smem(w, p))), n, d, x, V.Eval.isin.strs(vs), 0)), PV.fixw_w(D.TBool{}, n, d, v, ST.Strs.map_p(~List<&2, String>, ~U32, ~(p => w => Bool.to_u32(V.Eval.smem(w, p))), n, d, x, V.Eval.isin.strs(vs), 0))))

def Laws.eval_clip_typed(lo, hi, c, t, hok):
  match c:
    case C.CBool{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.clip(lo, hi, C.CBool{n, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.clip.ok(lo, hi, D.TBool{}), t, {==}, hok))
    case C.CU32{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TU32{}, n, Done{V.Eval.fix.w(D.TU32{}, n, d, v, K.Kernel.map_p(~U32, ~V.W2, ~U32, ~(p => w => V.Eval.clip.u(p, w)), n, d, x, V.W2{V.Eval.sword(lo), V.Eval.sword(hi)}, 0))}, clip_ok_t(lo, hi, D.TU32{}, t, hok), PV.done_w(D.TU32{}, n, V.Eval.fix.w(D.TU32{}, n, d, v, K.Kernel.map_p(~U32, ~V.W2, ~U32, ~(p => w => V.Eval.clip.u(p, w)), n, d, x, V.W2{V.Eval.sword(lo), V.Eval.sword(hi)}, 0)), PV.fixw_w(D.TU32{}, n, d, v, K.Kernel.map_p(~U32, ~V.W2, ~U32, ~(p => w => V.Eval.clip.u(p, w)), n, d, x, V.W2{V.Eval.sword(lo), V.Eval.sword(hi)}, 0))))
    case C.CI32{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TI32{}, n, Done{V.Eval.fix.w(D.TI32{}, n, d, v, K.Kernel.map_p(~U32, ~V.W2, ~U32, ~(p => w => V.Eval.clip.i(p, w)), n, d, x, V.W2{V.Eval.sword(lo), V.Eval.sword(hi)}, 0))}, clip_ok_t(lo, hi, D.TI32{}, t, hok), PV.done_w(D.TI32{}, n, V.Eval.fix.w(D.TI32{}, n, d, v, K.Kernel.map_p(~U32, ~V.W2, ~U32, ~(p => w => V.Eval.clip.i(p, w)), n, d, x, V.W2{V.Eval.sword(lo), V.Eval.sword(hi)}, 0)), PV.fixw_w(D.TI32{}, n, d, v, K.Kernel.map_p(~U32, ~V.W2, ~U32, ~(p => w => V.Eval.clip.i(p, w)), n, d, x, V.W2{V.Eval.sword(lo), V.Eval.sword(hi)}, 0))))
    case C.CF32{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TF32{}, n, Done{V.Eval.fix.f(n, d, v, K.Kernel.map_p(~F32, ~V.F2, ~F32, ~(p => w => V.Eval.clip.f(p, w)), n, d, x, V.F2{V.Eval.sf32(lo), V.Eval.sf32(hi)}, 0.0))}, clip_ok_t(lo, hi, D.TF32{}, t, hok), PV.done_w(D.TF32{}, n, V.Eval.fix.f(n, d, v, K.Kernel.map_p(~F32, ~V.F2, ~F32, ~(p => w => V.Eval.clip.f(p, w)), n, d, x, V.F2{V.Eval.sf32(lo), V.Eval.sf32(hi)}, 0.0)), PV.fixf_w(n, d, v, K.Kernel.map_p(~F32, ~V.F2, ~F32, ~(p => w => V.Eval.clip.f(p, w)), n, d, x, V.F2{V.Eval.sf32(lo), V.Eval.sf32(hi)}, 0.0))))
    case C.CStr{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.clip(lo, hi, C.CStr{n, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.clip.ok(lo, hi, D.TStr{}), t, {==}, hok))

def Laws.eval_strpred_typed(op, pat, c, t, hok):
  match c:
    case C.CBool{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.strpred(op, pat, C.CBool{n, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.strpred.ok(op, D.TBool{}), t, {==}, hok))
    case C.CU32{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.strpred(op, pat, C.CU32{n, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.strpred.ok(op, D.TU32{}), t, {==}, hok))
    case C.CI32{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.strpred(op, pat, C.CI32{n, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.strpred.ok(op, D.TI32{}), t, {==}, hok))
    case C.CF32{+n, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.strpred(op, pat, C.CF32{n, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.strpred.ok(op, D.TF32{}), t, {==}, hok))
    case C.CStr{+n, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, n, Done{V.Eval.fix.w(D.TBool{}, n, d, v, V.Eval.strpred.k(op, n, d, x, pat))}, L.done_inj(D.DType, D.TBool{}, t, hok), PV.done_w(D.TBool{}, n, V.Eval.fix.w(D.TBool{}, n, d, v, V.Eval.strpred.k(op, n, d, x, pat)), PV.fixw_w(D.TBool{}, n, d, v, V.Eval.strpred.k(op, n, d, x, pat))))

# ---- Eval.agg: one row of the agg rule's dtype --------------------------------------------------------
#
# The nullable one-row results are `Eval.unit(Bool.pick(.., SNull, s), t)`: the pick's Bool
# (U32.is_zero(k), U32.is_lt(k, 2)) is passed as a parameter and the scalar's payload as an
# erased Data value, so the lemma computes the dtype in both branches without knowing them.

# unit of a nullable word scalar (cell.word of a word dtype t2) has dtype t2
def unit_nz_word(b: Bool, +t2: D.DType, hw: {Laws.mkd(t2) == t2 : D.DType}, -w: U32) -> Laws.ColTy(t2, 1, V.Eval.unit(Bool.pick(D.Scalar, b, D.SNull{}, C.Column.cell.word(t2, w)), t2)):
  match b t2:
    case True{} D.TBool{}:
      ({==}, {==})
    case True{} D.TU32{}:
      ({==}, {==})
    case True{} D.TI32{}:
      ({==}, {==})
    case True{} D.TF32{}:
      ({==}, {==})
    case True{} D.TStr{}:
      ({==}, {==})
    case False{} D.TBool{}:
      ({==}, {==})
    case False{} D.TU32{}:
      ({==}, {==})
    case False{} D.TI32{}:
      ({==}, {==})
    case False{} D.TF32{}:
      (hw, {==})
    case False{} D.TStr{}:
      (hw, {==})

def unit_nz_f32(b: Bool, -w: F32) -> Laws.ColTy(D.TF32{}, 1, V.Eval.unit(Bool.pick(D.Scalar, b, D.SNull{}, D.SF32{w}), D.TF32{})):
  match b:
    case True{}:
      ({==}, {==})
    case False{}:
      ({==}, {==})

def unit_nz_str(b: Bool, -w: String) -> Laws.ColTy(D.TStr{}, 1, V.Eval.unit(Bool.pick(D.Scalar, b, D.SNull{}, D.SStr{w}), D.TStr{})):
  match b:
    case True{}:
      ({==}, {==})
    case False{}:
      ({==}, {==})

# a nullable scalar of dtype t2 (cell_w's fact) under a pick
def unit_pick_lit(b: Bool, s: D.Scalar, +t2: D.DType, hs: {Laws.lit_dtype(s, t2) == t2 : D.DType}) -> Laws.ColTy(t2, 1, V.Eval.unit(Bool.pick(D.Scalar, b, D.SNull{}, s), t2)):
  match b:
    case True{}:
      PV.unit_fin(t2, V.Eval.const_col.d(D.SNull{}, t2, 1, K.Kernel.depth_for(1)), PV.constnull_w(t2, 1, K.Kernel.depth_for(1)))
    case False{}:
      PV.unit_fin(t2, V.Eval.const_col.d(s, t2, 1, K.Kernel.depth_for(1)), PV.constcol_w(s, t2, t2, 1, K.Kernel.depth_for(1), hs))

# M4: the Str aggregations over either storage (Raw: Eval.agg.sr, the strings; Dictionary:
# Eval.agg.sd, through the entries)
def aggs_min_w(+k: U32, x: ST.Strs) -> Laws.ResW(True{}, D.TStr{}, 1, V.Eval.agg.s(X.Min{}, k, x)):
  match x:
    case ST.SRaw{xs}:
      (V.Eval.agg.s(X.Min{}, k, ST.SRaw{xs}), {==}, unit_nz_str(U32.is_zero(k), V.Eval.fold1(~String, ~(a => b => V.Eval.str_min(a, b)), k, xs)))
    case ST.SDict{codes, dict}:
      (V.Eval.agg.s(X.Min{}, k, ST.SDict{codes, dict}), {==}, unit_nz_str(U32.is_zero(k), V.Eval.ds.ext(False{}, k, codes, dict)))

def aggs_max_w(+k: U32, x: ST.Strs) -> Laws.ResW(True{}, D.TStr{}, 1, V.Eval.agg.s(X.Max{}, k, x)):
  match x:
    case ST.SRaw{xs}:
      (V.Eval.agg.s(X.Max{}, k, ST.SRaw{xs}), {==}, unit_nz_str(U32.is_zero(k), V.Eval.fold1(~String, ~(a => b => V.Eval.str_max(a, b)), k, xs)))
    case ST.SDict{codes, dict}:
      (V.Eval.agg.s(X.Max{}, k, ST.SDict{codes, dict}), {==}, unit_nz_str(U32.is_zero(k), V.Eval.ds.ext(True{}, k, codes, dict)))

def aggs_first_w(+k: U32, x: ST.Strs) -> Laws.ResW(True{}, D.TStr{}, 1, V.Eval.agg.s(X.First{}, k, x)):
  match x:
    case ST.SRaw{xs}:
      (V.Eval.agg.s(X.First{}, k, ST.SRaw{xs}), {==}, unit_nz_str(U32.is_zero(k), V.Eval.at(~String, xs, 0)))
    case ST.SDict{codes, dict}:
      (V.Eval.agg.s(X.First{}, k, ST.SDict{codes, dict}), {==}, unit_nz_str(U32.is_zero(k), V.Eval.ds.at(codes, 0, dict)))

def aggs_last_w(+k: U32, x: ST.Strs) -> Laws.ResW(True{}, D.TStr{}, 1, V.Eval.agg.s(X.Last{}, k, x)):
  match x:
    case ST.SRaw{xs}:
      (V.Eval.agg.s(X.Last{}, k, ST.SRaw{xs}), {==}, unit_nz_str(U32.is_zero(k), V.Eval.at(~String, xs, U32.sub(k, 1))))
    case ST.SDict{codes, dict}:
      (V.Eval.agg.s(X.Last{}, k, ST.SDict{codes, dict}), {==}, unit_nz_str(U32.is_zero(k), V.Eval.ds.at(codes, U32.sub(k, 1), dict)))

def aggs_count_w(+k: U32, x: ST.Strs, +t: D.DType, hok: {Done{D.TU32{}} == Done{t} : E.Res(D.DType)}) -> Laws.ResW(True{}, t, 1, V.Eval.agg.s(X.Count{}, k, x)):
  match x:
    case ST.SRaw{xs}:
      (V.Eval.agg.s(X.Count{}, k, ST.SRaw{xs}), {==}, (L.done_inj(D.DType, D.TU32{}, t, hok), {==}))
    case ST.SDict{codes, dict}:
      (V.Eval.agg.s(X.Count{}, k, ST.SDict{codes, dict}), {==}, (L.done_inj(D.DType, D.TU32{}, t, hok), {==}))

def aggs_len_w(+k: U32, x: ST.Strs, +t: D.DType, hok: {Done{D.TU32{}} == Done{t} : E.Res(D.DType)}) -> Laws.ResW(True{}, t, 1, V.Eval.agg.s(X.Len{}, k, x)):
  match x:
    case ST.SRaw{xs}:
      (V.Eval.agg.s(X.Len{}, k, ST.SRaw{xs}), {==}, (L.done_inj(D.DType, D.TU32{}, t, hok), {==}))
    case ST.SDict{codes, dict}:
      (V.Eval.agg.s(X.Len{}, k, ST.SDict{codes, dict}), {==}, (L.done_inj(D.DType, D.TU32{}, t, hok), {==}))

def aggs_nunique_w(+k: U32, x: ST.Strs, +t: D.DType, hok: {Done{D.TU32{}} == Done{t} : E.Res(D.DType)}) -> Laws.ResW(True{}, t, 1, V.Eval.agg.s(X.NUnique{}, k, x)):
  match x:
    case ST.SRaw{xs}:
      (V.Eval.agg.s(X.NUnique{}, k, ST.SRaw{xs}), {==}, (L.done_inj(D.DType, D.TU32{}, t, hok), {==}))
    case ST.SDict{codes, dict}:
      (V.Eval.agg.s(X.NUnique{}, k, ST.SDict{codes, dict}), {==}, (L.done_inj(D.DType, D.TU32{}, t, hok), {==}))

# agg.dense on the dense (null-free) column: per op and dtype
def aggdense_w(op: X.AggOp, c: C.Column, +t: D.DType, hok: {X.Expr.type.agg.ok(op, Laws.cdtype(c)) == Done{t} : E.Res(D.DType)}) -> Laws.ResW(True{}, t, 1, V.Eval.agg.dense(op, c)):
  match op c:
    case X.Sum{} C.CBool{+k, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, 1, V.Eval.agg.dense(X.Sum{}, C.CBool{k, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.agg.ok(X.Sum{}, D.TBool{}), t, {==}, hok))
    case X.Sum{} C.CU32{+k, +d, v, x}:
      (V.Eval.agg.dense(X.Sum{}, C.CU32{k, d, v, x}), {==}, (L.done_inj(D.DType, D.TU32{}, t, hok), {==}))
    case X.Sum{} C.CI32{+k, +d, v, x}:
      (V.Eval.agg.dense(X.Sum{}, C.CI32{k, d, v, x}), {==}, (L.done_inj(D.DType, D.TI32{}, t, hok), {==}))
    case X.Sum{} C.CF32{+k, +d, v, x}:
      (V.Eval.agg.dense(X.Sum{}, C.CF32{k, d, v, x}), {==}, (L.done_inj(D.DType, D.TF32{}, t, hok), {==}))
    case X.Sum{} C.CStr{+k, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, 1, V.Eval.agg.dense(X.Sum{}, C.CStr{k, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.agg.ok(X.Sum{}, D.TStr{}), t, {==}, hok))
    case X.Mean{} C.CBool{+k, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, 1, V.Eval.agg.dense(X.Mean{}, C.CBool{k, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.agg.ok(X.Mean{}, D.TBool{}), t, {==}, hok))
    case X.Mean{} C.CU32{+k, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TF32{}, 1, V.Eval.agg.dense(X.Mean{}, C.CU32{k, d, v, x}), L.done_inj(D.DType, D.TF32{}, t, hok), (V.Eval.agg.dense(X.Mean{}, C.CU32{k, d, v, x}), {==}, unit_nz_f32(U32.is_zero(k), F32.div(V.Eval.agg.wsum(D.TU32{}, k, x), U32.to_f32(k)))))
    case X.Mean{} C.CI32{+k, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TF32{}, 1, V.Eval.agg.dense(X.Mean{}, C.CI32{k, d, v, x}), L.done_inj(D.DType, D.TF32{}, t, hok), (V.Eval.agg.dense(X.Mean{}, C.CI32{k, d, v, x}), {==}, unit_nz_f32(U32.is_zero(k), F32.div(V.Eval.agg.wsum(D.TI32{}, k, x), U32.to_f32(k)))))
    case X.Mean{} C.CF32{+k, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TF32{}, 1, V.Eval.agg.dense(X.Mean{}, C.CF32{k, d, v, x}), L.done_inj(D.DType, D.TF32{}, t, hok), (V.Eval.agg.dense(X.Mean{}, C.CF32{k, d, v, x}), {==}, unit_nz_f32(U32.is_zero(k), F32.div(K.Kernel.fsum(~F32, ~(w => w), k, x), U32.to_f32(k)))))
    case X.Mean{} C.CStr{+k, +d, v, x}:
      Empty.absurd(Laws.ResW(True{}, t, 1, V.Eval.agg.dense(X.Mean{}, C.CStr{k, d, v, x})), PV.fail_done_r(D.DType, X.Expr.type.agg.ok(X.Mean{}, D.TStr{}), t, {==}, hok))
    case X.Min{} C.CBool{+k, +d, v, x}:
      PV.resw_dtype(True{}, t, D.TBool{}, 1, V.Eval.agg.dense(X.Min{}, C.CBool{k, d, v, x}), L.done_inj(D.DType, D.TBool{}, t, hok), (V.Eval.agg.dense(X.Min{}, C.CBool{k, d, v, x}), {==}, unit_nz_word(U32.is_zero(k), D.TBool{}, {==}, V.Eval.agg.wmin(D.TBool{}, k, x))))
