    case D.TStr{} C.CU32{+n, +d, v, x}:
      Laws.eval_try_cast_typed(D.TStr{}, C.CU32{n, d, v, x}, hok)
    case D.TStr{} C.CI32{+n, +d, v, x}:
      Laws.eval_try_cast_typed(D.TStr{}, C.CI32{n, d, v, x}, hok)
    case D.TStr{} C.CF32{+n, +d, v, x}:
