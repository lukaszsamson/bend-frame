      Empty.absurd(Laws.ResW(True{}, t, n, V.Eval.when.v(m, C.CBool{n, d, va, xa}, C.CU32{n2, d2, vb, xb})), PV.fail_done_r(D.DType, X.Expr.type.when.ok(D.TBool{}, D.TBool{}, D.TU32{}), t, {==}, hok))
