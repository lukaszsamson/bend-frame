    case D.TI32{} C.CF32{+n, +d, v, x}:
      cast_fallible(D.TF32{}, D.TI32{}, C.CF32{n, d, v, x}, hok)
    case D.TI32{} C.CStr{+n, +d, v, x}:
      cast_fallible(D.TStr{}, D.TI32{}, C.CStr{n, d, v, x}, hok)
    case D.TF32{} C.CBool{+n, +d, v, x}:
      Laws.eval_try_cast_typed(D.TF32{}, C.CBool{n, d, v, x}, hok)
    case D.TF32{} C.CU32{+n, +d, v, x}:
      Laws.eval_try_cast_typed(D.TF32{}, C.CU32{n, d, v, x}, hok)
    case D.TF32{} C.CI32{+n, +d, v, x}:
      Laws.eval_try_cast_typed(D.TF32{}, C.CI32{n, d, v, x}, hok)
    case D.TF32{} C.CF32{+n, +d, v, x}:
      Laws.eval_try_cast_typed(D.TF32{}, C.CF32{n, d, v, x}, hok)
    case D.TF32{} C.CStr{+n, +d, v, x}:
      cast_fallible(D.TStr{}, D.TF32{}, C.CStr{n, d, v, x}, hok)
    case D.TStr{} C.CBool{+n, +d, v, x}:
